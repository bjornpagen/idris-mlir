#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The growth check (`check`, Frontend/Growth/Check.idr) against brute force
# on every graph of up to three positions over a few weights, caps on some,
# and on hand cases: Box.idr, run by the pinned Idris against the installed
# checker, with the check and the modules it imports copied from compiler/src
# (Proof/Growth.idr, Frontend/Growth/Potential.idr), so that a module
# beyond them, or anything of Core, fails this build. Its output is
# expected-stdout.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
src=$root/compiler/src/IdrisMLIR
mkdir -p "$work/src/IdrisMLIR/Proof" "$work/src/IdrisMLIR/Frontend/Growth" &&
  cp "$src/Proof/Growth.idr" "$work/src/IdrisMLIR/Proof/" &&
  cp "$src/Frontend/Growth/Check.idr" "$src/Frontend/Growth/Potential.idr" "$work/src/IdrisMLIR/Frontend/Growth/" &&
  cp Box.idr "$work/src/Main.idr" || exit 1
packages=$(IDRIS2_PREFIX=$host_prefix "$idris2" --libdir)
if (cd "$work" && IDRIS2_PACKAGE_PATH=$packages && export IDRIS2_PACKAGE_PATH &&
    pinned_idris -p idris-mlir-checker --source-dir src --exec main src/Main.idr) > "$work/out" 2>&1 &&
   grep -v '^ *[0-9]*/[0-9]*: Building' "$work/out" | cmp -s - expected-stdout; then
  say "growth-check: every verdict as expected-stdout says"
else
  say "growth-check: a verdict otherwise"
  show "$work/out"
fi
