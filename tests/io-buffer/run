#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The runtime's buffers of standard input and output, one page of the
# target's each, are no part of what a program prints. io.c, linked with
# the build's runtime as a program is, is given the buffer's size, the page
# size the build records, and writes past the buffer's end: each character
# of every UTF-8 length meets it at every offset from 0 to 9, and a text
# runs past two buffers. What it prints is what the same pieces print
# written straight to the descriptor, through no buffer; after a crash the
# writes are still printed, and the run ends as a crash (status 1). On an
# input whose 2- and 4-byte characters, lone '\r's and "\r\n" endings each
# meet a refill of the input buffer at every offset from 0 to 8, with a
# line longer than two buffers, echo gives back each line without the
# "\r\n" or "\n" that ends it, a '\r' anywhere else kept
# (idris_rt_io_get_line), then a "\n", and nothing for no input.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
build=${idris_mlir%/foreign/idr/idris-mlir}
runtime=$build/runtime/libidris_rt.a
page=$(cat "$build/runtime/page-size" 2> /dev/null)
case $page in
  '' | *[!0-9]*)
    say "the build records no page size ($build/runtime/page-size)"
    exit 0 ;;
esac

# The input, read from a file, so each refill reads a whole buffer and the
# refills fall at every multiple of the page size: lines of 0 to 20 bytes,
# every third ended by "\r\n"; then, at each offset from 0 to 8 before a
# refill, a 2-byte character, a 4-byte character, a '\r' that ends no
# line, and the '\r' of a "\r\n", each placed by a line of 'p's before it;
# one line of twice the page and 7 bytes; and last a line that no '\n'
# ends, whose own '\r' is its last byte. What echo gives back,
# $work/stdin.lines, is written beside it: each line without the "\r\n"
# or '\n' that ends it, then a '\n'. Under the C locale awk counts bytes.
if ! LC_ALL=C awk -v size="$page" -v lines_file="$work/stdin.lines" '
     # n copies of c, by doubling, so a page-long run costs no more than
     # its length times its few doublings.
     function run(n, c,   out, s) {
       out = ""; s = c
       while (n > 0) { if (n % 2 == 1) out = out s; s = s s; n = int(n / 2) }
       return out
     }
     function line(text, ending) {
       printf "%s%s", text, ending
       at += length(text) + length(ending)
       printf "%s\n", text > lines_file
     }
     # A line of p bytes after which the next byte is `to` bytes into a
     # buffer, 0 <= to < size; the line is at least its "\n".
     function pad(to,   n) {
       n = (to - at - 1) % size
       if (n < 0) n += size
       line(run(n, "p"), "\n")
     }
     BEGIN {
       at = 0
       for (n = 0; n <= 20; n++) line(run(n, "a"), n % 3 == 2 ? "\r\n" : "\n")
       for (o = 0; o <= 8; o++) {
         before = (size - o - 1) % size
         pad(before); line("x" "\303\251" "y", "\n")
         pad(before); line("x" "\360\237\230\200" "y", "\n")
         pad(before); line("x" "\r" "y", "\n")
         pad(before); line("x", "\r\n")
       }
       line(run(2 * size + 7, "z"), "\n")
       printf "end\r"
       printf "end\r\n" > lines_file
     }' > "$work/stdin" 2> "$work/awk.err"; then
  say "the input could not be written"
  show "$work/awk.err"
  exit 0
fi
: > "$work/empty"

if ! runtime_c link_program -O1 -I"$root/harness/prop" "$here/io.c" "$runtime" -o "$work/io" \
    > "$work/cc.log" 2>&1; then
  say "io: does not link"
  show "$work/cc.log"
  exit 0
fi
say "io: linked with the build's runtime, its buffers of the page size"

# Each mode's stdout, stderr and exit status in $work/MODE.out, .err and
# .status. The mode echo-empty is echo on no input at all.
for mode in echo echo-empty write direct crash; do
  case $mode in
    echo) bounded "$work/io" echo < "$work/stdin" ;;
    echo-empty) bounded "$work/io" echo < "$work/empty" ;;
    *) bounded "$work/io" "$mode" "$page" < "$work/empty" ;;
  esac > "$work/$mode.out" 2> "$work/$mode.err"
  say "$?" > "$work/$mode.status"
done

# first_difference A B: the first byte, from 1, where files A and B differ;
# where one is the other's start, the byte after the shorter one.
first_difference() {
  first_difference_byte=$(cmp -l "$1" "$2" 2> /dev/null | awk 'NR == 1 { print $1 }')
  if [ -z "$first_difference_byte" ]; then
    first_difference_a=$(wc -c < "$1" | tr -d ' ')
    first_difference_b=$(wc -c < "$2" | tr -d ' ')
    if [ "$first_difference_a" -lt "$first_difference_b" ]; then
      first_difference_byte=$((first_difference_a + 1))
    else
      first_difference_byte=$((first_difference_b + 1))
    fi
  fi
  say "$first_difference_byte"
}

if [ "$(cat "$work/echo.status")" != 0 ]; then
  say "echo: exit $(cat "$work/echo.status")"
  show "$work/echo.err"
elif cmp -s "$work/stdin.lines" "$work/echo.out"; then
  say "echo: stdout is stdin's lines, each without the \"\\r\\n\" or \"\\n\" that ends it"
else
  say "echo: stdout differs from stdin's lines at byte $(first_difference "$work/stdin.lines" "$work/echo.out")"
fi
if [ "$(cat "$work/echo-empty.status")" != 0 ] || [ -s "$work/echo-empty.out" ]; then
  say "echo: on no input, exit $(cat "$work/echo-empty.status") and $(wc -c < "$work/echo-empty.out" | tr -d ' ') bytes"
else
  say "echo: no input, no line"
fi

if [ "$(cat "$work/direct.status")" != 0 ] || [ ! -s "$work/direct.out" ]; then
  say "direct: exit $(cat "$work/direct.status"), $(wc -c < "$work/direct.out" | tr -d ' ') bytes"
  show "$work/direct.err"
fi
if [ "$(cat "$work/write.status")" != 0 ]; then
  say "write: exit $(cat "$work/write.status")"
  show "$work/write.err"
elif cmp -s "$work/direct.out" "$work/write.out"; then
  say "write: stdout is what its pieces print straight to the descriptor"
else
  say "write: stdout differs from its pieces' at byte $(first_difference "$work/direct.out" "$work/write.out")"
fi
if [ "$(cat "$work/crash.status")" != 1 ]; then
  say "crash: exit $(cat "$work/crash.status"), where a crash exits 1"
  show "$work/crash.err"
elif cmp -s "$work/direct.out" "$work/crash.out"; then
  say "crash: exit 1, and stdout is what its pieces print straight to the descriptor"
else
  say "crash: exit 1, and stdout differs from its pieces' at byte $(first_difference "$work/direct.out" "$work/crash.out")"
fi
