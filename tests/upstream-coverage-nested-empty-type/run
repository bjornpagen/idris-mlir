#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/111-coverage-nested-empty-type, carried: the stock Idris's
# coverage check refuted a missing case only by a pattern variable whose
# type no constructor's return type fits, so a Refl matched inside a pair
# or a case block's scrutinee, which refines an argument the tree then
# splits, left that argument's other values proposed and unrefuted.
# CaseBlock.idr's and Clause.idr's definitions are covering, and the
# patched check, which also finds a type empty when each constructor that
# fits takes an argument of an empty type, accepts them under %default
# total. Missing.idr's misses a case, whose argument's type is inhabited
# through the same constructors, and is still refused, naming it.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
for case in CaseBlock Clause; do
  cp "$root/upstream/111-coverage-nested-empty-type/$case.idr" "$work/$case.idr"
  if (cd "$work" && pinned_idris --check "$case.idr") > "$work/$case.out" 2>&1; then
    say "$case: the covering definitions are accepted"
  elif grep -q 'not covering' "$work/$case.out"; then
    say "$case: still reproduces: a covering definition is reported not covering"
  else
    say "$case: the stock Idris fails on the reproducer, which is not this bug"
    show "$work/$case.out"
  fi
done
cp "$root/upstream/111-coverage-nested-empty-type/Missing.idr" "$work/Missing.idr"
if (cd "$work" && pinned_idris --check Missing.idr) > "$work/Missing.out" 2>&1; then
  say "Missing: a definition that misses a case is accepted"
elif grep -q 'below (S _) _' "$work/Missing.out"; then
  say "Missing: refused, naming the case it misses"
else
  say "Missing: refused otherwise"
  show "$work/Missing.out"
fi
