#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The fork of Idris's compiler (compiler/idris) and this compiler meet in
# one place, IdrisMLIR.Frontend.*, which imports both: no module stands on
# both sides of it. A module of the fork is one whose root is a root of
# the fork's modules (compiler/idris/idris-compiler.ipkg); the rest of this
# compiler is IdrisMLIR.* outside Frontend. So:
#   - a module of compiler/src outside IdrisMLIR.Frontend imports nothing of
#     the fork;
#   - nothing under compiler/idris imports IdrisMLIR.*, Frontend included;
#   - a test or the harness (tests/, harness/) that imports the fork, a
#     check of the fork's own code, imports nothing of IdrisMLIR outside
#     Frontend.
# One rule: what imports the fork is the fork, a test of it or the
# frontend, and only the frontend also imports the rest of this compiler.
#
# The rule is `frontend_imports ROOT`, run on the repository and on the
# planted trees (lib/planted.sh), each with its own fork package: witness/
# breaks it once on each side (a fork package that claims a module of
# IdrisMLIR; compiler/src importing the fork, publicly too; the fork
# importing the frontend and the rest; a test and the harness importing
# both); near-miss/ holds what is allowed: the frontend importing both
# (IdrisMLIR.Frontend itself among it), a test importing the fork and the
# frontend, a module whose root only begins like a fork root's, and an
# import in a comment.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# roots ROOT: the roots of the fork's modules, as words.
roots() {
  awk 'found { print; next } /modules/ { found = 1; sub(/^.*modules/, ""); print }' \
      "$1/compiler/idris/idris-compiler.ipkg" 2> /dev/null |
    grep -oE '^[[:space:]]*,?[[:space:]]*[A-Z][A-Za-z0-9]*([.,[:space:]]|$)' |
    sed 's/^[[:space:]]*,\{0,1\}[[:space:]]*\([A-Z][A-Za-z0-9]*\).*/\1/' | sort -u | tr '\n' ' '
}

# imports FILE: the modules FILE imports, `line TAB module`, one a line.
imports() {
  sed -n 's/^import[[:space:]]\{1,\}\(public[[:space:]]\{1,\}\)\{0,1\}\([A-Za-z0-9_.][A-Za-z0-9_.]*\).*/\2/p; =' "$1" |
    awk '/^[0-9]+$/ { if (held != "") print $0 "\t" held; held = ""; next } { held = $0 }'
}
# of_compiler MODULE: whether MODULE is this compiler's outside its frontend.
of_compiler() {
  case $1 in
    IdrisMLIR.Frontend | IdrisMLIR.Frontend.*) return 1 ;;
    IdrisMLIR | IdrisMLIR.*) return 0 ;;
  esac
  return 1
}

# frontend_imports ROOT: the findings in the tree at ROOT, `path:line: what`.
frontend_imports() (
  cd "$1" || exit 1
  fork_roots=" $(roots .) "
  of_fork() {
    case $fork_roots in *" ${1%%.*} "*) return 0 ;; esac
    return 1
  }
  # The fork's package claims no module of this compiler.
  grep -nE '^[[:space:]]*,?[[:space:]]*IdrisMLIR([.,[:space:]]|$)' compiler/idris/idris-compiler.ipkg 2> /dev/null |
    sed 's|^\([0-9]*\):.*|compiler/idris/idris-compiler.ipkg:\1: the fork claims a module of IdrisMLIR|'
  # compiler/src outside the frontend: no import of the fork.
  [ -d compiler/src ] && find compiler/src \( -path compiler/src/IdrisMLIR/Frontend -o -name build \) -prune \
    -o -name '*.idr' ! -path compiler/src/IdrisMLIR/Frontend.idr -print | LC_ALL=C sort | while IFS= read -r file; do
      imports "$file" | while IFS='	' read -r n module; do
        of_fork "$module" && printf '%s:%s: imports %s, of the fork\n' "$file" "$n" "$module"
      done
    done
  # The tests and the harness: one that imports the fork imports nothing of
  # this compiler outside its frontend. A test's planted trees are not.
  for fi_dir in tests harness; do
    [ -d "$fi_dir" ] && find "$fi_dir" \( -name build -o -path 'tests/*/witness' -o -path 'tests/*/near-miss' \) -prune \
      -o -name '*.idr' -print
  done | LC_ALL=C sort | while IFS= read -r file; do
    imports "$file" > "$work/imported"
    fork_import=
    while IFS='	' read -r n module; do
      of_fork "$module" && fork_import=$module
    done < "$work/imported"
    [ -n "$fork_import" ] || continue
    while IFS='	' read -r n module; do
      of_compiler "$module" &&
        printf '%s:%s: imports %s beside the fork'"'"'s %s\n' "$file" "$n" "$module" "$fork_import"
    done < "$work/imported"
  done
  # The fork: no import of IdrisMLIR at all.
  [ -d compiler/idris ] && find compiler/idris -name build -prune -o -name '*.idr' -print | LC_ALL=C sort |
    while IFS= read -r file; do
      imports "$file" | while IFS='	' read -r n module; do
        case $module in
          IdrisMLIR | IdrisMLIR.*) printf '%s:%s: the fork imports %s\n' "$file" "$n" "$module" ;;
        esac
      done
    done
)

roots=$(roots "$root")
case " $roots " in
  *" Core "*) say "the fork's module roots include Core" ;;
  *) say "the fork's module roots lack Core: $roots" ;;
esac
frontend_imports "$root" > "$work/found"
if grep -q ': the fork claims' "$work/found"; then
  say "the fork's package claims modules of IdrisMLIR:"
  grep ': the fork claims' "$work/found" | sed 's/^/  /'
fi
if grep -q ', of the fork$' "$work/found"; then
  say "modules of compiler/src outside IdrisMLIR.Frontend that import the fork:"
  grep ', of the fork$' "$work/found" | sed 's/^/  /'
else
  say "compiler/src: only IdrisMLIR.Frontend imports the fork"
fi
if grep -q "beside the fork's" "$work/found"; then
  say "tests that import the fork and this compiler outside its frontend:"
  grep "beside the fork's" "$work/found" | sed 's/^/  /'
else
  say "tests: one that imports the fork imports nothing of IdrisMLIR outside Frontend"
fi
if grep -q ': the fork imports ' "$work/found"; then
  say "modules of the fork that import IdrisMLIR:"
  grep ': the fork imports ' "$work/found" | sed 's/^/  /'
else
  say "the fork imports nothing of IdrisMLIR"
fi
planted frontend_imports
