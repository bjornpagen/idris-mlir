#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# idr-expect's table of properties (Properties.inc) is what the runner
# prints from their records (harness/Properties.idr), byte for byte: the
# records are the one list, the committed table their output, so a hand
# edit of the table, or a record changed without the table written again,
# fails here, naming the file. Written again with
# `runtests --expect-table > foreign/idr/lib/Transforms/Expect/Properties.inc`.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
table=foreign/idr/lib/Transforms/Expect/Properties.inc
if ! "$runtests" --expect-table > "$work/printed" 2> "$work/printed.err"; then
  say "runtests --expect-table fails:"
  show "$work/printed.err"
elif cmp -s "$work/printed" "$root/$table"; then
  say "$table: as the records print it"
else
  say "$table: not as the records print it"
  diff "$root/$table" "$work/printed" | sed 's/^/  /'
fi
