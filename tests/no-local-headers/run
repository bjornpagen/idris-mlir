#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Every public declaration of foreign/idr is in one header under
# foreign/idr/include, which a unit includes by its path (idr/...); no
# header sits beside a .cpp, so a declaration two units share has one home
# and a helper one unit uses stays in that unit. The runtime's include
# directory is runtime/ itself: a unit of the runtime includes its headers
# (idris_rt.h, each part's one header) by their path from there, and so
# does harness/prop/runtime.h, the one header through which a test of the
# runtime joins the checked runtime as one of its units, to read the count
# of cells it holds that no shipped runtime keeps. Beyond those, one header
# of the repository is always allowed:
# runtime/idris_rt.h, the C ABI, which C, generated code, the folders and
# the driver read. What TableGen and CMake generate is no file of the
# repository, so including it is no finding.
#
# A ratchet: `allowed` lists each other include of today, `file: header`
# as the file spells it, and only shrinks. An include that is not listed
# fails, and so does a listed one that is gone, so that whoever removes an
# include removes its line.
#
# The rule is `local_headers ROOT`, its list ROOT/tests/no-local-headers/
# allowed, run on the repository and on the planted trees
# (Planted.idr): witness/ holds a header beside a .cpp, a unit of
# foreign/idr and one of the runtime that include a header beside them,
# a unit of foreign/idr and a test header other than runtime.h that
# include a runtime header unlisted, and a list with a line that is gone
# (a forbidden include is a finding at the includer and at the header);
# near-miss/ holds what is allowed: a public header by its path,
# idris_rt.h, a runtime header by its path from runtime/, from the runtime
# and from harness/prop/runtime.h, a listed include, a generated one and a
# system one.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# local_headers ROOT: the findings in the tree at ROOT, `path:line: what`
# or `path: what`. A test's planted trees are no sources of the tree.
local_headers() (
  cd "$1" || exit 1
  list=tests/no-local-headers/allowed
  find . \( -name third_party -o -name build -o -name sources -o -name '.?*' \
            -o -path './tests/*/witness' -o -path './tests/*/near-miss' \) -prune \
    -o -type f \( -name '*.c' -o -name '*.cc' -o -name '*.cppm' -o -name '*.cpp' -o -name '*.h' \
       -o -name '*.hpp' -o -name '*.inc' \) -print | sed 's|^\./||' | LC_ALL=C sort > "$work/sources"
  # No header beside a .cpp: every header of foreign/idr is under its
  # include directory.
  grep -E '^foreign/idr/.*\.(h|hpp)$' "$work/sources" | grep -v '^foreign/idr/include/' |
    sed 's/$/: a header outside foreign\/idr\/include/'
  # Each quoted include that names a file of the repository: beside the
  # including file, or on an include path of the build (foreign/idr/include,
  # runtime). Those the rule allows are not kept.
  while IFS= read -r file; do
    grep -nE '^[[:space:]]*#[[:space:]]*include[[:space:]]*"' "$file" |
      sed 's/^\([0-9]*\):[[:space:]]*#[[:space:]]*include[[:space:]]*"\([^"]*\)".*/\1 \2/' |
      while read -r n header; do
        for base in "${file%/*}" foreign/idr/include runtime; do
          [ -f "$base/$header" ] || continue
          case $base/$header in
            runtime/idris_rt.h | foreign/idr/include/*) ;;
            *) case $file:$base in
                 runtime/*:runtime | harness/prop/runtime.h:runtime) ;;
                 *) printf '%s\t%s\t%s\t%s\n' "$file" "$n" "$header" "$base/$header" ;;
               esac ;;
          esac
          break
        done
      done
  done < "$work/sources" > "$work/includes"
  if [ -f "$list" ]; then
    awk '!/^[[:space:]]*#/ && !/^[[:space:]]*$/ { print $0 "\t" FNR }' "$list" > "$work/allowed"
  else
    : > "$work/allowed"
  fi
  while IFS='	' read -r file n header path; do
    awk -F'\t' -v entry="$file: $header" '$1 == entry { found = 1 } END { exit !found }' "$work/allowed" && continue
    printf '%s:%s: includes %s, a header of the repository outside foreign/idr/include\n' "$file" "$n" "$header"
    printf '%s: included by %s:%s\n' "$path" "$file" "$n"
  done < "$work/includes"
  while IFS='	' read -r entry n; do
    awk -F'\t' -v entry="$entry" '$1 ": " $3 == entry { found = 1 } END { exit !found }' "$work/includes" ||
      printf '%s:%s: allows %s, which is gone\n' "$list" "$n" "$entry"
  done < "$work/allowed"
)

(cd "$root" && find foreign/idr runtime -name '*.cpp' | grep -q .) && say "sources: found" || say "sources: none found"
local_headers "$root" > "$work/found"
if grep -q ': a header outside' "$work/found"; then
  say "headers outside foreign/idr/include:"
  grep ': a header outside' "$work/found" | sed 's/^/  /'
else
  say "no header beside a .cpp"
fi
if grep -q ': includes ' "$work/found"; then
  say "includes of repository headers outside foreign/idr/include:"
  grep ': includes ' "$work/found" | sed 's/^/  /'
else
  say "no include of a repository header that is not allowed"
fi
if grep -q '^tests/no-local-headers/allowed:' "$work/found"; then
  say "allowed includes that are gone (delete their lines from allowed):"
  grep '^tests/no-local-headers/allowed:' "$work/found" | sed 's/^/  /'
else
  say "every allowed include is still there"
fi
planted local_headers
