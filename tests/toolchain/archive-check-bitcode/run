#!/bin/sh
# The runtime's archive check (runtime/check-archive.sh) reads both halves of
# a member that carries its bitcode: the native code every link reads and
# the bitcode that joins every program. llvm-nm alone reads such a member as
# its bitcode, so a member whose native code references the C++ runtime and
# whose bitcode does not would pass unseen. Members are made both ways, the
# native code of one source with the bitcode of another, in the two
# containers of the target entries: an ELF fat LTO object's .llvm.lto
# section and a Mach-O object's __LLVM,__bitcode section, as clang writes
# them (-ffat-lto-objects, -fembed-bitcode=all); the bitcode's own sections
# (__bitcode and __cmdline in Mach-O) are no constructors to it. x86-64
# objects stand for both formats: every pinned toolchain has that backend,
# and the object format alone decides what the check reads
# (runtime-archive-check checks the build's own runtime archive).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
check=$root/runtime/check-archive.sh
elf_sections='.init_array .fini_array .ctors .dtors .preinit_array'
macho_sections='__mod_init_func __mod_term_func __init_offsets'

entry='extern "C" int idris_rt_start(void) { return 0; }'
printf '%s\n' "$entry" > "$work/clean.cc"
printf '%s\n' "$entry" 'int *cell() { return new int; }' > "$work/cxx.cc"
printf '%s\n' "$entry" 'extern "C" int answer(void);' \
  'struct S { int v; S() : v(answer()) {} }; S s;' > "$work/ctor.cc"

# compile TRIPLE SOURCE OUT FLAG...: SOURCE for TRIPLE, with FLAG...
compile() {
  compile_triple=$1
  compile_source=$2
  compile_out=$3
  shift 3
  bounded "$llvm_bin/clang++" --target="$compile_triple" -O2 -fno-exceptions "$@" \
    "$compile_source" -o "$compile_out" > "$work/cc.log" 2>&1 && return 0
  say "${compile_source##*/} for $compile_triple: does not compile"
  show "$work/cc.log"
  return 1
}

# mixed FORMAT TRIPLE SECTION NATIVE BITCODE: a member whose native code is
# NATIVE's and whose bitcode, in SECTION, is BITCODE's, in the archive
# $work/FORMAT-NATIVE-BITCODE.a. The object is assembled from NATIVE's
# assembly, with BITCODE's bitcode added as SECTION's contents.
mixed() {
  mixed_name=$1-$4-$5
  compile "$2" "$work/$4.cc" "$work/$mixed_name.s" -S || return 1
  compile "$2" "$work/$5.cc" "$work/$mixed_name.bc" -c -emit-llvm || return 1
  printf '\t.section %s\n\t.incbin "%s"\n' "$3" "$work/$mixed_name.bc" >> "$work/$mixed_name.s"
  bounded "$llvm_bin/clang" --target="$2" -c "$work/$mixed_name.s" -o "$work/$mixed_name.o" \
    > "$work/cc.log" 2>&1 || { say "$mixed_name: does not assemble"; show "$work/cc.log"; return 1; }
  archive "$mixed_name"
}

# carried FORMAT TRIPLE SOURCE FLAG...: SOURCE compiled with its bitcode
# carried as FLAG... say, in the archive $work/FORMAT-SOURCE.a.
carried() {
  carried_name=$1-$3
  carried_triple=$2
  carried_source=$3
  shift 3
  compile "$carried_triple" "$work/$carried_source.cc" "$work/$carried_name.o" -c "$@" || return 1
  archive "$carried_name"
}

archive() {
  rm -f "$work/$1.a"
  bounded "$llvm_bin/llvm-ar" rcs "$work/$1.a" "$work/$1.o"
}

# check NAME PREFIX SECTIONS: the check of $work/NAME.a with the format's
# spellings: its exit status and what it printed, the work directory taken
# out.
check() {
  bounded sh "$check" "$llvm_bin/llvm-nm" "$llvm_bin/llvm-objdump" "$2" "$3" "$work/$1.a" \
    > "$work/check.out" 2>&1
  say "$1: exit $?"
  sed "s|$work/||g; s/^/  | /" "$work/check.out"
}

elf=x86_64-unknown-linux-musl
macho=x86_64-apple-macosx14.0
for source in clean ctor cxx; do
  carried elf "$elf" "$source" -flto=full -ffat-lto-objects || exit 0
  carried macho "$macho" "$source" -fembed-bitcode=all || exit 0
done
mixed elf "$elf" '.llvm.lto,"e"' cxx clean || exit 0
mixed elf "$elf" '.llvm.lto,"e"' clean cxx || exit 0
mixed macho "$macho" '__LLVM,__bitcode' cxx clean || exit 0
mixed macho "$macho" '__LLVM,__bitcode' clean cxx || exit 0

for source in clean ctor cxx cxx-clean clean-cxx; do
  check "elf-$source" '' "$elf_sections"
done
for source in clean ctor cxx cxx-clean clean-cxx; do
  check "macho-$source" _ "$macho_sections"
done
