#!/bin/sh
# 176,000 doubles printed by the runtime (Ryu's digits in its layout), each
# the text expected-doubles holds: the shortest digits that read back as
# the double, a tie to the even last digit, a subnormal as any other, and
# the special values as IEEE 754 spells them.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
# The runtime archive the build made, linked natively with GMP.
runtime=$dev_prefix/runtime/libidris_rt.a
build_test() {
  if link_program -O1 -I"$root/runtime" "$1" "$runtime" -o "$2" > "$work/cc.log" 2>&1; then
    say "${2##*/}: built"
  else
    say "${2##*/}: does not build"
    show "$work/cc.log"
    return 1
  fi
}
build_test "$here/fuzz.c" "$work/fuzz" || exit 0
"$work/fuzz" 176000 > "$work/ours" 2> "$work/fuzz.err"
say "fuzz: exit $?"
if cmp -s "$here/expected-doubles" "$work/ours"; then
  say "176000 doubles: the text expected-doubles holds"
else
  say "doubles printed differently (< expected-doubles, > runtime):"
  diff "$here/expected-doubles" "$work/ours" | head -n 20 | sed 's/^/  | /'
fi
