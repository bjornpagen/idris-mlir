#!/bin/sh
# 176,000 doubles printed by the runtime (Ryu's digits in its layout) and by
# Chez's number->string, read as this compiler writes Doubles
# (chez_doubles): every text is the same. The reading is seen to change
# Chez's text for each class of tests/lib/chez-divergences it applies.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
# The runtime archive the build made, linked natively with GMP.
runtime=$dev_prefix/runtime/libidris_rt.a
build_test() {
  if link_program -O1 -I"$root/runtime" "$1" "$runtime" -o "$2" > "$work/cc.log" 2>&1; then
    say "${2##*/}: built"
  else
    say "${2##*/}: does not build"
    show "$work/cc.log"
    return 1
  fi
}
build_test "$here/fuzz.c" "$work/fuzz" || exit 0
"$work/fuzz" 176000 "$work/bits" > "$work/ours" 2> "$work/fuzz.err"
say "fuzz: exit $?"
if [ -z "$chez_scheme" ]; then say "chez: not found"; exit 0; fi
"$chez_scheme" --script "$here/chez.ss" "$work/bits" > "$work/chez" 2> "$work/chez.err"
say "chez: exit $?"
chez_doubles "$work/chez" > "$work/chez.read"
if cmp -s "$work/ours" "$work/chez.read"; then
  say "176000 doubles: the same text as Chez's, read as ours"
else
  say "doubles printed differently (< runtime, > Chez read as ours):"
  diff "$work/ours" "$work/chez.read" | head -n 20 | sed 's/^/  | /'
fi
# The texts the reading changed, by class: as strings, which awk would
# otherwise compare as the numbers they spell.
paste -d ' ' "$work/chez" "$work/chez.read" | awk '
  ($1 "") != ($2 "") {
    if ($1 ~ /[|]/) subnormal = 1
    else if ($1 ~ /inf|nan/) special = 1
    else tie = 1
  }
  END {
    printf "read as double-subnormal-suffix: %s\n", subnormal ? "seen" : "not seen"
    printf "read as double-special-text: %s\n", special ? "seen" : "not seen"
    printf "read as double-tie-even: %s\n", tie ? "seen" : "not seen"
  }'
