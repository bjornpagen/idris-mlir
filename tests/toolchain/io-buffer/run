#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The size of the runtime's buffers of standard input and output is no part
# of what a program prints: io.c, linked with the runtime's IO units built
# for a buffer of 4 bytes (the least a character's longest UTF-8 needs) and
# of 7 (prime, so no write of 2 to 4 bytes fills it evenly), prints what it
# prints at the default size, on stdout and stderr, with the same exit
# status, in each of its modes. A small buffer reaches with little
# data every boundary the default one reaches with much: a refill inside a
# line and inside its "\r\n", a line longer than the buffer, a character
# encoded at the buffer's end. The default build is the relation's other
# side, not an oracle; at the default size, echo gives back its input
# without the "\r" of each "\r\n", as idris_rt_io_get_line drops it.
#
# Every IO unit is rebuilt for a size, not some: Scratch holds a buffer's
# worth inline, so its layout is the size's, and every unit that holds one
# must agree. The units are compiled with the runtime's C flags
# (runtime_c) for the build's page size and linked ahead of the build's
# runtime archive, whose own IO units the link then leaves out.
# A step is bounded as page-size-mismatch bounds its compile of a runtime
# unit, the longest step here.
step_limit=120
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
build=${idris_mlir%/foreign/idr/idris-mlir}
runtime=$build/runtime/libidris_rt.a
page=$(cat "$build/runtime/page-size" 2> /dev/null)
case $page in
  '' | *[!0-9]*)
    say "the build records no page size ($build/runtime/page-size)"
    exit 0 ;;
esac
target=$("$idris_mlir" --print-target-triple)

# The input: lines of 0 to 20 bytes; a 2-byte and a 4-byte character each at
# every offset from 0 to 8; one line of 9000 bytes, longer than the default
# buffer. Every line ends in "\n", every third in "\r\n", and no "\r" is
# anywhere else.
if ! awk 'function line(text) {
       lines++
       printf "%s%s\n", text, (lines % 3 == 0 ? "\r" : "")
     }
     function run(n, c,   s) { s = ""; while (n-- > 0) s = s c; return s }
     BEGIN {
       for (n = 0; n <= 20; n++) line(run(n, "a"))
       for (o = 0; o <= 8; o++) {
         line(run(o, "x") "\303\251" "y")
         line(run(o, "x") "\360\237\230\200" "y")
       }
       line(run(9000, "z"))
     }' > "$work/stdin" 2> "$work/awk.err"; then
  say "the input could not be written"
  show "$work/awk.err"
  exit 0
fi
tr -d '\r' < "$work/stdin" > "$work/stdin.lines"

# build SIZE: io.c with every IO unit compiled for a buffer of SIZE bytes,
# then the build's runtime, into $work/io-SIZE.
build() {
  for unit in "$root"/runtime/Io/*.cpp; do
    unit_name=${unit##*/}
    if ! runtime_c bounded "$llvm_bin/clang++" --target="$target" -std=c++26 -fno-exceptions \
        -fno-rtti -O2 "-DIDRIS_RT_PAGE_SIZE=$page" "-DIDRIS_RT_IO_BUFFER_SIZE=$1" -c "$unit" \
        -o "$work/$1-${unit_name%.cpp}.o" > "$work/cc.log" 2>&1; then
      say "size $1: $unit_name does not compile"
      show "$work/cc.log"
      return 1
    fi
  done
  if ! runtime_c link_program -O1 "$here/io.c" "$work/$1-"*.o "$runtime" -o "$work/io-$1" \
      > "$work/cc.log" 2>&1; then
    say "size $1: does not link"
    show "$work/cc.log"
    return 1
  fi
}
if ! runtime_c link_program -O1 "$here/io.c" "$runtime" -o "$work/io-default" \
    > "$work/cc.log" 2>&1; then
  say "the default size: does not link"
  show "$work/cc.log"
  exit 0
fi
build 4 || exit 0
build 7 || exit 0
say "io: built at the default size, 4 and 7"

# Each mode of each build on the input: its stdout, stderr and exit status
# in $work/SIZE.MODE.out, .err and .status.
for size in default 4 7; do
  for mode in echo write crash; do
    bounded "$work/io-$size" "$mode" < "$work/stdin" > "$work/$size.$mode.out" \
      2> "$work/$size.$mode.err"
    say "$?" > "$work/$size.$mode.status"
  done
done

# first_difference A B: the first byte, from 1, where files A and B differ;
# where one is the other's start, the byte after the shorter one.
first_difference() {
  first_difference_byte=$(cmp -l "$1" "$2" 2> /dev/null | awk 'NR == 1 { print $1 }')
  if [ -z "$first_difference_byte" ]; then
    first_difference_a=$(wc -c < "$1" | tr -d ' ')
    first_difference_b=$(wc -c < "$2" | tr -d ' ')
    if [ "$first_difference_a" -lt "$first_difference_b" ]; then
      first_difference_byte=$((first_difference_a + 1))
    else
      first_difference_byte=$((first_difference_b + 1))
    fi
  fi
  say "$first_difference_byte"
}

if [ "$(cat "$work/default.echo.status")" != 0 ]; then
  say "echo: exit $(cat "$work/default.echo.status") at the default size"
  show "$work/default.echo.err"
elif cmp -s "$work/stdin.lines" "$work/default.echo.out"; then
  say "echo: stdout is stdin without its line-ending carriage returns, at the default size"
else
  say "echo: stdout differs from stdin at byte $(first_difference "$work/stdin.lines" "$work/default.echo.out")"
fi

for size in 4 7; do
  : > "$work/differs"
  for mode in echo write crash; do
    for stream in out err; do
      if ! cmp -s "$work/default.$mode.$stream" "$work/$size.$mode.$stream"; then
        say "  $mode: std$stream differs at byte $(first_difference "$work/default.$mode.$stream" "$work/$size.$mode.$stream")" >> "$work/differs"
      fi
    done
    if ! cmp -s "$work/default.$mode.status" "$work/$size.$mode.status"; then
      say "  $mode: exit $(cat "$work/$size.$mode.status"), where the default size exits $(cat "$work/default.$mode.status")" >> "$work/differs"
    fi
  done
  if [ -s "$work/differs" ]; then
    say "size $size: prints what the default size does not:"
    cat "$work/differs"
  else
    say "size $size: echo, write and crash print what the default size prints, with the same exit status"
  fi
done
