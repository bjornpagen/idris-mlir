#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The runtime's integer text holds to its meaning in idris_rt.h, on every
# case a property draws and every input of its box: show and put write
# snprintf's decimal text and big_show GMP's, `cast` from String to an
# integer reads what its grammar generates as its value and every other
# string as 0, the texts round-trip, and every operation borrows its
# argument and returns one owned result (text.cpp). The report beside the
# transcript says how the cases fell into classes.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
. "$root/tests/toolchain/lib/prop.sh"
prop_build "$here/text.cpp" "$work/text" || exit 0
# Debt: 20000 cases a property ran in 4 seconds on the coding machine (the
# host's clang, arm64 macOS), most of it the capture's 20000 temporary
# files; the owner's build sets the number so that the program ends well
# within step_limit on both targets.
prop_run "$work/text" --seed 1 --cases 20000
