#!/bin/sh
# Nothing this repository builds links a shared library: our tools and every
# program are static, but for macOS's C library, libSystem, which Darwin
# ships only as a shared library. An ELF executable names no shared library
# and no interpreter (a static PIE); a Mach-O executable names libSystem
# alone.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
build=${idris_mlir_cc%/foreign/idr/idris-mlir-cc}
program=$work/start
if ! link_program -O1 -I"$root/runtime" "$root/tests/toolchain/page-size-mismatch/start.c" \
    "$build/runtime/libidris_rt.a" -o "$program" > "$work/cc.log" 2>&1; then
  say "start: does not link"
  show "$work/cc.log"
  exit 0
fi

# shared FILE: what FILE needs of a dynamic loader, one per line: an ELF
# file's interpreter and shared libraries, a Mach-O file's shared libraries
# other than libSystem.
shared() {
  if "$llvm_bin/llvm-objdump" --file-headers "$1" 2> /dev/null | grep -q 'file format mach-o'; then
    "$llvm_bin/llvm-objdump" --macho --dylibs-used "$1" |
      sed -n 's/^[[:space:]]*\([^ ]*\) (compatibility.*/\1/p' | grep -vx /usr/lib/libSystem.B.dylib
  else
    "$llvm_bin/llvm-readelf" --program-headers --dynamic "$1" |
      awk '$1 == "INTERP" { print "an interpreter" } /\(NEEDED\)/ { print $NF }'
  fi
}

for file in "$idris_mlir_cc" "$idris_mlir_opt" "$program"; do
  shared "$file" > "$work/shared"
  if [ -s "$work/shared" ]; then
    say "${file##*/}: needs $(paste -sd, "$work/shared")"
  else
    say "${file##*/}: static, but for libSystem on macOS"
  fi
done
