#!/bin/sh
# An evaluation-arena allocation that crosses a page boundary is usable
# whole: the arena is reserved address space, committed as it is touched,
# so nothing may assume an allocation ends on a page. The block the test
# asks for is two pages, so it always reaches a second page; a few odd
# small allocations first keep it off the arena's own page boundary.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
runtime=$dev_prefix/runtime/libidris_rt.a
if ! link_program -O1 -I"$root/runtime" "$here/cell.c" "$runtime" -o "$work/cell" \
    > "$work/cc.log" 2>&1; then
  say "cell: does not build"
  show "$work/cc.log"
  exit 0
fi
bounded "$work/cell"
say "cell: exit $?"
