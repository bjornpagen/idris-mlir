#!/bin/sh
# The runtime's big and string operations print what Chez computes, its
# Doubles read as this compiler writes them (chez_doubles); the casts from
# String follow the grammar of idris_rt.h, every double's text reads back as
# it, bytes from outside become a string as idris_rt.h says, and every
# operation returns a result its caller owns. Reference counting frees what
# it counts, a structure of any depth on a small stack, and a program that
# returns reports its live cells when IDRIS_RT_LIVE is 1.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
# The runtime archive the build made, linked natively with GMP.
runtime=$dev_prefix/runtime/libidris_rt.a
build_test() {
  if link_program -O1 -I"$root/runtime" "$1" "$runtime" -o "$2" > "$work/cc.log" 2>&1; then
    say "${2##*/}: built"
  else
    say "${2##*/}: does not build"
    show "$work/cc.log"
    return 1
  fi
}
build_test "$here/api.c" "$work/api" || exit 0
build_test "$here/rc.c" "$work/rc" || exit 0
bounded "$work/api" > "$work/ours" 2> "$work/api.err"
say "api: exit $?"
cat "$work/api.err"

# 256 KiB of stack: freeing the list of 10^7 cells by recursion would need
# hundreds of megabytes.
( ulimit -s 256 && IDRIS_RT_LIVE=1 && export IDRIS_RT_LIVE && bounded "$work/rc" ) \
  > "$work/rc.out" 2> "$work/rc.err"
say "rc: exit $?"
cat "$work/rc.out" "$work/rc.err"

# rc_mode MODE [SETTING]: rc MODE with IDRIS_RT_LIVE=SETTING, or with the
# variable unset; its exit status, then every line of its stdout and stderr.
rc_mode() {
  if [ $# -gt 1 ]; then
    ( IDRIS_RT_LIVE=$2 && export IDRIS_RT_LIVE && bounded "$work/rc" "$1" ) \
      > "$work/mode.out" 2> "$work/mode.err"
    say "rc $1, IDRIS_RT_LIVE=$2: exit $?"
  else
    ( unset IDRIS_RT_LIVE && bounded "$work/rc" "$1" ) > "$work/mode.out" 2> "$work/mode.err"
    say "rc $1, IDRIS_RT_LIVE unset: exit $?"
  fi
  sed 's/^/  stdout | /' "$work/mode.out"
  sed 's/^/  stderr | /' "$work/mode.err"
}
rc_mode leak 1
rc_mode leak
rc_mode leak yes
rc_mode leak 11
rc_mode crash 1

if [ -z "$chez_scheme" ]; then say "chez: not found"; exit 0; fi
"$chez_scheme" --script "$here/chez.ss" > "$work/chez" 2> "$work/chez.err"
say "chez: exit $?"
chez_doubles "$work/chez" > "$work/chez.read"
if cmp -s "$work/ours" "$work/chez.read"; then
  say "$(wc -l < "$work/ours" | tr -d ' ') operations: the same results as Chez, its Doubles read as ours"
else
  say "results differ (< runtime, > Chez, its Doubles read as ours):"
  diff "$work/ours" "$work/chez.read" | head -n 20 | sed 's/^/  | /'
fi
