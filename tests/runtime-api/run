# Reference counting frees what it counts: a structure of any depth on a
# small stack, a wide cell's slots after the word that counts them, and
# never an odd word an object slot holds; each kind of counted word's
# entry leaves alone the words its kind admits besides a cell; a copy of a
# memref's view counts each object it copies before it releases what it
# overwrites; a string operation's result is never its operand (rc.c).
# Each runs as a program on the checked runtime: one that returns with a
# cell still held ends as its internal error, and a crash counts no cell.
# Every entry point that takes a handle gives, on each kind of handle
# (null, the standard streams, a file open and closed, a directory), its
# result and the errno it leaves (handles.c).
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
# build_test SOURCE OUTPUT: SOURCE linked as a program with the checked
# runtime and the count of the cells it holds (harness/prop/held.cpp).
build_test() {
  if runtime_c link_program -O1 -I"$root/harness/prop" "$1" "$root/harness/prop/held.cpp" \
      "$checked_runtime" -o "$2" > "$work/cc.log" 2>&1; then
    say "${2##*/}: built"
  else
    say "${2##*/}: does not build"
    show "$work/cc.log"
    return 1
  fi
}
build_test "$here/rc.c" "$work/rc" || exit 0

# rc_mode [MODE]: rc in MODE; its exit status, then every line of its
# stdout and stderr.
rc_mode() {
  bounded "$work/rc" "$@" > "$work/mode.out" 2> "$work/mode.err"
  say "rc${1:+ $1}: exit $?"
  cat "$work/mode.out"
  sed 's/^/  stderr | /' "$work/mode.err"
}
rc_mode
rc_mode leak
rc_mode crash

build_test "$here/handles.c" "$work/handles" || exit 0
# handles writes to standard output and error through the runtime, in one
# order, so both go to one file; its standard input is a file of its own.
bounded "$work/handles" > "$work/handles.out" 2>&1
say "handles: exit $?"
cat "$work/handles.out"
