#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/61-sqrt-negative-fold, carried: the toolchain's mlir-opt folds
# the math.sqrt of a negative constant (canonicalize), whose value is a
# NaN, as the patch makes it do.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
input=$root/upstream/61-sqrt-negative-fold/sqrt-negative.mlir
if ! bounded "$llvm_bin/mlir-opt" "$input" --canonicalize -o "$work/out.mlir" 2> "$work/err"; then
  say "mlir-opt failed, which is not this bug"
  show "$work/err"
elif grep -q 'math\.sqrt' "$work/out.mlir"; then
  say "still reproduces (the square root of -2.5 stays a math.sqrt)"
  show "$work/out.mlir"
elif grep -q 'arith\.constant 0x7FF8000000000000 : f64' "$work/out.mlir"; then
  say "folded: the square root of -2.5 is a quiet NaN"
else
  say "folded, but not to a quiet NaN"
  show "$work/out.mlir"
fi
