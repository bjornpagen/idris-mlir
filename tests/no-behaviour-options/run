#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# No option selects how a program is compiled: the compiler has one
# pipeline, and an experiment compares two binaries. So idris-mlir's
# command line is its input, its outputs, its resources and its queries
# alone, the flags `kept` names; no pass of the dialect declares an option
# but the test check `checks` names, idr-expect's `holds`, which chooses
# what a test checks, not how anything compiles; and idris-mlir registers no debug counter, which
# skips what a pass would do. idris-mlir-opt keeps upstream's counter, where
# experiments live. The contracts (idr-contracts) and a stage's properties
# (idr-expect-at) check each pass and change nothing; the action tags
# (idr-action-tags) are a query; the report (report) and the module the
# frontend emitted (emitted) are outputs. The generator of the Idris side
# (idris-mlir-tblgen) is a build tool, not the compiler, and is not
# searched.
#
# The rule is `behaviour_options ROOT`, run on the repository and on the
# planted trees (Planted.idr): witness/ declares a flag that selects
# how a program compiles, in the driver and in a tool, on one line and
# across lines, a pass option, and a debug counter; near-miss/ holds what
# is allowed: the kept flags, a positional input, idr-expect's holds, the
# generator's own flags, idris-mlir-opt's counter, and the counter in a
# comment.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
kept='o c p package-path prefix no-prelude emitted log-actions-tags runtime
print-runtime prepare-runtime print-target-triple print-link-flags print-cpu-flags num-threads
time-trace time-trace-granularity report idr-contracts idr-expect-at idr-action-tags'
checks='ListOption<"holds", "holds"'

# behaviour_options ROOT: the findings in the tree at ROOT, `path:line: what`.
behaviour_options() (
  cd "$1" || exit 1
  # The flag of every cl::opt and cl::list the compiler's sources declare:
  # the first string literal of each declaration but a positional one's,
  # at the line the declaration starts.
  {
    [ -d foreign/idr/lib ] && find foreign/idr/lib -name '*.cpp'
    for tool in idris-mlir idris-mlir-opt idris-mlir-reduce; do
      [ -f "foreign/idr/tools/$tool.cpp" ] && printf '%s\n' "foreign/idr/tools/$tool.cpp"
    done
  } | LC_ALL=C sort | while IFS= read -r source; do
    awk -v file="$source" -v kept=" $(printf '%s' "$kept" | tr '\n' ' ') " 'BEGIN { RS = ";"; line = 1 }
      {
        if ($0 ~ /cl::(opt|list)</ && $0 !~ /cl::Positional/ && $0 !~ /extern/) {
          at = match($0, /cl::(opt|list)</)
          before = substr($0, 1, at); n = gsub(/\n/, "", before)
          text = substr($0, at)
          sub(/^cl::(opt|list)<[^(]*\(/, "", text)
          if (match(text, /"[^"]*"/)) {
            flag = substr(text, RSTART + 1, RLENGTH - 2)
            if (index(kept, " " flag " ") == 0)
              print file ":" line + n ": the flag " flag ", which is not an input, an output, a resource or a query"
          }
        }
        line += gsub(/\n/, "")
      }' "$source"
  done
  # Every pass option the dialect's ODS declares but the test checks.
  [ -d foreign/idr/include ] && find foreign/idr/include -name '*.td' | LC_ALL=C sort | while IFS= read -r td; do
    grep -nE '(List)?Option<"' "$td" | grep -vF -- "$checks" | sed "s|^\([0-9]*\):.*|$td:\1: a pass option|"
  done
  # The counter's registration, in what idris-mlir links, in code.
  {
    [ -d foreign/idr/lib ] && find foreign/idr/lib -name '*.cpp'
    [ -f foreign/idr/tools/idris-mlir.cpp ] && printf '%s\n' foreign/idr/tools/idris-mlir.cpp
  } | LC_ALL=C sort | while IFS= read -r source; do
    cpp_lex "$source" | grep -E '^[^:]*:[0-9]+:.*DebugCounter[[:space:]]*::[[:space:]]*registerCLOptions' |
      sed 's/^\([^:]*:[0-9]*\):.*/\1: registers a debug counter/'
  done
)

(cd "$root" && grep -rqF -- "$checks" foreign/idr/include) ||
  say "pass options: the test check $checks not found"
behaviour_options "$root" > "$work/found"
report() {
  if grep -q "$1" "$work/found"; then
    say "$3:"
    grep "$1" "$work/found" | sed 's/^/  /'
  else
    say "$2"
  fi
}
report ': the flag ' "flags: every one an input, an output, a resource or a query" \
  "flags that are not an input, an output, a resource or a query"
report ': a pass option$' "pass options: the test check alone, idr-expect's holds" \
  "pass options beside the test checks"
report ': registers a debug counter$' "idris-mlir registers no debug counter" \
  "idris-mlir registers a debug counter"
planted behaviour_options
