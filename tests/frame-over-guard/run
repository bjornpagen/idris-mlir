#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# No frame of compiled code is larger than the guard below the native
# stack: the compiler knows every frame's size, so it proves that when the
# program is built and takes no probe at run time. A module whose one
# function keeps 64 MiB in its frame (huge.mlir, upstream's llvm dialect,
# given the build's target) is no program the compiler may build: the
# build fails as the compiler's own error, which names the function, and
# writes no object.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
if ! bounded "$idris_mlir_opt" "$here/huge.mlir" --idr-target -o "$work/huge.mlir" 2> "$work/err"; then
  say "target: fails"
  show "$work/err"
  exit 0
fi
bounded "$idris_mlir" -c "$work/huge.mlir" -o "$work/huge.o" > "$work/out" 2> "$work/err"
status=$?
if [ "$status" -eq 0 ]; then
  say "build: succeeds, with a frame larger than the guard"
elif grep -q 'huge' "$work/err"; then
  say "build: fails, naming the function whose frame is larger than the guard"
else
  say "build: fails (exit $status), naming no function"
  show "$work/err"
fi
if [ -e "$work/huge.o" ]; then say "object: written"; else say "object: none"; fi
