#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Every property idr-expect knows has a dialect fixture in which it
# fails: a property no module makes fail holds of every module, and a
# test that states it checks nothing. A failing fixture expects the
# property's fixed words, `{{expected <name>: `, in a diagnostic it
# expects, so the names are read from the rows of the one table of them
# and each is looked for in the expectations of the fixtures, never in
# their prose. The rule is `expect_coverage ROOT`, run on the repository
# and on the planted trees (lib/planted.sh): witness/ holds a table of a
# property no fixture makes fail, one a fixture names only in its prose
# and in a RUN line that states it, and one whose name only begins
# another's that fails; near-miss/ holds a table whose every property has
# its failing fixture, and the exemption.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
# Two properties check the compiler against its own oracle, which only a
# defective compiler makes them disagree with, so no module makes either
# fail, and they are the exemptions: folds-balanced reads the folders' own
# count of the cells they left live; labels-least compares the label
# solve's answer with the least sets derived the plain way.
exempt='folds-balanced labels-least'
table=foreign/idr/lib/Transforms/Expect/Lookup.cpp

# expect_coverage ROOT: each property of ROOT's table with no fixture of
# ROOT where it fails, `path:line: what`, and each fixture that names it
# otherwise, `path: what`.
expect_coverage() (
  cd "$1" || exit 1
  [ -f "$table" ] || exit 0
  sed -n 's/^ *property<[^>]*>("\([^"]*\)".*/\1/p; =' "$table" |
    awk '/^[0-9]+$/ { if (held != "") print $0 "\t" held; held = ""; next } { held = $0 }' |
    while IFS='	' read -r n name; do
      case " $exempt " in *" $name "*) continue ;; esac
      cat tests/*/*.mlir 2> /dev/null | grep -qF "{{expected $name: " && continue
      printf '%s:%s: %s has no fixture where it fails\n' "$table" "$n" "$name"
      for fixture in tests/*/*.mlir; do
        [ -f "$fixture" ] && grep -qF -- "$name" "$fixture" &&
          printf '%s: names %s, but expects no failure of it\n' "$fixture" "$name"
      done
    done
)

if grep -q '^ *property<' "$root/$table"; then say "properties: found"; else say "properties: none found"; fi
for name in $exempt; do
  grep -qE "^ *property<[^>]*>\(\"$name\"" "$root/$table" || say "exempt and unknown: $name"
done
expect_coverage "$root" > "$work/unfailed"
if [ -s "$work/unfailed" ]; then
  say "no fixture where it fails:"
  sed 's/^/  /' "$work/unfailed"
else
  say "every property has a fixture where it fails, folds-balanced and labels-least aside"
fi
planted expect_coverage
