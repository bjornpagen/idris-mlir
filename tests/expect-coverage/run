#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Every property idr-expect knows is shown able to fail and is stated:
#   - a dialect fixture makes it fail, since a property no module makes
#     fail holds of every module, and a test that states it checks
#     nothing; a failing fixture expects the property's fixed words,
#     `{{expected <name>: `, in a diagnostic it expects, never in its
#     prose. A self-check is the exception: it holds an answer of the
#     compiler to a second derivation of it, which only a defect makes
#     disagree;
#   - a test states it of what the compiler made, since a property no test
#     states holds the compiler to nothing: an mlir.expect line; a
#     fixture's RUN line that runs the compiler's pipeline and asks
#     idr-expect after it, expecting what it asks to hold; or a request of
#     idr-expect the harness makes itself, a line of its Idris that is no
#     comment. A RUN line that asks of the module as written, which no
#     pass made, or that expects what it asks to fail states nothing, and
#     a property stated by no test names each fixture that asks it so. A
#     universal property is stated by the contracts, of every compilation.
# The names and roles are the rows of the one table of them
# (ExpectProperties.inc), printed from its records. The rule is
# `expect_coverage ROOT`, run on the repository and on the planted trees
# (Planted.idr): witness/ holds a table of a property no fixture makes
# fail, one a fixture names only in its prose and in a RUN line that asks
# it of the module as written, one whose name only begins another's that
# fails, one no test states, one a fixture asks only of the module as
# written, and one a fixture asks only of the pipeline's module expecting
# it to fail; near-miss/ holds a table whose every property has its
# failing fixture and its statement (an mlir.expect line, a RUN line after
# the pipeline, the harness's own request), a self-check with no failing
# fixture, and a universal property no test states.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
table=foreign/idr/include/idr/Transforms/ExpectProperties.inc

# rows TABLE: each row of TABLE, `line<TAB>role<TAB>name`, the role the
# macro's last word: PROPERTY, SELF_CHECK or UNIVERSAL.
rows() {
  awk '/^IDR_EXPECT_[A-Z_]+\("/ {
         role = $0; sub(/\(.*/, "", role); sub(/^IDR_EXPECT_/, "", role)
         name = $0; sub(/^[^"]*"/, "", name); sub(/".*/, "", name)
         print NR "\t" role "\t" name }' "$1"
}

# asks NAME: a line of standard input names the property NAME as a request
# does, whole, between the separators of a request's list.
asks() {
  grep -qE "(^|[ :,=])$1(=|,|[ \"']|\$)"
}

# compiled FIXTURE...: the RUN lines of FIXTURE that ask idr-expect of what
# the compiler made: the compiler's pipeline runs first, and the run
# expects what it asks to hold, so it is not negated.
compiled() {
  grep -h '^// RUN:.*idr-pipeline.*idr-expect' "$@" 2> /dev/null |
    grep -vE '^// RUN:[[:space:]]+not[[:space:]]'
}

# stated NAME: a test states NAME of what the compiler made, in the tree
# at the current directory: a property of an mlir.expect line, of a
# fixture's RUN line after the pipeline, or of a request of idr-expect the
# harness's Idris makes, a line no comment holds.
stated() {
  { grep -hv '^#' tests/*/mlir.expect 2> /dev/null
    compiled tests/*/*.mlir
    grep -hvE '^[[:space:]]*(--|[|]{3})' harness/*.idr 2> /dev/null | grep 'idr-expect'; } |
    asks "$1"
}

# expect_coverage ROOT: each property of ROOT's table with no fixture of
# ROOT where it fails, `path:line: what`, and each fixture that names it
# otherwise, `path: what`; and each no test of ROOT states, and each
# fixture that asks it of no module the compiler made.
expect_coverage() (
  cd "$1" || exit 1
  [ -f "$table" ] || exit 0
  rows "$table" | while IFS='	' read -r n role name; do
    if [ "$role" != SELF_CHECK ] &&
       ! cat tests/*/*.mlir 2> /dev/null | grep -qF "{{expected $name: "; then
      printf '%s:%s: %s has no fixture where it fails\n' "$table" "$n" "$name"
      for fixture in tests/*/*.mlir; do
        [ -f "$fixture" ] && grep -qF -- "$name" "$fixture" &&
          printf '%s: names %s, but expects no failure of it\n' "$fixture" "$name"
      done
    fi
    if [ "$role" != UNIVERSAL ] && ! stated "$name"; then
      printf '%s:%s: %s is stated by no test\n' "$table" "$n" "$name"
      for fixture in tests/*/*.mlir; do
        [ -f "$fixture" ] && grep '^// RUN:.*idr-expect' "$fixture" | asks "$name" &&
          printf '%s: asks %s, but states it of no module the compiler made\n' "$fixture" "$name"
      done
    fi
  done
)

if [ -n "$(rows "$root/$table")" ]; then say "properties: found"; else say "properties: none found"; fi
expect_coverage "$root" > "$work/unfailed"
if [ -s "$work/unfailed" ]; then
  say "not covered:"
  sed 's/^/  /' "$work/unfailed"
else
  say "every property fails on a fixture, self-checks aside, and is stated by a test"
fi
planted expect_coverage
