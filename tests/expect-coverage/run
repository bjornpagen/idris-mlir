#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Every property idr-expect knows is shown able to fail and is stated:
#   - a dialect fixture makes it fail, since a property no module makes
#     fail holds of every module, and a test that states it checks
#     nothing; a failing fixture expects the property's fixed words,
#     `{{expected <name>: `, in a diagnostic it expects, never in its
#     prose. A self-check is the exception: it holds an answer of the
#     compiler to a second derivation of it, which only a defect makes
#     disagree;
#   - a test states it of what the compiler made (an mlir.expect line, or
#     a harness check that asks idr-expect), since a property no test
#     states holds the compiler to nothing. A universal property is
#     stated by the contracts, of every compilation.
# The names and roles are the rows of the one table of them
# (ExpectProperties.inc), printed from its records. The rule is
# `expect_coverage ROOT`, run on the repository and on the planted trees
# (Planted.idr): witness/ holds
# a table of a property no fixture makes fail, one a fixture names only in
# its prose and in a RUN line that states it, one whose name only begins
# another's that fails, and one no test states; near-miss/ holds a table
# whose every property has its failing fixture and its statement, a
# self-check with no failing fixture, and a universal property no test
# states.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
table=foreign/idr/include/idr/Transforms/ExpectProperties.inc

# rows TABLE: each row of TABLE, `line<TAB>role<TAB>name`, the role the
# macro's last word: PROPERTY, SELF_CHECK or UNIVERSAL.
rows() {
  awk '/^IDR_EXPECT_[A-Z_]+\("/ {
         role = $0; sub(/\(.*/, "", role); sub(/^IDR_EXPECT_/, "", role)
         name = $0; sub(/^[^"]*"/, "", name); sub(/".*/, "", name)
         print NR "\t" role "\t" name }' "$1"
}

# stated NAME: a test states NAME, in the tree at the current directory:
# a property of an mlir.expect line, or of a harness check's request of
# idr-expect.
stated() {
  { grep -hv '^#' tests/*/mlir.expect 2> /dev/null
    grep -h 'idr-expect' harness/lib/*.sh 2> /dev/null; } |
    grep -qE "(^|[ :,=])$1(=|,|[ \"']|\$)"
}

# expect_coverage ROOT: each property of ROOT's table with no fixture of
# ROOT where it fails, `path:line: what`, and each fixture that names it
# otherwise, `path: what`; and each no test of ROOT states.
expect_coverage() (
  cd "$1" || exit 1
  [ -f "$table" ] || exit 0
  rows "$table" | while IFS='	' read -r n role name; do
    if [ "$role" != SELF_CHECK ] &&
       ! cat tests/*/*.mlir 2> /dev/null | grep -qF "{{expected $name: "; then
      printf '%s:%s: %s has no fixture where it fails\n' "$table" "$n" "$name"
      for fixture in tests/*/*.mlir; do
        [ -f "$fixture" ] && grep -qF -- "$name" "$fixture" &&
          printf '%s: names %s, but expects no failure of it\n' "$fixture" "$name"
      done
    fi
    if [ "$role" != UNIVERSAL ] && ! stated "$name"; then
      printf '%s:%s: %s is stated by no test\n' "$table" "$n" "$name"
    fi
  done
)

if [ -n "$(rows "$root/$table")" ]; then say "properties: found"; else say "properties: none found"; fi
expect_coverage "$root" > "$work/unfailed"
if [ -s "$work/unfailed" ]; then
  say "not covered:"
  sed 's/^/  /' "$work/unfailed"
else
  say "every property fails on a fixture, self-checks aside, and is stated by a test"
fi
planted expect_coverage
