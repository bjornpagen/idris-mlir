# tests/linarray-lanes-wide's module through the pipeline under one thread
# and under the pool, byte for byte, its remarks included: its loops are
# vectorized and given 32-bit versions by a pass over each function on the
# pool's threads, which says something of every loop it meets.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
determinism_threads "$root/tests/linarray-lanes-wide"
# The remarks compared are not empty: the lanes' versioning says what it
# chose of each loop.
if [ -s "$work/one.remarks" ]; then
  say "remarks: some"
else
  say "remarks: none, so nothing of them was compared"
fi
