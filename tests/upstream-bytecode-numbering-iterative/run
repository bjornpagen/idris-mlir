#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/97-bytecode-numbering-iterative: the bytecode writer numbers an
# attribute's and a type's nested components from an explicit stack, so
# its native depth does not grow with their nesting. The reproducer's
# array, nested 100,000 deep, written as bytecode by mlir-opt on one
# thread under a 256 KiB stack, and read back: what it prints is what the
# text alone prints, so the bytecode holds the array whole.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
# on_small_stack ARG...: mlir-opt with ARG..., on one thread under the
# tools' small stack; its stderr in $work/err.
on_small_stack() {
  ( ulimit -s 256 && bounded "$llvm_bin/mlir-opt" -mlir-disable-threading "$@" ) 2> "$work/err"
}
sh "$root/upstream/97-bytecode-numbering-iterative/nested.sh" 100000 > "$work/nested.mlir"
if ! on_small_stack "$work/nested.mlir" --emit-bytecode -o "$work/nested.mlirbc"; then
  say "bytecode: writing 100,000 levels fails on a 256 KiB stack"
  show "$work/err"
elif ! on_small_stack "$work/nested.mlirbc" -o "$work/from-bytecode.mlir" ||
     ! on_small_stack "$work/nested.mlir" -o "$work/from-text.mlir"; then
  say "bytecode: written, and reading it or the text back fails on a 256 KiB stack"
  show "$work/err"
elif cmp -s "$work/from-bytecode.mlir" "$work/from-text.mlir"; then
  say "bytecode: 100,000 levels written on a 256 KiB stack, read back as the text reads"
else
  say "bytecode: 100,000 levels written, and read back otherwise than the text reads"
fi
