#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The generators on both hosts: the stock Idris builds Gen, Prims, Fuzz,
# Sem and TwoLevels as the test runner, and idris-mlir compiles them into a
# program that prints Fuzz.twoHosts, which must be the committed
# expected-stdout byte for byte: the generators' checks, each ok, then the
# text each seeded request it names means, reviewed section by section as
# any expected output is; a change to the five modules that changes the
# text rewrites the file in the same change. A draw and a tape's reset take
# apart only exclusive cells, count nothing, and build each cell in the one
# they took (mlir.expect).
# Debt: the limits are not measured; one compilation of five modules and
# their run, sized on the owner's build.
step_limit=600
test_limit=900
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
mkdir "$work/two-hosts"
cp Main.idr expected-stdout mlir.expect packages "$work/two-hosts/"
for two_hosts_module in Gen Prims Fuzz Sem TwoLevels; do
  cp "$root/tests/$two_hosts_module.idr" "$work/two-hosts/"
done
e2e_io "$work/two-hosts"
