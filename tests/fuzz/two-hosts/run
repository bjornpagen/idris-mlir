#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The generators on both hosts: the stock Idris (the runner, on Chez)
# prints Fuzz.twoHosts, Gen's checks and what Gen, Prims, Fuzz, Sem and
# TwoLevels make of a few requests, which becomes this fixture's
# expected-stdout; idris-mlir compiles the five modules into a program that
# must print that text byte for byte. A draw and a tape's reset take apart
# only exclusive cells, count nothing, and build each cell in the one they
# took (mlir.expect).
# Debt: the limits are not measured; one compilation of five modules and
# their run, sized on the owner's build.
step_limit=600
test_limit=900
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
mkdir "$work/two-hosts"
cp Main.idr mlir.expect packages "$work/two-hosts/"
for two_hosts_module in Gen Prims Fuzz Sem TwoLevels; do
  cp "$root/tests/$two_hosts_module.idr" "$work/two-hosts/"
done
if ! "$runtests" --fuzz-program two-hosts > "$work/two-hosts/expected-stdout" 2> "$work/two-hosts.err"; then
  say "stock host: no text"
  show "$work/two-hosts.err"
  exit 0
fi
if grep -q '^gen: .*: failed$' "$work/two-hosts/expected-stdout"; then
  say "stock host: Gen's checks: failed"
  grep '^gen: .*: failed$' "$work/two-hosts/expected-stdout" | sed 's/^/  | /'
else
  say "stock host: Gen's checks: ok"
fi
e2e_io "$work/two-hosts"
