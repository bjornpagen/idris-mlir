#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The runtime's string operations held to a model of scalars: every result
# the model's, canonical, and a string of its own, never an operand given
# back; every operand borrowed, on persistent and counted operands
# (strings.cpp states each property). Each run draws from a fresh seed,
# which a failure names; then each check runs with its own planted fault
# (bytes taken for scalars, an end of the string missed, an operand given
# back, a reference or the one empty string lost) and must catch it. One line per property; the classes each reached go to the
# report.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
. "$root/harness/prop/prop.sh"
prop_build "$here/strings.cpp" "$work/strings" || exit 0
# The case count is debt: 1000 cases took 0.5 s on an arm64 Mac (host
# clang, -O1); set it on the owner's build so the program ends well within
# step_limit on both targets.
prop_run "$work/strings" --cases 1000
