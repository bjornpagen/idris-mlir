#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Facts live in types and in an op's inherent properties, never in a
# discardable attribute, which a pass can drop without a word: so the
# dialect's ODS declares no discardable attribute. The one discardable
# attribute is the frontend's report on a refused program, `idr.refusals`:
# it sits on a module with no program, on which no pass runs, and the
# driver alone reads it. The rule is `discardable ROOT`, run on the
# repository and on the planted trees (lib/planted.sh): witness/ declares
# one discardable attribute, beside the report and alone, and near-miss/
# holds what is allowed: the empty list, the report itself, and the word in
# a comment and in an inherent attribute's name.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# discardable ROOT: each discardable attribute the ODS under ROOT declares
# but the refusals report, `path:line: text`. A comment is no declaration.
discardable() (
  cd "$1" || exit 1
  find foreign/idr/include -name '*.td' 2> /dev/null | LC_ALL=C sort | while IFS= read -r td; do
    grep -HnE '(^|[^A-Za-z0-9_])discardableAttrs([^A-Za-z0-9_]|$)' "$td"
  done | grep -vE '^[^:]*:[0-9]+:[[:space:]]*//' |
    grep -vE ':[0-9]+:[[:space:]]*let[[:space:]]+discardableAttrs[[:space:]]*=[[:space:]]*\(ins\)[[:space:]]*;' |
    grep -vE ':[0-9]+:[[:space:]]*let[[:space:]]+discardableAttrs[[:space:]]*=[[:space:]]*\(ins[[:space:]]+"::mlir::ArrayAttr":\$refusals\);'
)

(cd "$root" && find foreign/idr/include -name '*.td' | grep -q .) || say "ODS: no file found"
discardable "$root" > "$work/discardable"
if [ -s "$work/discardable" ]; then
  say "discardable attributes declared:"
  show "$work/discardable"
else
  say "discardable attributes: none declared but a refused module's report"
fi
planted discardable
