#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Every file in scope names its licence, and every licence text an
# identifier in use names is in LICENSES/. tools/licenses.sh is the one
# place that knows the scope, the parts and the holders, and checks all of
# it; what it prints when all holds is the identifiers in use, so a
# licence the tree gains shows here.
#
# The check is run on the repository and, through `licenses_tree ROOT`, on
# the planted trees (Planted.idr): each made a repository of its own,
# with the check and the licence texts. A checker file's holder is read
# from its own copyright line, so no tree needs the Idris pin.
# witness/ breaks the rule once per way (no line, a wrong holder, our
# licence in the checker, a checker file with no copyright line and one
# whose line names only years, an identifier with no text, a file of no
# known kind); near-miss/ holds what is allowed: our files and a script's,
# the checker's with our holder and with Idris's, and the kinds it
# excludes.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# licenses_tree ROOT: tools/licenses.sh's findings on the files of ROOT,
# made a repository beside the repository's check and licence texts,
# `path: what`.
licenses_tree() (
  tree=$(mktemp -d "$work/tree.XXXXXX") || exit 1
  cp -Rp "$1"/. "$tree"/
  mkdir -p "$tree/tools" "$tree/LICENSES"
  cp -p "$root/tools/licenses.sh" "$tree/tools/"
  cp -p "$root"/LICENSES/*.txt "$tree/LICENSES/"
  cd "$tree" || exit 1
  git init -q && git add -A || exit 1
  sh tools/licenses.sh | grep -v '^licenses: \|^texts: '
)

"$root/tools/licenses.sh" > "$work/licenses" 2>&1 ||
  say "licenses: not every file in scope names its licence:"
cat "$work/licenses"
planted licenses_tree
