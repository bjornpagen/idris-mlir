#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/28-liveness-non-forwarded-terminator is retired: nothing in the
# tree runs remove-dead-values, so the patch is not carried and the report
# stays a submission. The pinned tools still show the bug: liveness never
# revisits a terminator whose operands are all non-forwarded, so
# remove-dead-values replaces the element a tabulation's region yields by
# poison when the array is read only through a call. Upstream's dialects
# have no such terminator; ours has, through idris-mlir-opt. When the pin
# has upstream's fix this check fails, and the report goes with it.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
input=$root/upstream/28-liveness-non-forwarded-terminator/tabulate-across-call.mlir
if ! bounded "$idris_mlir_opt" "$input" --remove-dead-values -o "$work/out.mlir" 2> "$work/err"; then
  say "idris-mlir-opt failed, which is not this bug"
  show "$work/err"
elif grep -q 'ub.poison' "$work/out.mlir"; then
  say "still reproduces at the pin: the element is replaced by poison"
else
  say "fixed at the pin: the element is kept"
fi
