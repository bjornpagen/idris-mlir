# The fuzzer (harness/Fuzz.idr) on each seed of its regression corpus:
# closed expressions over every primitive, each written four ways, compiled
# once per part at the seed's thread count; each case's lines must print
# one value, the folders must have computed every d line, and a case over
# the integers must print the value their documented meaning gives. Each
# line names its seed.
# Two compilations of generated programs per seed, and a shrink's when a
# case fails, given half an hour.
test_limit=1800
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
for seed in 1 2; do
  fuzz "$seed" | sed "s/^/seed $seed: /"
done
