#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/106-size-change-call-paths, carried: the stock Idris's
# size-change closure appended both call paths of every graph it composed,
# kept only to report a loop, so a mutual block's totality check took time
# and memory exponential in its size although its graphs are few. With the
# patch the path is built only when a loop is reported: Paths.idr, a hub
# and twenty-two spokes, checks total well within a limit the stock Idris
# passes. The limit is short, since the stock Idris's memory grows with it.
step_limit=20
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
cp "$root/upstream/106-size-change-call-paths/Paths.idr" "$work/Paths.idr"
(cd "$work" && pinned_idris --check Paths.idr) > "$work/out" 2>&1
case $? in
  0) say "lazy: the mutual block checks total within the step limit" ;;
  124) say "still reproduces: the mutual block does not check within the step limit" ;;
  *) say "the stock Idris fails on the reproducer, which is not this bug"
     show "$work/out" ;;
esac
