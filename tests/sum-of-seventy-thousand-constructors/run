# A sum of 70,000 constructors (Main.idr), each of its cases a line whose
# characters pick constructors either side of the 16-bit tag's end: the
# first, the last before 65,536 (with an Int), the first after it (with a
# String), the last, and one between; an empty line picks none. Compiling
# 70,000 constructors takes longer than a program of its size would, so
# each command and the test have more time than most.
step_limit=600
test_limit=900
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
mkdir "$work/fixture"
cp -R cases "$work/fixture/"
awk '/^-- CONSTRUCTORS$/ {
       for (i = 0; i < 70000; i++)
         printf "  C%d : %sMany\n", i, (i == 65535 ? "Int -> " : (i == 65536 ? "String -> " : ""))
       next }
     { print }' Main.idr > "$work/fixture/Main.idr"
e2e_io "$work/fixture"
