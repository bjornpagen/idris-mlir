#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The compiler names Idris definitions only in its registry: outside
# compiler/src/IdrisMLIR/Registry.idr
# and compiler/src/IdrisMLIR/Registry/, no string literal in compiler/src or in
# the dialect's sources under foreign/idr is a qualified Idris name or a
# namespace the registry classifies, and no Idris name is built from a
# literal. The dialect's specification, compiler/spec, spells no name of
# base's: no literal of it is a name in a namespace the registry
# classifies, and none builds a name. A file's name the specification
# writes ("Control.h") is no name; a namespace's word alone is not looked
# for there, since the specification spells MLIR's builtin dialect, a
# family's kind and its headers' directories with words base uses too.
# `allowlist` lists the lines allowed anyway, one per line as `path: text
# -- reason`: a doc comment of the specification's.
#
# The rule is `registry_only ROOT`, its list ROOT/tests/registry-only/
# allowlist, run on the repository and on the planted trees
# (Planted.idr): witness/ names a definition by a qualified literal, a
# namespace alone and a name built from a literal, in the Idris, in the
# specification and in the dialect's C++ and ODS, and its list has an entry
# without its reason; near-miss/ holds what is allowed: the registry's own
# names, the dialect samples' and the googletest boxes', an include,
# literals that are no qualified name, the files and the module of its own
# the specification spells, and a listed line.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# A qualified name: a capitalized namespace, a dot and the rest, with no
# space ("Prelude.IO.prim__putStr", or the prefix "Builtin.").
qualified="\"[A-Z][A-Za-z0-9_']*\\.[^\" ]*\""
# The namespaces the registry classifies, and one of them alone
# ("Prelude").
classified='Builtin|PrimIO|Prelude|Data|Control|Decidable|Syntax|Main'
namespaces="\"($classified)\""
# A name in one of them ("Prelude.IO.putStr").
based="\"($classified)\\.[^\" ]*\""
# A file's name, by the extension of a file the specification writes.
files='"[^" ]*\.(h|td|inc|cpp|idr|txt)"'
# An Idris name built from a literal (`UN (Basic "main")`).
built='Basic "[^"]'

# registry_only ROOT: the findings in the tree at ROOT, `path:line: what`.
registry_only() (
  cd "$1" || exit 1
  list=tests/registry-only/allowlist
  # The compiler's sources, not its test programs: the dialect samples
  # (SyntaxSamples.idr, the program tests/dialect-syntax runs) and the
  # googletest boxes (foreign/idr/unittests) name what they test with,
  # which is data of the test and no name the compiler knows.
  {
    [ -d compiler/src ] && find compiler/src -name '*.idr' ! -path '*/build/*' \
      ! -path 'compiler/src/IdrisMLIR/Registry/*' ! -path 'compiler/src/IdrisMLIR/Registry.idr' \
      ! -path 'compiler/src/IdrisMLIR/SyntaxSamples.idr' | LC_ALL=C sort | while IFS= read -r f; do
        grep -nE "$qualified|$namespaces|$built" "$f" | sed "s|^|$f:|"
      done
    [ -d compiler/spec ] && find compiler/spec -name '*.idr' ! -path '*/build/*' | LC_ALL=C sort | while IFS= read -r f; do
        sed -E "s/$files/\"\"/g" "$f" | grep -nE "$based|$built" | sed "s|^|$f:|"
      done
    [ -d foreign/idr ] && find foreign/idr -type f \( -name '*.cpp' -o -name '*.h' -o -name '*.td' -o -name '*.inc' \) \
      ! -path 'foreign/idr/unittests/*' | LC_ALL=C sort | while IFS= read -r f; do
        grep -nE "$qualified" "$f" | grep -v '^[0-9]*:[[:space:]]*#[[:space:]]*include' | sed "s|^|$f:|"
      done
  } > "$work/found"
  # The list's entries, blank lines and comments aside; each needs a
  # path, a text and a reason.
  if [ -f "$list" ]; then
    awk '!/^[[:space:]]*#/ && !/^[[:space:]]*$/ { print FNR "\t" $0 }' "$list" > "$work/allowed"
  else
    : > "$work/allowed"
  fi
  : > "$work/entries"
  while IFS='	' read -r n entry; do
    case $entry in
      *': '*' -- '?*) printf '%s\t%s\n' "$n" "$entry" >> "$work/entries" ;;
      *) printf '%s:%s: an entry without a path, a text and a reason\n' "$list" "$n" ;;
    esac
  done < "$work/allowed"
  # A line found is allowed when an entry, with its reason, names its path
  # and a text it holds.
  while IFS= read -r hit; do
    keep=yes
    while IFS='	' read -r n entry; do
      path=${entry%%: *}
      rest=${entry#*: }
      text=${rest% -- *}
      case $hit in "$path:"*"$text"*) keep=no ;; esac
    done < "$work/entries"
    [ $keep = yes ] && printf '%s\n' "$hit" | sed 's/^\([^:]*:[0-9]*\):\(.*\)/\1: names an Idris definition outside the registry: \2/'
  done < "$work/found"
)

registry_only "$root" > "$work/left"
if [ -s "$work/left" ]; then
  say "names outside the registry:"
  sed 's/^/  /' "$work/left"
else
  say "names outside the registry: none, and every line of the allowlist names a path, a text and a reason"
fi
planted registry_only
