#!/bin/sh
# The pinned mlir-opt, with upstream/02-composite-fixed-point-sccp/llvm.patch,
# no longer shows the bug: composite-fixed-point-pass over sccp converges
# after one run on a module sccp leaves as it is, as it does over
# canonicalize, where llvmorg-23.1.2 warns at max-iterations. When the pin's
# sccp keeps the constants the IR holds, the patch goes, and with it the
# report and this test (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
input=$root/upstream/02-composite-fixed-point-sccp/one.mlir
# The module is at sccp's fixpoint: a second run prints what the first did.
bounded "$llvm_bin/mlir-opt" "$input" --sccp > "$work/once.mlir" 2> "$work/err" &&
  bounded "$llvm_bin/mlir-opt" "$work/once.mlir" --sccp > "$work/twice.mlir" 2>> "$work/err"
if ! cmp -s "$work/once.mlir" "$work/twice.mlir"; then
  say "sccp: changes the module, which is not this bug"
  show "$work/err"
  exit 0
fi
for pipeline in sccp canonicalize; do
  bounded "$llvm_bin/mlir-opt" "$input" \
    --composite-fixed-point-pass="pipeline=$pipeline max-iterations=3" \
    > "$work/out.mlir" 2> "$work/err"
  status=$?
  if [ "$status" -eq 0 ] && ! grep -q "didn't converge" "$work/err"; then
    say "$pipeline: converges after one run"
  else
    say "$pipeline: does not converge (exit $status)"
    show "$work/err"
  fi
done
