#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The upstream bug upstream/02-composite-fixed-point-sccp still reproduces
# with the pinned mlir-opt: composite-fixed-point-pass over sccp does not
# converge on a module sccp leaves as it is, since sccp remakes every
# constant it meets, while over canonicalize it converges after one run.
# This repository carries no patch for it (the README says why). When this
# fails, the bug is fixed: the report and this test go (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
input=$root/upstream/02-composite-fixed-point-sccp/one.mlir
# The module is at sccp's fixpoint: a second run prints what the first did.
bounded "$llvm_bin/mlir-opt" "$input" --sccp > "$work/once.mlir" 2> "$work/err" &&
  bounded "$llvm_bin/mlir-opt" "$work/once.mlir" --sccp > "$work/twice.mlir" 2>> "$work/err"
if ! cmp -s "$work/once.mlir" "$work/twice.mlir"; then
  say "sccp: changes the module, which is not this bug"
  show "$work/err"
  exit 0
fi
for pipeline in sccp canonicalize; do
  bounded "$llvm_bin/mlir-opt" "$input" \
    --composite-fixed-point-pass="pipeline=$pipeline max-iterations=3" \
    > "$work/out.mlir" 2> "$work/err"
  status=$?
  if [ "$status" -ne 0 ]; then
    say "$pipeline: mlir-opt failed (exit $status), which is not this bug"
    show "$work/err"
  elif grep -q "didn't converge" "$work/err"; then
    say "$pipeline: still reproduces (does not converge)"
  else
    say "$pipeline: converges after one run"
  fi
done
