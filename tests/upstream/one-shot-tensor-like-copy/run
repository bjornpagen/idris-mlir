#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The upstream bug upstream/27-one-shot-tensor-like-copy is still in the
# pinned source: One-Shot Bufferize gives an out-of-place OpOperand of a
# tensor-like type that is not a builtin tensor no copy, so the op writes a
# buffer that is read after it. Its reproducer needs the test dialect's
# tensor-like type, which the toolchain's mlir-opt does not build, so the
# check reads the pinned source of resolveTensorOpOperandConflicts. This
# repository carries no patch for it (the README says why). When this
# fails, the bug is fixed: the report and this test go (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
source=$toolchain/llvm-project/mlir/lib/Dialect/Bufferization/IR/BufferizableOpInterface.cpp
if [ ! -f "$source" ]; then
  say "tensor-like-copy: no pinned source to read ($source)"
elif awk '/resolveTensorOpOperandConflicts\(/ { inside = 1 }
          inside && /isa<TensorType>\(operandType\)/ { found = 1 }
          inside && /^}/ { inside = 0 }
          END { exit !found }' "$source"; then
  say "tensor-like-copy: still reproduces (an out-of-place OpOperand of a type that is no builtin tensor is skipped)"
else
  say "tensor-like-copy: no longer reproduces (every tensor-like OpOperand is copied)"
fi
