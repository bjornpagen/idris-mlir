#!/bin/sh
# The pinned mlir-opt, with upstream/remove-dead-values-unreachable/llvm.patch,
# no longer shows the bug: remove-dead-values gives ub.poison to the uses,
# in code dead-code analysis never reaches, of the dead arguments of a
# function, of a dead result and of a dead block argument, where
# llvmorg-23.1.2 leaves them a null operand. When the pin
# has upstream's fix (#208881), the patch goes, and with it the PINS.md
# entry remove-dead-values-unreachable, the report and this test
# (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
for input in unreachable uncalled dead-result dead-block-arg; do
  bounded "$llvm_bin/mlir-opt" "$root/upstream/remove-dead-values-unreachable/$input.mlir" \
    --remove-dead-values > "$work/out.mlir" 2> "$work/err"
  status=$?
  if [ "$status" -eq 0 ] && grep -q 'call @ext(%.*) : (i32) -> ()' "$work/out.mlir" &&
     grep -q 'ub.poison : i32' "$work/out.mlir"; then
    say "$input: fixed (the dead value's uses take poison)"
  else
    say "$input: still reproduces (exit $status)"
    sed 's/^/  | /' "$work/err" "$work/out.mlir"
  fi
done
