#!/bin/sh
# The pinned mlir-opt, with upstream/03-bytecode-deferred-quadratic/llvm.patch,
# no longer shows the bug: it reads an array attribute nested 4 times as
# deep from bytecode in about 4 times as long, where an unpatched mlir-opt
# (llvmorg-23.1.2, and main at 7208ba24) takes
# about 16 times. Each depth's time is the best of three reads, so that the
# load of other tests does not decide the ratio. When the pin's reader
# resolves deferred entries in linear time, the patch goes, and with it the
# report and this test (upstream/README.md). The text parser recurses per
# level, so the stack is as large as the system allows (stack_max).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
stack_max
milliseconds() {
  sh "$root/upstream/03-bytecode-deferred-quadratic/nested.sh" "$1" > "$work/n$1.mlir"
  bounded "$llvm_bin/mlir-opt" "$work/n$1.mlir" --emit-bytecode -o "$work/n$1.mlirbc" || return 1
  best=
  for run in 1 2 3; do
    start=$(now_ns) || return 1
    bounded "$llvm_bin/mlir-opt" "$work/n$1.mlirbc" --emit-bytecode -o /dev/null || return 1
    end=$(now_ns) || return 1
    took=$(( (end - start) / 1000000 ))
    if [ -z "$best" ] || [ "$took" -lt "$best" ]; then best=$took; fi
  done
  echo "$best"
}
small=$(milliseconds 8000) && large=$(milliseconds 32000) || { say "mlir-opt failed"; exit 0; }
# Linear reading takes about 4 times as long for 4 times the depth;
# quadratic, 16 times.
if [ "$large" -le $((small * 8)) ]; then
  say "deep: fixed (4 times the depth takes at most 8 times as long)"
else
  say "deep: still reproduces (${small} ms, then ${large} ms)"
fi
