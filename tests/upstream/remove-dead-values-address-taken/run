#!/bin/sh
# The pinned mlir-opt, with upstream/06-remove-dead-values-unreachable/llvm.patch,
# no longer shows this bug either: a direct call of a function remove-dead-
# values must leave alone, which never reads the value the call passes,
# keeps its operand as ub.poison, where llvmorg-23.1.2 leaves it null. When
# the pin has upstream's fix (#208881), the patch goes, and with it the
# PINS.md entry remove-dead-values-address-taken, the report and this test
# (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
bounded "$llvm_bin/mlir-opt" "$root/upstream/01-remove-dead-values-address-taken/address-taken.mlir" \
  --remove-dead-values > "$work/out.mlir" 2> "$work/err"
status=$?
if [ "$status" -eq 0 ] && grep -q 'ub.poison : i64' "$work/out.mlir" &&
   grep -q 'call @ignores(%.*) : (i64) -> i64' "$work/out.mlir"; then
  say "address-taken: fixed (the unread operand is poison)"
else
  say "address-taken: still reproduces (exit $status)"
  sed 's/^/  | /' "$work/err" "$work/out.mlir"
fi
