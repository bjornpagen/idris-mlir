#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The upstream bug upstream/22-remove-dead-values-poison-operand still
# reproduces with the pinned mlir-opt: remove-dead-values{canonicalize=false},
# on a module whose dead loop value is already poison, puts a new poison in
# its place, so composite-fixed-point-pass over it does not converge after
# one run. This repository carries no patch for it (the README says why).
# When this fails, the bug is fixed: the report and this test go
# (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
input=$root/upstream/22-remove-dead-values-poison-operand/poison-operand.mlir
bounded "$llvm_bin/mlir-opt" "$input" \
  --composite-fixed-point-pass="pipeline=remove-dead-values{canonicalize=false} max-iterations=1 on-convergence-failure=error" \
  > /dev/null 2> "$work/err"
status=$?
if [ "$status" -eq 0 ]; then
  say "no longer reproduces (keeps the poison operand)"
elif grep -q "didn't converge" "$work/err"; then
  say "still reproduces (replaces the poison operand)"
else
  say "mlir-opt failed (exit $status), which is not this bug"
  show "$work/err"
fi
