#!/bin/sh
# The pinned mlir-opt, with upstream/vectorize-precondition-body/llvm.patch,
# no longer shows the bug: the vectorizer's precondition refuses the
# reduction whose body holds a crash check, as it refuses the same body
# without the reduction dimension, so neither generic gets any vector code,
# where llvmorg-23.1.2 builds part of the reduction's before it refuses.
# When the pin's precondition checks a reduction's body, the patch goes,
# and with it the PINS.md entry vectorize-precondition-body, the report and
# this test (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
"$llvm_bin/mlir-opt" "$root/upstream/vectorize-precondition-body/body.mlir" --transform-interpreter \
  > "$work/out.mlir" 2> "$work/err"
status=$?
sed -n '/func.func @elementwise/,/^  }/p' "$work/out.mlir" > "$work/elementwise.mlir"
sed -n '/func.func @rows/,/^  }/p' "$work/out.mlir" > "$work/rows.mlir"
if [ "$status" -eq 0 ] && grep -q 'linalg.generic' "$work/elementwise.mlir" &&
   ! grep -q 'vector\.' "$work/elementwise.mlir" &&
   grep -q 'linalg.generic' "$work/rows.mlir" && ! grep -q 'vector\.' "$work/rows.mlir"; then
  say "body: fixed (the reduction is left whole, with no vector code)"
else
  say "body: still reproduces (exit $status)"
  sed 's/^/  | /' "$work/err" "$work/rows.mlir"
fi
