#!/bin/sh
# The pinned MLIR, with upstream/while-move-if-down-duplicates/llvm.patch,
# no longer shows the bug: canonicalize keeps what a loop computes when its
# scf.condition forwards one scf.if result twice, where llvmorg-23.1.2
# changes it. The program runs as it is and after canonicalize; its exit
# status is what it returns. When the pin has a65eb8723 (in 24.1.0), the
# patch goes, and with it the PINS.md entry while-move-if-down-duplicates,
# the report and this test (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
input=$root/upstream/while-move-if-down-duplicates/twice.mlir
# returns NAME FILE: builds FILE and prints the status it exits with.
returns() {
  bounded "$llvm_bin/mlir-opt" "$2" --convert-scf-to-cf --convert-to-llvm \
    --reconcile-unrealized-casts > "$work/$1.llvm.mlir" 2>> "$work/err" &&
    bounded "$llvm_bin/mlir-translate" --mlir-to-llvmir "$work/$1.llvm.mlir" \
      > "$work/$1.ll" 2>> "$work/err" &&
    link_program -Wno-override-module "$work/$1.ll" -o "$work/$1" 2>> "$work/err" ||
    return 1
  bounded "$work/$1"
  echo $?
}
bounded "$llvm_bin/mlir-opt" "$input" --canonicalize > "$work/canonical.mlir" 2> "$work/err"
before=$(returns input "$input") && after=$(returns canonical "$work/canonical.mlir") || {
  say "twice: did not build"
  show "$work/err"
  exit 0
}
if [ "$before" = 14 ] && [ "$after" = 14 ]; then
  say "twice: fixed (returns 14, and 14 after canonicalize)"
else
  say "twice: still reproduces (returns $before, and $after after canonicalize)"
  show "$work/canonical.mlir"
fi
