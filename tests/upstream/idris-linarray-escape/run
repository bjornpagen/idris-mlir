#!/bin/sh
# The upstream bug upstream/idris-linarray-escape still reproduces with the
# pinned Idris: a linear array returned by newArray's continuation is shared,
# and a write through one handle shows through another. When this fails, the
# bug is fixed: delete the PINS.md entry linarray-escape, the report and this
# test (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cp "$root/upstream/idris-linarray-escape/Main.idr" "$work/"
(cd "$work" && bounded "$idris2" --no-banner --no-color -p contrib --cg chez -o prog Main.idr) \
  > "$work/build.log" 2>&1
built=$?
if [ "$built" -ne 0 ]; then
  say "escape: rejected by idris2 (exit $built), so the bug is fixed"
  sed 's/^/  | /' "$work/build.log"
else
  bounded "$work/build/exec/prog" > "$work/out" 2>&1
  if [ "$(head -n 1 "$work/out")" = "Just 20" ]; then
    say "escape: still reproduces (a write through one handle shows through another)"
  else
    say "escape: no longer reproduces"
    sed 's/^/  | /' "$work/out"
  fi
fi
