#!/bin/sh
# The upstream bug upstream/recursive-attribute-parser still reproduces with
# the pinned mlir-opt: an array attribute nested 100,000 deep overflows an
# 8 MiB stack. When this fails, the bug is fixed: idris-mlir-cc may drop its
# reserved stack, and the PINS.md entry mlir-recursion, the report and this
# test go (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
sh "$root/upstream/recursive-attribute-parser/nested.sh" 100000 > "$work/nested.mlir"
( ulimit -s 8192 && bounded "$llvm_bin/mlir-opt" "$work/nested.mlir" ) > /dev/null 2> "$work/err"
status=$?
if [ "$status" -ge 128 ] && grep -q "MLIR Parser" "$work/err"; then
  say "nested: still reproduces (the parser overflows the stack)"
else
  say "nested: no longer reproduces (exit $status)"
  head -n 20 "$work/err" | sed 's/^/  | /'
fi
