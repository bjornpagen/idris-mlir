#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The pinned mlir-opt, with upstream/23-cse-statistic-assignment/llvm.patch,
# reports CSE's statistics accumulated over every function of a nested
# pipeline, the same under one thread and under many: 3 operations CSE'd
# in cse.mlir (1 in @f, 2 in @g, 0 in @h), where an unpatched mlir-opt
# (main at 7208ba24) reports the last function's count, 0, with threading
# disabled. When the pin has upstream's fix, the patch goes, and with it
# the PINS.md entry cse-statistic-assignment, the report and this test.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
for threads in many one; do
  flags=
  [ "$threads" = one ] && flags=--mlir-disable-threading
  # shellcheck disable=SC2086 # empty or one flag
  bounded "$llvm_bin/mlir-opt" $flags "$root/upstream/23-cse-statistic-assignment/cse.mlir" \
    -pass-pipeline='builtin.module(func.func(cse))' \
    --mlir-pass-statistics --mlir-pass-statistics-display=list \
    -o /dev/null > "$work/$threads.out" 2>&1
  if grep -q "(S) 3 num-cse'd" "$work/$threads.out"; then
    say "$threads: fixed (3 operations CSE'd, accumulated over the functions)"
  else
    say "$threads: still reproduces"
    grep "num-cse'd" "$work/$threads.out" | sed 's/^/  | /'
  fi
done
