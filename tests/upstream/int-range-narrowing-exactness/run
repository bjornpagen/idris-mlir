#!/bin/sh
# The pinned mlir-opt, with upstream/09-int-range-narrowing-exactness/llvm.patch,
# no longer shows the bug: arith-int-range-narrowing keeps as i64 ops a
# remsi that may see INT32_MIN % -1 and a remui of a word that may be
# negative, so the remui still computes what the input program does, where
# an unpatched mlir-opt (llvmorg-23.1.2, and main at 7208ba24) makes i32
# ops of both. (A shift whose amount reaches the narrow width was a third
# case; main's 44a4dbf32, which the pin has, fixed it.) When the pin's
# narrowing handles the remainders, the patch goes, and with it the PINS.md
# entry int-range-narrowing-exactness, the report and this test
# (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
input=$root/upstream/09-int-range-narrowing-exactness/narrowing.mlir
bounded "$llvm_bin/mlir-opt" "$input" --arith-int-range-narrowing="int-bitwidths-supported=32" \
  > "$work/narrowed.mlir" 2>&1
status=$?
for op in remsi remui; do
  if [ "$status" -eq 0 ] && grep -q "arith\.$op .* : i64\$" "$work/narrowed.mlir" &&
     ! grep -q "arith\.$op .* : i32\$" "$work/narrowed.mlir"; then
    say "$op: fixed (stays an i64 op)"
  else
    say "$op: still reproduces (exit $status)"
    show "$work/narrowed.mlir"
  fi
done
bounded "$llvm_bin/mlir-opt" "$work/narrowed.mlir" --inline --canonicalize > "$work/folded.mlir" 2>&1
if sed -n '/@remu_of_minus_two/,/return/p' "$work/folded.mlir" | grep -q 'arith.constant 0 : i64'; then
  say "remui of -2 by 7: fixed (0, as the input program gives)"
else
  say "remui of -2 by 7: still reproduces"
  show "$work/folded.mlir"
fi
