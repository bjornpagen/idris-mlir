#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The pinned toolchain, with
# upstream/24-one-shot-module-function-interface/llvm.patch, bufferizes
# function boundaries through FunctionOpInterface and on any symbol table:
# a module whose top holds a transform.named_sequence beside the payload
# still bufferizes (the case that reverted upstream's own generalization); a
# function that never returns bufferizes with its caller (the pin refuses
# it); a caller writes a copy of the constant a callee returns (the pin
# writes the constant's global); empty tensor elimination on a gpu.module
# sees function boundaries (the pin's sees them on a builtin.module alone);
# and idr.func's boundaries are analyzed by upstream's own models, so a
# callee writes the tensor it is given in place and neither it nor its
# caller copies, a returned constant is copied before it is written, and the
# constant's global is a symbol of the program. When the pin has all of it,
# the patch goes, and with it the PINS.md entry
# one-shot-module-function-interface, the report and this test
# (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
bug=$root/upstream/24-one-shot-module-function-interface

bounded "$llvm_bin/mlir-opt" "$bug/named-sequence.mlir" \
  --one-shot-bufferize=bufferize-function-boundaries > "$work/sequence.mlir" 2> "$work/err"
status=$?
if [ "$status" -ne 0 ]; then
  say "named-sequence: refused (exit $status), as upstream's reverted generalization did"
  show "$work/err"
elif grep -q 'func.func @payload(%[^:]*: memref<' "$work/sequence.mlir" &&
     grep -q 'transform.named_sequence @schedule' "$work/sequence.mlir"; then
  say "named-sequence: the payload bufferizes and the sequence is left as it is"
else
  say "named-sequence: bufferized otherwise"
  show "$work/sequence.mlir"
fi

bounded "$llvm_bin/mlir-opt" "$bug/no-return.mlir" \
  --one-shot-bufferize=bufferize-function-boundaries > "$work/no-return.mlir" 2> "$work/err"
status=$?
if [ "$status" -eq 0 ]; then
  say "no-return: a function that never returns bufferizes, and so does its caller"
else
  say "no-return: refused (exit $status), as at the unpatched pin"
  show "$work/err"
fi

bounded "$llvm_bin/mlir-opt" "$bug/non-writable-result.mlir" \
  --one-shot-bufferize=bufferize-function-boundaries > "$work/non-writable.mlir" 2> "$work/err"
status=$?
if [ "$status" -ne 0 ]; then
  say "non-writable-result: refused (exit $status)"
  show "$work/err"
elif grep -q 'memref.copy' "$work/non-writable.mlir"; then
  say "non-writable-result: the caller writes a copy of the constant the callee returns"
else
  say "non-writable-result: the caller writes the constant's global, as at the unpatched pin"
  show "$work/non-writable.mlir"
fi

bounded "$llvm_bin/mlir-opt" "$bug/symbol-table.mlir" \
  "--pass-pipeline=builtin.module(gpu.module(eliminate-empty-tensors))" \
  > "$work/symbol-table.mlir" 2> "$work/err"
status=$?
if [ "$status" -ne 0 ]; then
  say "symbol-table: refused (exit $status)"
  show "$work/err"
elif grep -q 'tensor.extract_slice' "$work/symbol-table.mlir"; then
  say "symbol-table: the elimination sees the call's boundary on a gpu.module"
else
  say "symbol-table: the elimination sees no function boundary, as at the unpatched pin"
  show "$work/symbol-table.mlir"
fi

bounded "$idris_mlir_opt" "$bug/idr-call.mlir" --idr-bufferize -o "$work/idr-call.mlir" 2> "$work/err"
status=$?
if [ "$status" -ne 0 ]; then
  say "idr-call: idr-bufferize fails (exit $status)"
  show "$work/err"
else
  if expect_holds "$work/idr-call.mlir" in-place=@callee in-place=@caller; then
    say "idr-call: the callee writes its argument in place and neither function copies"
  else
    say "idr-call: a copy is left"
    show "$work/expect.log"
  fi
  if expect_holds "$work/idr-call.mlir" in-place=@writes; then
    say "idr-call: the returned constant is written in place"
  else
    say "idr-call: the returned constant is copied before it is written"
  fi
  if awk '/idr\.program/ { program = 1 } /memref\.global/ && program { found = 1 }
          END { exit !found }' "$work/idr-call.mlir"; then
    say "idr-call: the constant's global is a symbol of the program"
  else
    say "idr-call: the constant's global is outside the program"
    show "$work/idr-call.mlir"
  fi
fi
