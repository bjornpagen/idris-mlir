#!/bin/sh
# The pinned ld64.lld, with upstream/ld64-lld-unknown-tapi-target/llvm.patch,
# no longer shows the bug: it reads a .tbd that names a target its LLVM does
# not know, skipping that target, where llvmorg-23.1.2 refuses the file (and
# so every link against the macOS 27 SDK's libSystem, which names
# arm64e.x1). unknown.tbd names unknown-macos, which no LLVM knows, so only
# reading stubs with SkipUnknownTriples makes it link; learning one more
# target, as arm64e.x1 is learned after 23.1.2, does not. When the pin's
# ld64.lld reads such stubs, the patch goes, and with it the PINS.md entry
# darwin-ld64-tapi, the report and this test (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
report=$root/upstream/ld64-lld-unknown-tapi-target

if ! bounded "$llvm_bin/clang" --target=x86_64-apple-macosx14.0 -c "$report/min.c" \
    -o "$work/min.o" > "$work/cc.log" 2>&1; then
  say "min.o: does not compile (the pinned clang has no X86 target?)"
  show "$work/cc.log"
  exit 0
fi
# known.tbd names targets LLVM knows: it must link, or the fixture itself
# is wrong and a link of unknown.tbd would prove nothing.
for stub in known unknown; do
  bounded "$llvm_bin/ld64.lld" -arch x86_64 -platform_version macos 14.0 14.0 \
    -o "$work/$stub.out" "$work/min.o" "$report/$stub.tbd" > "$work/$stub.log" 2>&1
  status=$?
  if [ "$status" -eq 0 ]; then
    say "$stub.tbd: links"
  else
    say "$stub.tbd: does not link (exit $status)"
    sed 's/^/  | /' "$work/$stub.log"
  fi
done
