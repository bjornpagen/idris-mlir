#!/bin/sh
# The upstream bug upstream/uplift-final-counter still reproduces with the
# pinned MLIR: the uplift of a loop that counts to 10 returns 9. The pinned
# mlir-opt has no test passes, so idris-mlir-opt runs upstream's test pass
# of the same name. When this fails, the bug is fixed: let idr-tail-loops
# uplift every counted loop (delete counterUsedAfter), and delete the
# PINS.md entry uplift-final-counter, idris-mlir-opt's copy of the test
# pass, the report and this test (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
"$idris_mlir_opt" "$root/upstream/uplift-final-counter/counter.mlir" \
  --test-scf-uplift-while-to-for > "$work/out.mlir" 2>&1
status=$?
if [ "$status" -eq 0 ] && grep -q 'arith.constant 9 : index' "$work/out.mlir"; then
  say "uplift: still reproduces (the loop that ends at 10 returns 9)"
else
  say "uplift: no longer reproduces (exit $status)"
  sed 's/^/  | /' "$work/out.mlir"
fi
