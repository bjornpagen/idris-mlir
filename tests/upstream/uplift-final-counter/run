#!/bin/sh
# The pinned MLIR, with upstream/uplift-final-counter/llvm.patch, no longer
# shows the bug: the uplift of a loop that counts to 10 returns 10, where
# llvmorg-23.1.2 returns 9. The pinned mlir-opt has no test passes, so
# idris-mlir-opt runs upstream's test pass of the same name, whose pattern
# driver folds the uplifted loop's final value. When the pin has upstream's
# fix, the patch goes, and with it the PINS.md entry uplift-final-counter,
# idris-mlir-opt's copy of the test pass, the report and this test
# (upstream/README.md).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
"$idris_mlir_opt" "$root/upstream/uplift-final-counter/counter.mlir" \
  --test-scf-uplift-while-to-for > "$work/out.mlir" 2>&1
status=$?
returned=$(sed -n 's/^ *return \(%[^ ]*\) : index$/\1/p' "$work/out.mlir")
if [ "$status" -eq 0 ] && ! grep -q 'scf.while' "$work/out.mlir" && [ -n "$returned" ] &&
   grep -q "^ *$returned = arith.constant 10 : index\$" "$work/out.mlir"; then
  say "uplift: fixed (the loop that ends at 10 returns 10)"
else
  say "uplift: still reproduces, or did not uplift (exit $status)"
  sed 's/^/  | /' "$work/out.mlir"
fi
