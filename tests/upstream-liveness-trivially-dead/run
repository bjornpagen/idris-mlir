#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/63-liveness-trivially-dead is retired: nothing in the tree runs
# remove-dead-values, so the patch is not carried and the report stays a
# submission. The pinned mlir-opt still walks a region branch op of n
# regions once per region: remove-dead-values on a private function
# returning an scf.index_switch of n cases grows about 16-fold from
# n = 2000 to n = 8000, where a walk per op grows about 4-fold. The line
# is drawn at 9 (the smaller time counted as at least 5 hundredths), far
# from both, as the times are the processor's, not the clock's. When the
# pin has upstream's fix this check fails, and the report goes with it.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
switch() {
  awk -v n="$1" 'BEGIN {
    print "func.func private @f(%i: index, %x: i64) -> i64 {"
    print "  %r = scf.index_switch %i -> i64"
    for (k = 0; k < n; k++)
      printf "  case %d {\n    %%c = arith.constant %d : i64\n    %%t = arith.addi %%c, %%x : i64\n    scf.yield %%t : i64\n  }\n", k, k
    print "  default {\n    scf.yield %x : i64\n  }"
    print "  return %r : i64"
    print "}"
    print "func.func @main(%i: index, %x: i64) -> i64 {"
    print "  %r = func.call @f(%i, %x) : (index, i64) -> i64"
    print "  return %r : i64"
    print "}"
  }'
}
# The processor time of remove-dead-values on the switch of $1 cases, in
# hundredths of a second, at least one.
cpu() {
  switch "$1" > "$work/switch.mlir"
  bounded /usr/bin/time -p "$llvm_bin/mlir-opt" "$work/switch.mlir" --remove-dead-values \
    -o /dev/null 2> "$work/time" || { show "$work/time"; return 1; }
  awk '$1 == "user" { t = int($2 * 100 + 0.5); print (t < 1 ? 1 : t) }' "$work/time"
}
small=$(cpu 2000) && large=$(cpu 8000) || { say "mlir-opt failed, which is not this bug"; exit 0; }
[ "$small" -ge 5 ] || small=5
if [ "$large" -le $((9 * small)) ]; then
  say "fixed at the pin: liveness walks the switch once"
else
  say "still reproduces at the pin: liveness walks the switch once per case"
fi
