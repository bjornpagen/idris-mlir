#!/bin/sh
# idris-mlir --mlir-timing reports where a compilation spent its time: the
# parse, with the verification that follows it, has a row of its own
# before the passes; each module pass the driver's one manager ran, from
# idr-target on, has a row of its own, under its pass name, one per module
# the IR printer writes; a group of passes run on every function is a row
# of its own, with the rows of its passes nested in it, and the
# optimizer's row holds those of the pipeline it runs on each function,
# so no pass of a group or of the optimizer has a row at the top; and no time is counted twice
# at the top, so the Rest is not negative. With a module and -c, neither
# the frontend nor the link runs, so neither has a row. MLIR keys a pass's
# timer by the pass's address, which one manager keeps for the whole
# compilation: every pass that ran has its own row, under its own name.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"

cat > "$work/main.mlir" << 'EOF_MODULE'
module {
  idr.func private @twice(%x: i64) -> i64 attributes {total, effects = #idr.effects<none>} {
    %y = arith.addi %x, %x : i64
    return %y : i64
  }
  idr.func @Prog.main() -> i64 {
    %c = arith.constant 21 : i64
    %y = idr.call @twice(%c) : (i64) -> i64
    return %y : i64
  }
}
EOF_MODULE
mkdir "$work/dumps"
if bounded "$idris_mlir" -c "$work/main.mlir" -o "$work/main.o" --mlir-timing \
    -mlir-print-ir-after-all -mlir-print-ir-tree-dir="$work/dumps" 2> "$work/report"; then
  say "compile: ok"
else
  say "compile: exit $bounded_status"
  show "$work/report"
  exit 0
fi
timing_rows "$work/report" > "$work/rows"

# The rows at the top that are a pass's or a group's: every row at the top
# but the parse, LLVM, the Rest, the Total and the verifier's, in the order
# they began, which is the order they ran.
awk -F'\t' '$1 == 0 && $3 != "parse" && $3 != "LLVM" && $3 != "Rest" && $3 != "Total" &&
    $3 !~ /Verifier/ && $3 !~ /^\(A\) / { print $3 }' "$work/rows" > "$work/passes"

if awk -F'\t' '$1 == 0 { top++; if ($3 == "parse") { parses++; if (top != 1) late = 1 } }
    END { exit parses != 1 || late }' "$work/rows"; then
  say "parse: a row of its own, before the passes"
else
  say "parse: not one row before the passes"
  show "$work/rows"
fi

# The module's own dumps, in the order the passes ran; a group's passes
# print into each function's directory below, so a group has no dump here.
ls "$work/dumps/builtin_module_no-symbol-name" | grep '[.]mlir$' | sort -n > "$work/dumps.list"
ran=$(wc -l < "$work/dumps.list" | tr -d ' ')
timed=$(grep -cv 'Pipeline$' "$work/passes" | tr -d ' ')
if [ "$ran" -gt 1 ] && [ "$ran" -eq "$timed" ] && [ "$(head -n 1 "$work/passes")" = IdrTarget ] &&
    [ "$(head -n 1 "$work/dumps.list")" = 0_idr-target.mlir ]; then
  say "passes: each module pass that ran has a row of its own, idr-target first, one per dump"
else
  say "passes: the rows are not the passes that ran ($timed rows, $ran dumps)"
  show "$work/passes"
fi

if awk -F'\t' '
    pending && $1 < 1 { failed = 1 }
    { pending = $1 == 0 && ($3 ~ /Pipeline$/ || $3 == "IdrOptimize") }
    $1 == 0 && $3 ~ /Pipeline$/ { groups++ }
    $1 == 0 && $3 == "IdrOptimize" { optimizers++ }
    END { exit failed || pending || groups < 1 || optimizers != 1 }' "$work/rows"; then
  say "groups: each, and the optimizer, has the rows of its passes nested in it"
else
  say "groups: one has no rows nested in it"
  show "$work/rows"
fi

inside=$(grep -x 'IdrEffects\|IdrRedirect\|IdrIdentity\|Canonicalizer\|CSE\|IdrTailLoops\|IdrStructureLoops' \
  "$work/passes")
if [ -z "$inside" ]; then
  say "top: no pass of a group or of the optimizer has a row at the top"
else
  say "top: rows at the top of passes run inside: $(printf '%s' "$inside" | paste -sd, -)"
fi

rest=$(awk -F'\t' '$1 == 0 && $3 == "Rest" { print $2 }' "$work/rows")
case $rest in
  '') say "rest: no row" ;;
  -*) say "rest: negative, $rest s" ;;
  *) say "rest: not negative" ;;
esac
