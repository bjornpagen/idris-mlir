#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Every property idr-expect knows has a fixture in this directory in which
# it fails: a property no module makes fail holds of every module, and a
# test that states it checks nothing. A failing fixture checks the
# property's fixed words, `expected <name>: `, so the names are read from
# the one table of them and each is looked for among the fixtures here.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cd "$root" || exit 1
# folds-balanced reads the folders' own count of the cells they left live,
# which only a defective folder makes nonzero: no module makes it fail, so
# it is the one exemption.
exempt='folds-balanced'
sed -n 's/^ *\.Case("\([^"]*\)".*/\1/p' foreign/idr/lib/Transforms/Expect/Lookup.cpp > "$work/names"
if [ -s "$work/names" ]; then say "properties: found"; else say "properties: none found"; fi
: > "$work/unfailed"
while IFS= read -r name; do
  case " $exempt " in *" $name "*) continue ;; esac
  grep -qF "expected $name: " tests/idr/expect/*.mlir || printf '%s\n' "$name" >> "$work/unfailed"
done < "$work/names"
if [ -s "$work/unfailed" ]; then
  say "no fixture where it fails:"
  cat "$work/unfailed"
else
  say "every property has a fixture where it fails, folds-balanced aside"
fi
for name in $exempt; do
  grep -qxF "$name" "$work/names" || say "exempt and unknown: $name"
done
