// -----

// An unboxed sum spreads over the cell that holds it: three counted slots
// in each of 86 fields are 258.
idr.data @Three {
  idr.ctor @P (!idr.str, !idr.str, !idr.str)
}
idr.data @Holder box {
  // expected-error @+1 {{it holds 258 counted references}}
  idr.ctor @H (!idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>, !idr.data<@Three>)
