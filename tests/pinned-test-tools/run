#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The dialect tests run without lit or Python. Their RUN lines find the
# FileCheck, not and count of the pinned LLVM first on PATH (`lit`, in
# harness/lib/lit.sh), shown here with stand-ins for them, and with other
# tools of those names already first on the caller's PATH, which lit must
# put after the pinned ones.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
say "the pinned LLVM: ${llvm_bin#"$root"/}"
llvm_bin=$work/llvm/bin
mkdir -p "$llvm_bin"
for tool in FileCheck not count; do
  printf '#!/bin/sh\nexit 0\n' > "$llvm_bin/$tool"
  chmod +x "$llvm_bin/$tool"
done
cat > "$work/which.mlir" <<'MLIR'
// RUN: command -v FileCheck > %t.FileCheck
// RUN: command -v not > %t.not
// RUN: command -v count > %t.count
MLIR
mkdir -p "$work/decoy"
for tool in FileCheck not count; do
  printf '#!/bin/sh\nexit 0\n' > "$work/decoy/$tool"
  chmod +x "$work/decoy/$tool"
done
PATH=$work/decoy:$PATH lit "$work/which.mlir" > "$work/lit.log"
for tool in FileCheck not count; do
  found=$(cat "$work/t.$tool" 2> /dev/null)
  if [ "$found" = "$llvm_bin/$tool" ]; then
    say "$tool: the pinned LLVM's, first on PATH"
  else
    say "$tool: ${found:-not found}, not the pinned LLVM's" | sed "s|$work|<work>|g"
    show "$work/lit.log"
  fi
done
