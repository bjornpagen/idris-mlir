#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# No primitive has a meaning in the compiler's Idris code: a primitive
# means what the runtime computes, and the folders call the runtime's own
# code, so nothing in compiler/src calls an Idris primitive (`prim__*`) to
# compute a value. Searched in the code of every module, comments and the
# contents of strings removed. That a folder computes what the runtime
# does is the fuzzer's to see (tests/fuzz-seeds: folded against run), as a
# folder can compute without a primitive.
#
# `allowlist` lists the calls allowed anyway, as `path: text -- reason`:
# serializing a literal is not computing with it. It only shrinks: an
# entry that allows no call is stale, and so is found.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
allowlist=$here/allowlist
cd "$root" || exit 1

: > "$work/found"
for file in $(find compiler/src -name '*.idr' | LC_ALL=C sort); do
  idris_lex code "$file" | grep -E 'prim__[A-Za-z0-9_]+' | sed 's/:.*//' |
    while IFS= read -r n; do
      printf '%s:%s: %s\n' "$file" "$n" "$(sed -n "${n}p" "$file")"
    done >> "$work/found"
done

grep -v '^[[:space:]]*#' "$allowlist" | grep -v '^[[:space:]]*$' > "$work/allowed"
: > "$work/stale"
: > "$work/left"
while IFS= read -r entry; do
  case $entry in
    *': '*' -- '?*) ;;
    *) say "allowlist entry without a path, a text and a reason: $entry" ;;
  esac
done < "$work/allowed"
while IFS= read -r entry; do
  path=${entry%%: *}
  rest=${entry#*: }
  text=${rest% -- *}
  grep -qF -- "$path:" "$work/found" && grep -F -- "$path:" "$work/found" | grep -qF -- "$text" ||
    printf '%s\n' "$entry" >> "$work/stale"
done < "$work/allowed"
while IFS= read -r hit; do
  keep=yes
  while IFS= read -r entry; do
    path=${entry%%: *}
    rest=${entry#*: }
    text=${rest% -- *}
    case $hit in "$path:"*"$text"*) keep=no ;; esac
  done < "$work/allowed"
  [ $keep = yes ] && printf '%s\n' "$hit" >> "$work/left"
done < "$work/found"

if [ -s "$work/left" ]; then
  say "primitives called in compiler/src:"
  show "$work/left"
else
  say "primitives: compiler/src calls none but the allowed serializations"
fi
if [ -s "$work/stale" ]; then
  say "allowlist entries that allow no call:"
  show "$work/stale"
else
  say "allowlist: each entry allows a call"
fi
