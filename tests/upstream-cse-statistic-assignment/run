#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/23-cse-statistic-assignment is retired: no test compares pass
# statistics across thread counts any more, so the patch is not carried
# and the report stays a submission. The pinned mlir-opt still reports
# CSE's statistic as the last function's count under one thread (0 for
# cse.mlir, where @f and @g CSE 3 operations between them). When the pin
# has upstream's fix this check fails, and the report goes with it.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
bounded "$llvm_bin/mlir-opt" --mlir-disable-threading "$root/upstream/23-cse-statistic-assignment/cse.mlir" \
  -pass-pipeline='builtin.module(func.func(cse))' \
  --mlir-pass-statistics --mlir-pass-statistics-display=list \
  -o /dev/null > "$work/one.out" 2>&1
if grep -q "(S) 3 num-cse'd" "$work/one.out"; then
  say "one thread: fixed at the pin (3 operations CSE'd, accumulated over the functions)"
else
  say "one thread: still reproduces at the pin"
fi
