// input: after idr-simplify
// FILECHECK-OPTIONS: --implicit-check-not={{[[:space:]](idr[.])?str[.][a-z]}}
// putStrLn of a string built from a runtime character becomes writes in
// order: append becomes two writes, cons a put_char then a put_str, and
// show of an Int a put_int. No string op is left.
// CHECK-DAG: [[GOT:%[a-z0-9_]+]] = constant "got "
// CHECK-DAG: [[EQ:%[a-z0-9_]+]] = constant " = "
// CHECK-DAG: [[NL:%[a-z0-9_]+]] = constant "\0A"
// CHECK: io.put_str [[GOT]],
// CHECK: io.put_char
// CHECK: io.put_str [[EQ]],
// CHECK: io.put_int
// CHECK: io.put_str [[NL]],
