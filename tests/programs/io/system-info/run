. "$IDRIS_MLIR_ROOT/tests/testutils.sh"

# What System.Info says on this host, from the names and the processor
# count tools/host.sh holds for it: the operating system the target's
# triple names, no Windows, this code generator and every processor. A
# host of neither target has no expected value, and the one line naming it
# fails the test.
case " $host_names " in
  *" macos "*) os=darwin ;;
  *" linux "*) os=unix ;;
  *)
    say "system-info: no target runs on the host $host_names"
    exit 0 ;;
esac
mkdir "$work/fixture"
cp Main.idr "$work/fixture/"
printf '%s\n' "$os" no mlir "$ncpu_total" > "$work/fixture/expected-stdout"
e2e_io "$work/fixture"
