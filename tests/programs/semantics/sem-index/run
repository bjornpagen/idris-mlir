#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The semantics tests and their table name each other: every chunk of
# tests/Sem.idr's table has its directory beside this one, and every prim-
# directory here a chunk, so a chunk nothing runs, or a directory whose
# program the table no longer makes, fails here.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
if ! "$runtests" --sem-names > "$work/names" 2> "$work/names.err"; then
  say "no names of the table's chunks"
  show "$work/names.err"
  exit 0
fi
LC_ALL=C sort "$work/names" > "$work/chunks"
for sem_dir in "$here"/../prim-*; do
  [ -d "$sem_dir" ] && say "${sem_dir##*/}"
done | LC_ALL=C sort > "$work/directories"
if cmp -s "$work/chunks" "$work/directories"; then
  say "every table chunk of tests/Sem.idr has a directory, and every prim- directory a chunk"
else
  say "the table's chunks and the prim- directories differ (< chunks, > directories)"
  diff "$work/chunks" "$work/directories" | head -n 20 | sed 's/^/  | /'
fi
