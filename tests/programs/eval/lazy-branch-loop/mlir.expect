# The recursion of `next` is the `else` of an `if`, whose branches are
# suspensions forced after the match. The force meets the suspension in
# each case, so each case calls its branch: the loop is a call of a
# function on a cycle, which is never inlined, and no cell is built on the
# way round it. The actions `fill` returns are closures until
# defunctionalization sums them, as in lazy-list-branches.
idr-optimize: no-heap-allocation=@Main.next
idr-defunctionalize: no-closures
