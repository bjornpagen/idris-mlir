# The fill and the sum are loops of stores and loads: nothing is allocated
# in them, and no count changes, since the vector is moved along its
# thread. Each access's position is a Fin that the loop's own test against
# the size gives, so no access is checked again.
idr-rc-exclusive: counts-nothing=@Main.fill counts-nothing=@Main.sumTo no-heap-allocation=@Main.fill no-heap-allocation=@Main.sumTo
