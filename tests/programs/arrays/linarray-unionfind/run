# The program of the benchmark bench/unionfind, run on this fixture's input
# against its expected files.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
mkdir "$work/fixture"
cp "$root/bench/unionfind/Main.idr" "$work/fixture/"
cp "$root/bench/unionfind/packages" "$work/fixture/"
cp stdin expected-stdout mlir.expect "$work/fixture/"
e2e_io "$work/fixture"
