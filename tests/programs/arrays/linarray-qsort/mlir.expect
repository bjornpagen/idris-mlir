# Quicksort over a growable linear vector of 32-bit words (Counting
# Immutable Beans' qsort): the partition and the sorted check change no
# count and allocate nothing; every swap is loads and stores on the one
# array, which bufferization writes in place, copying none. (partition
# itself is inlined into its one caller.)
idr-bufferize: in-place=@Main.partitionAux in-place=@Main.qsortAux in-place=@Main.checkSorted
idr-rc-exclusive: counts-nothing=@Main.partitionAux counts-nothing=@Main.checkSorted counts-nothing=@Main.qsortAux no-heap-allocation=@Main.partitionAux no-heap-allocation=@Main.checkSorted no-heap-allocation=@Main.qsortAux
