#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Stage 2 installed a complete tree into .toolchain/llvm, the same on every
# host: every tool, the CMake packages of LLVM and MLIR, the configuration
# those packages record (the backends of both targets, assertions on, RTTI
# and exceptions off, no plugins), and beside them the runtimes, the
# configuration file of the target's triple and the toolchain file every
# preset reads.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
missing=
for tool in clang lld clang-tidy mlir-tblgen mlir-opt mlir-translate opt llc llvm-ar llvm-nm \
            llvm-readelf llvm-objdump llvm-symbolizer FileCheck not count; do
  [ -x "$llvm_bin/$tool" ] || missing="$missing $tool"
done
if [ -n "$missing" ]; then say "tools missing:$missing"; else say "tools: all installed"; fi
cmake_dir=${llvm_bin%/bin}/lib/cmake
for package in llvm/LLVMConfig.cmake mlir/MLIRConfig.cmake; do
  if [ -f "$cmake_dir/$package" ]; then say "package: $package"; else say "package: $package missing"; fi
done
for setting in 'LLVM_TARGETS_TO_BUILD AArch64;X86' 'LLVM_ENABLE_ASSERTIONS ON' 'LLVM_ENABLE_RTTI OFF' \
               'LLVM_ENABLE_EH OFF' 'LLVM_ENABLE_PLUGINS OFF'; do
  if grep -qxF "set($setting)" "$cmake_dir/llvm/LLVMConfig.cmake" 2> /dev/null; then
    say "configured: $setting"
  else
    say "not configured: $setting"
  fi
done
prefix=${llvm_bin%/bin}
triple=$(sed -n 's/^set(CMAKE_CXX_COMPILER_TARGET "\(.*\)")$/\1/p' "$prefix/toolchain.cmake" 2> /dev/null)
if [ -n "$triple" ] && [ -f "$llvm_bin/$triple.cfg" ]; then
  say "toolchain file: names a target whose configuration file is beside clang"
else
  say "toolchain file: missing, or its target ${triple:-(none)} has no configuration file"
fi
# clang names a file it finds by its own real path, and only then names a
# directory at all; a checkout's .toolchain may be a link to another's, so
# both sides are compared as physical paths.
modules=$("$llvm_bin/clang++" "--target=$triple" -print-file-name=libc++.modules.json 2> /dev/null)
modules_dir=$(cd "$(dirname "$modules")" 2> /dev/null && pwd -P)
real_prefix=$(cd "$prefix" 2> /dev/null && pwd -P)
case $modules_dir/ in
  "$real_prefix"/*)
    if [ -f "$modules" ]; then
      say "runtimes: libc++ and its module manifest beside clang"
    else
      say "runtimes: clang names $modules, which is not there"
    fi ;;
  *) say "runtimes: clang names no libc++.modules.json beside it (${modules:-nothing})" ;;
esac
