# A large big's digits are in its cell, one load from its word, at the
# small range's edges and the limb's, both ways: the test reads the
# runtime's cells, and the runtime reads the test's (cell.c), as a program
# on the checked runtime, with the count of the cells it holds.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
if ! runtime_c link_program -O1 -I"$root/harness/prop" "$here/cell.c" "$root/harness/prop/held.cpp" \
     "$checked_runtime" -o "$work/cell" > "$work/cc.log" 2>&1; then
  say "cell: does not build"
  show "$work/cc.log"
  exit 0
fi
bounded "$work/cell"
say "cell: exit $?"
