# A large big's digits are in its cell, one load from its word, at the
# small range's edges and the limb's, both ways: the test reads the
# runtime's cells, and the runtime reads the test's (cell.c).
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
runtime=$dev_prefix/runtime/libidris_rt.a
if ! runtime_c link_program -O1 "$here/cell.c" "$runtime" -o "$work/cell" \
     > "$work/cc.log" 2>&1; then
  say "cell: does not build"
  show "$work/cc.log"
  exit 0
fi
bounded "$work/cell"
say "cell: exit $?"
