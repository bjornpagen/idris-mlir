#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# foreign/idr is an in-tree MLIR dialect in upstream's layout: every
# library one add_mlir_library (add_mlir_dialect_library for the dialect),
# linted by the clang-tidy of stage 2, the one LLVM. No state outlives a
# call but four: the dialect's count of the cells the folders left live
# (a member the ODS declares), the command-line option objects of the
# driver and the tools, an action's function-local type identity, a
# constant, and the footprint ledger (idr/Support/Footprint.h), the bytes
# the one allocator of the shared containers holds on each thread: per
# thread, so a run counts only what its own thread holds, with no shared
# counter between threads, and constant-initialized, so the allocator
# reaches it with no guard. Where the C++ is and in which extensions, and
# that none of it is a C++20 module, is tests/zones'; the flags the build
# compiles it with are tests/language-profile's, read from the build's own
# commands.
#
# The rule is `mlir_layout ROOT`, run on the repository and on the planted
# trees (Planted.idr): witness/ breaks it once per way (presets that
# lint with another clang-tidy, a plain add_library, the dialect as a plain
# add_mlir_library, a static mutable, a std::atomic, a thread_local, and a
# thread_local beside the ledger in the ledger's own header);
# near-miss/ holds what is allowed: the four kinds of state, a constant, a
# static function, and the words in comments and strings.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# mlir_layout ROOT: the findings in the tree at ROOT, `path:line: what` or
# `path: what`.
mlir_layout() (
  cd "$1" || exit 1
  idr=foreign/idr
  [ -d "$idr" ] || exit 0
  if [ -f CMakePresets.json ] && ! grep -qF '.toolchain/llvm/bin/clang-tidy' CMakePresets.json; then
    say "CMakePresets.json: lints without the stage-2 clang-tidy"
  fi
  find "$idr" -name CMakeLists.txt | LC_ALL=C sort > "$work/lists"
  # Every library is an add_mlir_library; there is no plain add_library.
  xargs grep -HnE '^[[:space:]]*add_library\(' < "$work/lists" | sed 's/^\([^:]*:[0-9]*\):.*/\1: a plain add_library/'
  if ! xargs grep -qE '^[[:space:]]*add_mlir_dialect_library\(IdrIR$' < "$work/lists"; then
    xargs grep -HnE '\(IdrIR([[:space:]]|$)' < "$work/lists" | sed 's/^\([^:]*:[0-9]*\):.*/\1: IdrIR is not an add_mlir_dialect_library/'
    xargs grep -qE '\(IdrIR([[:space:]]|$)' < "$work/lists" || say "$idr: no library IdrIR"
  fi
  # State: nothing thread_local or std::atomic in a unit but the footprint
  # ledger, at its one declaration (the folders' count is the ODS's), and no
  # static variable that is neither constant nor an option or an action's
  # type identity. A static variable is defined by an `=` or ended by a `;`
  # before any parenthesis; a static function has its parameters first, on
  # its line or the next. Comments and literals are no code.
  find "$idr" -name build -prune -o -type f \( -name '*.cpp' -o -name '*.h' \) -print | LC_ALL=C sort > "$work/units"
  # shellcheck disable=SC2046
  [ -s "$work/units" ] && cpp_lex $(cat "$work/units") > "$work/code"
  grep -E '^[^:]*:[0-9]+:.*(\bthread_local\b|std::atomic\b)' "$work/code" 2> /dev/null |
    grep -vE '^foreign/idr/include/idr/Support/Footprint\.h:[0-9]+:[[:space:]]*(inline[[:space:]]+)?constinit[[:space:]]+thread_local[[:space:]]+Ledger[[:space:]]+ledger;[[:space:]]*$' |
    sed 's/^\([^:]*:[0-9]*\):.*/\1: state shared between calls or threads/'
  grep -E '^[^:]*:[0-9]+:[[:space:]]*static[[:space:]][^(]*[=;]' "$work/code" 2> /dev/null |
    grep -vE '\bstatic[[:space:]]+(inline[[:space:]]+)?(const|constexpr|constinit)\b' |
    grep -vE 'cl::(opt|list)<|SelfOwningTypeID' | sed 's/^\([^:]*:[0-9]*\):.*/\1: a static mutable/'
)

(cd "$root" && find foreign/idr -name '*.cpp' | grep -q .) && say "units: found" || say "units: none found"
mlir_layout "$root" > "$work/found"
if [ -s "$work/found" ]; then
  say "foreign/idr is not in upstream's layout, or keeps state:"
  sed 's/^/  /' "$work/found"
else
  say "CMakePresets.json: lint with the stage-2 clang-tidy"
  say "every library is an add_mlir_library, IdrIR an add_mlir_dialect_library"
  say "no thread_local, static mutable or std::atomic but the four"
fi
planted mlir_layout
