#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/96-effectful-argument-inline, not yet patched: the stock
# Idris's inliner substitutes call by name, so an argument a body never
# uses is dropped with its effects. Bug.idr writes 7 into an array through
# an effectful `let` its body ignores; the pinned Idris still prints 0.
# When this check fails, either the pin has upstream's fix and the report
# goes, or our patch is carried and the check expects 7.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
cp "$root/upstream/96-effectful-argument-inline/Bug.idr" "$work/Bug.idr"
if ! (cd "$work" && pinned_idris --exec main Bug.idr) > "$work/out" 2> "$work/err"; then
  say "the stock Idris fails on the reproducer, which is not this bug"
  show "$work/err"
  exit 0
fi
case $(cat "$work/out") in
  0) say "still reproduces at the pin: the write is dropped, 0 is printed" ;;
  7) say "fixed at the pin: the write is kept, 7 is printed" ;;
  *) say "the reproducer prints $(cat "$work/out")" ;;
esac
