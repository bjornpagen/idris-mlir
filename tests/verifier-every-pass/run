#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# What Idris proved lives in types the verifier checks, and the owned stage's
# counts in its rule; they hold through the pipeline because the verifier
# runs after every pass, so a pass that breaks one fails its own step, by
# name, instead of a later pass or the program going wrong. It does, in every
# tool and every test: MLIR's pass manager verifies after each pass by
# default, idris-mlir-opt's -verify-each is on by default, and the pipelines
# a pass runs itself (idr-optimize's per-function pipeline, which it runs
# through runPipeline, and the nested steps of idr-rc, idr-narrow,
# idr-returned-arguments and idr-tail-calls) inherit the setting of the
# manager that runs the pass. The
# manager skips the verifier only after a pass that says it preserved every
# analysis, which ours say only when they changed nothing.
#
# So nothing may turn the verifier off: no code gives enableVerifier or
# verifyPasses anything but true, and no command, script or RUN line sets
# -verify-each to false or turns the verifier off on parsing. Documents,
# golden output and this test are not searched. A patch carried for a
# pinned upstream (upstream/) is searched in the lines it adds: the lines
# around them quote upstream's source, which this repository does not run.
#
# The rule is `verifier_off ROOT`, run on the repository and on the
# planted trees (lib/planted.sh): witness/ turns the verifier off once per
# way (in C++ through either call, in a RUN line, in a script, on parsing,
# and in a line a patch adds); near-miss/ holds what is allowed: both calls
# given true or nothing, -verify-each set on, the flags in a document, and
# a patch whose context and removed lines turn it off.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
call='(enableVerifier|verifyPasses)[[:space:]]*\('
on='(enableVerifier|verifyPasses)[[:space:]]*\([[:space:]]*(true)?[[:space:]]*\)'
off_flag='verify-each=(false|0)|disable-verifier'

# verifier_off ROOT: each place in the tree at ROOT that turns the
# verifier off, `path:line: text`. A test's planted trees, and this test,
# are not searched.
verifier_off() (
  cd "$1" || exit 1
  searched() {
    find . \( -name third_party -o -name .toolchain -o -name build -o -name .git -o -name sources \
              -o -name .claude -o -name .muse -o -path ./tests/verifier-every-pass \
              -o -path './tests/*/witness' -o -path './tests/*/near-miss' \) -prune \
       -o -type f ! -name '*.md' ! -name output "$@"
  }
  {
    searched ! -name '*.patch' ! -name '*.diff' -exec grep -HnIE "$call" {} + | grep -vE "$on"
    searched ! -name '*.patch' ! -name '*.diff' -exec grep -HniIE "$off_flag" {} +
    searched \( -name '*.patch' -o -name '*.diff' \) -exec awk '
      /^\+/ && !/^\+\+\+ / { print FILENAME ":" FNR ":" $0 }' {} + > "$work/added"
    grep -E "$call" "$work/added" | grep -vE "$on"
    grep -iE "$off_flag" "$work/added"
  } | sed 's|^\./||' | LC_ALL=C sort -u
)

(cd "$root" && find foreign -name '*.cpp' | grep -q .) && say "C++ sources searched: yes" || say "C++ sources searched: no"
(cd "$root" && find tests -path 'tests/*/*.mlir' | grep -q .) && say "RUN lines searched: yes" || say "RUN lines searched: no"
verifier_off "$root" > "$work/off"
if [ -s "$work/off" ]; then
  say "the verifier is turned off at:"
  sed 's/^/  /' "$work/off"
else
  say "no code, command or RUN line turns the verifier off"
fi
planted verifier_off
