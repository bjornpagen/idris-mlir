#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The compiler's C++ and the runtime terminate by structure, never by a
# count, and nothing correct or accepted depends on an iteration limit. A
# pass that only makes code better may stop at a budget, which is then a
# named size policy: a spent one leaves the program less optimized, never
# wrong or refused. What can be seen of that in a token of the C++ of
# foreign/idr and runtime/ (comments and literals removed), outside the
# policies:
#   - an iteration limit: `maxIterations`, `setMaxIterations`,
#     `maxNumRewrites`, `setMaxNumRewrites`, `kNoLimit`;
#   - a loop that states no end: `for (;;)`, `while (true)`, `while (1)`.
# And for the Idris side, compiler/src and libs: no module that is
# covering, by `%default covering` or by stating no `%default total`, no
# definition annotated `covering` or `partial`, and no `assert_total` or
# `assert_smaller` in code. Whether a loop's bound is a count is no token,
# so it is not searched here: a recursion on a Nat or a Vect's length is
# structure, which Idris's totality checker holds, and every command a test
# runs times out, so a pass that does not end fails the test that runs it.
#
# The only exceptions are the lines of tools/policies.txt, `path: text --
# reason`, a finding at `path` on a line holding `text`: the size policies,
# which bound growth, output or how long an optimization runs, never what
# is correct or accepted, and the frontend's trust points. That file is
# the list, reviewed where it changes: the output states that every finding
# is one of its lines, never which, so removing a covering definition and
# its line changes nothing here, and a new one is a line added there. An
# annotation alone on its line is read with the line after it, so that a
# policy names the definition, `covering name :`. Each must still be in
# its file, so that whoever removes one removes its line.
#
# The rule is `no_fuel ROOT`, run on the repository and on the planted
# trees (Planted.idr): witness/ breaks it once per way (each limit and
# loop form, each way a module or definition is covering, each assertion, a
# policy no longer in its file, a policy line without its reason), and
# near-miss/ holds what it allows: the words in comments, strings and
# longer names, a loop whose end is stated, a recursion on a Vect's length
# (which an earlier heuristic read as fuel), and a limit and a covering
# definition its own policies name.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# annotated: of Idris code as idris_lex writes it, `line:code`, each
# definition annotated covering or partial, after its visibility if it has
# one, as `line:code` with the visibility dropped and an annotation alone
# on its line joined to the line after it, `covering name : ...`.
annotated() {
  awk '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    {
      n = $0; sub(/:.*/, "", n)
      code = $0; sub(/^[0-9]+:/, "", code); code = trim(code)
    }
    held != "" { print held " " code; held = ""; next }
    code ~ /^((public[ \t]+)?export[ \t]+|private[ \t]+)?(covering|partial)([ \t]|$)/ {
      sub(/^((public[ \t]+)?export[ \t]+|private[ \t]+)/, "", code)
      if (code ~ /^(covering|partial)$/) held = n ":" code
      else print n ":" code
    }
    END { if (held != "") print held }'
}

# no_fuel ROOT: the rule's findings in the tree at ROOT, `path:line: what`.
no_fuel() (
  cd "$1" || exit 1
  nf_work=$work/no-fuel
  rm -rf "$nf_work"
  mkdir -p "$nf_work"
  # The policies, as `path TAB text TAB reason`; a line not of that form is
  # a finding of its own.
  if [ -f tools/policies.txt ]; then
    awk '!/^[[:space:]]*#/ && !/^[[:space:]]*$/ {
        at = index($0, ": "); cut = at ? index(substr($0, at + 2), " -- ") : 0
        if (cut) cut += at + 1
        if (at == 0 || cut == 0 || cut == at + 2 || cut + 4 > length($0)) {
          print "tools/policies.txt:" FNR ": a policy that is not `path: text -- reason`" > "/dev/stderr"; next
        }
        print substr($0, 1, at - 1) "\t" substr($0, at + 2, cut - at - 2) "\t" substr($0, cut + 4) "\t" FNR
      }' tools/policies.txt > "$nf_work/policies" 2> "$nf_work/malformed"
    cat "$nf_work/malformed"
  else
    : > "$nf_work/policies"
  fi
  # A policy is still in its file when its text is, or, in Idris, when an
  # annotated definition is, as `annotated` writes it.
  while IFS='	' read -r path text reason n; do
    if [ ! -f "$path" ]; then
      printf 'tools/policies.txt:%s: names %s, which is gone\n' "$n" "$path"
    elif ! grep -F -q -- "$text" "$path"; then
      case $path in
        *.idr) idris_lex code "$path" | annotated | grep -F -q -- "$text" ;;
        *) false ;;
      esac || printf 'tools/policies.txt:%s: no longer in %s: %s\n' "$n" "$path" "$text"
    fi
  done < "$nf_work/policies"
  # trusted FILE CODE: a policy names that line of FILE.
  trusted() {
    awk -F'\t' -v path="$1" -v code="$2" \
      '$1 == path && index(code, $2) > 0 { found = 1 } END { exit !found }' "$nf_work/policies"
  }

  # The C++.
  for nf_dir in foreign/idr runtime; do
    [ -d "$nf_dir" ] && find "$nf_dir" -name build -prune -o -type f \
      \( -name '*.cpp' -o -name '*.h' -o -name '*.c' -o -name '*.inc' \) -print
  done | LC_ALL=C sort > "$nf_work/sources"
  if [ -s "$nf_work/sources" ]; then
    # shellcheck disable=SC2046
    cpp_lex $(cat "$nf_work/sources") | awk '
      {
        f = $0; sub(/:.*$/, "", f)
        text = substr($0, length(f) + 2); n = text; sub(/:.*$/, "", n); text = substr(text, length(n) + 2)
        if (text ~ /(^|[^A-Za-z0-9_])for[ \t]*\([ \t]*;[ \t]*;[ \t]*\)/ || text ~ /(^|[^A-Za-z0-9_])while[ \t]*\([ \t]*(true|1)[ \t]*\)/)
          print f "\t" n "\t" text "\ta loop that states no end"
        if (match(text, /(^|[^A-Za-z0-9_])(maxIterations|setMaxIterations|maxNumRewrites|setMaxNumRewrites|kNoLimit)([^A-Za-z0-9_]|$)/)) {
          name = substr(text, RSTART, RLENGTH); gsub(/[^A-Za-z]/, "", name)
          print f "\t" n "\t" text "\tan iteration limit, " name
        }
      }' | while IFS='	' read -r f n text what; do
        trusted "$f" "$text" || printf '%s:%s: %s\n' "$f" "$n" "$what"
      done
  fi

  # The Idris side.
  for nf_dir in compiler/src libs; do
    [ -d "$nf_dir" ] && find "$nf_dir" -name build -prune -o -type f -name '*.idr' -print
  done | LC_ALL=C sort > "$nf_work/idris"
  while IFS= read -r file; do
    idris_lex code "$file" > "$nf_work/code"
    if grep -qE '^[0-9]+:%default[[:space:]]+(covering|partial)' "$nf_work/code"; then
      grep -E '^[0-9]+:%default[[:space:]]+(covering|partial)' "$nf_work/code" |
        sed "s|^\([0-9]*\):.*|$file:\1: covering by default|"
    elif ! grep -qE '^[0-9]+:%default[[:space:]]+total' "$nf_work/code" &&
       grep -qE '^[0-9]+:([a-z_][A-Za-z0-9_'"'"']*[[:space:]]+:([[:space:]]|$)|(export|public|private|data|record|interface|implementation)[[:space:]])' "$nf_work/code"; then
      printf '%s: covering by Idris'"'"'s default, with no %%default total\n' "$file"
    fi
    annotated < "$nf_work/code" |
      while IFS= read -r hit; do
        trusted "$file" "${hit#*:}" || printf '%s:%s: a definition Idris checks only for coverage\n' "$file" "${hit%%:*}"
      done
    grep -E '(^|[^A-Za-z0-9_'"'"'.])(assert_total|assert_smaller)([^A-Za-z0-9_'"'"']|$)' "$nf_work/code" |
      while IFS= read -r hit; do
        trusted "$file" "${hit#*:}" || printf '%s:%s: asserts what Idris does not check\n' "$file" "${hit%%:*}"
      done
  done < "$nf_work/idris"
)

[ -f "$root/tools/policies.txt" ] || say "policies: tools/policies.txt missing"
(cd "$root" && find foreign/idr runtime -type f -name '*.cpp' | grep -q .) &&
  say "sources: the C++ of foreign/idr and runtime searched" || say "sources: no C++ found"
(cd "$root" && find compiler/src libs -type f -name '*.idr' | grep -q .) &&
  say "idris sources: compiler/src and libs searched" || say "idris sources: none found"
no_fuel "$root" > "$work/found"
# report PATTERN WHEN-NONE WHEN-SOME: the findings whose text PATTERN matches.
report() {
  if grep -qE "$1" "$work/found"; then
    say "$3:"
    grep -E "$1" "$work/found" | sed 's/^/  /'
  else
    say "$2"
  fi
}
report ': an iteration limit' "iteration limits: none, no rewrite stops at a count of iterations" \
  "iteration limits: a rewrite stops at a count"
report ': a loop that states no end' "endless loops: none, every loop states when it ends" \
  "endless loops: a loop states no end"
report '^tools/policies.txt:' "policies: each with its reason, and each still in its file" \
  "policies: some are not each a line of its file with its reason"
report ': covering|: a definition Idris checks only' \
  "covering: every module and definition is total but those a policy names" \
  "covering: some modules or definitions are not total"
report ': asserts what' "assertions: only where a policy names them" \
  "assertions: some assert totality where no policy names it"
planted no_fuel
