#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Every op's declaration of its effects states what its runtime function
# does, held against a reading of the function that is not the
# declaration's: LLVM's own, of the runtime's bitcode as every program's
# module takes it in, after opt has inferred each function's attributes
# from its body. The declared half is the specification's, as the runner
# prints it (runtests --runtime-effects); derive.awk reads the derived
# half off the module opt prints (what each function proves of memory and
# of returning, the endings its calls reach, the operands it writes
# through), and relations.awk holds the one to the other, naming each op
# that breaks a relation. Where a function reaches code outside the module
# (the C library, GMP), LLVM knows nothing of what it does to memory, and
# the memory relations do not judge it; its endings, its calls and its
# parameters are judged all the same. Then each relation is shown to catch
# what it forbids (plant.awk): on copies of the two tables with one row
# made wrong, the check names that row's op for that relation, a finding
# the true tables do not give.
step_limit=300
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

if ! "$runtests" --runtime-effects > "$work/declared" 2> "$work/declared.err"; then
  say "declared: the runner prints no table"
  show "$work/declared.err"
  exit 0
fi
if ! grep -q '^op ' "$work/declared"; then
  say "declared: no op calls the runtime"
  exit 0
fi

# The runtime's bitcode, where the target entry keeps it: in a file beside
# the prepared object, or in the object's .llvm.lto section.
runtime=$("$idris_mlir" --print-runtime) || {
  say "runtime: idris-mlir names no prepared runtime"
  exit 0
}
if [ -f "${runtime%.o}.bc" ]; then
  cp "${runtime%.o}.bc" "$work/runtime.bc"
elif ! bounded "$llvm_bin/llvm-objcopy" --dump-section=.llvm.lto="$work/runtime.bc" \
    "$runtime" "$work/sections.o" 2> "$work/objcopy.err"; then
  say "runtime bitcode: not where the target entry keeps it"
  show "$work/objcopy.err"
  exit 0
fi
if ! bounded "$llvm_bin/opt" -passes='inferattrs,cgscc(function-attrs),rpo-function-attrs' -S \
    "$work/runtime.bc" -o "$work/runtime.ll" 2> "$work/opt.err"; then
  say "runtime bitcode: opt does not read it"
  show "$work/opt.err"
  exit 0
fi
say "runtime bitcode: read"

awk -f "$here/derive.awk" "$work/declared" "$work/runtime.ll" > "$work/derived"

if grep -q '^ending .* absent$' "$work/derived"; then
  say "endings: no function of the runtime ends a process as:"
  sed -n 's/^ending \(.*\) absent$/  \1/p' "$work/derived"
else
  say "endings: each the specification names ends a process through a function of the runtime"
fi

awk -f "$here/relations.awk" "$work/declared" "$work/derived" > "$work/findings"
if [ -s "$work/findings" ]; then
  say "relations: declarations that do not cover what their runtime function does:"
  sed 's/^/  /' "$work/findings"
else
  say "relations: every op's declaration covers what its runtime function does"
fi

# Each relation, on copies of the tables with one row made wrong: the
# finding the planted row must bring is printed by plant.awk, and must be
# among the copies' findings and not among the true tables'.
missed=""
for relation in stops crash exit inert operand writes; do
  if ! expected=$(awk -v relation="$relation" -v declaredOut="$work/planted.declared" \
      -v derivedOut="$work/planted.derived" -f "$here/plant.awk" "$work/declared" "$work/derived"); then
    missed="$missed $relation (no row to plant)"
    continue
  fi
  awk -f "$here/relations.awk" "$work/planted.declared" "$work/planted.derived" > "$work/planted.findings"
  if ! grep -qF -- "$expected" "$work/planted.findings" || grep -qF -- "$expected" "$work/findings"; then
    missed="$missed $relation"
  fi
done
if [ -z "$missed" ]; then
  say "planted: each relation names the op of the row made wrong"
else
  say "planted: relations that do not name the row made wrong:$missed"
fi
