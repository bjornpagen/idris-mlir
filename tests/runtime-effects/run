#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Every op's declaration of its effects states what its runtime function
# does, held against a reading of the function that is not the
# declaration's: LLVM's own, of the runtime's bitcode as every program's
# module takes it in, after opt has inferred each function's attributes
# from its body. The runner holds the specification's declarations to the
# module opt prints (runtests --runtime-effects, RuntimeEffects.idr): what
# each function proves of memory and of returning, the endings its calls
# reach and the operands it writes through, naming each op that breaks a
# relation, and each relation shown to catch what it forbids on copies of
# the tables with one row made wrong.
step_limit=300
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# The runtime's bitcode, in the file beside the prepared object, as on every
# target.
runtime=$("$idris_mlir" --print-runtime) || {
  say "runtime: idris-mlir names no prepared runtime"
  exit 0
}
if [ ! -f "${runtime%.o}.bc" ]; then
  say "runtime bitcode: not beside the prepared object"
  exit 0
fi
cp "${runtime%.o}.bc" "$work/runtime.bc"
if ! bounded "$llvm_bin/opt" -passes='inferattrs,cgscc(function-attrs),rpo-function-attrs' -S \
    "$work/runtime.bc" -o "$work/runtime.ll" 2> "$work/opt.err"; then
  say "runtime bitcode: opt does not read it"
  show "$work/opt.err"
  exit 0
fi
say "runtime bitcode: read"
bounded "$runtests" --runtime-effects "$work/runtime.ll"
