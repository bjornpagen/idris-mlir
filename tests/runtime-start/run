#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The runtime's entry, idris_rt_start: the program runs on a reserved stack
# far deeper than the process's own; main's value is the exit status from 0
# to 255, and any other is a crash that names it; a processor without what
# the program needs is refused before the program runs, and named.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
runtime=$dev_prefix/runtime/libidris_rt.a
if ! runtime_c link_program -O1 "$here/start.c" "$runtime" -o "$work/start" \
    > "$work/cc.log" 2>&1; then
  say "start: does not build"
  show "$work/cc.log"
  exit 0
fi
# start MODE: the program in MODE on an 8 MiB process stack; its status,
# stdout and stderr.
start() {
  ( ulimit -s 8192 && bounded "$work/start" "$1" ) > "$work/out" 2> "$work/err"
  say "$1: exit $?"
  sed 's/^/  stdout | /' "$work/out"
  sed 's/^/  stderr | /' "$work/err"
}
# A million frames, which the process's 8 MiB stack would not hold.
start million
# main's value at the edges of an exit status and of the words a status
# could be cut to: 2^32 and 2^32 + 255 are 0 and 255 in 32 bits.
start 0
start 255
start 256
start -1
start 4294967296
start 4294967551
start -9223372036854775808
start cpu
start cpu-two
