#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The runtime's entry, idris_rt_start, taking the program's one record: the
# program runs on the stack it states, far deeper than the process's own;
# each ending has its status and its message, `<program>: fatal: ...`, the
# program's name as the driver built it, after what the program wrote: an
# exit its byte, a crash at a site 1, out of memory 111; a processor
# without what the program needs cannot run it, 126, refused before the
# program runs, and named.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
runtime=$dev_prefix/runtime/libidris_rt.a
if ! runtime_c link_program -O1 "$here/start.c" "$runtime" -o "$work/start" \
    > "$work/cc.log" 2>&1; then
  say "start: does not build"
  show "$work/cc.log"
  exit 0
fi
# start MODE: the program in MODE on a 256 KiB process stack; its status,
# stdout and stderr.
start() {
  ( ulimit -s 256 && bounded "$work/start" "$1" ) > "$work/out" 2> "$work/err"
  say "$1: exit $?"
  sed 's/^/  stdout | /' "$work/out"
  sed 's/^/  stderr | /' "$work/err"
}
# A million frames, which the process's 256 KiB stack would not hold.
start million
start exit-0
start exit-255
start crash
start said
start memory
start cpu
start cpu-two
