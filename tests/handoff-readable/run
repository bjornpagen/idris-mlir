#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The module the frontend emits is meant to be read, as the dumps are: a
# symbol is the Idris name of what it defines, never a code-point escape
# (`$<digits>$`) nor a name Idris made up for a block (`case block in`,
# `with block in`, `{arg:`); a case or with block of a definition is named
# after it, `<parent>.case<k>` or `<parent>.with<k>`; the program is one
# idr.program, at the stage before defunctionalization, which names its
# root; and nothing of the func dialect is there before lowering. The
# module is bytecode, so it is read through idris-mlir-opt's print of it,
# which parses and verifies.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
cat > "$work/Main.idr" <<'IDRIS'
module Main

import Prelude

data Shape = Circle Int | Rect Int Int

area : Shape -> Int
area (Circle r) = 3 * r * r
area (Rect w h) = w * h

classify : Int -> String
classify n = case compare n 10 of
  LT => "small"
  EQ => "ten"
  GT => "large"

sign : Int -> String
sign n with (n < 0)
  sign n | True = "negative"
  sign n | False = "not negative"

main : IO ()
main = do
  traverse_ (\s => putStrLn (classify (area s))) [Circle 2, Rect 3 4]
  putStrLn (sign (area (Rect 2 (-1))))
  printLn (area (Circle 1))
IDRIS
compile_program "$work/Main.idr" Main
say "compile: exit $compiled"
if [ "$compiled" -ne 0 ]; then
  show "$work/compile.out" "$work/compile.err"
  exit 0
fi
# The emitted module as idris-mlir-opt prints it, its aliases and its
# dialects' syntax kept, which is what every check below reads.
if ! bounded "$idris_mlir_opt" --mlir-disable-threading "$(artifact_file "$work" Main module)" \
     -o "$work/emitted.mlir" > "$work/print.err" 2>&1; then
  say "print: the emitted module does not parse and verify"
  show "$work/print.err"
  exit 0
fi
emitted=$work/emitted.mlir

# Every symbol the module names, defined or used, one per line as written:
# `@` and a bare identifier, or `@` and a quoted name.
grep -oE '@("([^"\\]|\\.)*"|[A-Za-z0-9_$.]+)' "$emitted" | sort -u > "$work/symbols"
grep -E '\$[0-9]+\$' "$work/symbols" > "$work/escaped"
grep -F -e '{arg:' -e 'case block' -e 'with block' "$work/symbols" > "$work/made-up"
if [ -s "$work/escaped" ] || [ -s "$work/made-up" ]; then
  say "symbols: some are escaped or made up by Idris"
  show "$work/escaped" "$work/made-up"
else
  say "symbols: no code-point escape, and no name Idris made up for a block"
fi
if grep -qE '^@"?Main\.classify\.case[0-9]+' "$work/symbols" &&
   grep -qE '^@"?Main\.sign\.with[0-9]+' "$work/symbols"; then
  say "symbols: a case block is <parent>.case<k>, a with block <parent>.with<k>"
else
  say "symbols: no Main.classify.case<k> or no Main.sign.with<k>"
  grep -E 'classify|sign' "$work/symbols" | show
fi

if [ "$(grep -cE '^ *idr\.program @("([^"\\]|\\.)*"|[A-Za-z0-9_$.]+) root\(@("([^"\\]|\\.)*"|[A-Za-z0-9_$.]+)\) stage\(higher\) \{$' "$emitted")" = 1 ] &&
   [ "$(grep -cE '^ *idr\.program ' "$emitted")" = 1 ]; then
  say "program: one idr.program, at stage higher, which names its root"
else
  say "program: not one idr.program at stage higher naming its root"
  grep -nE 'idr\.program' "$emitted" | cut -c 1-200 | show
fi

if grep -qE '(^|[^A-Za-z0-9_.])func\.(func|call|return)([^A-Za-z0-9_]|$)' "$emitted"; then
  say "ops: the func dialect before lowering"
  grep -nE '(^|[^A-Za-z0-9_.])func\.(func|call|return)([^A-Za-z0-9_]|$)' "$emitted" | show
else
  say "ops: no func.func, func.call or func.return"
fi
