#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Two rules of the driver (foreign/idr/lib/Driver), each a token of its
# code: the command line is declared in one unit, Options.cpp, which parses
# it once and hands it down, so no cl::opt or cl::list is declared in any
# other unit of the driver; and the compiler registers what it uses, never
# MLIR's registerAll* (idris-mlir-opt and idris-mlir-reduce, which are
# tools over every dialect, do). Each rule's matcher runs on the driver and
# on a planted unit that breaks it, which it must find. Searched with
# comments left in, as each rule is a fact of the code, not of its prose.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# declared DRIVER: each option declared outside DRIVER/Options.cpp.
declared() {
  grep -rnE 'cl::(opt|list)<' "$1" | grep -v '/Options\.cpp:'
}

# registered DRIVER: each use of MLIR's registerAll*.
registered() {
  grep -rn 'registerAll' "$1"
}

# rule NAME TEXT MATCHER: TEXT when MATCHER finds nothing in the driver and
# finds the planted unit, else what it found or that it is blind.
rule() {
  "$3" "$root/foreign/idr/lib/Driver" > "$work/hits"
  "$3" "$work/planted" > "$work/planted-hits"
  if [ -s "$work/hits" ]; then
    say "$1: found where it must not be:"
    show "$work/hits"
  elif [ ! -s "$work/planted-hits" ]; then
    say "$1: the planted unit is not found"
  else
    say "$1: $2"
  fi
}

mkdir -p "$work/planted"
cat > "$work/planted/Planted.cpp" << 'EOF'
llvm::cl::opt<bool> planted("planted");
void planted(mlir::DialectRegistry &registry) { mlir::registerAllDialects(registry); }
EOF
rule "option declarations" "in Options.cpp alone" declared
rule "registration" "what the compiler uses, no registerAll" registered
