#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Two rules of the driver (foreign/idr/lib/Driver), each a token of its
# code: the command line is declared in one unit, Options.cpp, which parses
# it once and hands it down, so no cl::opt or cl::list is declared in any
# other unit of the driver; and the compiler registers what it uses, never
# MLIR's registerAll* (idris-mlir-opt and idris-mlir-reduce, which are
# tools over every dialect, do). Searched with comments left in, as each
# rule is a fact of the code, not of its prose. The rule is `driver_shape
# ROOT`, run on the repository and on the planted trees (lib/planted.sh):
# witness/ declares an option outside Options.cpp, of each kind, and calls
# registerAll*; near-miss/ declares its options in Options.cpp and reads
# them, and registers each dialect it uses by name, outside the driver too.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# driver_shape ROOT: the findings in ROOT's driver, `path:line: what`.
driver_shape() (
  cd "$1" || exit 1
  driver=foreign/idr/lib/Driver
  [ -d "$driver" ] || exit 0
  grep -rnE 'cl::(opt|list)<' "$driver" | grep -v "^$driver/Options\.cpp:" |
    sed 's/^\([^:]*:[0-9]*\):.*/\1: an option declared outside Options.cpp/'
  grep -rn 'registerAll' "$driver" | sed 's/^\([^:]*:[0-9]*\):.*/\1: MLIR'"'"'s registerAll/'
)

(cd "$root" && find foreign/idr/lib/Driver -name '*.cpp' | grep -q Options.cpp) ||
  say "driver: no Options.cpp"
driver_shape "$root" > "$work/found"
if grep -q 'outside Options.cpp' "$work/found"; then
  say "option declarations: found where they must not be:"
  grep 'outside Options.cpp' "$work/found" | sed 's/^/  /'
else
  say "option declarations: in Options.cpp alone"
fi
if grep -q 'registerAll' "$work/found"; then
  say "registration: registerAll found:"
  grep 'registerAll' "$work/found" | sed 's/^/  /'
else
  say "registration: what the compiler uses, no registerAll"
fi
planted driver_shape
