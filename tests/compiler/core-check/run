#!/bin/sh
# CORE-CHECK-1: ../CoreCheck.idr runs Core.Check on invalid Core. Stock
# Idris builds it against the compiler's own sources.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
ln -s "$root/compiler/src/IdrisMLIR" "$work/IdrisMLIR"
cp ../CoreCheck.idr "$work/"
(cd "$work" && $bounded "$idris2" --no-banner --no-color -p contrib -o corecheck CoreCheck.idr) \
  > "$work/build.log" 2>&1
status=$?
say "build: exit $status"
if [ "$status" -ne 0 ]; then
  show "$work/build.log"
  exit 0
fi
run_program corecheck "$work/build/exec/corecheck" /dev/null
say "run: exit $ran"
[ "$ran" -eq 0 ] || show "$work/corecheck.out" "$work/corecheck.err"
