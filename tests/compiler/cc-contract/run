#!/bin/sh
# rule: DRV-CC-1, DRV-CC-2, DIAG-ICE-1, IDR-IN-1, PROF-TYPE-4
# idris-mlir-cc's exit statuses (DRV-CC-2, docs/cutover.md 6.6): an op of a
# dialect outside the contract does not parse (IDR-IN-1: the parse-time
# registry holds only builtin, idr, func, arith, math and ub), an internal
# error, exit 1; a profile rejection is a user error, exit 3, with
# `unsupported (<RULE>)`, with and without --check; a usage error exits 2.
# A failed compilation leaves the output file, which exists, untouched.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cat > "$work/foreign.mlir" <<'MLIR'
module attributes {idr.program} {
  func.func @main() -> i64 {
    %0 = llvm.mlir.constant(1 : i64) : i64
    func.return %0 : i64
  }
}
MLIR
printf 'old' > "$work/foreign.o"
$bounded "$idris_mlir_cc" "$work/foreign.mlir" -o "$work/foreign.o" > "$work/cc.log" 2>&1
say "an op outside the contract: exit $?"
if [ "$(cat "$work/foreign.o")" = old ]; then
  say "existing output: untouched"
else
  say "existing output: changed by a failed compilation"
fi

# `count` is not total (no idr.total), so its closed call is neither
# evaluated nor specialized, and the Integer it returns exists at runtime.
cat > "$work/big.mlir" <<'MLIR'
module attributes {idr.program} {
  func.func private @count(%n: i64 {idr.quantity = "w"}) -> !idr.big {
    %r = idr.match_lit %n : i64 -> (!idr.big) {
    case 0 {
      %z = idr.constant #idr.big<"0"> : !idr.big
      idr.yield %z : !idr.big
    }
    default {
      %one = arith.constant 1 : i64
      %m = arith.subi %n, %one : i64
      %b = func.call @count(%m) : (i64) -> !idr.big
      %c = idr.constant #idr.big<"1"> : !idr.big
      %s = idr.big.add %b, %c
      idr.yield %s : !idr.big
    }
    }
    func.return %r : !idr.big
  }
  func.func @main() -> i64 {
    %n = arith.constant 5 : i64
    %b = func.call @count(%n) : (i64) -> !idr.big
    %x = idr.big.to_int %b : i64
    func.return %x : i64
  }
}
MLIR
printf 'old' > "$work/big.o"
$bounded "$idris_mlir_cc" "$work/big.mlir" -o "$work/big.o" > "$work/big.log" 2>&1
say "a profile rejection: exit $?"
if grep -qF 'unsupported (PROF-TYPE-4)' "$work/big.log"; then
  say "a profile rejection: unsupported (PROF-TYPE-4)"
else
  say "a profile rejection: no unsupported (PROF-TYPE-4)"
  show "$work/big.log"
fi
if [ "$(cat "$work/big.o")" = old ]; then
  say "existing output: untouched"
else
  say "existing output: changed by a failed compilation"
fi
$bounded "$idris_mlir_cc" "$work/big.mlir" --check > "$work/check.log" 2>&1
say "a profile rejection with --check: exit $?"

$bounded "$idris_mlir_cc" > "$work/usage.log" 2>&1
say "no arguments: exit $?"
