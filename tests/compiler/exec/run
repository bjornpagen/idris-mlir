#!/bin/sh
# --exec is rejected: the mlir backend writes programs, it does not run them.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cat > "$work/Main.idr" <<'IDRIS'
module Main

import Prelude

main : IO ()
main = putStrLn "x"
IDRIS
(cd "$work" && bounded "$idris_mlir" --no-banner --no-color --no-prelude --cg mlir --exec main Main.idr) \
  > "$work/exec.log" 2>&1
if grep -qF 'unsupported (FE-ENTRY-5)' "$work/exec.log"; then
  say "--exec: unsupported (FE-ENTRY-5)"
else
  say "--exec: not rejected with FE-ENTRY-5"
  show "$work/exec.log"
fi
