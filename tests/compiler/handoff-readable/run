#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The module the frontend emits is meant to be read, as the dumps are: a
# symbol is the Idris name of what it defines, never a code-point escape
# (`$<digits>$`) nor a name Idris made up for a block (`case block in`,
# `with block in`, `{arg:`); a case or with block of a definition is named
# after it, `<parent>.case<k>` or `<parent>.with<k>`; nothing Idris erased
# is written (no `!idr.erased`, no `#idr.erased`); the program is one
# idr.program, at the stage before defunctionalization, which names its
# root; the functions are idr.func, their calls and returns idr.call and
# idr.return, and nothing of
# the func dialect is there before lowering; every idr.func, and every data
# type, whose body is its declaration, names the Idris instance it is
# (`instance`); and every op and block argument carries the location of
# the Idris code it came from, never an unknown one. The module is
# bytecode, so it is read through idris-mlir-opt's print of it.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cat > "$work/Main.idr" <<'IDRIS'
module Main

import Prelude

data Shape = Circle Int | Rect Int Int

area : Shape -> Int
area (Circle r) = 3 * r * r
area (Rect w h) = w * h

classify : Int -> String
classify n = case compare n 10 of
  LT => "small"
  EQ => "ten"
  GT => "large"

sign : Int -> String
sign n with (n < 0)
  sign n | True = "negative"
  sign n | False = "not negative"

main : IO ()
main = do
  traverse_ (\s => putStrLn (classify (area s))) [Circle 2, Rect 3 4]
  putStrLn (sign (area (Rect 2 (-1))))
  printLn (area (Circle 1))
IDRIS
compile_program "$work/Main.idr" Main
say "compile: exit $compiled"
if [ "$compiled" -ne 0 ]; then
  show "$work/compile.out" "$work/compile.err"
  exit 0
fi
# The emitted module as idris-mlir-opt prints it, its aliases and its
# dialects' syntax kept, which is what every check below but the last
# reads.
if ! bounded "$idris_mlir_opt" --mlir-disable-threading "$(artifact_file "$work" Main module)" \
     -o "$work/emitted.mlir" > "$work/print.err" 2>&1; then
  say "print: the emitted module does not parse and verify"
  show "$work/print.err"
  exit 0
fi
emitted=$work/emitted.mlir

# Every symbol the module names, defined or used, one per line as written:
# `@` and a bare identifier, or `@` and a quoted name.
grep -oE '@("([^"\\]|\\.)*"|[A-Za-z0-9_$.]+)' "$emitted" | sort -u > "$work/symbols"
grep -E '\$[0-9]+\$' "$work/symbols" > "$work/escaped"
grep -F -e '{arg:' -e 'case block' -e 'with block' "$work/symbols" > "$work/made-up"
if [ -s "$work/escaped" ] || [ -s "$work/made-up" ]; then
  say "symbols: some are escaped or made up by Idris"
  show "$work/escaped" "$work/made-up"
else
  say "symbols: no code-point escape, and no name Idris made up for a block"
fi
if grep -qE '^@"?Main\.classify\.case[0-9]+' "$work/symbols" &&
   grep -qE '^@"?Main\.sign\.with[0-9]+' "$work/symbols"; then
  say "symbols: a case block is <parent>.case<k>, a with block <parent>.with<k>"
else
  say "symbols: no Main.classify.case<k> or no Main.sign.with<k>"
  grep -E 'classify|sign' "$work/symbols" | show
fi

if grep -qF -e '!idr.erased' -e '#idr.erased' "$emitted"; then
  say "erased: written"
  grep -nF -e '!idr.erased' -e '#idr.erased' "$emitted" | show
else
  say "erased: nothing"
fi

if [ "$(grep -cE '^ *idr\.program @("([^"\\]|\\.)*"|[A-Za-z0-9_$.]+) root\(@("([^"\\]|\\.)*"|[A-Za-z0-9_$.]+)\) stage\(higher\) \{$' "$emitted")" = 1 ] &&
   [ "$(grep -cE '^ *idr\.program ' "$emitted")" = 1 ]; then
  say "program: one idr.program, at stage higher, which names its root"
else
  say "program: not one idr.program at stage higher naming its root"
  grep -nE 'idr\.program' "$emitted" | cut -c 1-200 | show
fi

if grep -qE '(^|[^A-Za-z0-9_.])func\.(func|call|return)([^A-Za-z0-9_]|$)' "$emitted"; then
  say "ops: the func dialect before lowering"
  grep -nE '(^|[^A-Za-z0-9_.])func\.(func|call|return)([^A-Za-z0-9_]|$)' "$emitted" | show
else
  say "ops: no func.func, func.call or func.return"
fi

# The rest reads the module back, every op in the generic form and every
# location in place.
if ! bounded "$idris_mlir_opt" --mlir-disable-threading --mlir-print-op-generic \
     --mlir-print-debuginfo --mlir-print-local-scope "$(artifact_file "$work" Main module)" \
     -o "$work/generic.mlir" > "$work/parse.err" 2>&1; then
  say "parse: the emitted module does not parse and verify"
  show "$work/parse.err"
  exit 0
fi
say "parse: exit 0"

# Each idr.func whose instance is missing, by its first line: an op is its
# first line and, when it has regions, the line that closes them, the next
# one at its own indentation that starts with `})`, which holds the
# attributes printed after the regions.
awk '
  open == "" && /"idr\.func"\(/ {
    match($0, /^ */); indent = RLENGTH; head = $0
    if ($0 ~ /\(\{$/) { open = head; next }
    if (head !~ /instance = #idr\.instance</) print head
    next
  }
  open != "" {
    match($0, /^ */)
    if (RLENGTH == indent && substr($0, indent + 1, 2) == "})") {
      if ((open $0) !~ /instance = #idr\.instance</) print open
      open = ""
    }
  }' "$work/generic.mlir" > "$work/no-instance"
# Each data type whose body names no instance: a type's body is printed
# once, where its alias is defined at the head of the module.
grep -E '^![^ ]+ = !idr\.data<' "$emitted" | grep -v 'instance' >> "$work/no-instance"
if [ -s "$work/no-instance" ]; then
  say "instances: some idr.func or data type carries none"
  cut -c 1-200 "$work/no-instance" | show
else
  say "instances: every idr.func and data type names its own"
fi
# The forms the module no longer has: a closure or a suspension as a region
# (each is a function, named by idr.closure or idr.suspend), a data type
# declared by an op (its type's body declares it), and a discardable
# attribute (a fact is a type or an op's own property; the program is the
# op "idr.program", never a mark).
grep -nE '"idr\.lambda"|"idr\.delay"\([^)]*\) \(\{|"idr\.(data|ctor)"|(^|[^"])idr\.(program|stack)' \
  "$work/generic.mlir" | cut -c 1-200 > "$work/old-forms"
if [ -s "$work/old-forms" ]; then
  say "forms: a region closure or suspension, a data op or a discardable attribute"
  show "$work/old-forms"
else
  say "forms: no region closure or suspension, no data op, no discardable attribute"
fi
if grep -qF 'loc(unknown)' "$work/generic.mlir"; then
  say "locations: some op or block argument carries none of its own"
  grep -F 'loc(unknown)' "$work/generic.mlir" | cut -c 1-200 | show
else
  say "locations: every op and block argument carries its own"
fi
