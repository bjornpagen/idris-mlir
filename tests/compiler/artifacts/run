#!/bin/sh
# Artifacts exist after success, and are removed when the same module later
# fails.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"

# listed: the artifacts of Main under build/exec, on one line.
listed() {
  find "$work/build/exec" -type f \( -name Main.core -o -name Main.mlir -o -name Main.o -o -name Main \) 2> /dev/null |
    sed "s|^$work/||" | sort | tr '\n' ' ' | sed 's/ $//'
}

cat > "$work/Main.idr" <<'IDRIS'
module Main

import Prelude

main : IO ()
main = printLn (the Int 7)
IDRIS
compile_program "$work/Main.idr" "$work/build/exec/Main"
say "compile: exit $compiled"
[ "$compiled" -eq 0 ] || show "$work/compile.out" "$work/compile.err"
say "artifacts: $(listed)"

cat > "$work/Main.idr" <<'IDRIS'
module Main

import Prelude

f : Double -> Int
f 0.5 = 1
f _ = 0

main : IO ()
main = printLn (f 0.5)
IDRIS
compile_program "$work/Main.idr" "$work/build/exec/Main"
say "compile an unsupported change: exit $compiled"
left=$(listed)
if [ -z "$left" ]; then
  say "artifacts after the failure: none"
else
  say "stale artifacts after the failure: $left"
fi
