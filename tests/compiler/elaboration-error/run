#!/bin/sh
# A program Idris's type checker rejects: -o stops at Idris's error, with
# status 1, and the backend neither runs nor adds an error of its own.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cat > "$work/Main.idr" <<'IDRIS'
module Main

import Prelude

lz : List (Int, Int)
lz = zip' [1, 2] [3, 4]

main : IO ()
main = printLn lz
IDRIS
(cd "$work" && bounded "$idris_mlir" --no-banner --no-color --cg mlir -o prog Main.idr) \
  > "$work/compile.log" 2>&1
say "compile: exit $?"
if grep -qF "Undefined name zip'" "$work/compile.log"; then
  say "Idris's error: reported"
else
  say "Idris's error: not reported"
  show "$work/compile.log"
fi
if grep -qF 'mlir backend' "$work/compile.log"; then
  say "backend: ran"
  show "$work/compile.log"
else
  say "backend: did not run"
fi
if [ -e "$work/build/exec/prog" ] || [ -e "$work/build/exec/prog.mlir" ]; then
  say "artifacts: written"
else
  say "artifacts: none"
fi
