#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# A program Idris's type checker rejects: idris-mlir stops at Idris's error,
# with status 3, the program's, and the pipeline neither runs nor adds an
# error of its own.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cat > "$work/Main.idr" <<'IDRIS'
module Main

import Prelude

lz : List (Int, Int)
lz = zip' [1, 2] [3, 4]

main : IO ()
main = printLn lz
IDRIS
(cd "$work" && bounded "$idris_mlir" Main.idr -o build/exec/prog) \
  > "$work/compile.log" 2>&1
say "compile: exit $?"
if grep -qF "Undefined name zip'" "$work/compile.log"; then
  say "Idris's error: reported"
else
  say "Idris's error: not reported"
  show "$work/compile.log"
fi
if [ -n "$(artifact_file "$work" prog module)" ] || grep -qF 'unsupported (' "$work/compile.log"; then
  say "pipeline: ran"
  show "$work/compile.log"
else
  say "pipeline: did not run"
fi
written=
for kind in $artifact_kinds; do
  [ -z "$(artifact_file "$work" prog "$kind")" ] || written=yes
done
if [ -n "$written" ]; then
  say "artifacts: written"
else
  say "artifacts: none"
fi
