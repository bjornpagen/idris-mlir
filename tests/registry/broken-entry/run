#!/bin/sh
# The registry validates every entry against the loaded context before
# anything uses it. Each case is a program whose own module, named as the
# module an entry resolves to, is the pinned module with that entry's
# definition at another shape: the compilation must then fail with a shape
# mismatch, showing the entry, the shape expected and the shape found, and
# leave no artifact. An entry keyed by a definition and one keyed by a
# %foreign spec are broken in turn; unbroken, the program compiles.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"

registry_shadowed Builtin.replace definition third_party/Idris2/libs/prelude/Builtin.idr \
  Builtin.idr replace shape 'module Main

import Builtin

main : Unit
main = MkUnit'
registry_shadowed C:idris2_putStr spec third_party/Idris2/libs/prelude/Prelude/IO.idr \
  Prelude/IO.idr prim__putStr shape 'module Main

import Prelude.IO

main : IO ()
main = putStr "hello"'

mkdir "$work/unbroken"
copy_fixture . "$work/unbroken"
compile_program "$work/unbroken/Main.idr" prog
say "unbroken: exit $compiled"
[ "$compiled" -eq 0 ] || show "$work/compile.out" "$work/compile.err"
