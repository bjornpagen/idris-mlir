#!/bin/sh
# Base's surface is in the registry, each kind of its entries validated
# against the module that defines it whenever a program loads that module:
# a runtime primitive by its C spec (a file's open, a directory's entry,
# an environment variable, an error number), a clock by its Chez spec,
# which is the one a clock declares, a pointer operation by its spec or as
# the identity on its handle, the exit by name, and a definition outside
# the language by name (a signal, a thread, a process). The test hook
# `--directive break-shape=<key>` breaks one entry's shape at a time; the
# compilation must then fail with a shape mismatch that shows the entry,
# the shape expected and the shape found, and leave no artifact. Unbroken,
# the program compiles.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"

broken() {
  mkdir "$work/$2"
  copy_fixture . "$work/$2"
  compile_program --directive "break-shape=$1" "$work/$2/Main.idr" prog
  say "$1 broken: exit $compiled"
  if grep -qF "unsupported (hook): the registry's entry $1 (" "$work/compile.out" "$work/compile.err" &&
     grep -q "expects .* : (_ : %World) -> .*, but found " "$work/compile.out" "$work/compile.err"; then
    say "$1 broken: the error shows the entry, the shape expected and the shape found"
  else
    say "$1 broken: no hook error for the entry"
    show "$work/compile.out" "$work/compile.err"
  fi
  no_artifacts "$work/$2"
}

broken C:idris2_openFile file
broken C:idris2_nextDirEntry directory
broken C:getenv environment
broken C:idris2_getErrno errno
broken scheme:blodwen-clock-time-monotonic clock
broken C:idris2_getString string
broken PrimIO.prim__castPtr cast
broken System.exitWith exit
broken System.Signal.collectSignal signal
broken System.Concurrency.makeMutex threads
broken System.system process

mkdir "$work/unbroken"
copy_fixture . "$work/unbroken"
compile_program "$work/unbroken/Main.idr" prog
say "unbroken: exit $compiled"
[ "$compiled" -eq 0 ] || show "$work/compile.out" "$work/compile.err"
