#!/bin/sh
# rule: HOOK-SHAPE-1
# The registry validates every entry against the loaded context before
# anything uses it (docs/architecture/17-registry.md). The test hook
# `--directive break-shape=<key>` gives one entry a shape no definition has;
# the compilation must then fail with HOOK-SHAPE-1, showing the entry, the
# shape expected and the shape found, and leave no artifact. An entry keyed
# by a definition and one keyed by a %foreign spec are broken in turn;
# unbroken, the program compiles.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"

broken() {
  mkdir "$work/$2"
  copy_fixture . "$work/$2"
  compile_program --io --directive "break-shape=$1" "$work/$2/Main.idr" prog
  say "$1 broken: exit $compiled"
  if grep -qF "unsupported (HOOK-SHAPE-1): the registry's entry $1 (" "$work/compile.out" "$work/compile.err" &&
     grep -q "expects .* : (_ : %World) -> .*, but found " "$work/compile.out" "$work/compile.err"; then
    say "$1 broken: HOOK-SHAPE-1 shows the entry, the shape expected and the shape found"
  else
    say "$1 broken: no HOOK-SHAPE-1 for the entry"
    show "$work/compile.out" "$work/compile.err"
  fi
  no_artifacts "$work/$2"
}

broken Builtin.replace definition
broken C:idris2_putStr spec

mkdir "$work/unbroken"
copy_fixture . "$work/unbroken"
compile_program --io "$work/unbroken/Main.idr" prog
say "unbroken: exit $compiled"
[ "$compiled" -eq 0 ] || show "$work/compile.out" "$work/compile.err"
