#!/bin/sh
# The entries of the string iterator's primitives, which the in-house
# library declares %extern, are validated like base's once a program loads
# their module: each broken in turn by `--break-shape=<key>`
# stops the compilation with a shape mismatch that shows the entry, the
# shape expected and the shape found, and leaves no artifact; unbroken,
# the program compiles.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"

broken() {
  mkdir "$work/$2"
  copy_fixture . "$work/$2"
  compile_program -p mlir-linear --break-shape="$1" "$work/$2/Main.idr" prog
  say "$1 broken: exit $compiled"
  if grep -qF "unsupported (hook): the registry's entry $1 (" "$work/compile.out" "$work/compile.err" &&
     grep -q "expects .* : (_ : %World) -> .*, but found " "$work/compile.out" "$work/compile.err"; then
    say "$1 broken: the error shows the entry, the shape expected and the shape found"
  else
    say "$1 broken: no hook error for the entry"
    show "$work/compile.out" "$work/compile.err"
  fi
  no_artifacts "$work/$2"
}

broken Linear.String.Iterator.prim__scalarAt scalar-at
broken Linear.String.Iterator.prim__scalarEnd scalar-end
broken Linear.String.Iterator.prim__dropBytes drop-bytes

mkdir "$work/unbroken"
copy_fixture . "$work/unbroken"
compile_program -p mlir-linear "$work/unbroken/Main.idr" prog
say "unbroken: exit $compiled"
[ "$compiled" -eq 0 ] || show "$work/compile.out" "$work/compile.err"
