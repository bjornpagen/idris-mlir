#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The entries of the string iterator's primitives, which the in-house
# library declares %extern, are validated like base's once a program loads
# their module: each case is a program whose own Linear.String.Iterator is
# the library's with one primitive at another shape, which stops the
# compilation with a shape mismatch that shows the entry, the shape
# expected and the shape found, and leaves no artifact; unbroken, the
# program compiles.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"

main='module Main

import Prelude
import Linear.String.Iterator

main : IO ()
main = putStrLn (show (Iterator.foldl (\n, _ => n + 1) (the Int 0) "héllo"))'
for case in prim__scalarAt:scalar-at prim__scalarEnd:scalar-end prim__dropBytes:drop-bytes; do
  registry_shadowed "Linear.String.Iterator.${case%%:*}" "${case#*:}" \
    libs/mlir-linear/Linear/String/Iterator.idr Linear/String/Iterator.idr "${case%%:*}" shape \
    "$main" -p mlir-linear
done

mkdir "$work/unbroken"
copy_fixture . "$work/unbroken"
compile_program -p mlir-linear "$work/unbroken/Main.idr" prog
say "unbroken: exit $compiled"
[ "$compiled" -eq 0 ] || show "$work/compile.out" "$work/compile.err"
