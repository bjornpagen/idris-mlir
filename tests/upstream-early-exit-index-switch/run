#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/71-early-exit-index-switch: a case of scf.index_switch may end
# in a break, which lowers to a branch to its loop's exit, so the switch
# lowers with no scf op left.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
input=$root/upstream/71-early-exit-index-switch/index-switch.mlir
if bounded "$llvm_bin/mlir-opt" "$input" -convert-scf-to-cf -o "$work/cf.mlir" 2> "$work/err"; then
  if grep -q 'scf\.' "$work/cf.mlir"; then say "convert-scf-to-cf: scf ops are left"; else say "convert-scf-to-cf: the switch and its break lowered to blocks"; fi
else
  say "convert-scf-to-cf: fails"
  show "$work/err"
fi
