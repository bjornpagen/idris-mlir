# no import can carry.
foreign/idr/lib/Driver/NativeRuns.cppm: cpu_features.h
foreign/idr/lib/Lower/Entry.cppm: cpu_features.h
runtime/Platform/CpuBits.cppm: cpu_features.h
runtime/Start/Entry.cppm: cpu_features.h
