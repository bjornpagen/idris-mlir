#!/bin/sh
# All C++ (.cpp, .h, .hpp, .cc, .td, .inc) is under foreign/idr or, for the
# runtime, runtime/, with .cc its only source extension; src/ and unsafe/
# exist only once they hold code.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
(cd "$root" && find . \( -name third_party -o -name .toolchain -o -name build -o -name .git -o -name sources \) -prune \
   -o -type f \( -name '*.cpp' -o -name '*.h' -o -name '*.hpp' -o -name '*.cc' -o -name '*.td' -o -name '*.inc' \) \
   -print) | sed 's|^\./||' | sort > "$work/cpp"
if [ -s "$work/cpp" ]; then say "C++: found"; else say "C++: none found"; fi
if grep -q '^runtime/' "$work/cpp"; then say "C++: the runtime under runtime/"; else say "C++: no runtime under runtime/"; fi
if grep -v -e '^foreign/idr/' -e '^runtime/' "$work/cpp" > "$work/outside"; then
  say "C++ outside foreign/idr and runtime:"
  cat "$work/outside"
else
  say "C++: all under foreign/idr and runtime"
fi
if grep '\.cpp$' "$work/cpp" > "$work/retired"; then
  say "C++ sources named .cpp:"
  cat "$work/retired"
else
  say "C++ sources: .cc only"
fi
# src/ and unsafe/ exist only once they hold code.
empty=
for zone in src unsafe; do
  [ -e "$root/$zone" ] || continue
  if [ -f "$root/$zone/CMakeLists.txt" ] &&
     [ -n "$(find "$root/$zone" -type f -name '*.cc' | head -n 1)" ]; then
    :
  else
    say "$zone/: exists but holds no code"
    empty=yes
  fi
done
[ -n "$empty" ] || say "zones: none empty"
