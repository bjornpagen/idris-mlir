#!/bin/sh
# All C++ (.cpp, .h, .hpp, .cc, .cppm, .td, .inc) is under foreign/idr or,
# for the runtime, runtime/. foreign/idr is in MLIR's layout: its sources
# are .cpp under lib and tools, its headers under include; the runtime's
# are .cpp and .h, so a C++20 module interface (.cppm) is in no area. A hidden directory is a tool's (the editor's, the agent's
# worktrees), never a source zone, so none is searched; nor is upstream/,
# whose C++ is a reproducer of a bug in upstream tools, built by its check
# and never by the build.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
(cd "$root" && find . \( -name third_party -o -name build -o -name sources -o -name upstream -o -name '.?*' \) -prune \
   -o -type f \( -name '*.cpp' -o -name '*.h' -o -name '*.hpp' -o -name '*.cc' -o -name '*.cppm' -o -name '*.td' -o -name '*.inc' \) \
   -print) | sed 's|^\./||' | sort > "$work/cpp"
if [ -s "$work/cpp" ]; then say "C++: found"; else say "C++: none found"; fi
if grep -q '^runtime/' "$work/cpp"; then say "C++: the runtime under runtime/"; else say "C++: no runtime under runtime/"; fi
if grep -v -e '^foreign/idr/' -e '^runtime/' "$work/cpp" > "$work/outside"; then
  say "C++ outside foreign/idr and runtime:"
  cat "$work/outside"
else
  say "C++: all under foreign/idr and runtime"
fi
# Each extension where its area keeps it.
grep -E '^foreign/idr/' "$work/cpp" | grep -vE \
  -e '^foreign/idr/lib/.*\.(cpp|td)$' \
  -e '^foreign/idr/include/.*\.(h|td)$' \
  -e '^foreign/idr/tools/[^/]*\.cpp$' > "$work/misplaced"
grep -E '^runtime/' "$work/cpp" | grep -vE '^runtime/.*\.(cpp|h)$' >> "$work/misplaced"
if [ -s "$work/misplaced" ]; then
  say "C++ sources outside their area's extension:"
  cat "$work/misplaced"
else
  say "C++ sources: .cpp and .h in foreign/idr's layout and the runtime"
fi
