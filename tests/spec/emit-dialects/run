#!/bin/sh
# Emit writes ops of the contract's dialects only, each through the builder
# generated from the op's ODS (IdrisMLIR.Dialect.*, tools/dialects.sh):
# idris-mlir-cc parses with a registry of exactly idr, func, arith, math,
# ub, memref and builtin. So
#   - each generated module builds ops of one dialect of the contract, and
#     the contract's dialects each have one;
#   - no other module builds an op (`MkOp`), other than MLIR.idr, which
#     defines and prints it;
#   - no string literal of Emit.idr, Emit/*.idr, MLIR.idr or
#     CustomSyntax.idr spells an op name, `<dialect>.<op>`, or a prefix
#     `<dialect>.` or suffix `.<op>` that code completes into one.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cd "$root" || exit 1
contract='idr func arith math ub memref builtin'
src=compiler/src/IdrisMLIR

: > "$work/built"
for file in "$src"/Dialect/*.idr; do
  module=${file##*/}
  idris_lex code "$file" | grep -q 'MkOp' || { say "IdrisMLIR.Dialect.${module%.idr}: builds no op"; continue; }
  # The op names are the literals that follow MkOp; the lexer blanks them
  # in code, so they are read from the source.
  dialects=$(grep -o 'MkOp "[a-z_]*\.' "$file" | sed 's/^MkOp "//; s/\.$//' | sort -u | tr '\n' ' ')
  case $dialects in
    *' '?*) say "IdrisMLIR.Dialect.${module%.idr}: builds ops of several dialects: $dialects" ;;
    *)
      dialect=${dialects% }
      case " $contract " in
        *" $dialect "*) say "$dialect: built by IdrisMLIR.Dialect.${module%.idr}"
                        printf '%s\n' "$dialect" >> "$work/built" ;;
        *) say "IdrisMLIR.Dialect.${module%.idr}: builds ops of $dialect, outside the contract" ;;
      esac ;;
  esac
done
for dialect in $contract; do
  grep -qx "$dialect" "$work/built" || say "$dialect: built by no module"
done

: > "$work/builders"
find "$src" -path "$src/Dialect" -prune -o -name '*.idr' -print | sort | while IFS= read -r file; do
  [ "$file" = "$src/MLIR.idr" ] && continue
  idris_lex code "$file" | grep -E '(^|[^A-Za-z0-9_.])MkOp([^A-Za-z0-9_]|$)' |
    sed "s|^|$file:|" >> "$work/builders"
done
say "places that build an op by hand: $(wc -l < "$work/builders" | tr -d ' ')"
cat "$work/builders"

: > "$work/names"
for file in "$src"/Emit.idr "$src"/Emit/*.idr "$src"/MLIR.idr "$src"/CustomSyntax.idr; do
  idris_lex strings "$file" | awk -v file="$file" '
    {
      n = $0; sub(/:.*/, "", n); s = $0; sub(/^[0-9]*:/, "", s)
      if (s ~ /(^|[ (,={<])[a-z][a-z0-9_]*\.([a-z_]|$)/ || s ~ /^\.[a-z]/)
        printf "%s:%s: \"%s\"\n", file, n, s
    }' >> "$work/names"
done
say "op names spelled by hand: $(wc -l < "$work/names" | tr -d ' ')"
cat "$work/names"
