#!/bin/sh
# rule: TC-LAYOUT-1
# The repository's layout.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
for path in CMakeLists.txt CMakePresets.json PINS.md toolchain.lock.json Makefile \
            compiler/idris-mlir.ipkg foreign/idr/CMakeLists.txt src/CMakeLists.txt \
            unsafe/CMakeLists.txt tests/Main.idr tests/tests.ipkg tests/testutils.sh \
            tests/spec tests/toolchain tests/compiler tests/profile/v0 tests/profile/v1 \
            tests/idr tests/e2e/v0 tests/e2e/v1 tests/mlir docs/cpp-profile.md; do
  if [ -e "$root/$path" ]; then say "$path"; else say "$path: missing"; fi
done
