#!/bin/sh
# Every name the compiler makes is derived from content, the owner's name
# and a hash of the structural key, never from a counter or the order in
# which things were made: creation order must not reach output, and a name
# must not move when an unrelated definition changes. So no source of the
# compiler builds a name from the forms the counters made: a lambda's,
# a suspension's, a capture's, a specialization's or a raising's numbered
# suffix, a sum numbered by first appearance (its owner, the literal the
# content name is made under, followed by a count), a static datum numbered by
# one counter, or the frontend's repeat of a printed key. The forms are
# spelled in pieces so this test is not its own hit; the behaviour, one
# definition edited and every other symbol unchanged, is
# tests/determinism/name-stability's.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cd "$root" || exit 1
q='"'
suffixes="$q\\.(la""m|del""ay|cap""ture|sp""ec|ra""ise)$q"
sums="$q(f""n|la""zy)\\\$$q *\\+"
statics="${q}__id""r_(msg|caf|box|str|big)_$q"
repeat="\\+\\+ $q'$q \\+\\+ show"
find foreign/idr/lib -name '*.cpp' | LC_ALL=C sort > "$work/cpp"
find compiler/src -name '*.idr' ! -path '*/build/*' | LC_ALL=C sort > "$work/idris"
if [ -s "$work/cpp" ] && [ -s "$work/idris" ]; then
  say "sources: the dialect's and the frontend's searched"
else
  say "sources: none found"
fi
: > "$work/counted"
while IFS= read -r file; do
  grep -nE -e "$suffixes" -e "$sums" -e "$statics" "$file" | sed "s|^|$file:|" >> "$work/counted"
done < "$work/cpp"
while IFS= read -r file; do
  grep -nE "$repeat" "$file" | sed "s|^|$file:|" >> "$work/counted"
done < "$work/idris"
if [ -s "$work/counted" ]; then
  say "names made from a counter:"
  cat "$work/counted"
else
  say "names: none made from a counter"
fi
