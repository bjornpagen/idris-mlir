#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Profiling is LLVM's time trace alone: the profiler that was culled for
# it is named nowhere outside the proposals, the research library
# (sources/, whose reports are kept verbatim) and third_party, there is no
# profile build, and the one place the --time-trace option is defined is
# the profile's support library.
# The culled names are spelled in pieces so this test is not its own hit.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
culled='trac''y'
build='IDRIS_MLIR_''PROFILE'
(cd "$root" && git grep -il "$culled" -- . ':!third_party' ':!proposals' ':!sources') > "$work/mentions"
if [ -s "$work/mentions" ]; then
  say "the culled profiler is mentioned in:"
  cat "$work/mentions"
else
  say "the culled profiler: no mention outside proposals, sources and third_party"
fi
(cd "$root" && git grep -ln "$build" -- . ':!third_party' ':!proposals') > "$work/build"
if [ -s "$work/build" ]; then
  say "a profile build remains in:"
  cat "$work/build"
else
  say "no profile build: no profile option in the tree"
fi
if grep -q '"time-trace"' "$root/foreign/idr/lib/Support/Profile.cpp"; then
  say "--time-trace is Profile.cpp's option"
else
  say "--time-trace is not Profile.cpp's option"
fi
if grep -q -- '--time-trace=' "$root/tools/profile.sh"; then
  say "tools/profile.sh runs --time-trace"
else
  say "tools/profile.sh does not run --time-trace"
fi
