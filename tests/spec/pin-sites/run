#!/bin/sh
# Every PIN(<name>) site outside the docs names a `## <name>` entry in
# PINS.md or an upstream bug, upstream/<name>/ (what golden tests printed,
# their `output`, is not a site, nor is a patch carried for upstream).
# Hidden directories are not the repository's sources: .git, .toolchain,
# and the worktrees of work in progress under .claude.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
{
  sed -n 's/^## \([^[:space:]]\{1,\}\)$/\1/p' "$root/PINS.md"
  for bug in "$root"/upstream/*/; do basename "$bug"; done
} | sort -u > "$work/entries"
(cd "$root" && find . \( -name third_party -o -name build -o -name sources -o -name '.?*' \) -prune \
   -o -type f ! -name '*.md' ! -name '*.patch' ! -name output -exec grep -hoI 'PIN([A-Za-z0-9_-]\{1,\})' {} +) |
  sed 's/^PIN(\(.*\))$/\1/' | sort -u > "$work/sites"
if comm -23 "$work/sites" "$work/entries" > "$work/missing" && [ ! -s "$work/missing" ]; then
  say "every PIN site names a PINS.md entry or an upstream bug"
else
  say "PIN sites that name neither a PINS.md entry nor an upstream bug:"
  cat "$work/missing"
fi
