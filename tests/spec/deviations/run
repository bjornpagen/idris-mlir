#!/bin/sh
# rule: TC-DEV-1, TC-DEV-3, TC-DEV-4, TC-DEV-5
# The deviations from cpp-starter are pinned in PINS.md.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cmake=$root/CMakeLists.txt
if grep -q x86_64 "$cmake"; then say "CMakeLists.txt: the gate accepts x86_64"; else say "CMakeLists.txt: no x86_64"; fi
if grep -qF 'PIN(platform-gate-x86_64)' "$cmake"; then
  say "CMakeLists.txt: PIN(platform-gate-x86_64)"
else
  say "CMakeLists.txt: no PIN(platform-gate-x86_64)"
fi
# TC-DEV-3: the lint graph runs the clang-tidy of stage 2, the one LLVM.
if grep -qF '.toolchain/llvm-musl/bin/clang-tidy' "$root/CMakePresets.json"; then
  say "CMakePresets.json: lint with the stage-2 clang-tidy"
else
  say "CMakePresets.json: lint without the stage-2 clang-tidy"
fi
if sed 's/no-stdexec//g' "$cmake" | grep -q stdexec; then say "CMakeLists.txt: stdexec"; else say "CMakeLists.txt: no stdexec"; fi
for name in platform-gate-x86_64 no-stdexec llvm-cxx17-headers clang-libcxx clang-no-reflection \
            no-sanitizer-runtimes musl-thread-stacks stage2-thinlto; do
  if grep -qF "## $name" "$root/PINS.md"; then say "PINS.md: $name"; else say "PINS.md: no $name"; fi
done
