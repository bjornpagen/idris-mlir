#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The Idris side's modules of the dialects, their syntax and their ops
# (compiler/src/IdrisMLIR/Syntax/ and Dialect/), are what idris-mlir-tblgen
# writes from the dialects' ODS and its own source now: tools/dialects.sh
# check, which needs no build, finds each current. On a copy, it finds a
# module edited by hand, and every module stale once the generator changes.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
# make check runs where stage 2 is not built, and there the TableGen of the
# typecheck step reads the same records, so the fingerprints are the same.
mode=
[ -x "$llvm_bin/mlir-tblgen" ] || mode=typecheck
check() {
  bounded sh "$1/tools/dialects.sh" check $mode > "$work/out" 2>&1
  say "$2: exit $?"
  modules
}
# modules: what tools/dialects.sh check said of the modules, as one line:
# every one current, every one stale, or those that are not current when
# every other one is. What it said of no module (why it could not check)
# is shown as it is.
modules() {
  awk '
    !/^IdrisMLIR\./ { print "  | " $0; next }
    {
      n++; name = $0; sub(/:.*/, "", name)
      state = $0; sub(/^[^:]*: /, "", state); sub(/ \(.*\)$/, "", state)
      if (state == "current") current++
      else if (state == "stale") stale++
      else { others++; other = other (other == "" ? "" : ", ") name " " state }
    }
    END {
      if (n == 0) print "modules: none checked"
      else if (current == n) print "modules: every one current"
      else if (stale == n) print "modules: every one stale"
      else if (current + others == n) print "modules: " other ", every other one current"
      else print "modules: " current " current, " stale " stale, " others " other, of " n
    }' "$work/out"
}
check "$root" "the checked-in modules"

copy=$work/repo
mkdir -p "$copy/tools" "$copy/foreign/idr/tools" "$copy/compiler/src/IdrisMLIR"
cp "$root/tools/dialects.sh" "$root/tools/toolchain.sh" "$root/tools/host.sh" "$copy/tools/"
cp -R "$root/foreign/idr/include" "$copy/foreign/idr/"
cp "$root/foreign/idr/tools/idris-mlir-tblgen.cpp" "$copy/foreign/idr/tools/"
cp -R "$root/compiler/src/IdrisMLIR/Syntax" "$root/compiler/src/IdrisMLIR/Dialect" \
  "$copy/compiler/src/IdrisMLIR/"
export IDRIS_MLIR_TOOLCHAIN="$toolchain"
printf '%s\n' '-- a line no generator wrote' >> "$copy/compiler/src/IdrisMLIR/Dialect/UB.idr"
check "$copy" "a module edited by hand"
printf '%s\n' '// a change of the generator' >> "$copy/foreign/idr/tools/idris-mlir-tblgen.cpp"
check "$copy" "a changed generator"
