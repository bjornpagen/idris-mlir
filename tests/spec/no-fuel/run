#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The compiler's C++ and the runtime terminate by structure, never by a
# count: every loop iterates a finite range, a worklist whose finiteness
# its type states (`while (std::optional<T> x = work.pop())`), or its own
# input; and nothing correct or accepted depends on an iteration limit. A
# pass that only makes code better may stop at a budget, which is then a
# named size policy: a spent one leaves the program less optimized, never
# wrong or refused, and a test states that its rewrites converge. This is
# spec/totality's twin for the C++ of foreign/idr and runtime/ (comments
# and literals removed). What it rejects, outside the policies:
#   - a loop bounded by a counter: a `for` whose variable its body never
#     reads, compared against a count (a literal, a constant, a name that
#     says budget, fuel, limit or cap), or a `while` that counts one down
#     or up;
#   - an iteration limit: `maxIterations`, `setMaxIterations`,
#     `maxNumRewrites`, `kNoLimit`;
#   - a named constant that says budget, fuel, limit, cap or cutoff;
#   - a loop that runs until nothing changed (`while (changed)`) and a loop
#     that states no end (`for (;;)`, `while (true)`).
# And for the Idris side, compiler/src and libs: no module that is
# covering, by `%default covering` or by stating no `%default total`, no
# definition annotated `covering` or `partial`, and no `assert_total` or
# `assert_smaller` in code.
#
# The only exceptions are the lines of tools/policies.txt, `path: text --
# reason`, a finding at `path` on a line holding `text`: the size policies,
# which bound growth, output or how long an optimization runs, never what
# is correct or accepted, the widths of the runtime's representation, the
# frontend's trust points and the definitions not yet total. That file is
# the list, reviewed where it changes: the output states that every finding
# is one of its lines, never which, so removing a covering definition and
# its line changes nothing here, and a new one is a line added there. An
# annotation alone on its line is read with the line after it, so that a
# policy names the definition, `covering name :`. Each must still be in
# its file, so that whoever removes one removes its line.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cd "$root" || exit 1
policies=tools/policies.txt

find foreign/idr runtime -name build -prune -o -type f \
  \( -name '*.cpp' -o -name '*.h' -o -name '*.c' -o -name '*.inc' \) -print | LC_ALL=C sort > "$work/sources"
if [ -s "$work/sources" ]; then
  say "sources: the C++ of foreign/idr and runtime searched"
else
  say "sources: no C++ found"
fi
# shellcheck disable=SC2046
cpp_lex $(cat "$work/sources") > "$work/code"

# The policies, as `path TAB text TAB reason`; a line not of that form is
# a finding of its own.
grep -v '^[[:space:]]*#' "$policies" | grep -v '^[[:space:]]*$' > "$work/policy-lines"
awk '{
    at = index($0, ": "); cut = at ? index(substr($0, at + 2), " -- ") : 0
    if (cut) cut += at + 1
    if (at == 0 || cut == 0 || cut == at + 2 || cut + 4 > length($0)) { print > "/dev/stderr"; next }
    print substr($0, 1, at - 1) "\t" substr($0, at + 2, cut - at - 2) "\t" substr($0, cut + 4)
  }' "$work/policy-lines" > "$work/policies" 2> "$work/malformed"
# annotated: of Idris code as idris_lex writes it, `line:code`, each
# definition annotated covering or partial, after its visibility if it has
# one, as `line:code` with the visibility dropped and an annotation alone
# on its line joined to the line after it, `covering name : ...`.
annotated() {
  awk '
    function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
    {
      n = $0; sub(/:.*/, "", n)
      code = $0; sub(/^[0-9]+:/, "", code); code = trim(code)
    }
    held != "" { print held " " code; held = ""; next }
    code ~ /^((public[ \t]+)?export[ \t]+|private[ \t]+)?(covering|partial)([ \t]|$)/ {
      sub(/^((public[ \t]+)?export[ \t]+|private[ \t]+)/, "", code)
      if (code ~ /^(covering|partial)$/) held = n ":" code
      else print n ":" code
    }
    END { if (held != "") print held }'
}

# A policy is still in its file when its text is, or, in Idris, when an
# annotated definition is, as `annotated` writes it.
: > "$work/stale"
while IFS='	' read -r path text reason; do
  if [ ! -f "$path" ]; then
    say "  $path: $text" >> "$work/stale"
  elif ! grep -F -q -- "$text" "$path"; then
    case $path in
      *.idr) idris_lex code "$path" | annotated | grep -F -q -- "$text" ;;
      *) false ;;
    esac || say "  $path: $text" >> "$work/stale"
  fi
done < "$work/policies"

# The findings, as `kind TAB path TAB line TAB code TAB what`. The counted loops
# need a loop's body, so each file is read whole before its loops are.
awk '
  function words(name,   s, out, j, ch) {
    s = name; gsub(/_/, " ", s); out = ""
    for (j = 1; j <= length(s); j++) {
      ch = substr(s, j, 1)
      if (ch ~ /[A-Z]/ && j > 1 && substr(s, j - 1, 1) ~ /[a-z0-9]/) out = out " "
      out = out ch
    }
    return " " tolower(out) " "
  }
  function counts(name) { return words(name) ~ / (budget|fuel|limit|cap|cutoff|steps|rounds|iterations|attempts|tries) / }
  # Whether a bound is a count: a literal, a macro, a constant, or a name
  # that says it is one.
  function count_bound(b) {
    return b ~ /^[0-9]/ || b ~ /^[A-Z][A-Z0-9_]*$/ || b ~ /^k[A-Z]/ || (b in constant) || counts(b)
  }
  function find(kind, at, what) { print kind "\t" file "\t" at "\t" L[at] "\t" what }
  # The line that holds offset `p` of the joined source.
  function line_of(p,   j) { for (j = nl; j > 1; j--) if (start[j] <= p) return j; return 1 }
  # The end, just past it, of the statement that starts at `p`: a block, or
  # what runs to the `;` outside parentheses and braces.
  function statement_end(p,   paren, brace, ch, n) {
    n = length(src)
    while (p <= n && substr(src, p, 1) ~ /[ \t\n]/) p++
    paren = 0; brace = 0
    for (; p <= n; p++) {
      ch = substr(src, p, 1)
      if (ch == "(") paren++
      else if (ch == ")") paren--
      else if (ch == "{") brace++
      else if (ch == "}") { brace--; if (brace == 0 && paren == 0 && substr(src, p + 1) !~ /^[ \t\n]*else([^A-Za-z0-9_]|$)/) return p + 1 }
      else if (ch == ";" && paren == 0 && brace == 0) return p + 1
    }
    return p
  }
  function loops(   rest, base, p, q, depth, ch, header, parts, part, j, init, cond, step, v, b, body, e) {
    src = ""
    for (j = 1; j <= nl; j++) { start[j] = length(src) + 1; src = src L[j] "\n" }
    rest = src; base = 0
    while (match(rest, /(^|[^A-Za-z0-9_])for[ \t\n]*\(/)) {
      p = base + RSTART + RLENGTH
      depth = 1
      for (q = p; q <= length(src) && depth > 0; q++) {
        ch = substr(src, q, 1)
        if (ch == "(") depth++; else if (ch == ")") depth--
      }
      header = substr(src, p, q - p - 1)
      base = p - 1; rest = substr(src, p)
      # The three clauses, split at the semicolons outside parentheses.
      parts = 0; part[0] = ""; depth = 0
      for (j = 1; j <= length(header); j++) {
        ch = substr(header, j, 1)
        if (ch == "(" || ch == "[" || ch == "{") depth++
        else if (ch == ")" || ch == "]" || ch == "}") depth--
        if (ch == ";" && depth == 0) { parts++; part[parts] = ""; continue }
        part[parts] = part[parts] ch
      }
      if (parts != 2) continue
      init = part[0]; cond = part[1]; step = part[2]; v = ""
      if (match(init, /[A-Za-z_][A-Za-z0-9_]*[ \t]*=[^=]/)) {
        v = substr(init, RSTART, RLENGTH); sub(/[ \t]*=.*$/, "", v)
      } else if (match(step, /[A-Za-z_][A-Za-z0-9_]*/)) {
        v = substr(step, RSTART, RLENGTH)
      }
      if (v == "") continue
      # The bound the variable is compared against, on either side.
      b = ""
      if (match(cond, "(^|[^A-Za-z0-9_.>])" v "[ \t\n]*(<|<=|!=|>|>=)[ \t\n]*[A-Za-z0-9_:]+[ \t\n]*$")) {
        b = substr(cond, RSTART, RLENGTH); sub(/^.*(<|<=|!=|>|>=)[ \t\n]*/, "", b); sub(/[ \t\n]*$/, "", b)
      } else if (match(cond, "^[ \t\n]*[A-Za-z0-9_:]+[ \t\n]*(<|<=|!=|>|>=)[ \t\n]*" v "[ \t\n]*$")) {
        b = substr(cond, RSTART, RLENGTH); sub(/^[ \t\n]*/, "", b); sub(/[ \t\n<>=!].*$/, "", b)
      }
      sub(/^.*::/, "", b)
      if (b == "" || !count_bound(b)) continue
      e = statement_end(q)
      body = substr(src, q, e - q)
      if (body !~ "(^|[^A-Za-z0-9_])" v "([^A-Za-z0-9_]|$)")
        find("counted", line_of(p), "a loop bounded by a counter: " v " against " b)
    }
  }
  function finish() { if (file != "") loops(); nl = 0; split("", L); split("", start); split("", constant) }
  {
    f = $0; sub(/:.*$/, "", f)
    text = substr($0, length(f) + 2); n = text; sub(/:.*$/, "", n); text = substr(text, length(n) + 2)
    if (f != file) { finish(); file = f }
    nl = n + 0; L[nl] = text
    if (text ~ /(^|[^A-Za-z0-9_])for[ \t]*\([ \t]*;[ \t]*;[ \t]*\)/ || text ~ /(^|[^A-Za-z0-9_])while[ \t]*\([ \t]*(true|1)[ \t]*\)/)
      find("endless", nl, "a loop that states no end")
    if (text ~ /(^|[^A-Za-z0-9_])while[ \t]*\([ \t]*[A-Za-z_]*([Cc]hanged?|[Pp]rogress|[Aa]gain|[Gg]rew|[Mm]odified|[Dd]irty)[ \t]*\)/)
      find("fixpoint", nl, "a loop that runs until nothing changed")
    if (text ~ /(^|[^A-Za-z0-9_])while[ \t]*\([ \t]*(\+\+|--)[ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*\)/ ||
        text ~ /(^|[^A-Za-z0-9_])while[ \t]*\([ \t]*[A-Za-z_][A-Za-z0-9_]*[ \t]*(\+\+|--)[ \t]*((<|<=|>|>=|!=)[ \t]*[A-Za-z0-9_:]+[ \t]*)?\)/)
      find("counted", nl, "a loop that counts down or up to its end")
    if (match(text, /(^|[^A-Za-z0-9_])(maxIterations|setMaxIterations|maxNumRewrites|setMaxNumRewrites|kNoLimit)([^A-Za-z0-9_]|$)/)) {
      name = substr(text, RSTART, RLENGTH); gsub(/[^A-Za-z]/, "", name)
      find("limits", nl, "an iteration limit, " name)
    }
    name = ""
    if (match(text, /^[ \t]*#[ \t]*define[ \t]+[A-Za-z_][A-Za-z0-9_]*/)) {
      name = substr(text, RSTART, RLENGTH); sub(/^.*[ \t]/, "", name)
      if (text ~ /define[ \t]+[A-Za-z_][A-Za-z0-9_]*[ \t]+[0-9(]/) constant[name] = 1
    } else if (text ~ /(^|[^A-Za-z0-9_])(constexpr|const)[ \t]/ && match(text, /[A-Za-z_][A-Za-z0-9_]*[ \t]*(=[^=]|\{)/)) {
      name = substr(text, RSTART, RLENGTH); sub(/[ \t]*(=|\{).*$/, "", name)
      if (text ~ /[A-Za-z_][A-Za-z0-9_]*[ \t]*(=[ \t]*|\{)[-(]*[0-9]/) constant[name] = 1
    }
    if (name != "" && counts(name)) find("constants", nl, "a constant that bounds a count, " name)
  }
  END { finish() }' "$work/code" > "$work/found-all"

# A finding a policy names is no finding. What is left is in the order of
# the files and their lines.
awk -F'\t' '
  NR == FNR { n++; ppath[n] = $1; ptext[n] = $2; next }
  {
    for (j = 1; j <= n; j++) if (ppath[j] == $2 && index($4, ptext[j]) > 0) next
    print $1 "\t" $2 "\t" $3 "\t" $5
  }' "$work/policies" "$work/found-all" | LC_ALL=C sort -t '	' -k1,1 -k2,2 -k3,3n > "$work/found"

# report KIND WHEN-NONE WHEN-SOME: the findings of one kind.
report() {
  if grep -q "^$1	" "$work/found"; then
    say "$3:"
    grep "^$1	" "$work/found" | awk -F'\t' '{ print "  " $2 ":" $3 ": " $4 }'
  else
    say "$2"
  fi
}
report counted "counted loops: none, no loop is bounded by a counter" \
  "counted loops: a loop ends at a count"
report limits "iteration limits: none, no rewrite stops at a count of iterations" \
  "iteration limits: a rewrite stops at a count"
report constants "limit constants: none but the policies" \
  "limit constants: a constant bounds a count, and no policy names it"
report fixpoint "fixpoint loops: none, no loop runs until nothing changed" \
  "fixpoint loops: a loop runs until nothing changed"
report endless "endless loops: none, every loop states when it ends" \
  "endless loops: a loop states no end"
if [ -s "$work/malformed" ] || [ -s "$work/stale" ]; then
  say "policies: some are not each a line of its file with its reason:"
  sed 's/^/  /' "$work/malformed"
  cat "$work/stale"
else
  say "policies: each with its reason, and each still in its file"
fi

# The Idris side. trusted FILE CODE: a policy names that line of FILE.
trusted() {
  awk -F'\t' -v path="$1" -v code="$2" \
    '$1 == path && index(code, $2) > 0 { found = 1 } END { exit !found }' "$work/policies"
}
find compiler/src libs -name build -prune -o -type f -name '*.idr' -print | LC_ALL=C sort > "$work/idris"
if [ -s "$work/idris" ]; then
  say "idris sources: compiler/src and libs searched"
else
  say "idris sources: none found"
fi
: > "$work/covering"
: > "$work/asserted"
while IFS= read -r file; do
  idris_lex code "$file" > "$work/idris-code"
  if grep -qE '^[0-9]+:%default[[:space:]]+(covering|partial)' "$work/idris-code"; then
    grep -E '^[0-9]+:%default[[:space:]]+(covering|partial)' "$work/idris-code" |
      sed "s|^\([0-9]*\):.*|  $file:\1: covering by default|" >> "$work/covering"
  elif ! grep -qE '^[0-9]+:%default[[:space:]]+total' "$work/idris-code" &&
     grep -qE '^[0-9]+:([a-z_][A-Za-z0-9_'"'"']*[[:space:]]+:([[:space:]]|$)|(export|public|private|data|record|interface|implementation)[[:space:]])' "$work/idris-code"; then
    say "  $file: covering by Idris's default, with no %default total" >> "$work/covering"
  fi
  # A definition annotated covering or partial, which a policy names by
  # `covering name :`, or is a finding.
  annotated < "$work/idris-code" |
    while IFS= read -r hit; do
      line=${hit%%:*}
      code=${hit#*:}
      trusted "$file" "$code" || say "  $file:$line: a definition Idris checks only for coverage"
    done >> "$work/covering"
  grep -E '(^|[^A-Za-z0-9_'"'"'.])(assert_total|assert_smaller)([^A-Za-z0-9_'"'"']|$)' "$work/idris-code" |
    while IFS= read -r hit; do
      line=${hit%%:*}
      code=${hit#*:}
      trusted "$file" "$code" || say "  $file:$line: asserts what Idris does not check"
    done >> "$work/asserted"
done < "$work/idris"
if [ -s "$work/covering" ]; then
  say "covering: some modules or definitions are not total:"
  cat "$work/covering"
else
  say "covering: every module and definition is total but those a policy names"
fi
if [ -s "$work/asserted" ]; then
  say "assertions: some assert totality where no policy names it:"
  cat "$work/asserted"
else
  say "assertions: only where a policy names them"
fi
