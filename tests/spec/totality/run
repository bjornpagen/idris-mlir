#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Acceptance is a property of the program, never of the optimizer, and the
# compiler terminates by structure, never by a count: a structurally
# smaller argument, a set of unvisited items that shrinks, a bottom-up order,
# Idris's own totality proof or a well-quasi-order, so no count refuses a
# program and a limit of a representation is lifted by a representation.
# What that leaves to see in the tree:
#   - no definition of the frontend runs on fuel: no binder is named for
#     it, and no definition that counts down its first argument (a clause
#     on Z or 0 and one on S) is handed a budget, a numeral of 16 or more,
#     where it is called;
#   - every rule a refusal names has its category in the generated list of
#     the rules (lib/rules.sh): megamorphic, a construct whose choices no
#     compile-time analysis bounds, outside the language, or a user error
#     (a program Idris does not elaborate, refused with Idris's message);
#   - each limit that was lifted has a program among the tests that must
#     compile and run: a reduction deeper than the old 64 steps, a
#     constructor of more counted fields than a header counts, a sum of
#     more constructors than a tag of 16 bits tells apart (generated by its
#     own test).
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
cd "$root" || exit 1
find compiler/src -type f -name '*.idr' ! -path '*/build/*' | LC_ALL=C sort > "$work/sources"
if [ -s "$work/sources" ]; then
  say "sources: the frontend's searched"
else
  say "sources: none found"
fi
: > "$work/code"
while IFS= read -r file; do
  idris_lex code "$file" | sed "s|^|$file:|" >> "$work/code"
done < "$work/sources"

# The binders named for fuel, and the calls that hand a count-down
# definition a budget. A line of code is `<file>:<line>:<text>`.
awk '
  { text = $0; sub(/^[^:]*:[^:]*:/, "", text); where = substr($0, 1, length($0) - length(text) - 1) }
  NR == FNR {
    if (text ~ /(^|[^A-Za-z0-9_'"'"'.])[Ff]uel/) print where ": a binder named for fuel"
    if (match(text, /^[ \t]*[a-z][A-Za-z0-9_'"'"']*[ \t]+(Z|0)([ \t]|$)/)) {
      name = substr(text, RSTART, RLENGTH); sub(/^[ \t]*/, "", name); sub(/[ \t].*$/, "", name); zero[name] = 1
    }
    if (match(text, /^[ \t]*[a-z][A-Za-z0-9_'"'"']*[ \t]+\(S[ \t]+[a-z]/)) {
      name = substr(text, RSTART, RLENGTH); sub(/^[ \t]*/, "", name); sub(/[ \t].*$/, "", name); succ[name] = 1
    }
    next
  }
  {
    rest = text
    while (match(rest, /(^|[^A-Za-z0-9_'"'"'.])[a-z][A-Za-z0-9_'"'"']*[ \t]+[0-9]+/)) {
      call = substr(rest, RSTART, RLENGTH); rest = substr(rest, RSTART + RLENGTH)
      sub(/^[^a-z]*/, "", call)
      name = call; sub(/[ \t].*$/, "", name)
      count = call; sub(/^[^ \t]*[ \t]+/, "", count)
      if ((name in zero) && (name in succ) && count + 0 >= 16)
        print where ": " name " " count ", a count-down definition handed a budget"
    }
  }' "$work/code" "$work/code" > "$work/fuel"
if [ -s "$work/fuel" ]; then
  say "fuel: a definition terminates by a count:"
  cat "$work/fuel"
else
  say "fuel: none, every definition terminates by its structure"
fi

if ! rules_lines > "$work/rules"; then
  say "rules: no list (IdrRules.txt, which the build writes)"
elif [ ! -s "$work/rules" ]; then
  say "rules: the list names none"
else
  awk -F'\t' '$2 != "megamorphic" && $2 != "outside the language" && $2 != "user error" { print "  " $0 }' "$work/rules" > "$work/uncategorized"
  if [ -s "$work/uncategorized" ]; then
    say "rules: some have no category:"
    cat "$work/uncategorized"
  else
    say "rules: each has its category"
  fi
fi

: > "$work/limits"
for limit in \
    programs/interfaces/implementation-a-hundred-definitions-deep \
    programs/data/layout-256-counted-fields \
    programs/data/sum-of-seventy-thousand-constructors; do
  [ -f "tests/$limit/run" ] && [ -f "tests/$limit/expected" ] || say "  tests/$limit" >> "$work/limits"
done
if [ -s "$work/limits" ]; then
  say "limits: a lifted limit has no program that must compile:"
  cat "$work/limits"
else
  say "limits: a program that must compile for each lifted limit"
fi
