#!/bin/sh
# The smoke test of the MLIR tools (tests/mlir) fails when they are missing.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
mkdir "$work/empty"
if native_pipeline "$work/empty" /bin/sh "$root/tests/mlir/fixtures/exit_code.mlir" > "$work/out"; then
  say "the smoke test passes without the MLIR tools"
else
  say "the smoke test fails without the MLIR tools"
fi
cat "$work/out"
