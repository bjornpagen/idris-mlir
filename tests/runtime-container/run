#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The prepared runtime keeps the bitcode that joins every program in a file
# beside the object, on every target; no option chooses it. Preparing is
# deterministic: twice
# in a row, and as the build did, byte for byte. A prepared runtime serves a
# program as the build's does: its bitcode joins the program from where it
# is kept, its object alone is on the link line, and the program (Main.idr,
# compiled by idris-mlir) computes, small bigs and large ones past 2^62,
# and returns; no executable carries bitcode, as a search that finds the
# runtime's own bitcode says.
step_limit=300
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
runtime=$("$idris_mlir" --print-runtime)
archive=$dev_prefix/runtime/libidris_rt.a

# prepare NAME [OPTION...]: the archive prepared into $work/NAME.o.
prepare() {
  prepare_name=$1
  shift
  bounded "$idris_mlir" --prepare-runtime --runtime="$archive" "$@" -o "$work/$prepare_name.o" \
    > "$work/prepare.log" 2>&1 && return 0
  say "$prepare_name: --prepare-runtime failed"
  show "$work/prepare.log"
  return 1
}
prepare again || exit 0
if cmp -s "$work/again.o" "$runtime"; then
  say "prepared again: the build's runtime, byte for byte"
else
  say "prepared again: differs from the build's runtime"
fi
prepare again2 || exit 0
# Both files, twice the same.
if cmp -s "$work/again.o" "$work/again2.o" && cmp -s "$work/again.bc" "$work/again2.bc"; then
  say "prepared twice: the same object and bitcode"
else
  say "prepared twice: differs"
fi
# Raw bitcode ('B' 'C' 0xc0 0xde), or the wrapper LLVM writes on Darwin so
# that the system archiver reads it (0x0B17C0DE, then the offset and size);
# parseBitcodeFile reads both. The build's runtime keeps its bitcode there
# too.
case $(od -An -tx1 -N4 "$work/again.bc" 2> /dev/null | tr -d ' \n') in
  4243c0de | dec0170b)
    if [ -f "${runtime%.o}.bc" ]; then
      say "bitcode: beside the object"
    else
      say "bitcode: beside the prepared object, and not beside the build's"
    fi ;;
  *) say "bitcode: not beside the object" ;;
esac

# program NAME RUNTIME: Main.idr compiled and linked against RUNTIME into
# $work/NAME and run: its exit status and stdout, then its stderr.
program() {
  program_name=$1
  program_runtime=$2
  mkdir -p "$work/$program_name"
  cp "$here/Main.idr" "$work/$program_name/"
  compile_program --runtime="$program_runtime" "$work/$program_name/Main.idr" "$work/$program_name/prog"
  program=$work/$program_name/build/exec/prog
  if [ "$compiled" -ne 0 ] || [ ! -x "$program" ]; then
    say "$program_name: idris-mlir failed, exit $compiled"
    show "$work/compile.out" "$work/compile.err"
    return 1
  fi
  bounded "$program" > "$program.out" 2> "$program.err"
  program_status=$?
  say "$program_name: exit $program_status, prints $(paste -s -d ' ' "$program.out")"
  sed 's/^/  stderr | /' "$program.err"
  if carries_bitcode "$program"; then
    say "$program_name: the executable carries bitcode"
  fi
}
# carries_bitcode FILE: FILE holds the four bytes bitcode starts with,
# which the prepared runtime's bitcode holds wherever the entry keeps it
# (shown below, so the search could find what it looks for).
printf '\102\103\300\336' > "$work/magic"
carries_bitcode() {
  LC_ALL=C grep -q -F -f "$work/magic" "$1"
}
if [ -f "$work/again.bc" ]; then kept=$work/again.bc; else kept=$work/again.o; fi
if ! carries_bitcode "$kept"; then
  say "bitcode: the search does not find the prepared runtime's own"
fi
program built "$runtime"
program again "$work/again.o"
