#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The prepared runtime keeps the bitcode that joins every program where the
# target entry says (CMakeLists.txt, IDRIS_MLIR_RUNTIME_BITCODE_HOME): in
# the object's .llvm.lto section, which every link leaves out, or in a file
# beside the object; no option chooses it. Preparing is deterministic: twice
# in a row, and as the build did, byte for byte. A prepared runtime serves a
# program as the build's does: its bitcode joins the program from where it
# is kept, its object alone is on the link line, and the program (Main.idr,
# compiled by idris-mlir) computes, frees every cell and exits; no
# executable carries bitcode.
step_limit=300
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
runtime=$("$idris_mlir" --print-runtime)
archive=$dev_prefix/runtime/libidris_rt.a

# prepare NAME [OPTION...]: the archive prepared into $work/NAME.o.
prepare() {
  prepare_name=$1
  shift
  bounded "$idris_mlir" --prepare-runtime --runtime="$archive" "$@" -o "$work/$prepare_name.o" \
    > "$work/prepare.log" 2>&1 && return 0
  say "$prepare_name: --prepare-runtime failed"
  show "$work/prepare.log"
  return 1
}
prepare again || exit 0
if cmp -s "$work/again.o" "$runtime"; then
  say "prepared again: the build's runtime, byte for byte"
else
  say "prepared again: differs from the build's runtime"
fi
prepare again2 || exit 0
if [ -f "${runtime%.o}.bc" ]; then
  # The entry keeps it beside the object: both files, twice the same.
  if cmp -s "$work/again.o" "$work/again2.o" && cmp -s "$work/again.bc" "$work/again2.bc"; then
    say "prepared twice: the same object and bitcode"
  else
    say "prepared twice: differs"
  fi
  # Raw bitcode ('B' 'C' 0xc0 0xde), or the wrapper LLVM writes on Darwin
  # so that the system archiver reads it (0x0B17C0DE, then the offset and
  # size); parseBitcodeFile reads both.
  case $(od -An -tx1 -N4 "$work/again.bc" | tr -d ' \n') in
    4243c0de | dec0170b) say "bitcode: where the target entry keeps it" ;;
    *) say "bitcode: not beside the object, where the target entry keeps it" ;;
  esac
else
  # The entry keeps it in the object's .llvm.lto section.
  if cmp -s "$work/again.o" "$work/again2.o"; then
    say "prepared twice: the same object and bitcode"
  else
    say "prepared twice: differs"
  fi
  if "$llvm_bin/llvm-readobj" --sections "$work/again.o" 2> /dev/null | grep -q 'Name: \.llvm\.lto'; then
    say "bitcode: where the target entry keeps it"
  else
    say "bitcode: not in the object's .llvm.lto section, where the target entry keeps it"
  fi
fi

# program NAME RUNTIME: Main.idr compiled and linked against RUNTIME into
# $work/NAME, run with IDRIS_RT_LIVE=1: its exit status, stdout and stderr.
program() {
  program_name=$1
  program_runtime=$2
  mkdir -p "$work/$program_name"
  cp "$here/Main.idr" "$work/$program_name/"
  compile_program --runtime="$program_runtime" "$work/$program_name/Main.idr" "$work/$program_name/prog"
  program=$work/$program_name/build/exec/prog
  if [ "$compiled" -ne 0 ] || [ ! -x "$program" ]; then
    say "$program_name: idris-mlir failed, exit $compiled"
    show "$work/compile.out" "$work/compile.err"
    return 1
  fi
  ( IDRIS_RT_LIVE=1 && export IDRIS_RT_LIVE && bounded "$program" ) > "$program.out" 2> "$program.err"
  program_status=$?
  say "$program_name: exit $program_status, prints $(cat "$program.out"), $(cat "$program.err")"
  # Bitcode starts with these four bytes; they are nowhere in the
  # executable.
  printf '\102\103\300\336' > "$work/magic"
  if LC_ALL=C grep -q -F -f "$work/magic" "$program"; then
    say "$program_name: the executable carries bitcode"
  fi
}
program built "$runtime"
program again "$work/again.o"
