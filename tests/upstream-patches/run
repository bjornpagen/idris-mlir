#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# A bug in a pinned upstream is fixed by a patch carried in upstream/
# (upstream/README.md), and the tree keeps that as data: every
# upstream/<bug>/ has a README with an upstreaming plan, and either a patch
# or the reason it has none; every patch is named for a project of
# tools/patches.sh, and applies to that project's pinned source after the
# patches before it, as tools/bootstrap.sh applies them; and every carried
# patch is present where the tree checks it: its tests/upstream-<bug>, the
# bug's name without its number, which says whether the pinned tools have
# the fix. And every change the fork of Idris's compiler carries as its own
# code, recorded as upstream/<bug>/pull-request.diff against the pinned
# Idris (a bug whose README is titled for Idris2), still applies to that
# pin, so the record a re-sync reads has not gone stale. The pinned
# sources are only read: the patches are applied in order to a copy of the
# files they touch, and a record is only checked. The policy is `upstream_policy
# ROOT`, run on the repository and on the planted trees (lib/planted.sh):
# witness/ holds a bug for each way of breaking it (no README, no plan,
# neither a patch nor its reason, both, a patch named for no project, a
# carried patch with no check); near-miss/ holds a bug with a patch for
# each project and its check, and one with the reason it has none.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
. "$root/tools/patches.sh"

# upstream_policy ROOT: each bug of ROOT/upstream that does not keep the
# policy, `path: what`, at the file the fault is in: every file of a bug
# with no README, the README that lacks a section, the patch that
# contradicts it, names no project or has no check.
upstream_policy() (
  cd "$1" || exit 1
  for dir in upstream/*/; do
    [ -d "$dir" ] || continue
    dir=${dir%/}
    readme=$dir/README.md
    if [ ! -f "$readme" ]; then
      find "$dir" -type f | LC_ALL=C sort | sed 's/$/: no README.md beside it/'
      continue
    fi
    grep -qx '## Upstreaming plan' "$readme" || say "$readme: no '## Upstreaming plan'"
    patch_files=$(find "$dir" -maxdepth 1 -type f -name '*.patch' | LC_ALL=C sort)
    reason=no
    if grep -qx '## Why there is no patch' "$readme"; then reason=yes; fi
    if [ -z "$patch_files" ] && [ "$reason" = no ]; then
      say "$readme: no patch, and no '## Why there is no patch'"
    fi
    if [ -n "$patch_files" ] && ! grep -qx '## Patch' "$readme"; then
      say "$readme: a patch, and no '## Patch' saying what it does"
    fi
    # A carried patch's check is tests/upstream-<bug>, the bug's name
    # without its number.
    bug=${dir#upstream/}
    check=tests/upstream-${bug#*-}
    for file in $patch_files; do
      [ "$reason" = yes ] && say "$file: a patch, beside '## Why there is no patch'"
      name=${file##*/}
      case " $patch_projects " in
        *" ${name%.patch} "*)
          if [ ! -f "$check/run" ]; then
            say "$file: carried, and no $check/run checks it"
            say "$readme: its bug carries $name, and has no check"
          fi ;;
        *) say "$file: names no project (tools/patches.sh: $patch_projects)"
           say "$readme: its bug carries $name, a patch for no project" ;;
      esac
    done
  done
)

upstream_policy "$root" > "$work/readmes"
if [ -s "$work/readmes" ]; then
  say "upstream/ does not keep the policy:"
  sed 's/^/  /' "$work/readmes"
else
  say "upstream/: every bug has a README with an upstreaming plan, and a patch or the reason it has none"
fi
planted upstream_policy

# check_project PROJECT SOURCE WHAT: PROJECT's patches against SOURCE, a
# checkout of its pinned commit.
check_project() {
  patches "$1" > "$work/$1.list"
  if [ ! -s "$work/$1.list" ]; then
    say "$1: its patches apply to the pinned source in order"
    return 0
  fi
  if [ -z "$2" ] || ! git -C "$2" rev-parse --verify -q HEAD > /dev/null 2>&1; then
    say "$1: no checkout of $3 to check its patches against"
    return 0
  fi
  : > "$work/$1.failed"
  : > "$work/$1.paths"
  # A patch may patch what an earlier one of its series added (the early
  # exits' fixes patch the backport), so a project's patches are checked as
  # the bootstrap applies them: the whole series, in order, on a copy of
  # the files they touch.
  while IFS= read -r patch; do
    git -C "$2" apply --numstat "$patch" 2> /dev/null | cut -f3 >> "$work/$1.paths"
  done < "$work/$1.list"
  copy=$work/$1-copy
  mkdir -p "$copy"
  git -C "$copy" init -q
  sort -u "$work/$1.paths" | while IFS= read -r path; do
    if git -C "$2" cat-file -e "HEAD:$path" 2> /dev/null; then
      mkdir -p "$copy/$(dirname "$path")"
      git -C "$2" show "HEAD:$path" > "$copy/$path"
    fi
  done
  while IFS= read -r patch; do
    git -C "$copy" apply "$patch" > "$work/$1.out" 2>&1 ||
      { say "${patch#"$root"/} does not apply after the patches before it:"; show "$work/$1.out"; } >> "$work/$1.failed"
  done < "$work/$1.list"
  if [ -s "$work/$1.failed" ]; then
    cat "$work/$1.failed"
  else
    say "$1: its patches apply to the pinned source in order"
  fi
}

# LLVM: the checkout the bootstrap builds from, at the lock's revision.
llvm_source=$toolchain/llvm-project
llvm_pin=$("$root/tools/verify-pins.sh" lock llvm revision)
if [ -n "$(patches llvm)" ] && [ "$(git -C "$llvm_source" rev-parse HEAD 2> /dev/null)" != "$llvm_pin" ]; then
  say "llvm: $llvm_source is not a checkout at the lock's revision; run: tools/bootstrap.sh llvm"
else
  check_project llvm "$llvm_source" "the pinned llvm-project"
fi
# fork_records SOURCE: each change the fork records against the pinned
# Idris, checked against SOURCE, a checkout of that pin. A bug's README
# names its project in its title, and a record of the fork's is titled for
# Idris2; what the stock Idris lacks and nothing it builds reaches is
# titled for Idris and laid out against Idris's main, not the pin. A record
# laid out on another's change says so in its README, a line `After:
# upstream/<bug>`, so it is checked as a re-sync would apply it: its chain
# of records, the earliest first, applied in order to a copy of the files
# they touch. A record whose chain fails before it is not checked again
# here: the record that fails is, on its own chain.
fork_records() {
  : > "$work/fork.failed"
  for readme in "$root"/upstream/*/README.md; do
    dir=${readme%/README.md}
    [ -f "$dir/pull-request.diff" ] || continue
    case $(grep -m 1 '^# ' "$readme") in
      '# [Idris2]'*) ;;
      *) continue ;;
    esac
    # The chain, the earliest record first and this one last.
    chain=$dir
    at=$dir
    while before=$(sed -n 's|^After: upstream/\([^ /]*\)$|\1|p' "$at/README.md" 2> /dev/null | head -n 1) &&
          [ -n "$before" ]; do
      at=$root/upstream/$before
      case " $chain " in
        *" $at "*) say "${dir#"$root"/}/README.md: its records are laid out after one another in a circle" >> "$work/fork.failed"
                   continue 2 ;;
      esac
      if [ ! -f "$at/pull-request.diff" ]; then
        say "${dir#"$root"/}/README.md: laid out after upstream/$before, which records no change" >> "$work/fork.failed"
        continue 2
      fi
      chain="$at $chain"
    done
    copy=$work/fork-copy
    rm -rf "$copy" && mkdir -p "$copy" && git -C "$copy" init -q
    for link in $chain; do
      git -C "$1" apply --numstat "$link/pull-request.diff" 2> /dev/null | cut -f3
    done | sort -u | while IFS= read -r path; do
      if git -C "$1" cat-file -e "HEAD:$path" 2> /dev/null; then
        mkdir -p "$copy/$(dirname "$path")"
        git -C "$1" show "HEAD:$path" > "$copy/$path"
      fi
    done
    for link in $chain; do
      if ! git -C "$copy" apply "$link/pull-request.diff" > "$work/fork.out" 2>&1; then
        if [ "$link" = "$dir" ]; then
          { say "${dir#"$root"/}/pull-request.diff does not apply to the pinned Idris after the records before it:"
            show "$work/fork.out"; } >> "$work/fork.failed"
        fi
        break
      fi
    done
  done
  if [ -s "$work/fork.failed" ]; then
    cat "$work/fork.failed"
  else
    say "idris: every change the fork records applies to the pinned source"
  fi
}

# Idris: third_party/Idris2 at its gitlink, unmodified.
idris_source=${IDRIS_MLIR_IDRIS_SOURCE:-$root/third_party/Idris2}
if ! "$root/tools/verify-pins.sh" source > "$work/idris.pin" 2>&1; then
  say "idris: third_party/Idris2 is not its pinned commit:"
  show "$work/idris.pin"
else
  check_project idris "$idris_source" "third_party/Idris2"
  fork_records "$idris_source"
fi
# snmalloc: third_party/snmalloc at the lock's revision, the source the
# bootstrap exports with its patches for the runtime's build.
snmalloc_source=$root/third_party/snmalloc
snmalloc_pin=$("$root/tools/verify-pins.sh" lock snmalloc revision)
if [ -n "$(patches snmalloc)" ] && [ "$(git -C "$snmalloc_source" rev-parse HEAD 2> /dev/null)" != "$snmalloc_pin" ]; then
  say "snmalloc: third_party/snmalloc is not a checkout at the lock's revision"
else
  check_project snmalloc "$snmalloc_source" "third_party/snmalloc"
fi
# simdutf: third_party/simdutf at the lock's revision, the source the
# bootstrap exports with its patches for the runtime's build.
simdutf_source=$root/third_party/simdutf
simdutf_pin=$("$root/tools/verify-pins.sh" lock simdutf revision)
if [ -n "$(patches simdutf)" ] && [ "$(git -C "$simdutf_source" rev-parse HEAD 2> /dev/null)" != "$simdutf_pin" ]; then
  say "simdutf: third_party/simdutf is not a checkout at the lock's revision"
else
  check_project simdutf "$simdutf_source" "third_party/simdutf"
fi
# Chez Scheme: the bootstrap clones it for its build and keeps no checkout.
check_project chez "" "the pinned Chez Scheme (the bootstrap keeps none)"
