#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The Makefile's opening comment is the list of commands (`make` alone
# prints it): every `make <target>` it documents is a target of the
# Makefile, every command AGENTS.md tells a contributor to run is
# documented there, tools/bootstrap.sh builds the toolchain, and doctor
# reports the pinned CMake, Ninja, LLVM and sysroot. The list is read from
# the header, so a command is added in one place.
#
# The rule of the files is `commands ROOT`, run on the repository and on
# the planted trees (lib/planted.sh): witness/ holds a Makefile that
# documents a command it has no target for, an AGENTS.md naming a command
# the Makefile does not document, and a bootstrap that cannot run;
# near-miss/ holds what is allowed: documented commands with their
# targets, one of them with prerequisites, AGENTS.md naming them with
# arguments, and a `make` in a comment after the header, which documents
# nothing.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# documented MAKEFILE: the targets its opening comment names, `line TAB
# target`, one a line.
documented() {
  awk '!/^#/ { exit } { line = $0 }
       sub(/^#   make /, "", line) && match(line, /^[a-z][a-z-]*/) { print NR "\t" substr(line, 1, RLENGTH) }' "$1"
}

# commands ROOT: the findings in the tree at ROOT, `path:line: what`.
commands() (
  cd "$1" || exit 1
  [ -f Makefile ] || exit 0
  documented Makefile > "$work/documented"
  while IFS='	' read -r n target; do
    grep -q "^$target:" Makefile || printf 'Makefile:%s: documents make %s, which is no target\n' "$n" "$target"
  done < "$work/documented"
  if [ -f AGENTS.md ]; then
    grep -no '`make [a-z][a-z-]*' AGENTS.md | sed 's/:`make /\t/' | while IFS='	' read -r n target; do
      cut -f2 "$work/documented" | grep -qx "$target" ||
        printf 'AGENTS.md:%s: names make %s, which the Makefile does not document\n' "$n" "$target"
    done
  fi
  [ -x tools/bootstrap.sh ] || printf 'tools/bootstrap.sh: missing or not executable\n'
)

[ -n "$(documented "$root/Makefile")" ] || say "Makefile: documents no command"
commands "$root" > "$work/found"
if grep -q '^Makefile:' "$work/found"; then
  say "Makefile: documented commands with no target:"
  grep '^Makefile:' "$work/found" | sed 's/^/  /'
else
  say "Makefile: every documented command is a target"
fi
if grep -q '^AGENTS.md:' "$work/found"; then
  say "AGENTS.md: names commands the Makefile does not document:"
  grep '^AGENTS.md:' "$work/found" | sed 's/^/  /'
else
  say "AGENTS.md: every command it names is documented"
fi
if grep -q '^tools/bootstrap.sh:' "$work/found"; then
  say "tools/bootstrap.sh: missing or not executable"
else
  say "tools/bootstrap.sh"
fi
planted commands

"$root/tools/doctor.sh" > "$work/doctor" 2>&1
for tool in cmake ninja llvm sysroot; do
  if grep -q "^Pinned $tool: " "$work/doctor"; then
    say "doctor reports the pinned $tool"
  else
    say "doctor does not report the pinned $tool"
  fi
done
