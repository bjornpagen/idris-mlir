#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Artifacts exist after success, in build/exec, which does not exist before
# and which idris-mlir makes, and are removed when the same module later
# fails; the module made good again leaves every kind of them again.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# listed: the artifacts of the build Main left, of every kind
# (Harness.idr), on one line.
listed() {
  for listed_kind in $("$runtests" --artifact-kinds); do
    artifact_files "$work" Main "$listed_kind"
  done | sed "s|^$work/||" | LC_ALL=C sort | tr '\n' ' ' | sed 's/ $//'
}

cat > "$work/Main.idr" <<'IDRIS'
module Main

import Prelude

main : IO ()
main = printLn (the Int 7)
IDRIS
if [ -e "$work/build" ]; then say "before: build exists"; else say "before: no build"; fi
compile_program "$work/Main.idr" "$work/build/exec/Main"
say "compile: exit $compiled"
[ "$compiled" -eq 0 ] || show "$work/compile.out" "$work/compile.err"
artifacts "$work" Main
cp "$work/Main.idr" "$work/Good.idr"

cat > "$work/Main.idr" <<'IDRIS'
module Main

import Prelude

f : Double -> Int
f 0.5 = 1
f _ = 0

main : IO ()
main = printLn (f 0.5)
IDRIS
compile_program "$work/Main.idr" "$work/build/exec/Main"
say "compile an unsupported change: exit $compiled"
left=$(listed)
if [ -z "$left" ]; then
  say "artifacts after the failure: none"
else
  say "stale artifacts after the failure: $left"
fi
cp "$work/Good.idr" "$work/Main.idr"
compile_program "$work/Main.idr" "$work/build/exec/Main"
say "compile it good again: exit $compiled"
[ "$compiled" -eq 0 ] || show "$work/compile.out" "$work/compile.err"
artifacts "$work" Main
