#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Bytes as a string, held to the Unicode Standard: utf8model.h decodes as
# chapter 3 does, one byte at a time, and judges from_bytes, from_utf8 and
# utf8_count on random bytes and on boxes at simdutf's block boundaries
# (utf8.cpp states each property). One line per property; the classes each
# reached go to the report.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
. "$root/harness/prop/prop.sh"
prop_build "$here/utf8.cpp" "$work/utf8" || exit 0
# The case count is debt: 1000 cases took 0.2 s on an arm64 Mac (host
# clang, -O1); set it on the owner's build so the program ends well within
# step_limit on both targets.
prop_run "$work/utf8" --seed 1 --cases 1000
