# tests/programs/arrays/linarray-lanes-wide's module through idr-pipeline
# under one thread and under the pool, byte for byte, its remarks included:
# its loops are vectorized and given 32-bit versions, so idr-narrow-lanes,
# a function pass that runs on the pool's threads, says something of every
# loop it meets.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"
determinism_threads "$root/tests/programs/arrays/linarray-lanes-wide"
if grep -q 'idr-narrow-lanes' "$work/one.remarks" 2> /dev/null; then
  say "remarks: idr-narrow-lanes remarks"
else
  say "remarks: idr-narrow-lanes said nothing"
  show "$work/one.remarks"
fi
