#!/bin/sh
# A name is derived from content, so an edit moves only the names it is
# about: Main.idr and edited/Main.idr differ in the body of one definition,
# Main.step, and in every module the two compilations pass through, the
# emitted one and the one after each step up to lowering, every symbol of
# one that the other lacks is a name made from Main.step (an owner's name
# leads every name made from it). The program has lambdas, closures
# applied where they are known and a function specialized on one, so
# generated names are among the symbols.
. "$IDRIS_MLIR_ROOT/tests/testutils.sh"

# symbols MODULE OUT: every symbol MODULE names, defined or used, one per
# line, as idris-mlir-opt prints it.
symbols() {
  if ! bounded "$idris_mlir_opt" --mlir-disable-threading "$1" -o "$work/printed.mlir" \
       > "$work/print.err" 2>&1; then
    say "${1##*/}: does not parse and verify"
    show "$work/print.err"
    : > "$2"
    return 1
  fi
  grep -oE '@("([^"\\]|\\.)*"|[A-Za-z0-9_$.]+)' "$work/printed.mlir" | sed 's/^@//; s/^"//; s/"$//' |
    LC_ALL=C sort -u > "$2"
}

# moved A B: the symbols of A or B that the other lacks and that are not
# made from Main.step, on one line.
moved() {
  LC_ALL=C comm -3 "$1" "$2" | sed 's/^[[:space:]]*//' | grep -v '^Main\.step' | tr '\n' ' '
}

for version in original edited; do
  mkdir "$work/$version"
  case $version in
    original) copy_fixture "$here/Main.idr" "$work/$version" ;;
    edited) copy_fixture "$here/edited/Main.idr" "$work/$version" ;;
  esac
  # shellcheck disable=SC2046 # the dump options are words
  compile_program $(dump_options "$work/$version/build/exec/prog.dump") "$work/$version/Main.idr" prog
  say "$version: compile exit $compiled"
  if [ "$compiled" -ne 0 ]; then
    show "$work/compile.out" "$work/compile.err"
    exit 0
  fi
done

symbols "$(artifact_file "$work/original" prog module)" "$work/emitted.original"
symbols "$(artifact_file "$work/edited" prog module)" "$work/emitted.edited"
emitted_moved=$(moved "$work/emitted.original" "$work/emitted.edited")
if [ ! -s "$work/emitted.original" ]; then
  say "emitted: no symbols"
elif [ -z "$emitted_moved" ]; then
  say "emitted: every symbol not made from Main.step is the same"
else
  say "emitted: symbols moved by an edit of Main.step: $emitted_moved"
fi

steps_moved=
steps_count=0
for dump in $(step_dumps "$work/original/build/exec/prog.dump"); do
  step=$(step_of "$dump")
  [ "$step" = idr-lower ] && break
  other=$(step_module "$step" - "$work/edited/build/exec/prog.dump")
  if [ -z "$other" ]; then
    steps_moved="$steps_moved $step: (no dump in the edited compilation)"
    continue
  fi
  steps_count=$((steps_count + 1))
  symbols "$dump" "$work/step.original"
  symbols "$other" "$work/step.edited"
  step_moved=$(moved "$work/step.original" "$work/step.edited")
  [ -z "$step_moved" ] || steps_moved="$steps_moved $step: $step_moved"
done
if [ "$steps_count" -eq 0 ]; then
  say "steps: none dumped"
elif [ -z "$steps_moved" ]; then
  say "steps up to lowering: every symbol not made from Main.step is the same"
else
  say "steps up to lowering: symbols moved by an edit of Main.step:$steps_moved"
fi
