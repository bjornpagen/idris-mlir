#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# A name is derived from content, so an edit moves only the names of what
# it is about: Main.idr and edited/Main.idr differ in the body of one
# definition, Main.step, and in every module the two compilations pass
# through, the emitted one and the one after each step up to lowering,
# taken in the order the steps ran, a symbol of one that the other lacks
# holds code of Main.step: an op of its function's body whose location,
# fused and call-site locations included, is Main.step's span. That is the
# provenance a content name may move by, read from the locations
# idris-mlir writes on every op, so a lambda of main's that holds
# Main.step's body, inlined, may move, and one that does not may not. The
# program has lambdas, closures applied where they are known and a
# function specialized on one, so generated names are among the symbols.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# printed MODULE OUT: MODULE as idris-mlir-opt prints it, with its
# locations written in place; status 1, with a line that says so, when it does not parse
# and verify.
printed() {
  if ! bounded "$idris_mlir_opt" --mlir-disable-threading --mlir-print-debuginfo --mlir-print-local-scope "$1" -o "$2" \
       > "$work/print.err" 2>&1; then
    say "${1##*/}: does not parse and verify"
    show "$work/print.err"
    : > "$2"
    return 1
  fi
}

# symbols PRINTED: every symbol the printed module names, defined or used,
# one per line.
symbols() {
  grep -oE '@("([^"\\]|\\.)*"|[A-Za-z0-9_$.]+)' "$1" | sed 's/^@//; s/^"//; s/"$//' | LC_ALL=C sort -u
}

# body PRINTED SYMBOL: the text of the function SYMBOL in the printed
# module, its header line to the line that closes it at the header's
# indentation; nothing when no function of that name is there.
body() {
  awk -v symbol="$2" '
    !inside && /func/ && (index($0, "@" symbol "(") || index($0, "@\"" symbol "\"(")) {
      inside = 1; match($0, /^ */); indent = RLENGTH; print; next
    }
    inside { print; if (match($0, /^ *} loc/) && RLENGTH - 5 == indent) exit }' "$1"
}

# span PRINTED: the location of Main.step's definition, as the module
# writes it inside the name location of its function, `"Main.idr":L:C to
# :C`.
span() {
  grep -o 'loc("Main.step"("Main.idr":[0-9]*:[0-9]* to [0-9:]*))' "$1" | head -n 1 |
    sed 's/^loc("Main.step"(//; s/))$//'
}

# unowned ORIGINAL EDITED: the symbols one printed module names and the
# other does not whose function, in the module that has it, holds no code
# of Main.step's span in that compilation ($span_original, $span_edited,
# read from the emitted modules, where Main.step is a function of its own).
unowned() {
  symbols "$1" > "$work/symbols.original"
  symbols "$2" > "$work/symbols.edited"
  LC_ALL=C comm -3 "$work/symbols.original" "$work/symbols.edited" | sed 's/^[[:space:]]*//' |
    while IFS= read -r symbol; do
      if grep -qxF -- "$symbol" "$work/symbols.original"; then
        body "$1" "$symbol" | grep -qF -- "$span_original" && continue
      else
        body "$2" "$symbol" | grep -qF -- "$span_edited" && continue
      fi
      printf '%s ' "$symbol"
    done
}

for version in original edited; do
  mkdir "$work/$version"
  case $version in
    original) copy_fixture "$here/Main.idr" "$work/$version" ;;
    edited) copy_fixture "$here/edited/Main.idr" "$work/$version" ;;
  esac
  # shellcheck disable=SC2046 # the dump options are words
  compile_program $(dump_options "$work/$version/build/exec/prog.dump" all) "$work/$version/Main.idr" prog
  say "$version: compile exit $compiled"
  if [ "$compiled" -ne 0 ]; then
    show "$work/compile.out" "$work/compile.err"
    exit 0
  fi
done

printed "$(artifact_file "$work/original" prog module)" "$work/emitted.original" || exit 0
printed "$(artifact_file "$work/edited" prog module)" "$work/emitted.edited" || exit 0
span_original=$(span "$work/emitted.original")
span_edited=$(span "$work/emitted.edited")
if [ -z "$span_original" ] || [ -z "$span_edited" ]; then
  say "emitted: Main.step's span is not found"
  exit 0
else
  # The witness: a function renamed that holds no code of Main.step is
  # found.
  sed 's/@Main\.twice\([^A-Za-z0-9_.]\)/@Main.renamed\1/g' "$work/emitted.original" > "$work/emitted.renamed"
  witness=" $(span_edited=$span_original unowned "$work/emitted.original" "$work/emitted.renamed")"
  case $witness in *" Main.twice "*) witness_found=yes ;; *) witness_found= ;; esac
  case $witness in *" Main.renamed "*) ;; *) witness_found= ;; esac
  if [ -n "$witness_found" ]; then
    say "witness: a renamed function that holds no code of Main.step is found"
  else
    say "witness: a renamed function that holds no code of Main.step is not found"
  fi
  emitted_moved=$(unowned "$work/emitted.original" "$work/emitted.edited")
  if [ -z "$emitted_moved" ]; then
    say "emitted: every symbol that moved holds code of Main.step"
  else
    say "emitted: symbols moved by an edit of Main.step that hold none of its code: $emitted_moved"
  fi
fi

# The steps up to lowering, paired in the order they ran.
for version in original edited; do
  step_dumps "$work/$version/build/exec/prog.dump" | while IFS= read -r dump; do
    [ "$(step_of "$dump")" = idr-lower ] && break
    printf '%s\n' "$dump"
  done > "$work/dumps.$version"
  while IFS= read -r dump; do step_of "$dump"; done < "$work/dumps.$version" > "$work/steps.$version"
done
if [ ! -s "$work/steps.original" ]; then
  say "steps: none dumped"
elif ! cmp -s "$work/steps.original" "$work/steps.edited"; then
  say "steps: the two compilations ran different steps"
else
  steps_moved=
  paste "$work/dumps.original" "$work/dumps.edited" > "$work/pairs"
  while IFS="$(printf '\t')" read -r one other; do
    printed "$one" "$work/step.original" || continue
    printed "$other" "$work/step.edited" || continue
    moved=$(unowned "$work/step.original" "$work/step.edited")
    [ -z "$moved" ] || steps_moved="$steps_moved $(step_of "$one"): $moved"
  done < "$work/pairs"
  if [ -z "$steps_moved" ]; then
    say "steps up to lowering: every symbol that moved holds code of Main.step"
  else
    say "steps up to lowering: symbols moved by an edit of Main.step that hold none of its code:$steps_moved"
  fi
fi
