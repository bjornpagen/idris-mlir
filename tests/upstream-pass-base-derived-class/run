#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/76-pass-base-derived-class documents what the compiler's staged
# passes rest on: a pass's base class may be a template that names the
# derived pass, and the generated base derives from it with DerivedT
# spliced in. The documentation is the patch; the behaviour it documents
# is checked here, so a pin that stops splicing fails before any staged
# pass does.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
input=$root/upstream/76-pass-base-derived-class/crtp-pass.td
if ! bounded "$llvm_bin/mlir-tblgen" -gen-pass-decls -name Example -I "$llvm_prefix/include" "$input" \
     -o "$work/out.inc" 2> "$work/err"; then
  say "mlir-tblgen fails"
  show "$work/err"
elif grep -q '::example::StagedPass<DerivedT, ::mlir::ModuleOp>' "$work/out.inc"; then
  say "the generated base derives from the template, the derived pass spliced in"
else
  say "the generated base does not derive from the template as written"
fi
