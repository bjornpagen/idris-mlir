#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# idris-mlir --mlir-timing reports where a compilation spent its time: the
# parse, with the verification that follows it, has a row of its own
# before the passes; each module pass the driver's one manager ran, from
# idr-target on, has a row of its own, under its pass name, one per module
# the IR printer writes; a group of passes run on the program or on every
# function is a row of its own, with the rows of its passes nested in it,
# and the optimizer's row, wherever it is, holds those of the pipeline it
# runs on each function, so no pass of a group or of the optimizer has a
# row at the top; and no time is counted twice at the top, so the Rest is
# not negative. With a module and -c, neither
# the frontend nor the link runs, so neither has a row. MLIR keys a pass's
# timer by the pass's address, which one manager keeps for the whole
# compilation: every pass that ran has its own row, under its own name.
# The passes at the top are those of the one pipeline, which
# idris-mlir-opt runs as --idr-pipeline after --idr-target: its rows at
# the top, but for its parser and output, are the driver's, in order, and
# what runs inside a group or the optimizer is read off the report itself.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

cat > "$work/main.mlir" << 'EOF_MODULE'
idr.program @timing root(@Prog.main) stage(higher) {
  idr.func effects<none> @twice(%x: i64) -> i64 attributes {total} {
    %y = arith.addi %x, %x : i64
    return %y : i64
  }
  idr.func @Prog.main() -> i64 {
    %c = arith.constant 21 : i64
    %y = idr.call @twice(%c) : (i64) -> i64
    return %y : i64
  }
}
EOF_MODULE
if bounded "$idris_mlir" -c "$work/main.mlir" -o "$work/main.o" --mlir-timing 2> "$work/report"; then
  say "compile: ok"
else
  say "compile: exit $bounded_status"
  show "$work/report"
  exit 0
fi
timing_rows "$work/report" > "$work/rows"

# The rows at the top that are a pass's or a group's: every row at the top
# but the parse, LLVM, the Rest, the Total and the verifier's, in the order
# they began, which is the order they ran.
awk -F'\t' '$1 == 0 && $3 != "parse" && $3 != "LLVM" && $3 != "Rest" && $3 != "Total" &&
    $3 !~ /Verifier/ && $3 !~ /^\(A\) / { print $3 }' "$work/rows" > "$work/passes"

if awk -F'\t' '$1 == 0 { top++; if ($3 == "parse") { parses++; if (top != 1) late = 1 } }
    END { exit parses != 1 || late }' "$work/rows"; then
  say "parse: a row of its own, before the passes"
else
  say "parse: not one row before the passes"
  show "$work/rows"
fi

# The same pipeline run by idris-mlir-opt: its rows at the top, but for
# the parser's, the output's, the Rest and the Total.
if bounded "$dev_prefix/foreign/idr/idris-mlir-opt" "$work/main.mlir" --idr-target --idr-pipeline \
    --mlir-timing -o /dev/null 2> "$work/opt.report"; then
  timing_rows "$work/opt.report" | awk -F'\t' '$1 == 0 && $3 != "Parser" && $3 != "Output" &&
      $3 != "Rest" && $3 != "Total" && $3 !~ /Verifier/ && $3 !~ /^\(A\) / { print $3 }' > "$work/opt.passes"
else
  say "idris-mlir-opt: exit $bounded_status"
  show "$work/opt.report"
  exit 0
fi
if [ "$(wc -l < "$work/passes" | tr -d ' ')" -gt 1 ] && [ "$(head -n 1 "$work/passes")" = IdrTarget ] &&
    cmp -s "$work/passes" "$work/opt.passes"; then
  say "passes: each module pass of the pipeline has a row of its own, idr-target first"
else
  say "passes: the rows at the top are not the pipeline's passes"
  diff "$work/opt.passes" "$work/passes" | show
fi

if awk -F'\t' '
    pending && $1 <= depth { failed = 1 }
    { pending = $3 ~ /Pipeline$/ || $3 == "IdrOptimize"; depth = $1 }
    $1 == 0 && $3 ~ /Pipeline$/ { groups++ }
    $3 == "IdrOptimize" { optimizers++ }
    END { exit failed || pending || groups < 1 || optimizers != 1 }' "$work/rows"; then
  say "groups: each, and the optimizer, has the rows of its passes nested in it"
else
  say "groups: one has no rows nested in it"
  show "$work/rows"
fi

# The passes that ran nested in a group or in the optimizer, by the
# report's own rows.
awk -F'\t' '$1 > 0 && $3 !~ /Pipeline$/ && $3 !~ /^\(A\) / { print $3 }' "$work/rows" | sort -u > "$work/nested"
inside=$(sort -u "$work/passes" | comm -12 - "$work/nested")
if [ -z "$inside" ]; then
  say "top: no pass of a group or of the optimizer has a row at the top"
else
  say "top: rows at the top of passes run inside: $(printf '%s' "$inside" | paste -sd, -)"
fi

rest=$(awk -F'\t' '$1 == 0 && $3 == "Rest" { print $2 }' "$work/rows")
case $rest in
  '') say "rest: no row" ;;
  -*) say "rest: negative, $rest s" ;;
  *) say "rest: not negative" ;;
esac
