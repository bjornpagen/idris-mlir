#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Emit writes ops of the contract's dialects only, each through the builder
# generated for the op (IdrisMLIR.Dialect.*: idr's from the specification,
# the admitted upstream ops' from upstream's records). The contract's
# dialects are idr and the upstream dialects the specification lists as the
# ones the frontend writes, in its output WrittenDialects.txt. So
#   - each generated module builds ops of one dialect of the contract, and
#     the contract's dialects each have one. An op's name is the
#     specification's dialect and a name within it (`MkOpName Arith
#     "addi"`), and the dialect's namespace is the specification's
#     (`namespaceWord`), read from it;
#   - no string literal of Emit.idr, Emit/*.idr, MLIR.idr or MLIR/Text.idr,
#     the modules that write a module, spells a name of a contract
#     dialect: `<dialect>.<name>`, or the prefix `<dialect>.` that code
#     completes into one; the names are the generated modules'.
# And a type or an attribute of a dialect is a constructor of the sum
# generated from the dialect's ODS (IdrisMLIR.Syntax.*), so
#   - no string literal outside the syntax and dialect modules spells one,
#     `!<dialect>.` or `#<dialect>.`;
#   - MLIR.idr holds each generated sum in its types or attributes, and
#     SyntaxSamples.idr, whose module the round trip reads back, samples
#     each through the sum's list of mnemonics.
# The literal rules are `literals ROOT`, run on the repository and on the
# planted trees (lib/planted.sh): witness/ spells an op, a dialect's
# prefix, a type and an attribute by hand, each where it may not; near-miss/
# spells them in a comment, in a syntax module, and names of dialects
# outside the contract or with no dot.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
cd "$root" || exit 1
written=foreign/idr/include/idr/IR/Generated/WrittenDialects.txt
if [ ! -f "$written" ]; then
  say "contract: no $written, which the specification writes"
  exit 0
fi
contract=idr$(awk '/^#/ || NF == 0 { next } { printf " %s", $1 }' "$written")
src=compiler/src/IdrisMLIR

# The namespace of each of the specification's dialects, `Dialect word`,
# from its one table of them.
sed -n 's/^namespaceWord \([A-Za-z]*\) = word "\([a-z_]*\)"$/\1 \2/p' \
  compiler/spec/IdrisMLIR/Spec/Core/Dialect.idr > "$work/namespaces"

: > "$work/built"
for file in "$src"/Dialect/*.idr; do
  module=${file##*/}
  # grep reads all of the lexer's output: one that stops at the first match
  # closes the pipe on awk, which says so on stderr.
  idris_lex code "$file" | grep 'MkOpName' > /dev/null || { say "IdrisMLIR.Dialect.${module%.idr}: builds no op"; continue; }
  # The dialect of each op is the constructor its name holds, however
  # qualified, as the namespace the specification gives it; one the
  # specification has not is said by its constructor.
  dialects=$(idris_lex code "$file" | grep -o 'MkOpName \([A-Za-z]*\.\)*[A-Z][A-Za-z]*' |
    sed 's/^MkOpName //; s/.*\.//' | sort -u | while IFS= read -r constructor; do
      awk -v c="$constructor" '$1 == c { print $2; found = 1 } END { if (!found) print c }' "$work/namespaces"
    done | sort -u | tr '\n' ' ')
  case $dialects in
    *' '?*) say "IdrisMLIR.Dialect.${module%.idr}: builds ops of several dialects: $dialects" ;;
    *)
      dialect=${dialects% }
      case " $contract " in
        *" $dialect "*) say "$dialect: built by IdrisMLIR.Dialect.${module%.idr}"
                        printf '%s\n' "$dialect" >> "$work/built" ;;
        *) say "IdrisMLIR.Dialect.${module%.idr}: builds ops of $dialect, outside the contract" ;;
      esac ;;
  esac
done
for dialect in $contract; do
  grep -qx "$dialect" "$work/built" || say "$dialect: built by no module"
done

# literals ROOT: the string literals of the Idris under ROOT that spell a
# name of a contract dialect where only generated code may: in a module
# that writes a module (Emit.idr, Emit/*.idr, MLIR.idr, MLIR/Text.idr) an
# op's name or its dialect's prefix, `<dialect>.`; outside the syntax and
# dialect modules a type or an attribute, `!<dialect>.` or `#<dialect>.`.
# As `path:line: what`.
literals() (
  cd "$1" || exit 1
  [ -d "$src" ] || exit 0
  for file in "$src"/Emit.idr "$src"/Emit/*.idr "$src"/MLIR.idr "$src"/MLIR/Text.idr; do
    [ -f "$file" ] || continue
    idris_lex strings "$file" | grep -E "^[0-9]+:($(printf '%s' "$contract" | tr ' ' '|'))\\." |
      sed "s|^\([0-9]*\):\(.*\)|$file:\1: an op of a dialect spelled by hand, \2|"
  done
  find "$src" -path "$src/Syntax" -prune -o -path "$src/Dialect" -prune -o -name '*.idr' -print |
    LC_ALL=C sort | while IFS= read -r file; do
      idris_lex strings "$file" | grep -E '^[0-9]+:[!#][a-z_]+\.' |
        sed "s|^\([0-9]*\):\(.*\)|$file:\1: a type or attribute spelled by hand, \2|"
    done
)

literals "$root" > "$work/literals"
if grep -q ': an op of' "$work/literals"; then
  say "names of the dialects in Emit: spelled by hand:"
  grep ': an op of' "$work/literals" | sed 's/^/  /'
else
  say "names of the dialects in Emit: none spelled by hand"
fi
if grep -q ': a type or attribute' "$work/literals"; then
  say "types and attributes: spelled outside the syntax modules:"
  grep ': a type or attribute' "$work/literals" | sed 's/^/  /'
else
  say "types and attributes: none spelled outside the syntax modules"
fi

# Each generated sum, with the list of its mnemonics, from the definitions
# the syntax module gives them.
: > "$work/sums"
for file in "$src"/Syntax/*.idr; do
  for kind in Type Attr; do
    sum=$(sed -n "s/^data \([A-Za-z]*$kind\) : .*/\1/p" "$file")
    [ -n "$sum" ] || continue
    list=$(sed -n "s/^\([a-z][A-Za-z]*${kind}Mnemonics\) : List String\$/\1/p" "$file")
    printf '%s %s\n' "$sum" "${list:-none}" >> "$work/sums"
  done
done
[ -s "$work/sums" ] || say "syntax modules: no generated sum found"
idris_lex code "$src/MLIR.idr" > "$work/mlir"
idris_lex code "$src/SyntaxSamples.idr" > "$work/samples"
: > "$work/unheld"
: > "$work/unsampled"
while read -r sum list; do
  grep -Eq "(^|[^A-Za-z0-9_.])$sum([^A-Za-z0-9_']|\$)" "$work/mlir" || printf '%s\n' "$sum" >> "$work/unheld"
  grep -Eq "(^|[^A-Za-z0-9_.])$list([^A-Za-z0-9_']|\$)" "$work/samples" ||
    printf '%s (%s)\n' "$sum" "$list" >> "$work/unsampled"
done < "$work/sums"
if [ -s "$work/unheld" ]; then
  say "generated sums MLIR.idr does not hold:"
  show "$work/unheld"
else
  say "generated sums: each held by MLIR.idr"
fi
if [ -s "$work/unsampled" ]; then
  say "generated sums SyntaxSamples.idr does not sample:"
  show "$work/unsampled"
else
  say "generated sums: each sampled through its mnemonics"
fi
planted literals
