#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Every PIN(<name>) site outside the docs names a `## <name>` entry in
# PINS.md or an upstream bug, upstream/<name>/ (what golden tests printed,
# their `output`, is not a site, nor is a patch carried for upstream).
# Hidden directories are not the repository's sources: .git, .toolchain,
# and the worktrees of work in progress under .claude.
#
# The rule is `pin_sites ROOT`, run on the repository and on the planted
# trees (lib/planted.sh): witness/ holds sites naming no entry, in C++ and
# in a script; near-miss/ holds what is allowed: sites naming an entry of its PINS.md
# and an upstream bug, and sites in a document and a patch.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# pin_sites ROOT: each PIN site of the tree at ROOT that names neither an
# entry of its PINS.md nor a bug of its upstream/, `path:line: what`. A
# test's planted trees are no sites of the tree.
pin_sites() (
  cd "$1" || exit 1
  {
    [ -f PINS.md ] && sed -n 's/^## \([^[:space:]]\{1,\}\)$/\1/p' PINS.md
    for bug in upstream/*/; do [ -d "$bug" ] && basename "$bug"; done
  } | LC_ALL=C sort -u > "$work/entries"
  find . \( -name third_party -o -name build -o -name sources -o -name '.?*' \
            -o -path './tests/*/witness' -o -path './tests/*/near-miss' \) -prune \
     -o -type f ! -name '*.md' ! -name '*.patch' ! -name output -exec grep -HnoI 'PIN([A-Za-z0-9_-]\{1,\})' {} + |
    sed 's|^\./||; s/^\([^:]*:[0-9]*\):PIN(\(.*\))$/\1\t\2/' |
    while IFS='	' read -r at name; do
      grep -qxF "$name" "$work/entries" || printf '%s: PIN(%s) names no entry\n' "$at" "$name"
    done
)

(cd "$root" && grep -rqI --exclude-dir=.git --exclude-dir=.toolchain 'PIN([A-Za-z0-9_-]\{1,\})' foreign runtime tools 2> /dev/null) &&
  say "PIN sites: found" || say "PIN sites: none found"
pin_sites "$root" > "$work/missing"
if [ -s "$work/missing" ]; then
  say "PIN sites that name neither a PINS.md entry nor an upstream bug:"
  sed 's/^/  /' "$work/missing"
else
  say "every PIN site names a PINS.md entry or an upstream bug"
fi
planted pin_sites
