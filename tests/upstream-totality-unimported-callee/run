#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The type checker (compiler/checker) fixes a bug the stock Idris still
# has, as its own code: a termination check that follows a call out of
# what a module imports reads the callee from the modules its imports
# reach, which the elaborator never sees.
# Main.idr imports neither Loop nor Count. Its `caller` reaches Loop.loop,
# which never returns, through ViaLoop.viaLoop, and is refused as not
# total; its `counted` reaches the total Count.count through
# ViaCount.viaCount, and is not. The pinned, unpatched Idris finds neither
# callee, drops both calls, and accepts the module.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
mkdir "$work/fixture"
copy_fixture . "$work/fixture"
compile_program "$work/fixture/Main.idr" Main
say "compile: exit $compiled"
cat "$work/compile.out" "$work/compile.err" > "$work/compile.all"
if grep -qF 'caller is not total' "$work/compile.all"; then
  say "caller: refused as not total"
else
  say "caller: not refused as not total"
  show "$work/compile.all"
fi
if grep -qF 'counted is not total' "$work/compile.all"; then
  say "counted: refused"
  show "$work/compile.all"
else
  say "counted: not refused"
fi
if grep -qF 'unsupported (' "$work/compile.all"; then
  say "refusal: a rule of ours"
  show "$work/compile.all"
else
  say "refusal: Idris's own, no rule of ours"
fi
no_artifacts "$work/fixture"
