#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# idris-mlir takes a runtime member compiled for the target's triple
# however clang spells it, and refuses one compiled for another vendor,
# environment or operating system: it compares what the triples name (clang writes a Darwin
# triple with its OS version normalized, arm64-apple-macosx14.0 as
# arm64-apple-macosx14.0.0), not their text. Each member is bitcode, as
# the runtime's members carry theirs, prepared alone (--prepare-runtime).
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
target=$("$idris_mlir" --print-target-triple)
arch=${target%%-*}

# prepare NAME TRIPLE: a member compiled for TRIPLE, in an archive of its
# own, prepared; the exit status, and of a refusal, whether it names the
# member, TRIPLE as the member records it (clang's normal form) and the
# target's triple: what it is about, not its wording.
prepare() {
  printf '%s\n' 'int idris_rt_answer(void) { return 42; }' > "$work/$1.c"
  if ! bounded "$llvm_bin/clang" --target="$2" -flto=full -c "$work/$1.c" -o "$work/$1.o" \
      > "$work/cc.log" 2>&1; then
    say "$1: does not compile"
    show "$work/cc.log"
    return
  fi
  # The triple as the member records it, clang's normal form of TRIPLE.
  member_triple=
  if bounded "$llvm_bin/clang" --target="$2" -S -emit-llvm "$work/$1.c" -o "$work/$1.ll" > "$work/cc.log" 2>&1; then
    member_triple=$(sed -n 's/^target triple = "\(.*\)"$/\1/p' "$work/$1.ll")
  fi
  rm -f "$work/$1.a"
  bounded "$llvm_bin/llvm-ar" rcs "$work/$1.a" "$work/$1.o"
  bounded "$idris_mlir" --prepare-runtime --runtime="$work/$1.a" -o "$work/$1.prepared.o" \
    > "$work/prepare.log" 2>&1
  prepare_status=$?
  if [ "$prepare_status" -eq 0 ]; then
    say "$1: exit 0"
  elif grep -qF "$1.o" "$work/prepare.log" && [ -n "$member_triple" ] &&
       grep -qF -- "$member_triple" "$work/prepare.log" &&
       grep -q "${target}\(\.0\)*\([^.0-9]\|$\)" "$work/prepare.log"; then
    say "$1: exit $prepare_status, naming the member, its triple and the target's"
  else
    say "$1: exit $prepare_status, without naming the member, its triple and the target's"
    show "$work/prepare.log"
  fi
}

prepare same "$target"
# Another spelling of the same architecture.
case $arch in
  x86_64) prepare spelled "amd64-${target#*-}" ;;
  arm64) prepare spelled "aarch64-${target#*-}" ;;
  aarch64) prepare spelled "arm64-${target#*-}" ;;
  *) say "spelled: no other spelling of $arch known here" ;;
esac
prepare vendor "$arch-pc-${target#*-*-}"
# Another environment: a triple of four parts with its last replaced, gnu
# and musl each the other's; one of three, which names none, given one.
case $target in
  *-*-*-gnu*) other_environment=${target%-*}-musl ;;
  *-*-*-*) other_environment=${target%-*}-gnu ;;
  *) other_environment=$target-simulator ;;
esac
prepare environment "$other_environment"
# Another operating system: Linux for every other, macOS for Linux.
case $target in
  *-linux-*) prepare system "$arch-apple-macosx14.0" ;;
  *) prepare system "$arch-unknown-linux-gnu" ;;
esac
