#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# Every rule a refusal can name is stated by a program it refuses, a test
# whose Main.idr's first line, `-- expect: <rule>, line <n>`, names it, or
# has a line of tests/rules-covered/without-fixture saying why it has none
# (no source program reaches it, another test reaches it, or its fixture is
# owed); never both, so the file only shrinks. The rules are the build's
# list (harness/lib/rules.sh), so a rule the dialect gains is asked for at
# once.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
cd "$root" || exit 1
listed=tests/rules-covered/without-fixture
rule_phrases | LC_ALL=C sort -u > "$work/rule-set"
if [ ! -s "$work/rule-set" ]; then
  say "rules: no list of the rules (IdrRules.txt, which the build writes)"
  exit 0
fi
say "rules: read from the build's list"
for main in tests/*/Main.idr; do
  [ -f "$main" ] && head -n 1 "$main"
done | sed -n 's/^-- expect: \(.*\), line [0-9][0-9]*$/\1/p' | LC_ALL=C sort -u |
  LC_ALL=C comm -12 - "$work/rule-set" > "$work/fixtures"
if [ -s "$work/fixtures" ]; then say "reject fixtures: found"; else say "reject fixtures: none found"; fi
grep -v '^#' "$listed" | grep . > "$work/lines"
awk -F'\t' 'NF != 3 || ($2 != "unreachable" && $2 != "elsewhere" && $2 != "owed") || $3 == "" { print "  " $0 }' \
  "$work/lines" > "$work/malformed"
cut -f1 "$work/lines" | LC_ALL=C sort > "$work/listed"
LC_ALL=C uniq -d "$work/listed" | sed 's/^/  twice: /' >> "$work/malformed"
LC_ALL=C sort -u "$work/listed" | LC_ALL=C comm -23 - "$work/rule-set" | sed 's/^/  no rule: /' >> "$work/malformed"
LC_ALL=C sort -u "$work/fixtures" "$work/listed" | LC_ALL=C comm -23 "$work/rule-set" - > "$work/uncovered"
LC_ALL=C sort -u "$work/listed" | LC_ALL=C comm -12 "$work/fixtures" - > "$work/both"
if [ -s "$work/uncovered" ]; then
  say "rules with neither a reject fixture nor a line of $listed:"
  sed 's/^/  /' "$work/uncovered"
else
  say "every rule has a reject fixture or a line of $listed"
fi
if [ -s "$work/both" ]; then
  say "rules with both a fixture and a line (remove the line):"
  sed 's/^/  /' "$work/both"
else
  say "no rule has both a fixture and a line"
fi
if [ -s "$work/malformed" ]; then
  say "lines of $listed that are not a rule, a kind and a reason, once each:"
  cat "$work/malformed"
else
  say "every line names a rule, once, with a kind and a reason"
fi
