#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# A program test's cases (lib/e2e.sh, e2e_cases) hold each run to what its
# case says, from both sides: Main.idr, compiled once, runs on a case of
# each kind that holds (an output, an exit, a crash with its site and
# cause) and on one of each kind that does not, and only those that do not
# are named, each by what differs: the status and the stderr a case's ending
# gives are the specification's, so a crash at the wrong site, an exit for
# a return and a return for a crash each differ. A cases directory that
# cannot be read as cases (a file no field names, an ending that is none,
# no case at all) stops the test or the case, naming the fault, so no case
# passes unread.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"

# fixture DIR: a program test in DIR, Main.idr its only module.
fixture() {
  mkdir -p "$1"
  cp "$here/Main.idr" "$1/"
}

# case_of DIR NAME STDIN [FIELD TEXT]...: the case NAME of the fixture DIR, its
# stdin STDIN (a line) and each FIELD's text (a line).
case_of() {
  cs_dir=$1/cases/$2
  mkdir -p "$cs_dir"
  printf '%s\n' "$3" > "$cs_dir/stdin"
  shift 3
  while [ "$#" -ge 2 ]; do
    printf '%s\n' "$2" > "$cs_dir/$1"
    shift 2
  done
}

# Runs that hold, and runs that must each be named.
fixture "$work/runs"
case_of "$work/runs" holds-output 5 expected-stdout 20
case_of "$work/runs" holds-exit 7 expected-stdout 14 expected-ending 'exited 7'
case_of "$work/runs" holds-crash 0 expected-ending 'crashed division_by_zero' \
  expected-stderr 'prog: fatal: Main.idr:15:11: division by zero'
case_of "$work/runs" wrong-output 4 expected-stdout 20
case_of "$work/runs" wrong-exit 7 expected-stdout 14
case_of "$work/runs" wrong-site 0 expected-ending 'crashed division_by_zero' \
  expected-stderr 'prog: fatal: Main.idr:16:3: division by zero'
case_of "$work/runs" no-crash 5 expected-stdout 20 expected-ending 'crashed division_by_zero' \
  expected-stderr 'prog: fatal: Main.idr:15:11: division by zero'
case_of "$work/runs" no-ending 5 expected-stdout 20 expected-ending 'ended somehow'
(work=$work/runs.work && mkdir "$work" && e2e_io "$work/../runs")

# Cases that cannot be read as cases: nothing compiles.
fixture "$work/unread"
case_of "$work/unread" misspelt 5 expected-stdot 20
case_of "$work/unread" old 0 expected-crash 'division by zero'
mkdir -p "$work/unread/cases/no-file"
: > "$work/unread/cases/a-file"
(work=$work/unread.work && mkdir "$work" && e2e_io "$work/../unread")
fixture "$work/none"
mkdir "$work/none/cases"
(work=$work/none.work && mkdir "$work" && e2e_io "$work/../none")
