#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The checked runtime (libidris_rt_checked.a, Alloc/Alloc.h) ends a program
# at the first count operation on a cell that died, a release once too
# often or a reference that outlived its cell, and at the end of a program
# whose body returned with a cell still held, each as the runtime's
# internal error (SIGABRT after its message, 134 to the shell); counting as
# idris_rt.h defines it ends as a program that returned. Each mode of
# checked.c makes one misuse, or none (held).
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
if ! runtime_c link_program -O1 -I"$root/harness/prop" "$here/checked.c" "$checked_runtime" \
    -o "$work/checked" > "$work/cc.log" 2>&1; then
  say "checked: does not build"
  show "$work/cc.log"
  exit 0
fi
for mode in held twice holder leak; do
  bounded "$work/checked" "$mode" > "$work/mode.out" 2> "$work/mode.err"
  say "checked $mode: exit $?"
  sed 's/^/  stdout | /' "$work/mode.out"
  sed 's/^/  stderr | /' "$work/mode.err"
done
