// input: after idr-simplify
// FILECHECK-OPTIONS: --implicit-check-not=idr.str.
// rule: ELIM-G-7, TEST-ELIM-1
// putStrLn of a string built from a runtime character becomes writes in
// order: append becomes two writes, cons a put_char then a put_str, and
// show of an Int a put_int. No string op is left.
// CHECK-DAG: [[GOT:%[a-z0-9_]+]] = idr.constant "got "
// CHECK-DAG: [[EQ:%[a-z0-9_]+]] = idr.constant " = "
// CHECK-DAG: [[NL:%[a-z0-9_]+]] = idr.constant "\0A"
// CHECK: idr.io.put_str [[GOT]],
// CHECK: idr.io.put_char
// CHECK: idr.io.put_str [[EQ]],
// CHECK: idr.io.put_int
// CHECK: idr.io.put_str [[NL]],
