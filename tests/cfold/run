# The program of the benchmark bench/cfold on each of its cases: no input
# and one that is no number (both read as 0, a single leaf), each depth
# from 0 to 3, 5 and 12 (2^12 leaves, chains 2^11 deep). Each case's
# two numbers are the sum before folding and after, so they agree; the
# values are bench/cfold/main.c's on the same input.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
mkdir "$work/fixture"
cp "$root/bench/cfold/Main.idr" "$work/fixture/"
cp -R cases mlir.expect "$work/fixture/"
e2e_io "$work/fixture"
