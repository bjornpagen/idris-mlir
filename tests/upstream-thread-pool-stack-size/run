#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/75-thread-pool-stack-size: a thread pool's strategy names the
# stack its threads get, so the compiler's own workers run on the stack it
# sizes rather than the system's default. A pool asked for 16 MiB runs a
# task whose frame takes 12 MiB, more than any default: built against the
# toolchain's LLVM, statically, the program prints "ok".
# Building a program against MLIR's libraries takes longer than a step.
step_limit=180
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
mlir_check "a task needing 12 MiB of stack runs on the pool's 16 MiB thread" \
  "$root/upstream/75-thread-pool-stack-size/stack-size.cpp"
