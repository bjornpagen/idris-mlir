#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# A runtime built for another page size than the system's refuses to start:
# idris_rt_start checks first that the target entry's page size
# (IDRIS_MLIR_PAGE_SIZE, which the build records in runtime/page-size) is
# the system's, and otherwise names both, runs nothing and ends as a
# program this machine cannot run (126), its stderr the ending's one line.
# The check is the entry's own (runtime/Start/Entry.cpp), so that unit
# alone is compiled here, as the build compiles it, once for the build's
# page size and once each for pages 2 and 4 times smaller and larger, and
# linked ahead of the build's runtime archive, whose own copy of it the
# link then leaves out: the program is the build's runtime, built for that
# page size. The unit and start.c read the runtime's C ABI, part of which
# the build generates, so each compiles with the runtime's C flags
# (runtime_c).
step_limit=120
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
build=${idris_mlir%/foreign/idr/idris-mlir}
runtime=$build/runtime/libidris_rt.a
page=$(cat "$build/runtime/page-size" 2> /dev/null)
case $page in
  '' | *[!0-9]*)
    say "the build records no page size ($build/runtime/page-size)"
    exit 0 ;;
esac
target=$("$idris_mlir" --print-target-triple)

# program NAME PAGE: start.c with the entry built for PAGE, then the
# build's runtime, into $work/NAME.
program() {
  if ! runtime_c bounded "$llvm_bin/clang++" --target="$target" -std=c++26 -fno-exceptions \
      -fno-rtti -O2 "-DIDRIS_RT_PAGE_SIZE=$2" -c "$root/runtime/Start/Entry.cpp" \
      -o "$work/$1-entry.o" > "$work/cc.log" 2>&1; then
    say "$1: the entry does not compile"
    show "$work/cc.log"
    return 1
  fi
  if ! runtime_c link_program -O1 -I"$root/harness/prop" "$here/start.c" "$work/$1-entry.o" "$runtime" \
      -o "$work/$1" > "$work/cc.log" 2>&1; then
    say "$1: does not link"
    show "$work/cc.log"
    return 1
  fi
}

# start NAME PAGE WHAT: the program built for PAGE (a page WHAT names): its
# exit status, whether its body ran, and whether what it said is the crash
# that names the page size it was built for and the build's, which is the
# system's (runtime-start runs the build's runtime here), exactly as the
# runtime writes the ending of a program this machine cannot run: the
# program's own name as its driver built it (start.c's), `fatal: `, and why.
start() {
  program "$1" "$2" || return
  ( bounded "$work/$1" ) > "$work/$1.out" 2> "$work/$1.err"
  start_status=$?
  if grep -qx ran "$work/$1.out"; then ran="the program ran"; else ran="the program did not run"; fi
  printf 'start: fatal: the runtime is built for a %s-byte page, and this system has a %s-byte page\n' \
    "$2" "$page" > "$work/$1.crash"
  if [ ! -s "$work/$1.err" ]; then
    said="nothing on stderr"
  elif cmp -s "$work/$1.crash" "$work/$1.err"; then
    said="stderr is the ending that names the page it was built for and the system's"
  else
    said="stderr is not the ending that names both pages"
  fi
  say "built for $3: exit $start_status, $ran, $said"
  [ "$said" != "stderr is not the ending that names both pages" ] || show "$work/$1.err"
}

# The system's page, and the pages a factor of 2 and of 4 either side of
# it: the nearest a build can be wrong by, and x86-64's 4 KiB against
# arm64's 16 KiB.
start same "$page" "the system's page"
start half "$((page / 2))" "half the page"
start quarter "$((page / 4))" "a quarter of the page"
start double "$((page * 2))" "twice the page"
start quadruple "$((page * 4))" "four times the page"
