#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# All C++ (.cpp, .h, .hpp, .cc, .cppm, .td, .inc) is in a zone of the
# list below, each a path pattern with the extensions it keeps: foreign/idr
# in MLIR's layout (.cpp under lib and tools, headers under include) and its
# unit tests, one level under unittests; every .td and generated
# table of ours in the one directory the dialect's specification writes
# (spec-current holds each to it, so ODS no one generated has no zone), and
# idr-expect's table of properties, which the runner prints from its
# records (expect-table-current holds it to them); the runtime's .cpp and
# .h; the runtime tests' shared headers, with the one unit that gives a
# test written in C the checked runtime's count, and their C++ property
# programs with their own headers, one directory each; and the
# C++ programs the upstream checks build against the pinned MLIR, one
# directory each. So a C++20 module interface (.cppm) is in no zone, and no
# unit declares or imports a module (below). A hidden directory is a tool's
# (the editor's, the agent's worktrees), never a source zone, so none is
# searched; nor is upstream/, whose C++ is a reproducer of a bug in
# upstream tools, built by its check and never by the build.
#
# The rule is `zones ROOT`, run on the repository and on the planted trees
# (Planted.idr): witness/ holds C++ in no zone (each extension the list
# does not keep, a .cpp under include, a unit test two levels
# down, a source of tools/, ODS and a table outside the generated
# directory) and units that declare and import a module; near-miss/ holds
# a file of every zone, MLIR text in a string, a call whose name starts
# with `import`, and a reproducer under upstream/.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
zones='^foreign/idr/lib/.*\.cpp$
^foreign/idr/include/.*\.h$
^foreign/idr/include/idr/IR/Generated/[^/]*\.(td|inc)$
^foreign/idr/include/idr/Transforms/ExpectProperties\.inc$
^foreign/idr/tools/[^/]*\.cpp$
^foreign/idr/unittests/[^/]*\.cpp$
^runtime/.*\.(cpp|h)$
^harness/prop/[^/]*\.h$
^harness/prop/held\.cpp$
^tests/runtime-[^/]*/[^/]*\.(cpp|h)$
^tests/upstream-[^/]*/[^/]*\.cpp$'
printf '%s\n' "$zones" > "$work/zones"

# zones ROOT: the findings in the tree at ROOT, `path: what` or
# `path:line: what`. A test's planted trees are no C++ of the tree.
zones() (
  cd "$1" || exit 1
  find . \( -name third_party -o -name build -o -name sources -o -name upstream -o -name '.?*' \
            -o -path './tests/*/witness' -o -path './tests/*/near-miss' \) -prune \
     -o -type f \( -name '*.cpp' -o -name '*.h' -o -name '*.hpp' -o -name '*.cc' -o -name '*.cppm' -o -name '*.td' -o -name '*.inc' \) \
     -print | sed 's|^\./||' | LC_ALL=C sort > "$work/cpp"
  grep -vE -f "$work/zones" "$work/cpp" | sed 's/$/: C++ in no zone of the list/'
  # No C++20 module: an interface unit (.cppm) is in no zone above, and no
  # unit declares or imports one. A declaration ends in `;`, which tells it
  # from MLIR text a unit holds in a string (`module attributes {...} {`).
  # shellcheck disable=SC2046
  [ -s "$work/cpp" ] && grep -HnE '^[[:space:]]*(export[[:space:]]+)?(module|import)([[:space:]]+[A-Za-z_.:<"][^;{]*)?;' \
    $(cat "$work/cpp") 2> /dev/null | sed 's/^\([^:]*:[0-9]*\):.*/\1: declares or imports a C++20 module/'
)

(cd "$root" && find runtime -name '*.cpp' | grep -q .) && say "C++: the runtime under runtime/" || say "C++: no runtime under runtime/"
zones "$root" > "$work/found"
if grep -q ': C++ in no zone' "$work/found"; then
  say "C++ in no zone of the list:"
  grep ': C++ in no zone' "$work/found" | sed 's/: C++ in no zone.*//; s/^/  /'
else
  say "C++: each file in a zone of the list, with that zone's extensions"
fi
if grep -q ': declares or imports' "$work/found"; then
  say "C++20 modules declared or imported:"
  grep ': declares or imports' "$work/found" | sed 's/^/  /'
else
  say "C++: no unit declares or imports a C++20 module"
fi
planted zones
