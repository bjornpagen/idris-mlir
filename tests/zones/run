#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# All C++ (.cpp, .h, .hpp, .cc, .cppm, .td, .inc) is in a zone of the
# list below, each a path pattern with the extensions it keeps: foreign/idr
# in MLIR's layout (.cpp under lib and tools, headers under include, ODS
# under both) and its googletest programs, one level under unittests; the
# runtime's .cpp and .h; and the runtime tests' one shared header and their
# C++ property programs with their own headers, one directory each. So a
# C++20 module interface (.cppm) is in no zone, and no unit declares or
# imports a module (below). A hidden directory is a
# tool's (the editor's, the agent's worktrees), never a source zone, so none
# is searched; nor is upstream/, whose C++ is a reproducer of a bug in
# upstream tools, built by its check and never by the build.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
zones='^foreign/idr/lib/.*\.(cpp|td)$
^foreign/idr/include/.*\.(h|td)$
^foreign/idr/tools/[^/]*\.cpp$
^foreign/idr/unittests/[^/]*\.cpp$
^runtime/.*\.(cpp|h)$
^harness/prop/[^/]*\.h$
^tests/runtime-[^/]*/[^/]*\.(cpp|h)$'
(cd "$root" && find . \( -name third_party -o -name build -o -name sources -o -name upstream -o -name '.?*' \) -prune \
   -o -type f \( -name '*.cpp' -o -name '*.h' -o -name '*.hpp' -o -name '*.cc' -o -name '*.cppm' -o -name '*.td' -o -name '*.inc' \) \
   -print) | sed 's|^\./||' | sort > "$work/cpp"
if [ -s "$work/cpp" ]; then say "C++: found"; else say "C++: none found"; fi
if grep -q '^runtime/' "$work/cpp"; then say "C++: the runtime under runtime/"; else say "C++: no runtime under runtime/"; fi
printf '%s\n' "$zones" > "$work/zones"
if grep -vE -f "$work/zones" "$work/cpp" > "$work/outside"; then
  say "C++ in no zone of the list:"
  cat "$work/outside"
else
  say "C++: each file in a zone of the list, with that zone's extensions"
fi

# No C++20 module: an interface unit (.cppm) is in no zone above, and no
# unit declares or imports one. A declaration ends in `;`, which tells it
# from MLIR text a unit holds in a string (`module attributes {...} {`).
# A planted unit that imports one is the witness that the matcher sees.
modules() {
  grep -HnE '^[[:space:]]*(export[[:space:]]+)?(module|import)([[:space:]]+[A-Za-z_.:<"][^;{]*)?;' "$@" 2> /dev/null
}
printf '%s\n' 'import idr.planted;' > "$work/planted.cpp"
# shellcheck disable=SC2046
(cd "$root" && modules $(cat "$work/cpp")) > "$work/modules"
if [ -s "$work/modules" ]; then
  say "C++20 modules declared or imported:"
  show "$work/modules"
elif [ -z "$(modules "$work/planted.cpp")" ]; then
  say "C++20 modules: the planted import is not found"
else
  say "C++: no unit declares or imports a C++20 module"
fi
