#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The pinned toolchain, with
# upstream/24-one-shot-module-function-interface/llvm.patch, bufferizes
# function boundaries through FunctionOpInterface and on any symbol table:
# a module whose top holds a transform.named_sequence beside the payload
# still bufferizes (the case that reverted upstream's own generalization); a
# function that never returns bufferizes with its caller (the pin refuses
# it); a recursive function that reads its argument after calling itself
# passes it without a copy (the pin copies it), and each level of a
# recursion writes what the level below returns in place; a caller writes
# a copy of the constant a callee returns (the pin writes the constant's
# global), but writes in place a call result that is its own operand's
# buffer; empty tensor elimination on a gpu.module
# sees function boundaries (the pin's sees them on a builtin.module alone).
# The reproducers are of upstream's dialects alone; what bufferization
# makes of idr.func's boundaries through these models the program suite
# covers, each program run through it to its cases. When the pin has all
# of it, the patch goes, and with it the PINS.md entry
# one-shot-module-function-interface, the report and this test
# (upstream/README.md).
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
bug=$root/upstream/24-one-shot-module-function-interface

bounded "$llvm_bin/mlir-opt" "$bug/named-sequence.mlir" \
  --one-shot-bufferize=bufferize-function-boundaries > "$work/sequence.mlir" 2> "$work/err"
status=$?
if [ "$status" -ne 0 ]; then
  say "named-sequence: refused (exit $status), as upstream's reverted generalization did"
  show "$work/err"
elif grep -q 'func.func @payload(%[^:]*: memref<' "$work/sequence.mlir" &&
     grep -q 'transform.named_sequence @schedule' "$work/sequence.mlir"; then
  say "named-sequence: the payload bufferizes and the sequence is left as it is"
else
  say "named-sequence: bufferized otherwise"
  show "$work/sequence.mlir"
fi

bounded "$llvm_bin/mlir-opt" "$bug/no-return.mlir" \
  --one-shot-bufferize=bufferize-function-boundaries > "$work/no-return.mlir" 2> "$work/err"
status=$?
if [ "$status" -eq 0 ]; then
  say "no-return: a function that never returns bufferizes, and so does its caller"
else
  say "no-return: refused (exit $status), as at the unpatched pin"
  show "$work/err"
fi

bounded "$llvm_bin/mlir-opt" "$bug/recursive-read.mlir" \
  --one-shot-bufferize=bufferize-function-boundaries > "$work/recursive-read.mlir" 2> "$work/err"
status=$?
if [ "$status" -ne 0 ]; then
  say "recursive-read: refused (exit $status)"
  show "$work/err"
elif grep -q 'memref.copy' "$work/recursive-read.mlir"; then
  say "recursive-read: the recursive call is given a copy, as at the unpatched pin"
  show "$work/recursive-read.mlir"
else
  say "recursive-read: the recursive call is given the argument itself"
fi

bounded "$llvm_bin/mlir-opt" "$bug/recursive-result.mlir" \
  --one-shot-bufferize=bufferize-function-boundaries > "$work/recursive-result.mlir" 2> "$work/err"
status=$?
if [ "$status" -ne 0 ]; then
  say "recursive-result: refused (exit $status)"
  show "$work/err"
elif grep -q 'memref.copy' "$work/recursive-result.mlir"; then
  say "recursive-result: each level copies what the level below returns"
  show "$work/recursive-result.mlir"
else
  say "recursive-result: each level writes what the level below returns in place"
fi

bounded "$llvm_bin/mlir-opt" "$bug/non-writable-result.mlir" \
  --one-shot-bufferize=bufferize-function-boundaries > "$work/non-writable.mlir" 2> "$work/err"
status=$?
if [ "$status" -ne 0 ]; then
  say "non-writable-result: refused (exit $status)"
  show "$work/err"
elif awk '/func.func @writes_constant/ { caller = 1 } caller && /memref.copy/ { found = 1 }
          END { exit !found }' "$work/non-writable.mlir"; then
  say "non-writable-result: the caller writes a copy of the constant the callee returns"
else
  say "non-writable-result: the caller writes the constant's global, as at the unpatched pin"
  show "$work/non-writable.mlir"
fi

bounded "$llvm_bin/mlir-opt" "$bug/definite-alias.mlir" \
  --one-shot-bufferize=bufferize-function-boundaries > "$work/definite-alias.mlir" 2> "$work/err"
status=$?
if [ "$status" -ne 0 ]; then
  say "definite-alias: refused (exit $status)"
  show "$work/err"
elif awk '/func.func @writes_picked/ { caller = 1 } caller && /memref.copy/ { found = 1 }
          END { exit !found }' "$work/definite-alias.mlir"; then
  say "definite-alias: the caller copies the call result before writing it"
  show "$work/definite-alias.mlir"
else
  say "definite-alias: the caller writes the call result in place"
fi

bounded "$llvm_bin/mlir-opt" "$bug/symbol-table.mlir" \
  "--pass-pipeline=builtin.module(gpu.module(eliminate-empty-tensors))" \
  > "$work/symbol-table.mlir" 2> "$work/err"
status=$?
if [ "$status" -ne 0 ]; then
  say "symbol-table: refused (exit $status)"
  show "$work/err"
elif grep -q 'tensor.extract_slice' "$work/symbol-table.mlir"; then
  say "symbol-table: the elimination sees the call's boundary on a gpu.module"
else
  say "symbol-table: the elimination sees no function boundary, as at the unpatched pin"
  show "$work/symbol-table.mlir"
fi
