#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# upstream/10-recursive-attribute-parser: the textual parser, the printer
# and the alias collection before it handle builtin arrays and
# dictionaries nested in one another from an explicit stack, so their
# native depth does not grow with an attribute's nesting, and a constant
# a program computes reads and prints on the tools' small stack. The
# reproducer's array, nested 100,000 deep, read and printed back by
# mlir-opt on one thread under a 256 KiB stack: it exits 0, and what it
# prints holds the array at its whole depth.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
sh "$root/upstream/10-recursive-attribute-parser/nested.sh" 100000 > "$work/nested.mlir"
if ( ulimit -s 256 && bounded "$llvm_bin/mlir-opt" "$work/nested.mlir" -mlir-disable-threading \
       -o "$work/printed.mlir" ) 2> "$work/err"; then
  depth=$(tr -cd '[' < "$work/printed.mlir" | wc -c | tr -d ' ')
  if [ "$depth" -eq 100000 ]; then
    say "nested: 100,000 levels read and printed back on a 256 KiB stack"
  else
    say "nested: read and printed, $depth levels deep instead of 100,000"
  fi
else
  say "nested: mlir-opt fails on 100,000 levels on a 256 KiB stack"
  head -n 20 "$work/err" | sed 's/^/  | /'
fi
