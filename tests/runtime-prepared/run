#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The runtime idris-mlir prepares for programs (--print-runtime) is one
# object that every executable links. Its native half defines the C ABI
# programs call and behaves as the archive it was prepared from: start.c,
# the runtime-start program, built against it, prints what it prints
# against the archive and ends alike, however it ends (returned, an exit,
# a crash at a site, out of memory). Every symbol it needs from outside
# is one its target's allowlist allows, of the C library, GMP or
# compiler-rt: `allowed` holds what every target allows, and NAME/allowed
# what the target allows besides, NAME one of the names the host answers to
# (IDRIS_MLIR_HOST_NAMES), as the runner names an expected.NAME; and no
# allowlist allows the dynamic loader or the C++ runtime. A program's
# object needs nothing beyond the runtime's symbols and these
# (harness/lib/heap.sh checks each e2e program for that).
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
runtime=$("$idris_mlir" --print-runtime)
archive=$dev_prefix/runtime/libidris_rt.a
if [ ! -f "$runtime" ]; then
  say "prepared runtime: missing ($runtime)"
  exit 0
fi
say "prepared runtime: one object"
# build_test RUNTIME SOURCE OUT: SOURCE, the runtime-start program, linked
# with RUNTIME and GMP into OUT.
build_test() {
  if runtime_c link_program -O1 "$2" "$1" -o "$3" > "$work/cc.log" 2>&1; then
    return 0
  fi
  say "${3##*/}: does not build"
  show "$work/cc.log"
  return 1
}
start=$root/tests/runtime-start/start.c
build_test "$archive" "$start" "$work/start.archive" || exit 0
build_test "$runtime" "$start" "$work/start.prepared" || exit 0
# same MODE: start built both ways, run in MODE, prints the same and ends
# alike.
same() {
  bounded "$work/start.archive" "$1" > "$work/archive.out" 2> "$work/archive.err"
  same_archive=$?
  bounded "$work/start.prepared" "$1" > "$work/prepared.out" 2> "$work/prepared.err"
  same_prepared=$?
  if [ "$same_archive" -eq "$same_prepared" ] && cmp -s "$work/archive.out" "$work/prepared.out" &&
     cmp -s "$work/archive.err" "$work/prepared.err"; then
    say "start $1: the same output and exit status ($same_archive) with the prepared runtime as with the archive"
  else
    say "start $1: differs (archive exit $same_archive, prepared exit $same_prepared)"
    diff "$work/archive.out" "$work/prepared.out" | head -n 10 | sed 's/^/  stdout | /'
    diff "$work/archive.err" "$work/prepared.err" | head -n 10 | sed 's/^/  stderr | /'
  fi
}
same million
same exit-255
same crash
same memory

# A bitcode file that is neither the archive --prepare-runtime reads nor a
# runtime it wrote (it carries no prepared marks) is refused, by its name,
# when a program (Main.idr) is compiled against it.
printf 'int idris_flagless(void) { return 0; }\n' > "$work/flagless.c"
if ! bounded "$pinned_cc" --target="$("$idris_mlir" --print-target-triple)" -c -emit-llvm \
    "$work/flagless.c" -o "$work/flagless.bc" > "$work/flagless-cc.log" 2>&1; then
  say "flagless bitcode: the C compiler failed"
  show "$work/flagless-cc.log"
else
  mkdir -p "$work/flagless"
  cp "$here/Main.idr" "$work/flagless/"
  compile_program --runtime="$work/flagless.bc" "$work/flagless/Main.idr" "$work/flagless/prog"
  if [ "$compiled" -ne 0 ] && grep -qF flagless.bc "$work/compile.err"; then
    say "flagless bitcode: refused, and named"
  else
    say "flagless bitcode: exit $compiled, not refused by name"
    show "$work/compile.out" "$work/compile.err"
  fi
fi

# The allowlist of this host's target, and what the prepared runtime needs,
# in C names: the object format's prefix, which the build records, taken
# off. A runtime that needs nothing would hold of any allowlist, so an
# empty list of needs is a failure too: llvm-nm read nothing.
allowlist=
for host_name in ${IDRIS_MLIR_HOST_NAMES-}; do
  if [ -f "$here/$host_name/allowed" ]; then
    allowlist=$here/$host_name/allowed
    break
  fi
done
if [ -z "$allowlist" ]; then
  say "no allowlist names this host (NAME/allowed, for a NAME of: ${IDRIS_MLIR_HOST_NAMES-})"
  exit 0
fi
sed -e '/^#/d' -e '/^$/d' "$here/allowed" "$allowlist" > "$work/allowed"
if ! prefix=$(cat "$dev_prefix/runtime/symbol-prefix" 2> /dev/null); then
  say "no $dev_prefix/runtime/symbol-prefix, which the build writes"
  exit 0
fi
if ! "$llvm_bin/llvm-nm" --no-llvm-bc --undefined-only --format=just-symbols "$runtime" \
    > "$work/needs.raw" 2> "$work/nm.err"; then
  say "llvm-nm failed on the prepared runtime"
  show "$work/nm.err"
  exit 0
fi
sed "s/^$prefix//" "$work/needs.raw" | LC_ALL=C sort -u > "$work/needs"
if [ ! -s "$work/needs" ]; then
  say "the prepared runtime needs nothing, as llvm-nm reads it"
  exit 0
fi
# allowed SYMBOL: a pattern of the allowlist matches SYMBOL.
allowed() {
  while IFS= read -r allowed_pattern; do
    case $1 in $allowed_pattern) return 0 ;; esac
  done < "$work/allowed"
  return 1
}
# What no allowlist may allow, which the matcher is shown refusing: the
# dynamic loader (nothing of ours is loaded at run time), the C++ runtime's
# allocation, exceptions and static destructors, and a symbol of no
# library.
for refused in dlopen dlsym _Znwm __cxa_throw __cxa_atexit idris_rt_not_a_symbol; do
  if allowed "$refused"; then
    say "the allowlist allows $refused"
  fi
done
while IFS= read -r symbol; do
  allowed "$symbol" || say "$symbol"
done < "$work/needs" > "$work/outside"
if [ -s "$work/outside" ]; then
  say "the prepared runtime needs what its target's allowlist does not allow:"
  sed 's/^/  /' "$work/outside"
else
  say "the prepared runtime needs only what its target's allowlist allows"
fi
