#!/bin/sh
# SPDX-License-Identifier: 0BSD
# Copyright (c) 2026 Bjorn Pagen
# The type checker (compiler/checker), which fixes
# upstream/18-elaboration-primitive-folding as its own code, does not show
# the bug: a definition that applies a primitive to constants keeps the call
# in its checked form, and so does a literal whose FromString applies one,
# so the program computes each with the runtime's meaning of the primitive,
# the one meaning there is: "12.7" is no Int, so 0, the infinity is spelled
# inf, and the Char 233 is é. The pinned, unpatched Idris checks `plain` to
# 12, its own evaluator's reading of "12.7", `infinity` to "+inf.0",
# `eAcute` to the four characters \233 and `viaLiteral` to `MkN 12`, which
# the program would print instead. A literal of a primitive type is still
# the constant it denotes.
. "$IDRIS_MLIR_ROOT/harness/testutils.sh"
mkdir "$work/fold" && cp -R cases "$work/fold/" || exit 1
{
  printf 'module Main\n\nimport Prelude\n\n'
  cat "$root/upstream/18-elaboration-primitive-folding/Fold.idr"
  cat <<'IDRIS'

partial
main : IO ()
main = do
  printLn plain
  putStrLn infinity
  putStrLn eAcute
  let MkN n = viaLiteral
  printLn n
  printLn small
IDRIS
} > "$work/fold/Main.idr" || exit 1
e2e_io "$work/fold"
