[submodule "third_party/Idris2"]
	path = third_party/Idris2
	url = https://github.com/idris-lang/Idris2.git
[submodule "third_party/gmp"]
	path = third_party/gmp
	url = https://github.com/arthenica/gmp.git
[submodule "third_party/simdutf"]
	path = third_party/simdutf
	url = https://github.com/simdutf/simdutf.git
[submodule "third_party/fast_float"]
	path = third_party/fast_float
	url = https://github.com/fastfloat/fast_float.git
[submodule "third_party/snmalloc"]
	path = third_party/snmalloc
	url = https://github.com/microsoft/snmalloc.git
[submodule "third_party/ryu"]
	path = third_party/ryu
	url = https://github.com/ulfjack/ryu.git
[submodule "third_party/modular"]
	path = third_party/modular
	url = https://github.com/modular/modular.git
	shallow = true
	update = none
