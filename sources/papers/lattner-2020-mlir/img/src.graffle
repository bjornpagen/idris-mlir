\f0\fs24 \cf2 \cb3 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 // A rewrite pattern declaring an equivalence between a source and target DAG.\cf4 \strokec4 \
\pard\pardeftab720\sl340\partightenfactor0
\cf5 \strokec5 def\cf4 \strokec4  : Pattern&lt;\
    \cf2 \strokec2 // The first parameter is the source DAG with nodes corresponding to Ops in\cf4 \strokec4 \
    \cf2 \strokec2 // ODS followed by a list of named arguments, potentially with more type\cf4 \strokec4 \
    \cf2 \strokec2 // constraints.\cf4 \strokec4 \
    (LeakyReluOp $arg, F32Attr:$alpha),\
\
    \cf2 \strokec2 // The second parameter is a list of DAGs that is used to replace matched\cf4 \strokec4 \
    \cf2 \strokec2 // source DAG. DRR supports multiple result patterns as well as auxiliary\cf4 \strokec4 \
    \cf2 \strokec2 // Ops, which are used for building the replacement ops but are not\cf4 \strokec4 \
    \cf2 \strokec2 // directly used for replacements. The DAGs may refer to matched values in\cf4 \strokec4 \
    \cf2 \strokec2 // the source DAG or those created in target.\cf4 \strokec4 \
    [(SelectOp (CmpFOp CMPF_P_ODT\
      \cf2 \strokec2 // A referenced argument bound in the source DAG.\cf4 \strokec4 \
        $arg\
      \cf2 \strokec2 // Nested DAG construct Ops that produce value from attribute created in\cf4 \strokec4 \
      \cf2 \strokec2 // pattern.\cf4 \strokec4 \
        (ConstantOp ConstantAttr&lt;F32Attr, \cf6 \strokec6 "0."\cf4 \strokec4 &gt;))\
      \cf2 \strokec2 // And the two final, required arguments of SelectOp.\cf4 \strokec4 \
        $arg,  (ConstantOp $alpha))]&gt;;}</string>
