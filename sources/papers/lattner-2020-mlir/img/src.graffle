%results\cf4 :2 = \cf5 "d.operation"\cf4 (\cf2 %arg0\cf4 , \cf2 %arg1\cf4 ) (\{\
  \cf6 // Regions belong to Ops and can have multiple blocks.\cf4 \
  ^block(\cf2 %argument\cf4 : \cf7 !d.type\cf4 ):\
    \cf6 // Ops have function types (expressing mapping).\cf4 \
    \cf2 %value\cf4  = \cf5 "nested.operation"\cf4 () (\{\
      \cf6 // Ops can contain nested regions.\cf4 \
      \cf5 "d.op"\cf4 () : () -&gt; ()\
    \}) : () -&gt; (\cf7 !d.other_type\cf4 )\
    \cf5 "consume.value"\cf4 (\cf2 %value\cf4 ) : (\cf7 !d.other_type\cf4 ) -&gt; ()\
  ^other_block:\
    \cf5 "d.terminator"\cf4 () [^block(\cf2 %argument\cf4  : \cf7 !d.type\cf4 )] : () -&gt; ()\
  \})\
\cf6 // Ops can have a list of attributes.\cf4 \
\{attribute=\cf5 "value"\cf4  : \cf7 !d.type\cf4 \} : () -&gt; (\cf7 !d.type\cf4 , \cf7 !d.other_type\cf4 )\
}</string>
