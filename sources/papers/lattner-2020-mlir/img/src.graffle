// Affine loops are Ops with regions.\cf4 \
affine.for \cf5 %arg0\cf4  = \cf6 0\cf4  to \cf5 %N\cf4  \{\
  \cf2 // Only loop-invariant values, loop iterators, and affine functions of\
  // those are allowed.\cf4 \
  affine.for \cf5 %arg1\cf4  = \cf6 0\cf4  to \cf5 %N\cf4  \{\
    \cf2 // Body of affine for loops obey SSA.\cf4 \
    \cf5 %0\cf4  = affine.load \cf5 %A\cf4 [\cf5 %arg0\cf4 ] : \cf7 memref\cf4 &lt;? x \cf7 f32\cf4 &gt;\
    \cf2 // Structured memory reference (memref) type can have\cf4 \
    \cf2 // affine layout maps.\cf4 \
    \cf5 %1\cf4  = affine.load \cf5 %B\cf4 [\cf5 %arg1\cf4 ] : \cf7 memref\cf4 &lt;? x \cf7 f32\cf4 , (d0)[s0] -&gt; (d0 + s0)&gt;\
    \cf5 %2\cf4  = mulf \cf5 %0\cf4 , \cf5 %1\cf4  : \cf7 f32\cf4 \
    \cf2 // Affine load/store can have affine expressions as subscripts.\cf4 \
    \cf5 %3\cf4  = affine.load \cf5 %C\cf4 [\cf5 %arg0\cf4  + \cf5 %arg1\cf4 ] : \cf7 memref\cf4 &lt;? x \cf7 f32\cf4 &gt;\
    \cf5 %4\cf4  = addf \cf5 %3\cf4 , \cf5 %2\cf4  : \cf7 f32\cf4 \
    affine.store \cf5 %4\cf4 , \cf5 %C\cf4 [\cf5 %arg0\cf4  + \cf5 %arg1\cf4 ] : \cf7 memref\cf4 &lt;? x \cf7 f32\cf4 &gt;\
  \}\
\}}</string>
