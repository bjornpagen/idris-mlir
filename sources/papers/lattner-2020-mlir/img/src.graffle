%0\cf4  = tf.graph (\cf2 %arg0\cf4  : \cf5 tensor\cf4 &lt;\cf5 f32\cf4 &gt;, \cf2 %arg1\cf4  : \cf5 tensor\cf4 &lt;\cf5 f32\cf4 &gt;,\
               \cf2 %arg2\cf4  : !tf.resource) \{\
  \cf6 // Execution of these operations is asynchronous, the %control\cf4  \cf6 return value\
  // can be used to impose extra runtime ordering,\cf4  \cf6 for example the assignment\
  // to the variable %arg2 is ordered\cf4  \cf6 after the read explicitly below.\cf4 \
