\f0\fs24 \cf2 \cb3 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 // An Op is a TableGen definition that inherits the "Op" class parameterized\cf4 \strokec4 \
\cf2 \strokec2 // with the Op name\cf4 \strokec4 \
\pard\pardeftab720\sl340\partightenfactor0
\cf5 \strokec5 def\cf4 \strokec4  LeakyReluOp: Op&lt;\cf6 \strokec6 "leaky_relu"\cf4 \strokec4 ,\
    \cf2 \strokec2 // and a list of traits used for verification and optimization.\cf4 \strokec4 \
    [NoSideEffect, SameOperandsAndResultType]&gt; \{\
  \cf2 \strokec2 // The body of the definition contains named fields for a one-line\cf4 \strokec4 \
  \cf2 \strokec2 // documentation summary for the Op.\cf4 \strokec4 \
  \cf5 \strokec5 let\cf4 \strokec4  summary = \cf6 \strokec6 "Leaky Relu operator"\cf4 \strokec4 ;\
\
  \cf2 \strokec2 // The Op can also a full-text description that can be used to generate\cf4 \strokec4 \
  \cf2 \strokec2 // documentation for the dialect.\cf4 \strokec4 \
  \cf5 \strokec5 let\cf4 \strokec4  description = [\{\
    \cf6 Element-wise Leaky ReLU operator\
      x -&gt; x &gt;= 0 ? x : (alpha * x)\cf4 \
  \}];\
\
