@InProceedings{Aehlig,
  author    = {Klaus Aehlig and Florian Haftmann and Tobias Nipkow},
  citet     = {Aehlig et al.\@},
  booktitle = {Theorem Proving in Higher Order Logics},
  title     = {A Compiled Implementation of Normalization by Evaluation},
