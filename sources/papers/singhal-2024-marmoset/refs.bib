month = {nov},
pages = {1684–1699},
numpages = {16},
keywords = {data structures, CAD, storage management, DAG, design hierarchy, data structure, clustering sequences, directed graphs, database management systems, CAD databases, computer-aided design, direct acyclic graph, clustered sequences}
