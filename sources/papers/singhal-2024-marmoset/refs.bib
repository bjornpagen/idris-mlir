@article{clusterDAG,
author = {Banerjee, J. and Kim, W. and Kim, S.-J. and Garza, J. F.},
title = {Clustering a DAG for CAD Databases},
year = {1988},
issue_date = {November 1988},
publisher = {IEEE Press},
