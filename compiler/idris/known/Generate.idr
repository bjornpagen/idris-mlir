||| knowngen: prints the fork's modules its vocabularies define
||| (`Vocabulary`), or checks that the committed ones are what it prints.
||| The one module that does IO; what it prints is `outputs`, a pure
||| function of the vocabularies:
|||   knowngen write <root>   rewrites each module whose bytes differ;
|||   knowngen check <root>   writes nothing, and fails naming each that differs.
module Generate

import Vocabulary

import Data.List
import Data.String
import System
import System.File

%default total

------------------------------------------------------------------------------
-- Printing
------------------------------------------------------------------------------

-- The lines every printed module opens with: its licence, and that it is
-- this generator's output.
banner : List String
banner =
  [ "-- SPDX-License-Identifier: BSD-3-Clause"
  , "-- Copyright (c) 2026 Bjorn Pagen"
  , "-- Generated by knowngen from the fork's vocabularies"
  , "-- (compiler/idris/known/); `make check` regenerates it and fails on any"
  , "-- difference. Do not edit."
  ]

-- A text as an Idris string literal.
literal : String -> String
literal s = "\"" ++ concatMap escape (unpack s) ++ "\""
  where
    escape : Char -> String
    escape '"' = "\\\""
    escape '\\' = "\\\\"
    escape c = singleton c

-- Each element with its position, from zero.
numbered : List a -> List (Nat, a)
numbered = from Z
  where
    from : Nat -> List a -> List (Nat, a)
    from _ [] = []
    from i (x :: xs) = (i, x) :: from (S i) xs

-- A data type of the entries' constructors, none with an argument.
enumeration : (type : String) -> List Entry -> List String
enumeration type es = ["public export", "data " ++ type] ++ map alternative (numbered es)
  where
    alternative : (Nat, Entry) -> String
    alternative (Z, (c, _)) = "  = " ++ c
    alternative (S _, (c, _)) = "  | " ++ c

-- A function with one clause per entry, matching its constructor.
byConstructor : (name, type, doc : String) -> (Nat -> Entry -> String) -> List Entry -> List String
byConstructor name type doc rhs es
    = ["", "||| " ++ doc, "public export", name ++ " : " ++ type]
      ++ map (\(i, e) => name ++ " " ++ fst e ++ " = " ++ rhs i e) (numbered es)

-- Each entry's position as a number, and its inverse: the entry a number
-- stands for, and nothing for a number none has.
numbering : (to, from, type, toDoc, fromDoc : String) -> List Entry -> List String
numbering to from type toDoc fromDoc es
    = byConstructor to (type ++ " -> Int") toDoc (\i, _ => show i) es ++
      [ "", "||| " ++ fromDoc, "public export", from ++ " : Int -> Maybe " ++ type ] ++
      map (\(i, e) => from ++ " " ++ show i ++ " = Just " ++ fst e) (numbered es) ++
      [ from ++ " _ = Nothing" ]

-- `Core.Name.Known`: the identifiers, how each is spelled, the id each has
-- in every session's table, the identifier at an id, and the first id no
-- identifier has.
knownModule : List Entry -> String
knownModule es
    = unlines $
        banner ++
        [ "||| The identifiers the compiler's own code spells: the builtin names it"
        , "||| recognizes or makes, the namespaces they live in, the constructors of"
        , "||| reflection's types, and the stems of the names it generates. Each is"
        , "||| known when the compiler is built, so each has a fixed id, its ordinal,"
        , "||| and a session's table of identifiers holds each at that id before it"
        , "||| meets any other text: an identifier the code spells is a constant, never"
        , "||| looked up."
        , "module Core.Name.Known"
        , ""
        , "%default total"
        , ""
        ] ++
        enumeration "Known" es ++
        byConstructor "spelling" "Known -> String" "How the identifier is spelled."
                      (\_, e => literal (snd e)) es ++
        numbering "ordinal" "fromOrdinal" "Known"
                  "The identifier's id in every session's table."
                  "The known identifier at an id, if the id is one." es ++
        [ ""
        , "||| The first id a text the vocabulary does not spell gets."
        , "public export"
        , "knownCount : Int"
        , "knownCount = " ++ show (length es)
        ]

-- An enumeration the lexer reads from text: the type, how the source
-- writes each, the one a text spells, and their equality.
lexed : (type, noun, text, from : String) -> List Entry -> List String
lexed type noun text from es
    = [ "", "||| A " ++ noun ++ " the language reserves." ] ++
      enumeration type es ++
      byConstructor text (type ++ " -> String") ("How the source writes a " ++ noun ++ ".")
                    (\_, e => literal (snd e)) es ++
      [ ""
      , "||| The " ++ noun ++ " a text spells, if it spells one."
      , "public export"
      , from ++ " : String -> Maybe " ++ type
      ] ++
      map (\e => from ++ " " ++ literal (snd e) ++ " = Just " ++ fst e) es ++
      [ from ++ " _ = Nothing"
      , ""
      , "public export"
      , "Eq " ++ type ++ " where"
      ] ++
      map (\e => "  " ++ fst e ++ " == " ++ fst e ++ " = True") es ++
      [ "  _ == _ = False" ]

-- `Parser.Lexer.Reserved`: the words and the symbols the language
-- reserves.
reservedModule : (words, symbols : List Entry) -> String
reservedModule ws ss
    = unlines $
        banner ++
        [ "||| The words and symbols the language reserves. None is an identifier or"
        , "||| an operator: the lexer gives each as its kind, and the parser compares"
        , "||| kinds, never text."
        , "module Parser.Lexer.Reserved"
        , ""
        , "%default total"
        ] ++
        lexed "Keyword" "word" "keywordText" "keywordOf" ws ++
        lexed "Reserved" "symbol" "reservedText" "reservedOf" ss

-- `Parser.Lexer.Pragma`: the pragmas, how the source writes each, the one
-- a text spells, their equality, and each one's tag in a TTC with its
-- inverse. A module of its own, since a pragma and a keyword share
-- spellings (`default`, `export`, `rewrite`) and so constructor names.
pragmaModule : List Entry -> String
pragmaModule ps
    = unlines $
        banner ++
        [ "||| The pragmas the language has: a `%` and a word. The lexer gives each"
        , "||| as its kind, so a rule names the pragma it takes by a value it cannot"
        , "||| misspell and compares kinds, never text, and a module's uses of"
        , "||| pragmas are facts a reader matches on, which its TTC keeps by tag."
        , "module Parser.Lexer.Pragma"
        , ""
        , "%default total"
        ] ++
        lexed "KwPragma" "pragma" "spelling" "pragmaOf" ps ++
        numbering "pragmaTag" "pragmaAt" "KwPragma"
                  "The pragma's tag in a TTC."
                  "The pragma at a tag, if the tag is one." ps

||| Each module the vocabularies define: its path under the checkout's
||| root, and its text.
export
outputs : List (String, String)
outputs =
  [ ("compiler/idris/src/Core/Name/Known.idr", knownModule known)
  , ("compiler/idris/src/Parser/Lexer/Reserved.idr", reservedModule keywords reservedSymbols)
  , ("compiler/idris/src/Parser/Lexer/Pragma.idr", pragmaModule pragmas)
  ]

-- A text two entries of a vocabulary share, if there is one. The table of
-- identifiers holds each text at one id, and the lexer reads each text as
-- one kind, so a text written twice would leave one entry unreachable.
repeated : List Entry -> Maybe String
repeated [] = Nothing
repeated ((_, t) :: es) = if any (\e => snd e == t) es then Just t else repeated es

------------------------------------------------------------------------------
-- Writing
------------------------------------------------------------------------------

-- What knowngen was asked to do with the modules: write each that differs,
-- or only name each that differs.
data Command = WriteModules | CheckModules

commandOf : String -> Maybe Command
commandOf "write" = Just WriteModules
commandOf "check" = Just CheckModules
commandOf _ = Nothing

-- The text of a file, or nothing where there is none. Covering, not total:
-- a read runs to the file's end, which a file that never ends never reaches.
covering
readText : String -> IO (Maybe String)
readText path = do
  got <- readFile path
  case got of
    Right t => pure (Just t)
    Left _ => pure Nothing

-- Writes each module whose file differs from it; the paths it could not
-- write.
covering
writeAll : List (String, String) -> IO (List String)
writeAll [] = pure []
writeAll ((path, text) :: rest) = do
  old <- readText path
  more <- writeAll rest
  if old == Just text
    then pure more
    else do
      done <- writeFile path text
      case done of
        Right () => pure more
        Left _ => pure (path :: more)

-- The paths whose file differs from what would be written.
covering
differing : List (String, String) -> IO (List String)
differing [] = pure []
differing ((path, text) :: rest) = do
  old <- readText path
  more <- differing rest
  pure (if old == Just text then more else path :: more)

report : String -> List String -> IO ()
report _ [] = pure ()
report what (p :: ps) = do
  putStrLn ("knowngen: " ++ what ++ p)
  report what ps

-- Does what the command asks with each module; the paths it reports.
covering
run : Command -> List (String, String) -> IO (List String)
run WriteModules = writeAll
run CheckModules = differing

usage : IO ()
usage = do
  putStrLn "knowngen: write <root> | check <root>"
  exitWith (ExitFailure 2)

export
covering
main : IO ()
main = do
  args <- getArgs
  case args of
    [_, m, root] =>
      case commandOf m of
        Nothing => usage
        Just command =>
          case mapMaybe repeated [known, keywords, reservedSymbols, pragmas] of
            (t :: _) => do
              putStrLn ("knowngen: a vocabulary spells " ++ literal t ++ " twice")
              exitWith (ExitFailure 1)
            [] => do
              let files = map (\(p, t) => (root ++ "/" ++ p, t)) outputs
              failed <- run command files
              case failed of
                [] => pure ()
                ps => do
                  report (case command of
                            WriteModules => "cannot write "
                            CheckModules => "differs from the vocabulary: ") ps
                  exitWith (ExitFailure 1)
    _ => usage
