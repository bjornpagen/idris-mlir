  , ("KCons", "::")
  , ("KCons1", ":::")
  , ("KSnoc", ":<")
  , ("KAp", "<*>")
  , ("KAutoMark", "<auto>")
  , ("KEquals", "=")
  , ("KHomoEq", "===")
  , ("KSeq", ">>")
  , ("KBindOp", ">>=")
  ]

