||| The fork's vocabularies, each written once, as a list of pairs: a
||| constructor, and the text it stands for. `knowngen` (`Generate`) prints
||| from each the module of the fork that defines it, so an entry's
||| constructor, its text, its ordinal and the inverses are one entry here,
||| and nothing else holds them.
module Vocabulary

%default total

||| A constructor, and the text it stands for.
public export
Entry : Type
Entry = (String, String)

||| The operators and marks the compiler spells.
public export
symbols : List Entry
symbols =
  [ ("KDollar", "$")
  , ("KMinus", "-")
