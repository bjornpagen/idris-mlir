        , IdrisMLIR.Spec.Effects.Declaration
        , IdrisMLIR.Spec.Effects.Declarations
        , IdrisMLIR.Spec.Effects.LLVM
        , IdrisMLIR.Spec.Effects.Resource
        , IdrisMLIR.Spec.Families.Declarations
        , IdrisMLIR.Spec.Families.Dialect
        , IdrisMLIR.Spec.Families.Group
        , IdrisMLIR.Spec.Families.Layout
        , IdrisMLIR.Spec.Families.Terms
        , IdrisMLIR.Spec.Functions.Copy
        , IdrisMLIR.Spec.Functions.Declarations
        , IdrisMLIR.Spec.Functions.GivenBack
        , IdrisMLIR.Spec.Functions.LivesIn
        , IdrisMLIR.Spec.Functions.Parameters
        , IdrisMLIR.Spec.Functions.Tail
        , IdrisMLIR.Spec.Functions.Termination
        , IdrisMLIR.Spec.Grades.Declarations
