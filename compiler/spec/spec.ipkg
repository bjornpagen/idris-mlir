        , IdrisMLIR.Spec.Core.Declarations
        , IdrisMLIR.Spec.Core.Dialect
        , IdrisMLIR.Spec.Core.Enums
        , IdrisMLIR.Spec.Core.Format
        , IdrisMLIR.Spec.Core.Hooks
        , IdrisMLIR.Spec.Core.Interfaces
        , IdrisMLIR.Spec.Core.Ods
        , IdrisMLIR.Spec.Core.Op
        , IdrisMLIR.Spec.Core.Rewrite
        , IdrisMLIR.Spec.Core.Rules
        , IdrisMLIR.Spec.Core.Text
        , IdrisMLIR.Spec.Core.Types
        , IdrisMLIR.Spec.Core.Upstream
        , IdrisMLIR.Spec.Core.Vocabulary
        , IdrisMLIR.Spec.Counting.Declarations
        , IdrisMLIR.Spec.Counting.Types
