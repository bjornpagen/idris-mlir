module IdrisMLIR.Dialect.Linalg

import IdrisMLIR.MLIR
import IdrisMLIR.Spec.Core.Dialect
import IdrisMLIR.Syntax.Linalg

import Data.List

%default total

------------------------------------------------------------------------------
-- Attributes
------------------------------------------------------------------------------

||| An attribute of the linalg dialect, spelled as its syntax writes it.
export
linalg : LinalgAttr IntegerOrIndex Void -> MlirAttr
linalg x = Spelled Dialect.Linalg (MkSpelling (linalgAttrText integerOrIndexText absurd x))

------------------------------------------------------------------------------
-- Ops
------------------------------------------------------------------------------

||| `linalg.transpose`: Transpose operator
export
transposeOp : (input : Value) -> (init : Value) -> (permutation : List Integer) -> (region : Region) -> (result : List MlirType) -> Op
transposeOp input init permutation region result =
  MkOp (MkOpName Dialect.Linalg "transpose") [input, init] [("permutation", DenseI64ArrayAttr permutation)] [region] [] result

||| `linalg.yield`: Linalg yield operation
export
yieldOp : (values : List Value) -> Op
yieldOp values =
  MkOp (MkOpName Dialect.Linalg "yield") values [] [] [] []

