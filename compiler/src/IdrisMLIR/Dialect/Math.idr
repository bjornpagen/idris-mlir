||| `math.acos`: arcus cosine of the specified value
export
acosOp : {default Nothing fastmath : Maybe MlirAttr} -> (operand : Value) -> (result : MlirType) -> Op
acosOp operand result =
  MkOp (MkOpName Dialect.Math "acos") [operand] (attrIf "fastmath" id fastmath) [] [] [result]

