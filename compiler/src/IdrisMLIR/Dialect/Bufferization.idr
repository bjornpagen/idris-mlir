||| `bufferization.to_buffer`: cast a tensor-like type to buffer-like type
export
toBufferOp : {default False readOnly : Bool} -> (tensor : Value) -> (buffer : MlirType) -> Op
toBufferOp tensor buffer =
  MkOp (MkOpName Dialect.Bufferization "to_buffer") [tensor] (unitIf "read_only" readOnly) [] [] [buffer]

