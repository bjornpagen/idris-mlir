||| The scf dialect, as the Idris side writes it. Generated by
||| idris-mlir-tblgen -gen-idris-dialect from the dialect's ODS; `make build`
||| writes it (tools/dialects.sh). Do not edit.
module IdrisMLIR.Dialect.SCF

import IdrisMLIR.MLIR
import IdrisMLIR.Syntax.SCF

import Data.List
import Data.Maybe

%default total

------------------------------------------------------------------------------
-- Ops
------------------------------------------------------------------------------

||| `scf.condition`: loop continuation condition
export
conditionOp : (condition : Value) -> (args : List Value) -> Op
conditionOp condition args =
  MkOp "scf.condition" (concat [[condition], args]) [] [] [] []

||| `scf.execute_region`: operation that executes its region exactly once
export
executeRegionOp : {default False noInline : Bool} -> (region : Region) -> (result0 : List MlirType) -> Op
executeRegionOp region result0 =
  MkOp "scf.execute_region" [] (unitIf "no_inline" noInline) [region] [] result0

||| `scf.for`: for operation
export
forOp : {default False unsignedCmp : Bool} -> (lowerBound : Value) -> (upperBound : Value) -> (step : Value) -> (initArgs : List Value) -> (region : Region) -> (results : List MlirType) -> Op
forOp lowerBound upperBound step initArgs region results =
  MkOp "scf.for" (concat [[lowerBound], [upperBound], [step], initArgs]) (unitIf "unsignedCmp" unsignedCmp) [region] [] results

||| `scf.forall`: evaluate a block multiple times in parallel
export
forallOp : {default Nothing mapping : Maybe (List MlirAttr)} -> (dynamicLowerBound : List Value) -> (dynamicUpperBound : List Value) -> (dynamicStep : List Value) -> (staticLowerBound : MlirAttr) -> (staticUpperBound : MlirAttr) -> (staticStep : MlirAttr) -> (outputs : List Value) -> (region : Region) -> (results : List MlirType) -> Op
forallOp dynamicLowerBound dynamicUpperBound dynamicStep staticLowerBound staticUpperBound staticStep outputs region results =
  MkOp "scf.forall" (concat [dynamicLowerBound, dynamicUpperBound, dynamicStep, outputs]) ([("staticLowerBound", staticLowerBound), ("staticUpperBound", staticUpperBound), ("staticStep", staticStep)] ++ attrIf "mapping" ArrayAttr mapping ++ [("operandSegmentSizes", DenseI32ArrayAttr [length dynamicLowerBound, length dynamicUpperBound, length dynamicStep, length outputs])]) [region] [] results

||| `scf.forall.in_parallel`: terminates a `forall` block
export
forallInParallelOp : (region : Region) -> Op
forallInParallelOp region =
  MkOp "scf.forall.in_parallel" [] [] [region] [] []

||| `scf.if`: if-then-else operation
export
ifOp : (condition : Value) -> (thenRegion : Region) -> (elseRegion : Region) -> (results : List MlirType) -> Op
ifOp condition thenRegion elseRegion results =
  MkOp "scf.if" [condition] [] [thenRegion, elseRegion] [] results

||| `scf.index_switch`: switch-case operation on an index argument
export
indexSwitchOp : (arg : Value) -> (cases : MlirAttr) -> (defaultRegion : Region) -> (caseRegions : List Region) -> (results : List MlirType) -> Op
indexSwitchOp arg cases defaultRegion caseRegions results =
  MkOp "scf.index_switch" [arg] [("cases", cases)] (concat [[defaultRegion], caseRegions]) [] results

||| `scf.parallel`: parallel for operation
export
parallelOp : {default False unsignedCmp : Bool} -> (lowerBound : List Value) -> (upperBound : List Value) -> (step : List Value) -> (initVals : List Value) -> (region : Region) -> (results : List MlirType) -> Op
parallelOp lowerBound upperBound step initVals region results =
  MkOp "scf.parallel" (concat [lowerBound, upperBound, step, initVals]) (unitIf "unsignedCmp" unsignedCmp ++ [("operandSegmentSizes", DenseI32ArrayAttr [length lowerBound, length upperBound, length step, length initVals])]) [region] [] results

||| `scf.reduce`: reduce operation for scf.parallel
export
reduceOp : (operands : List Value) -> (reductions : List Region) -> Op
reduceOp operands reductions =
  MkOp "scf.reduce" operands [] reductions [] []

||| `scf.reduce.return`: terminator for reduce operation
export
reduceReturnOp : (result : Value) -> Op
reduceReturnOp result =
  MkOp "scf.reduce.return" [result] [] [] [] []

||| `scf.while`: a generic 'while' loop
export
whileOp : (inits : List Value) -> (before : Region) -> (after : Region) -> (results : List MlirType) -> Op
whileOp inits before after results =
  MkOp "scf.while" inits [] [before, after] [] results

||| `scf.yield`: loop yield and termination operation
export
yieldOp : (results : List Value) -> Op
yieldOp results =
  MkOp "scf.yield" results [] [] [] []

------------------------------------------------------------------------------
-- Printer
------------------------------------------------------------------------------

-- An attribute an op's syntax writes without its type, which the parser
-- is given and does not read.
covering
bare : MlirAttr -> String
bare (IntegerAttr n _) = show n
bare (FloatAttr d _) = floatLiteral d
bare a = attrText a

-- The name of the symbol an op declares, as a reference to it writes it.
covering
symbolName : MlirAttr -> String
symbolName (StringAttr s) = symbol s
symbolName a = attrText a

||| An op of the scf dialect in the declarative syntax its ODS
||| gives, up to its regions: its full name and its syntax, which puts the
||| regions last, for the caller to write after it. Nothing for an op
||| written in the generic form: one whose syntax this printer does not
||| write (each is named below, with the reason), one of another dialect,
||| and one whose operands, results, regions or attributes are not what its
||| ODS lets it have, which the generic form carries to the verifier.
export covering
printOp : Op -> Maybe String
printOp (MkOp "scf.condition" (o0 :: o1) props [] attrs []) = do
  guard (null props)
  pure (fastConcat ["scf.condition (", o0.name, ")", dictionary "{" "}" attrs, (if not (null o1) then fastConcat [(if null o1 then "" else " " ++ commaSeparated (map (.name) o1)), " :", (if null (map (.type) o1) then "" else " " ++ commaSeparated (map typeText (map (.type) o1)))] else "")])

printOp (MkOp "scf.reduce.return" [o0] props [] attrs []) = do
  guard (null props)
  pure (fastConcat ["scf.reduce.return ", o0.name, dictionary "{" "}" attrs, " : ", typeText o0.type])

printOp (MkOp "scf.yield" o0 props [] attrs []) = do
  guard (null props)
  pure (fastConcat ["scf.yield", dictionary "{" "}" attrs, (if not (null o0) then fastConcat [(if null o0 then "" else " " ++ commaSeparated (map (.name) o0)), " :", (if null (map (.type) o0) then "" else " " ++ commaSeparated (map typeText (map (.type) o0)))] else "")])

printOp _ = Nothing

