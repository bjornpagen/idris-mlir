module IdrisMLIR.Dialect.Tensor

import IdrisMLIR.MLIR
import IdrisMLIR.Spec.Core.Dialect
import IdrisMLIR.Syntax.Tensor

import Data.List

%default total

------------------------------------------------------------------------------
-- Ops
------------------------------------------------------------------------------

||| `tensor.cast`: tensor cast operation
export
castOp : (source : Value) -> (dest : MlirType) -> Op
castOp source dest =
  MkOp (MkOpName Dialect.Tensor "cast") [source] [] [] [] [dest]

||| `tensor.collapse_shape`: operation to produce a tensor with a smaller rank
export
collapseShapeOp : (src : Value) -> (reassociation : List MlirAttr) -> (result : MlirType) -> Op
collapseShapeOp src reassociation result =
  MkOp (MkOpName Dialect.Tensor "collapse_shape") [src] [("reassociation", ArrayAttr reassociation)] [] [] [result]

||| `tensor.concat`: tensor concatenation operation
export
concatOp : (dim : Integer) -> (inputs : List Value) -> (result : MlirType) -> Op
concatOp dim inputs result =
  MkOp (MkOpName Dialect.Tensor "concat") inputs [("dim", IntegerAttr dim (OfWidth 64))] [] [] [result]

||| `tensor.dim`: dimension index operation
export
dimOp : (source : Value) -> (index : Value) -> (result : MlirType) -> Op
dimOp source index result =
  MkOp (MkOpName Dialect.Tensor "dim") [source, index] [] [] [] [result]

||| `tensor.empty`: empty tensor operation
export
emptyOp : (dynamicSizes : List Value) -> (result : MlirType) -> Op
emptyOp dynamicSizes result =
  MkOp (MkOpName Dialect.Tensor "empty") dynamicSizes [] [] [] [result]

||| `tensor.expand_shape`: operation to produce a tensor with a higher rank
export
expandShapeOp : (src : Value) -> (reassociation : List MlirAttr) -> (outputShape : List Value) -> (staticOutputShape : List Integer) -> (result : MlirType) -> Op
expandShapeOp src reassociation outputShape staticOutputShape result =
  MkOp (MkOpName Dialect.Tensor "expand_shape") ([src] ++ outputShape) [("reassociation", ArrayAttr reassociation), ("static_output_shape", DenseI64ArrayAttr staticOutputShape)] [] [] [result]

||| `tensor.extract`: element extraction operation
export
extractOp : (tensor : Value) -> (indices : List Value) -> (result : MlirType) -> Op
extractOp tensor indices result =
  MkOp (MkOpName Dialect.Tensor "extract") ([tensor] ++ indices) [] [] [] [result]

||| `tensor.extract_slice`: extract slice operation
export
extractSliceOp : (source : Value) -> (offsets : List Value) -> (sizes : List Value) -> (strides : List Value) -> (staticOffsets : List Integer) -> (staticSizes : List Integer) -> (staticStrides : List Integer) -> (result : MlirType) -> Op
extractSliceOp source offsets sizes strides staticOffsets staticSizes staticStrides result =
  MkOp (MkOpName Dialect.Tensor "extract_slice") ([source] ++ offsets ++ sizes ++ strides) [("static_offsets", DenseI64ArrayAttr staticOffsets), ("static_sizes", DenseI64ArrayAttr staticSizes), ("static_strides", DenseI64ArrayAttr staticStrides), ("operandSegmentSizes", DenseI32ArrayAttr [1, length offsets, length sizes, length strides])] [] [] [result]

||| `tensor.from_elements`: tensor from elements operation.
export
fromElementsOp : (elements : List Value) -> (result : MlirType) -> Op
fromElementsOp elements result =
  MkOp (MkOpName Dialect.Tensor "from_elements") elements [] [] [] [result]

||| `tensor.insert`: element insertion operation
export
insertOp : (scalar : Value) -> (dest : Value) -> (indices : List Value) -> (result : MlirType) -> Op
insertOp scalar dest indices result =
  MkOp (MkOpName Dialect.Tensor "insert") ([scalar, dest] ++ indices) [] [] [] [result]

||| `tensor.insert_slice`: insert_slice operation
export
insertSliceOp : (source : Value) -> (dest : Value) -> (offsets : List Value) -> (sizes : List Value) -> (strides : List Value) -> (staticOffsets : List Integer) -> (staticSizes : List Integer) -> (staticStrides : List Integer) -> (result : MlirType) -> Op
insertSliceOp source dest offsets sizes strides staticOffsets staticSizes staticStrides result =
  MkOp (MkOpName Dialect.Tensor "insert_slice") ([source, dest] ++ offsets ++ sizes ++ strides) [("static_offsets", DenseI64ArrayAttr staticOffsets), ("static_sizes", DenseI64ArrayAttr staticSizes), ("static_strides", DenseI64ArrayAttr staticStrides), ("operandSegmentSizes", DenseI32ArrayAttr [1, 1, length offsets, length sizes, length strides])] [] [] [result]

||| `tensor.pad`: tensor pad operation
export
padOp : {default False nofold : Bool} -> (source : Value) -> (low : List Value) -> (high : List Value) -> (staticLow : List Integer) -> (staticHigh : List Integer) -> (region : Region) -> (result : MlirType) -> Op
padOp source low high staticLow staticHigh region result =
  MkOp (MkOpName Dialect.Tensor "pad") ([source] ++ low ++ high) ([("static_low", DenseI64ArrayAttr staticLow), ("static_high", DenseI64ArrayAttr staticHigh)] ++ unitIf "nofold" nofold ++ [("operandSegmentSizes", DenseI32ArrayAttr [1, length low, length high])]) [region] [] [result]

||| `tensor.yield`: Yield a value from a region
export
yieldOp : (value : Value) -> Op
yieldOp value =
  MkOp (MkOpName Dialect.Tensor "yield") [value] [] [] [] []

