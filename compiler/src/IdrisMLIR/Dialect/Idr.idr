||| `idr.str.of_errno`: the text of an error number, a new string
export
strOfErrnoOp : Value -> MlirType -> Op
strOfErrnoOp code' str' =
  MkOp (MkOpName Dialect.Idr "str.of_errno") ([code']) ([]) ([]) [] ([str'])

||| `idr.io.clock`: a reading of a clock, or -1 where it cannot be read
export
ioClockOp : IdrisMLIR.Spec.Runtime.Clocks.ClockKind -> Op
ioClockOp kind' =
  MkOp (MkOpName Dialect.Idr "io.clock") ([]) ([("kind", enumAttr IdrisMLIR.Spec.Runtime.Clocks.clockKindClosed kind')]) ([]) [] ([IntegerType 64])

||| `idr.handle.string`: the string a string handle holds, with a reference of its own
export
handleStringOp : Value -> MlirType -> Guarded
handleStringOp handle' str' =
  Checking (MkOpName Dialect.Idr "check.holds_string") (caseAt IdrisMLIR.Spec.Runtime.Endings.causeClosed 7) handle' [] (\handle' =>
    Unguarded (MkOp (MkOpName Dialect.Idr "handle.string") ([handle']) ([]) ([]) [] ([str'])))

||| `idr.io.handle_free`: releases a handle's slot
export
ioHandleFreeOp : Value -> Op
ioHandleFreeOp handle' =
  MkOp (MkOpName Dialect.Idr "io.handle_free") ([handle']) ([]) ([]) [] ([])

||| `idr.fn.closure`: a closure of a function: its leading parameters are the captures
export
fnClosureOp : {default Nothing index_args' : Maybe MlirAttr} -> MlirAttr -> List Value -> MlirType -> Op
fnClosureOp {index_args'} callee' captures' result' =
  MkOp (MkOpName Dialect.Idr "fn.closure") (captures') ([("callee", callee')] ++ attrIf "index_args" id index_args') ([]) [] ([result'])

||| `idr.lazy.suspend`: a suspension of a function: every parameter is a capture
export
lazySuspendOp : {default Nothing index_args' : Maybe MlirAttr} -> MlirAttr -> List Value -> MlirType -> Op
lazySuspendOp {index_args'} callee' captures' result' =
  MkOp (MkOpName Dialect.Idr "lazy.suspend") (captures') ([("callee", callee')] ++ attrIf "index_args" id index_args') ([]) [] ([result'])

||| `idr.lazy.delay`: a suspension already evaluated: it holds its operand
export
lazyDelayOp : Value -> MlirType -> Op
lazyDelayOp value' result' =
  MkOp (MkOpName Dialect.Idr "lazy.delay") ([value']) ([]) ([]) [] ([result'])

||| `idr.lazy.force`: the value of a suspension, computed on the first force and shared
export
lazyForceOp : Value -> MlirType -> Op
lazyForceOp suspension' result' =
  MkOp (MkOpName Dialect.Idr "lazy.force") ([suspension']) ([]) ([]) [] ([result'])

||| `idr.fn.apply`: applies a closure to arguments
export
fnApplyOp : {default Nothing arg_attrs' : Maybe MlirAttr} -> {default Nothing res_attrs' : Maybe MlirAttr} -> Value -> List Value -> List MlirType -> Op
fnApplyOp {arg_attrs'} {res_attrs'} callee' args' results' =
  MkOp (MkOpName Dialect.Idr "fn.apply") ([callee'] ++ args') (attrIf "arg_attrs" id arg_attrs' ++ attrIf "res_attrs" id res_attrs') ([]) [] (results')

