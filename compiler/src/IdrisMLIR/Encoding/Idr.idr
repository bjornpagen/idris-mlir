||| The idr dialect's bytecode entries, as the Idris side writes
||| them: the code of each of its records, and the parts of each record whose
||| members' kinds are known, from its members in order, a type as the parts
||| the writer gives for it. Generated by
||| idris-mlir-tblgen -gen-idris-bytecode from the dialect's bytecode records,
||| from which mlir-tblgen -gen-bytecode writes the C++ reader; `make build`
||| writes it (tools/dialects.sh). Do not edit.
module IdrisMLIR.Encoding.Idr

import IdrisMLIR.MLIR.Parts
import IdrisMLIR.Syntax.Idr

%default total

------------------------------------------------------------------------------
-- Types
------------------------------------------------------------------------------

||| The code of `QType`, its place among the dialect's types.
export
qTypeCode : Nat
qTypeCode = 0

||| The parts of `QType`: its code, `quantity`, `permission`, `value`, `lifetime`.
export
encodeQType : Quantity -> Permission -> List Part -> Lifetime -> List Part
encodeQType quantity permission value lifetime = [VarInt qTypeCode, VarInt (quantityValue quantity), VarInt (permissionValue permission)] ++ value ++ [VarInt (lifetimeValue lifetime)]

||| The code of `FnType`, its place among the dialect's types.
export
fnTypeCode : Nat
fnTypeCode = 1

||| The parts of `FnType`: its code, `function_type`.
export
encodeFnType : List Part -> List Part
encodeFnType functionType = [VarInt fnTypeCode] ++ functionType

||| The code of `LazyType`, its place among the dialect's types.
export
lazyTypeCode : Nat
lazyTypeCode = 2

||| The parts of `LazyType`: its code, `value`.
export
encodeLazyType : List Part -> List Part
encodeLazyType value = [VarInt lazyTypeCode] ++ value

||| The code of `BoxType`, its place among the dialect's types.
export
boxTypeCode : Nat
boxTypeCode = 3

||| The parts of `BoxType`: its code, `data`.
export
encodeBoxType : List Part -> List Part
encodeBoxType data' = [VarInt boxTypeCode] ++ data'

||| The code of `DestType`, its place among the dialect's types.
export
destTypeCode : Nat
destTypeCode = 4

||| The parts of `DestType`: its code, `value`.
export
encodeDestType : List Part -> List Part
encodeDestType value = [VarInt destTypeCode] ++ value

------------------------------------------------------------------------------
-- Attributes
------------------------------------------------------------------------------

||| The code of `DataTable`, its place among the dialect's attributes.
export
dataTableCode : Nat
dataTableCode = 0

||| The parts of `DataTable`: its code, `rows`.
export
encodeDataTable : List (String, SumKind, List (String, CtorRole, Maybe AttrRef, Nat, List (List Part)), Maybe AttrRef) -> List Part
encodeDataTable rows = [VarInt dataTableCode, VarInt (length rows)] ++ concatMap (\(name, kind, ctors, instance) => [Str name, VarInt (sumKindValue kind), VarInt (length ctors)] ++ concatMap (\(name', role, label, byName, fields) => [Str name', VarInt (ctorRoleValue role), OptionalAttrAt label, VarInt byName, VarInt (length fields)] ++ concat fields) ctors ++ [OptionalAttrAt instance]) rows

