||| The idr dialect's bytecode entries, as the Idris side writes
||| them: the code of each of its records, and the parts of each record whose
||| members' kinds are known, from its members in order, a type as the parts
||| the writer gives for it; and the field codes and the records of the
||| module's table of data types, where the dialect has one. Generated by
||| idris-mlir-tblgen -gen-idris-bytecode from the dialect's bytecode records,
||| from which mlir-tblgen -gen-bytecode writes the C++ reader; `make build`
||| writes it (tools/dialects.sh). Do not edit.
module IdrisMLIR.Encoding.Idr

import IdrisMLIR.MLIR.Parts
import IdrisMLIR.Syntax.Idr

%default total

------------------------------------------------------------------------------
-- Types
------------------------------------------------------------------------------

||| The code of `DataType`, its place among the dialect's types.
export
dataTypeCode : Nat
dataTypeCode = 0

||| The parts of `DataType`: its code, `table`, `index`.
export
encodeDataType : AttrRef -> Nat -> List Part
encodeDataType table index = [VarInt dataTypeCode, AttrAt table, VarInt index]

||| The code of `QType`, its place among the dialect's types.
export
qTypeCode : Nat
qTypeCode = 1

||| The parts of `QType`: its code, `quantity`, `permission`, `value`, `lifetime`.
export
encodeQType : Quantity -> Permission -> List Part -> Lifetime -> List Part
encodeQType quantity permission value lifetime = [VarInt qTypeCode, VarInt (quantityValue quantity), VarInt (permissionValue permission)] ++ value ++ [VarInt (lifetimeValue lifetime)]

||| The code of `FnType`, its place among the dialect's types.
export
fnTypeCode : Nat
fnTypeCode = 2

||| The parts of `FnType`: its code, `function_type`.
export
encodeFnType : List Part -> List Part
encodeFnType functionType = [VarInt fnTypeCode] ++ functionType

||| The code of `LazyType`, its place among the dialect's types.
export
lazyTypeCode : Nat
lazyTypeCode = 3

||| The parts of `LazyType`: its code, `value`.
export
encodeLazyType : List Part -> List Part
encodeLazyType value = [VarInt lazyTypeCode] ++ value

||| The code of `BoxType`, its place among the dialect's types.
export
boxTypeCode : Nat
boxTypeCode = 4

||| The parts of `BoxType`: its code, `data`.
export
encodeBoxType : List Part -> List Part
encodeBoxType data' = [VarInt boxTypeCode] ++ data'

||| The code of `DestType`, its place among the dialect's types.
export
destTypeCode : Nat
destTypeCode = 5

||| The parts of `DestType`: its code, `value`.
export
encodeDestType : List Part -> List Part
encodeDestType value = [VarInt destTypeCode] ++ value

------------------------------------------------------------------------------
-- Attributes
------------------------------------------------------------------------------

||| The code of `DataTable`, its place among the dialect's attributes.
export
dataTableCode : Nat
dataTableCode = 0

------------------------------------------------------------------------------
-- The table of data types
------------------------------------------------------------------------------

||| The code of `FieldEntry`, its place among the field codes of the table of data types.
export
fieldEntryCode : Nat
fieldEntryCode = 0

||| The code of `FieldMember`, its place among the field codes of the table of data types.
export
fieldMemberCode : Nat
fieldMemberCode = 1

||| The code of `FieldIdr`, its place among the field codes of the table of data types.
export
fieldIdrCode : Nat
fieldIdrCode = 2

||| The code of `FieldBuiltin`, its place among the field codes of the table of data types.
export
fieldBuiltinCode : Nat
fieldBuiltinCode = 3

||| The parts of `TableCtor`: `name`, `role`, `fields`.
export
encodeTableCtor : String -> CtorRole -> List (List Part) -> List Part
encodeTableCtor name role fields = [Str name, VarInt (ctorRoleValue role), VarInt (length fields)] ++ concat fields

||| The parts of `TableBody`: `kind`, `ctors`, `instance`.
export
encodeTableBody : SumKind -> List (List Part) -> Maybe AttrRef -> List Part
encodeTableBody kind ctors instance = [VarInt (sumKindValue kind), VarInt (length ctors)] ++ concat ctors ++ [OptionalAttrAt instance]

