||| The builtin dialect's bytecode entries the frontend writes, as
||| the Idris side writes them: the code of each record the specification
||| admits, its place among all of the dialect's, and the parts of each whose
||| members' kinds are known, from its members in order, a type as the parts
||| the writer gives for it. Generated by
||| idris-mlir-tblgen -gen-idris-bytecode from the dialect's entries file and
||| the bytecode records it includes, from which mlir-tblgen -gen-bytecode
||| writes the C++ reader;
||| `make test-mlir-tools` generates it again and fails on any difference.
||| Do not edit.
module IdrisMLIR.Encoding.Builtin

import IdrisMLIR.MLIR.Parts

%default total

------------------------------------------------------------------------------
-- Types
------------------------------------------------------------------------------

||| The code of `IntegerType`, its place among the dialect's types.
export
integerTypeCode : Nat
integerTypeCode = 0

||| The code of `IndexType`, its place among the dialect's types.
export
indexTypeCode : Nat
indexTypeCode = 1

||| The parts of `IndexType`: its code.
export
encodeIndexType : List Part
encodeIndexType = [VarInt indexTypeCode]

||| The code of `FunctionType`, its place among the dialect's types.
export
functionTypeCode : Nat
functionTypeCode = 2

||| The parts of `FunctionType`: its code, `inputs`, `results`.
export
encodeFunctionType : List (List Part) -> List (List Part) -> List Part
encodeFunctionType inputs results = [VarInt functionTypeCode, VarInt (length inputs)] ++ concat inputs ++ [VarInt (length results)] ++ concat results

||| The code of `Float64Type`, its place among the dialect's types.
export
float64TypeCode : Nat
float64TypeCode = 6

||| The parts of `Float64Type`: its code.
export
encodeFloat64Type : List Part
encodeFloat64Type = [VarInt float64TypeCode]

||| The code of `MemRefType`, its place among the dialect's types.
export
memRefTypeCode : Nat
memRefTypeCode = 10

||| The parts of `MemRefType`: its code, `shape`, `elementType`, `layout`.
export
encodeMemRefType : List Integer -> List Part -> AttrRef -> List Part
encodeMemRefType shape elementType layout = [VarInt memRefTypeCode, VarInt (length shape)] ++ map SignedVarInt shape ++ elementType ++ [AttrAt layout]

||| The code of `MemRefTypeWithMemSpace`, its place among the dialect's types.
export
memRefTypeWithMemSpaceCode : Nat
memRefTypeWithMemSpaceCode = 11

||| The parts of `MemRefTypeWithMemSpace`: its code, `memorySpace`, `shape`, `elementType`, `layout`.
export
encodeMemRefTypeWithMemSpace : AttrRef -> List Integer -> List Part -> AttrRef -> List Part
encodeMemRefTypeWithMemSpace memorySpace shape elementType layout = [VarInt memRefTypeWithMemSpaceCode, AttrAt memorySpace, VarInt (length shape)] ++ map SignedVarInt shape ++ elementType ++ [AttrAt layout]

||| The code of `NoneType`, its place among the dialect's types.
export
noneTypeCode : Nat
noneTypeCode = 12

||| The parts of `NoneType`: its code.
export
encodeNoneType : List Part
encodeNoneType = [VarInt noneTypeCode]

||| The code of `RankedTensorType`, its place among the dialect's types.
export
rankedTensorTypeCode : Nat
rankedTensorTypeCode = 13

||| The parts of `RankedTensorType`: its code, `shape`, `elementType`.
export
encodeRankedTensorType : List Integer -> List Part -> List Part
encodeRankedTensorType shape elementType = [VarInt rankedTensorTypeCode, VarInt (length shape)] ++ map SignedVarInt shape ++ elementType

||| The code of `TokenType`, its place among the dialect's types.
export
tokenTypeCode : Nat
tokenTypeCode = 33

||| The parts of `TokenType`: its code.
export
encodeTokenType : List Part
encodeTokenType = [VarInt tokenTypeCode]

------------------------------------------------------------------------------
-- Attributes
------------------------------------------------------------------------------

||| The code of `ArrayAttr`, its place among the dialect's attributes.
export
arrayAttrCode : Nat
arrayAttrCode = 0

||| The parts of `ArrayAttr`: its code, `value`.
export
encodeArrayAttr : List AttrRef -> List Part
encodeArrayAttr value = [VarInt arrayAttrCode, VarInt (length value)] ++ map AttrAt value

||| The code of `DictionaryAttr`, its place among the dialect's attributes.
export
dictionaryAttrCode : Nat
dictionaryAttrCode = 1

||| The parts of `DictionaryAttr`: its code, `value`.
export
encodeDictionaryAttr : List (AttrRef, AttrRef) -> List Part
encodeDictionaryAttr value = [VarInt dictionaryAttrCode, VarInt (length value)] ++ concatMap (\(name, value') => [AttrAt name, AttrAt value']) value

||| The code of `StringAttr`, its place among the dialect's attributes.
export
stringAttrCode : Nat
stringAttrCode = 2

||| The parts of `StringAttr`: its code, `value`.
export
encodeStringAttr : String -> List Part
encodeStringAttr value = [VarInt stringAttrCode, Str value]

||| The code of `TypeAttr`, its place among the dialect's attributes.
export
typeAttrCode : Nat
typeAttrCode = 6

||| The parts of `TypeAttr`: its code, `value`.
export
encodeTypeAttr : List Part -> List Part
encodeTypeAttr value = [VarInt typeAttrCode] ++ value

||| The code of `FloatAttr`, its place among the dialect's attributes.
export
floatAttrCode : Nat
floatAttrCode = 9

||| The code of `FileLineColLoc`, its place among the dialect's attributes.
export
fileLineColLocCode : Nat
fileLineColLocCode = 11

||| The parts of `FileLineColLoc`: its code, `filename`, `start_line`, `start_column`.
export
encodeFileLineColLoc : AttrRef -> Nat -> Nat -> List Part
encodeFileLineColLoc filename startLine startColumn = [VarInt fileLineColLocCode, AttrAt filename, VarInt startLine, VarInt startColumn]

||| The code of `FusedLocWithMetadata`, its place among the dialect's attributes.
export
fusedLocWithMetadataCode : Nat
fusedLocWithMetadataCode = 13

||| The parts of `FusedLocWithMetadata`: its code, `locations`, `metadata`.
export
encodeFusedLocWithMetadata : List AttrRef -> AttrRef -> List Part
encodeFusedLocWithMetadata locations metadata = [VarInt fusedLocWithMetadataCode, VarInt (length locations)] ++ map AttrAt locations ++ [AttrAt metadata]

||| The code of `NameLoc`, its place among the dialect's attributes.
export
nameLocCode : Nat
nameLocCode = 14

||| The parts of `NameLoc`: its code, `name`, `childLoc`.
export
encodeNameLoc : AttrRef -> AttrRef -> List Part
encodeNameLoc name childLoc = [VarInt nameLocCode, AttrAt name, AttrAt childLoc]

||| The code of `UnknownLoc`, its place among the dialect's attributes.
export
unknownLocCode : Nat
unknownLocCode = 15

||| The parts of `UnknownLoc`: its code.
export
encodeUnknownLoc : List Part
encodeUnknownLoc = [VarInt unknownLocCode]

||| The code of `FileLineColRange`, its place among the dialect's attributes.
export
fileLineColRangeCode : Nat
fileLineColRangeCode = 22

-- Not generated:
-- type IntegerType: its member `width` is read by `(($_var = _widthAndSignedness >> 2), true)`
-- attribute FloatAttr: its member `value` is read by `succeeded(readAPFloatWithKnownSemantics($_reader, type, $_var))`
-- attribute FileLineColRange: its member `rawLocData` is read by `succeeded(readFileLineColRangeLocs($_reader, $_var))`
