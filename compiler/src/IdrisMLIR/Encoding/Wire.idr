||| The values the idr dialect's types and attributes the frontend writes
||| hold that a wire of the specification lays out: each one's type, over
||| what the types `ty` and attributes `at` it holds are, one constructor
||| per case the frontend writes, and its parts, as the dialect's C++
||| reader reads them. Printed from the dialect's specification.
module IdrisMLIR.Encoding.Wire

import IdrisMLIR.MLIR.Parts
import IdrisMLIR.Spec.Core.Enums
import IdrisMLIR.Spec.Families.Group
import IdrisMLIR.Spec.Families.Dialect

%default total

||| one node of an index term, in preorder
public export
data TermNode : (ty : Type) -> (at : Type) -> Type where
  ||| a natural, a number
  TermNodeNatural : (value' : Nat) -> TermNode ty at
  ||| a binder, by its level in its scope
  TermNodeLevel : (value' : Nat) -> TermNode ty at
  ||| a level plus a positive count
  TermNodeSuccessor : (value' : Nat) -> TermNode ty at
  ||| levels, each with how often it occurs, plus a count
  TermNodeSum : (value' : Nat) -> (arity' : Nat) -> TermNode ty at
  ||| a level of a sum, with how often it occurs there
  TermNodeMultiple : (value' : Nat) -> TermNode ty at
  ||| a constant of a scalar sort, or a type
  TermNodeLiteral : (payload' : at) -> TermNode ty at
  ||| a constructor applied to its binders and fields
  TermNodeConstructor : (payload' : Maybe at) -> (member' : Nat) -> (value' : Nat) -> (arity' : Nat) -> TermNode ty at
  ||| an index outside the language, which refines nothing
  TermNodeOpaque : TermNode ty at

||| The parts of a `TermNode`, its types and attributes by their entries.
export
partsTermNode : TermNode TypeRef AttrRef -> List Part
partsTermNode (TermNodeNatural value') = [VarInt 0] ++ [VarInt value']
partsTermNode (TermNodeLevel value') = [VarInt 1] ++ [VarInt value']
partsTermNode (TermNodeSuccessor value') = [VarInt 2] ++ [VarInt value']
partsTermNode (TermNodeSum value' arity') = [VarInt 3] ++ [VarInt value'] ++ [VarInt arity']
partsTermNode (TermNodeMultiple value') = [VarInt 4] ++ [VarInt value']
partsTermNode (TermNodeLiteral payload') = [VarInt 5] ++ [AttrAt payload']
partsTermNode (TermNodeConstructor payload' member' value' arity') = [VarInt 6] ++ [OptionalAttrAt payload'] ++ [VarInt member'] ++ [VarInt value'] ++ [VarInt arity']
partsTermNode TermNodeOpaque = [VarInt 7]

||| the sort of an index position or a binder
public export
data SortOf : (ty : Type) -> (at : Type) -> Type where
  ||| a natural, or a member whose values are numbers
  SortOfNatSort : SortOf ty at
  ||| an Idris type, by the MLIR type it is
  SortOfTypeSort : SortOf ty at
  ||| anything else: levels and opaque terms alone
  SortOfOpaqueSort : SortOf ty at
  ||| a scalar type, whose literals are its terms
  SortOfScalarSort : (payload' : at) -> SortOf ty at
  ||| a member of a family, whose constructors are its terms
  SortOfFamilySort : (payload' : Maybe at) -> (member' : Nat) -> SortOf ty at

||| The parts of a `SortOf`, its types and attributes by their entries.
export
partsSortOf : SortOf TypeRef AttrRef -> List Part
partsSortOf SortOfNatSort = [VarInt 0]
partsSortOf SortOfTypeSort = [VarInt 1]
partsSortOf SortOfOpaqueSort = [VarInt 2]
partsSortOf (SortOfScalarSort payload') = [VarInt 3] ++ [AttrAt payload']
partsSortOf (SortOfFamilySort payload' member') = [VarInt 4] ++ [OptionalAttrAt payload'] ++ [VarInt member']

||| a constructor of a data member or a frame stack
public export
data CtorDecl : (ty : Type) -> (at : Type) -> Type where
  ||| a constructor of a data member or a frame stack
  MkCtorDecl : (label' : String) -> (binders' : List (SortOf ty at)) -> (equation' : List (TermNode ty at)) -> (fields' : List (ty)) -> CtorDecl ty at

||| The parts of a `CtorDecl`, its types and attributes by their entries.
export
partsCtorDecl : CtorDecl TypeRef AttrRef -> List Part
partsCtorDecl (MkCtorDecl label' binders' equation' fields') = [Str label'] ++ (VarInt (length binders') :: concatMap (\x' => partsSortOf x') binders') ++ (VarInt (length equation') :: concatMap (\x' => partsTermNode x') equation') ++ (VarInt (length fields') :: concatMap (\x' => [TypeAt x']) fields')

||| Idris's data, its declaration's constructors
public export
data DataMember : (ty : Type) -> (at : Type) -> Type where
  ||| Idris's data, its declaration's constructors
  MkDataMember : (label' : String) -> (promise' : IdrisMLIR.Spec.Families.Group.Promise) -> (loc' : at) -> (indices' : List (SortOf ty at)) -> (ctors' : List (CtorDecl ty at)) -> DataMember ty at

||| The parts of a `DataMember`, its types and attributes by their entries.
export
partsDataMember : DataMember TypeRef AttrRef -> List Part
partsDataMember (MkDataMember label' promise' loc' indices' ctors') = [Str label'] ++ [VarInt (position IdrisMLIR.Spec.Families.Dialect.promiseClosed promise')] ++ [AttrAt loc'] ++ (VarInt (length indices') :: concatMap (\x' => partsSortOf x') indices') ++ (VarInt (length ctors') :: concatMap (\x' => partsCtorDecl x') ctors')

||| a member of a family, its alternative its kind
public export
data MemberOf : (ty : Type) -> (at : Type) -> Type where
  ||| Idris's data, its declaration's constructors
  MemberOfData : (dataMember' : DataMember ty at) -> MemberOf ty at

||| The parts of a `MemberOf`, its types and attributes by their entries.
export
partsMemberOf : MemberOf TypeRef AttrRef -> List Part
partsMemberOf (MemberOfData dataMember') = [VarInt 0] ++ partsDataMember dataMember'

