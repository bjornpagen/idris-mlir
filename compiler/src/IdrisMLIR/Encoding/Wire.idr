data LifetimeKindRoom : (ty : Type) -> (at : Type) -> Type where
  ||| a room: a block of static size
  MkLifetimeKindRoom : LifetimeKindRoom ty at

||| The parts of a `LifetimeKindRoom`, its types and attributes by their entries.
