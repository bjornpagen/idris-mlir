namespace FastMathFlags
  ||| Floating point fast math flags
  public export
  data FastMathFlags = Reassoc | Nnan | Ninf | Nsz | Arcp | Contract | Afn

export
Prelude.EqOrd.Eq FastMathFlags where
  FastMathFlags.Reassoc == FastMathFlags.Reassoc = True
  FastMathFlags.Nnan == FastMathFlags.Nnan = True
  FastMathFlags.Ninf == FastMathFlags.Ninf = True
  FastMathFlags.Nsz == FastMathFlags.Nsz = True
  FastMathFlags.Arcp == FastMathFlags.Arcp = True
  FastMathFlags.Contract == FastMathFlags.Contract = True
  FastMathFlags.Afn == FastMathFlags.Afn = True
  _ == _ = False

-- How the syntax below spells each FastMathFlags.
fastMathFlagsSpelling : FastMathFlags -> String
fastMathFlagsSpelling FastMathFlags.Reassoc = "reassoc"
fastMathFlagsSpelling FastMathFlags.Nnan = "nnan"
fastMathFlagsSpelling FastMathFlags.Ninf = "ninf"
fastMathFlagsSpelling FastMathFlags.Nsz = "nsz"
fastMathFlagsSpelling FastMathFlags.Arcp = "arcp"
fastMathFlagsSpelling FastMathFlags.Contract = "contract"
fastMathFlagsSpelling FastMathFlags.Afn = "afn"

-- How the syntax below spells a set of FastMathFlags: its bits, apart.
fastMathFlagsSpellings : List FastMathFlags -> String
fastMathFlagsSpellings [] = "none"
fastMathFlagsSpellings es = separated "," (map fastMathFlagsSpelling es)

