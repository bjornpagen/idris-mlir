------------------------------------------------------------------------------
-- Attributes
------------------------------------------------------------------------------

||| The arith dialect's attributes, one constructor each, named
||| after its C++ class; `ty` is the type of the types they hold, `at` of the
||| attributes.
public export
data ArithAttr : (ty : Type) -> (at : Type) -> Type where
  ||| `#arith.fastmath`: Floating point fast math flags
  FastMathFlagsAttr : (value : List FastMathFlags) -> ArithAttr ty at
  ||| `#arith.overflow`: Integer overflow arith flags
  IntegerOverflowFlagsAttr : (value : List IntegerOverflowFlags) -> ArithAttr ty at

||| The mnemonics of the arith dialect's attributes.
export
arithAttrMnemonics : List String
arithAttrMnemonics = ["fastmath", "overflow"]

||| The mnemonic of each of the arith dialect's attributes.
export
arithAttrMnemonic : ArithAttr ty at -> String
arithAttrMnemonic (FastMathFlagsAttr _) = "fastmath"
arithAttrMnemonic (IntegerOverflowFlagsAttr _) = "overflow"

||| The text of each of the arith dialect's attributes, the types it
||| holds written by `t`, the attributes by `a`.
export
arithAttrText : (t : ty -> String) -> (a : at -> String) -> ArithAttr ty at -> String
arithAttrText t a (FastMathFlagsAttr value) = fastConcat ["#arith.fastmath<", (fastMathFlagsSpellings value), ">"]
arithAttrText t a (IntegerOverflowFlagsAttr value) = fastConcat ["#arith.overflow<", (integerOverflowFlagsSpellings value), ">"]

