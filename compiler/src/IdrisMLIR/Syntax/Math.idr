namespace RoundingMode
  ||| Floating point rounding mode
  public export
  data RoundingMode = ToNearestEven | Downward | Upward | TowardZero | ToNearestAway

export
Prelude.EqOrd.Eq RoundingMode where
  RoundingMode.ToNearestEven == RoundingMode.ToNearestEven = True
  RoundingMode.Downward == RoundingMode.Downward = True
  RoundingMode.Upward == RoundingMode.Upward = True
  RoundingMode.TowardZero == RoundingMode.TowardZero = True
  RoundingMode.ToNearestAway == RoundingMode.ToNearestAway = True
  _ == _ = False

export
Show RoundingMode where
  show RoundingMode.ToNearestEven = "to_nearest_even"
  show RoundingMode.Downward = "downward"
  show RoundingMode.Upward = "upward"
  show RoundingMode.TowardZero = "toward_zero"
  show RoundingMode.ToNearestAway = "to_nearest_away"

||| The value of each RoundingMode.
export
roundingModeValue : RoundingMode -> Nat
roundingModeValue RoundingMode.ToNearestEven = 0
roundingModeValue RoundingMode.Downward = 1
roundingModeValue RoundingMode.Upward = 2
roundingModeValue RoundingMode.TowardZero = 3
roundingModeValue RoundingMode.ToNearestAway = 4

