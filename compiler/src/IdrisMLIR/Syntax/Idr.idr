------------------------------------------------------------------------------
-- Types
------------------------------------------------------------------------------

||| One constructor of a data type's body, as the program's table of data
||| types holds it: its name, its fields' types, and the part it plays in
||| its sum, never a label's, which the frontend writes none of.
public export
record IdrCtor ty where
  constructor MkIdrCtor
  name : String
  fields : List ty
  role : CtorRole

||| A data type's body, as the program's table of data types holds it:
||| what sum it is, its constructors in tag order, and the Idris instance
||| it is of, an `#idr.instance` attribute, when it is of one.
public export
record IdrSum ty at where
  constructor MkIdrSum
  kind : SumKind
  ctors : List (IdrCtor ty)
  instanceOf : Maybe at

||| A constructor of a body as the program's table writes it: its name, its
||| fields' types and, but for a plain one, its role.
export
idrCtorText : (t : ty -> String) -> IdrCtor ty -> String
idrCtorText t (MkIdrCtor name fields role) =
  fastConcat [symbol name, "(", commaSeparated (map t fields), ")", roleText role]
  where
    roleText : CtorRole -> String
    roleText CtorRole.Plain = ""
    roleText r = " " ++ show r

||| A body as the program's table writes it: its kind of sum, its
||| constructors and its instance.
export
idrSumText : (t : ty -> String) -> (a : at -> String) -> IdrSum ty at -> String
idrSumText t a (MkIdrSum kind ctors instanceOf) =
  fastConcat [show kind, " [", commaSeparated (map (idrCtorText t) ctors), "]",
              maybe "" (\i => " instance " ++ a i) instanceOf]

||| The program's table of data types, `#idr.types`: each member its
||| name and its body, one to a line.
export
idrTableText : (t : ty -> String) -> (a : at -> String) -> List (String, IdrSum ty at) -> String
idrTableText t a [] = "#idr.types<>"
idrTableText t a members =
  fastConcat ["#idr.types<\n  ", separated ",\n  " (map (\(name, s) => fastConcat [utf8 name, " = ", idrSumText t a s]) members), "\n>"]

||| The idr dialect's types, one constructor each, named
||| after its C++ class; `ty` is the type of the types they hold.
public export
data IdrType : (ty : Type) -> Type where
  ||| `!idr.big`: an Integer
  BigType : IdrType ty
  ||| `!idr.box`: a reference to a cell that holds a value of a data type
  BoxType : (data' : ty) -> IdrType ty
  ||| `!idr.data`: a data type, identified by its name, whose body is its constructors; written by its name, its body in the module's table of data types
  DataType : (name : String) -> IdrType ty
  ||| `!idr.dest`: a field of a cell built without it, to be written exactly once
  DestType : (value : ty) -> IdrType ty
  ||| `!idr.fn`: a closure
  FnType : (functionType : Signature ty) -> IdrType ty
  ||| `!idr.lazy`: a suspension of one value, forced once into this cell
  LazyType : (value : ty) -> IdrType ty
  ||| `!idr.nat`: a natural number: a non-negative big
  NatType : IdrType ty
  ||| `!idr.q`: a value at a grade: its quantity, what it owns and how long what it reaches lives
  QType : (quantity : Quantity) -> (permission : Permission) -> (value : ty) -> (lifetime : Maybe Lifetime) -> IdrType ty
  ||| `!idr.str`: a string (UTF-8)
  StrType : IdrType ty
  ||| `!idr.token`: the memory of a cell whose fields idr.take moved out, or null
  TokenType : IdrType ty
  ||| `!idr.world`: the IO world token, used exactly once by its type
  WorldType : IdrType ty

||| The mnemonics of the idr dialect's types.
export
idrTypeMnemonics : List String
idrTypeMnemonics = ["big", "box", "data", "dest", "fn", "lazy", "nat", "q", "str", "token", "world"]

||| The mnemonic of each of the idr dialect's types.
export
idrTypeMnemonic : IdrType ty -> String
idrTypeMnemonic BigType = "big"
idrTypeMnemonic (BoxType _) = "box"
idrTypeMnemonic (DataType _) = "data"
idrTypeMnemonic (DestType _) = "dest"
idrTypeMnemonic (FnType _) = "fn"
idrTypeMnemonic (LazyType _) = "lazy"
idrTypeMnemonic NatType = "nat"
idrTypeMnemonic (QType _ _ _ _) = "q"
idrTypeMnemonic StrType = "str"
idrTypeMnemonic TokenType = "token"
idrTypeMnemonic WorldType = "world"

||| The text of each of the idr dialect's types, the types it
||| holds written by `t`.
export
idrTypeText : (t : ty -> String) -> IdrType ty -> String
idrTypeText t BigType = "!idr.big"
idrTypeText t (BoxType data') = fastConcat ["!idr.box<", (t data'), ">"]
idrTypeText t (DataType name) = fastConcat ["!idr.data<", utf8 name, ">"]
idrTypeText t (DestType value) = fastConcat ["!idr.dest<", (t value), ">"]
idrTypeText t (FnType functionType) = fastConcat ["!idr.fn<", (signature t functionType), ">"]
idrTypeText t (LazyType value) = fastConcat ["!idr.lazy<", (t value), ">"]
idrTypeText t NatType = "!idr.nat"
idrTypeText t (QType quantity permission value lifetime) = fastConcat ["!idr.q<", (quantitySpelling quantity), ", ", (permissionSpelling permission), ", ", (t value), maybe "" (\lifetime => fastConcat [", ", (lifetimeSpelling lifetime)]) lifetime, ">"]
idrTypeText t StrType = "!idr.str"
idrTypeText t TokenType = "!idr.token"
idrTypeText t WorldType = "!idr.world"

------------------------------------------------------------------------------
-- Attributes
------------------------------------------------------------------------------

||| The idr dialect's attributes, one constructor each, named
||| after its C++ class; `ty` is the type of the types they hold, `at` of the
||| attributes.
public export
data IdrAttr : (ty : Type) -> (at : Type) -> Type where
  ||| `#idr.big`: an integer of any size
  BigAttr : (value : Integer) -> IdrAttr ty at
  ||| `#idr.closure`: a closure of a function with its captures as attributes
  ClosureAttr : (callee : String) -> (captures : List at) -> IdrAttr ty at
  ||| `#idr.types`: a program's data types, each with its body, in name order
  DataTableAttr : (members : List (String, IdrSum ty at)) -> IdrAttr ty at
  ||| `#idr.instance`: the Idris definition and arguments a function or data type is an instance of
  InstanceAttr : (origin : String) -> (arguments : List String) -> IdrAttr ty at
  ||| `#idr.refusal`: a refusal of the program the frontend found, which the driver reports
  RefusalAttr : (rule : Rule) -> (loc : Location) -> (message : String) -> IdrAttr ty at
  ||| `#idr.rule`: the rule a refusal of a program names
  RuleAttr : (value : Rule) -> IdrAttr ty at
  ||| `#idr.world`: the memory of an array a world orders
  WorldSpaceAttr : IdrAttr ty at

||| The mnemonics of the idr dialect's attributes.
export
idrAttrMnemonics : List String
idrAttrMnemonics = ["big", "closure", "types", "instance", "refusal", "rule", "world"]

||| The mnemonic of each of the idr dialect's attributes.
export
idrAttrMnemonic : IdrAttr ty at -> String
idrAttrMnemonic (BigAttr _) = "big"
idrAttrMnemonic (ClosureAttr _ _) = "closure"
idrAttrMnemonic (DataTableAttr _) = "types"
idrAttrMnemonic (InstanceAttr _ _) = "instance"
idrAttrMnemonic (RefusalAttr _ _ _) = "refusal"
idrAttrMnemonic (RuleAttr _) = "rule"
idrAttrMnemonic WorldSpaceAttr = "world"

||| The text of each of the idr dialect's attributes, the types it
||| holds written by `t`, the attributes by `a`.
export
idrAttrText : (t : ty -> String) -> (a : at -> String) -> IdrAttr ty at -> String
idrAttrText t a (BigAttr value) = fastConcat ["#idr.big<", (show value), ">"]
idrAttrText t a (ClosureAttr callee captures) = fastConcat ["#idr.closure<", (symbol callee), ", ", (array a captures), ">"]
idrAttrText t a (DataTableAttr members) = idrTableText t a members
idrAttrText t a (InstanceAttr origin arguments) = fastConcat ["#idr.instance<", (utf8 origin), ", ", (fastConcat ["[", commaSeparated (map utf8 arguments), "]"]), ">"]
idrAttrText t a (RefusalAttr rule loc message) = fastConcat ["#idr.refusal<", (ruleSpelling rule), ", ", (location loc), ", ", (utf8 message), ">"]
idrAttrText t a (RuleAttr value) = fastConcat ["#idr.rule<", (ruleSpelling value), ">"]
idrAttrText t a WorldSpaceAttr = "#idr.world"

