||| One sample of every type and attribute of the `idr` dialect the
||| frontend writes, each its bytecode entry, and of `arith`'s and `ub`'s
||| attributes the frontend writes as text, and of the builtin ones it
||| writes (IdrisMLIR.MLIR), and ops of every shape the frontend's builders
||| make (IdrisMLIR.Dialect.*), written as the frontend writes them: one
||| MLIR bytecode file (IdrisMLIR.MLIR.Bytecode), at the path its command
||| line names. The module's discardable attributes hold the type and
||| attribute samples; its program holds functions of op samples: a family
||| declared and applied, its constructor built and matched, each case
||| binding the scrutinee refined, its fields read; a call with its index
||| arguments and its tail fact; a closure and a suspension of functions;
||| an array built, read and folded; a crash at its site. The round trip
||| (tests/dialect-syntax) has idris-mlir-opt read the file and print it,
||| so that what the Idris side writes is what MLIR reads, through the
||| dialect's generated bytecode readers. Every grade a frontend writes is
||| sampled.
|||
||| A generated sum that gains a constructor gains a mnemonic: this program
||| exits 1, naming every mnemonic of a sum MLIR.idr holds that no sample
||| has, and writes nothing.
module IdrisMLIR.SyntaxSamples

import IdrisMLIR.Dialect.Arith as Arith
import IdrisMLIR.Dialect.Builtin as Builtin
import IdrisMLIR.Dialect.Idr as Idr
import IdrisMLIR.Dialect.Tensor as Tensor
import IdrisMLIR.Loc
import IdrisMLIR.MLIR
import IdrisMLIR.MLIR.Bytecode
import IdrisMLIR.Spec.Core.Enums
import IdrisMLIR.Spec.Core.Rules
import IdrisMLIR.Spec.Families.Group
import IdrisMLIR.Spec.Functions.Tail
import IdrisMLIR.Spec.Functions.Termination
import IdrisMLIR.Spec.Grades.Grade
import IdrisMLIR.Spec.Pipeline.Stage
import IdrisMLIR.Spec.Runtime.Endings
import IdrisMLIR.Syntax.Arith
import IdrisMLIR.Syntax.UB

import Data.List
import Data.SortedSet
import Data.String
import System
import System.File

%default total

str : MlirType
str = Idr StrType

big : MlirType
big = Idr BigType

||| A natural no index term is known of, and the natural three.
nat : MlirType
nat = IdrHand (NatOf [OpaqueNode])

nat3 : MlirType
nat3 = IdrHand (NatOf [NatNode 3])

i64 : MlirType
i64 = IntegerType 64

||| A family of naturals' lists, recursive through itself: its cons names
||| the group's one member by `self`, at its binder's level.
natLists : MlirAttr
natLists = IdrHand (FamilyOf
  [ MkDataMember "List[Nat]" Promise.None (LocAttr (At noLoc)) [SortNat]
      [ MkCtorDecl "Nil" [] [NatNode 0] []
      , MkCtorDecl "Cons" [SortNat] [SuccNode 1, LevelNode 0]
          [nat, IdrHand (SelfOf 0 [LevelNode 0])] ] ])

||| A vector of naturals of three, and of any length.
vec3 : MlirType
vec3 = IdrHand (DataOf natLists 0 [NatNode 3] Nothing)

vecAny : MlirType
vecAny = IdrHand (DataOf natLists 0 [OpaqueNode] Nothing)

||| A vector known to be a cons.
consCell : MlirType
consCell = IdrHand (DataOf natLists 0 [OpaqueNode] (Just (DenseI32ArrayAttr [1])))

types : List MlirType
types =
  [ str, big, nat, nat3, vec3, vecAny, consCell
  , Idr (FnType [] [])
  , Idr (FnType [i64] [i64])
  , Idr (LazyType nat)
  , Idr (GradedType Once Nothing i64)
  , Idr (GradedType Once (Just (Hold.Counted None)) str)
  , Idr (GradedType Many (Just Hold.Static) str)
  , RankedTensorType [Dynamic, Static 3] F64Type
  , RankedTensorType [] i64
  , MemRefType [Dynamic] (IntegerType 8) (Just (Idr MutableAttr))
  , IndexType
  ]

int : Integer -> MlirAttr
int n = IntegerAttr n i64

attrs : List MlirAttr
attrs =
  [ natLists
  , Idr (BigAttr (-12345678901234567890))
  , Idr (SiteAttr "Main.idr" 3 7 "Main.main")
  , Idr MutableAttr
  , IdrHand (TerminatesOf (ProvedIn 2))
  , IdrHand (TerminatesOf MadeAcyclic)
  , IdrHand (BindersOf [SortNat, SortType, SortOpaque])
  , IdrHand (ArgsOf [NatNode 3, LevelNode 0, SuccNode 2, LevelNode 0, OpaqueNode])
  , arith (FastMathFlagsAttr [])
  , arith (FastMathFlagsAttr [Nnan, Ninf])
  , arith (IntegerOverflowFlagsAttr [Nsw, Nuw])
  , ub PoisonAttr
  , UnitAttr
  , BoolAttr True
  , FloatAttr 0.1 F64Type
  , FloatAttr (-0.0) F64Type
  , StringAttr "a string with \"quotes\" and \x00e9"
  , SymbolRefAttr (MkSymbolRef "T" ["A"])
  , TypeAttr vec3
  , ArrayAttr [int 1, StringAttr "b"]
  , DenseI32ArrayAttr [1, 0, 2]
  , DenseI64ArrayAttr [0, dynamicExtent, 4]
  , DenseI64ArrayAttr []
  , DictionaryAttr [("a", int 1), ("b", UnitAttr)]
  ]

||| The mnemonics of the generated sums that no sample has, each with its
||| dialect and whether it is a type.
unsampled : List String
unsampled =
  missing "idr type" idrTypeMnemonics (mapMaybe idrType types)
    ++ missing "idr attribute" idrAttrMnemonics (mapMaybe idrAttr attrs)
    ++ missing "arith attribute" arithAttrMnemonics (mapMaybe arithAttr attrs)
    ++ missing "ub attribute" ubAttrMnemonics (mapMaybe ubAttr attrs)
  where
    missing : String -> List String -> List String -> List String
    missing what mnemonics sampled =
      let seen = SortedSet.fromList sampled in
      map (\m => what ++ " " ++ m) (filter (\m => not (contains m seen)) mnemonics)
    idrType : MlirType -> Maybe String
    idrType (Idr x) = Just (idrTypeMnemonic x)
    idrType _ = Nothing
    idrAttr : MlirAttr -> Maybe String
    idrAttr (Idr x) = Just (idrAttrMnemonic x)
    idrAttr _ = Nothing
    arithAttr : MlirAttr -> Maybe String
    arithAttr (Arith x _) = Just (arithAttrMnemonic x)
    arithAttr _ = Nothing
    ubAttr : MlirAttr -> Maybe String
    ubAttr (UB x _) = Just (ubAttrMnemonic x)
    ubAttr _ = Nothing

||| The samples, named `stem` and their index in two digits, so that the
||| dictionary the parser sorts keeps their order.
named : String -> List MlirAttr -> List NamedAttr
named stem samples =
  zipWith (\i, a => (stem ++ padLeft 2 '0' (show i), a)) [0 .. length samples] samples

------------------------------------------------------------------------------
-- Ops
------------------------------------------------------------------------------

-- The samples are no program's, so every op and block argument is at no
-- location.

||| An op whose results the statement names `r`.
binding : String -> Op -> Statement
binding r o = MkStatement (Just r) o (At noLoc)

||| An op with no result.
stmt : Op -> Statement
stmt o = MkStatement Nothing o (At noLoc)

||| A region of one block, which binds `vs`.
block : List Value -> List Statement -> Region
block vs ss = MkRegion (map (\v => MkArgument v (At noLoc)) vs) ss

index : Integer -> Op
index n = Arith.constantOp (IntegerAttr n IndexType) IndexType

||| One op of each shape, in a function of the values they use.
sample : Statement
sample =
  let v = MkValue "%v" vecAny
      n = MkValue "%n" nat
      x = MkValue "%x" i64
      s = MkValue "%s" str
      fn = Idr (FnType [i64] [i64])
      lazy = Idr (LazyType i64)
      vec = RankedTensorType [Dynamic] i64
      scalar = RankedTensorType [] i64
      i = MkValue "%i" IndexType
      c4 = MkValue "%c4" IndexType
      cons = MkValue "%cons" consCell
  in stmt (Idr.funcOp {binders = Just (IdrHand (BindersOf [SortNat]))} "sample"
            (FunctionType (MkSignature [vecAny, nat, i64, str] [i64]))
            (block [v, n, x, s]
               [ -- A constructor, its value refined to it, then reindexed.
                 binding "%nil" (Idr.dataConOp [] [] (IdrHand (DataOf natLists 0 [NatNode 0] (Just (DenseI32ArrayAttr [0])))))
               , binding "%nil1" (Idr.dataReindexOp (MkValue "%nil" (IdrHand (DataOf natLists 0 [NatNode 0] (Just (DenseI32ArrayAttr [0]))))) [] vecAny)
               , binding "%lin" (Idr.linCastOp x [] (Idr (GradedType Once Nothing i64)))
               , binding "%used" (Idr.linCastOp (MkValue "%lin" (Idr (GradedType Once Nothing i64))) [] i64)
               , binding "%checked" (Idr.checkNonzeroOp (IntegerAttr (natToInteger (position causeClosed DivisionByZero)) (IntegerType 32)) (Idr (SiteAttr "Main.idr" 1 1 "Main.sample")) x i64)
                 -- A closure and a suspension of functions, with the
                 -- scope's levels.
               , binding "%f" (Idr.fnClosureOp {indexArgs = Just (IdrHand (ArgsOf [LevelNode 0]))} "callee" [] fn)
               , binding "%lazy" (Idr.lazySuspendOp {indexArgs = Just (IdrHand (ArgsOf [LevelNode 0]))} "thunk" [x] lazy)
               , binding "%applied" (Idr.fnApplyOp (MkValue "%f" fn) [x] [i64])
                 -- A match whose case binds its scrutinee refined to the
                 -- constructor and its binder, its fields reads of it.
               , binding "%m" (Idr.dataMatchOp (DenseI32ArrayAttr [0, 1]) v [] [] NoBlocks
                                 [ block [MkValue "%none" (IdrHand (DataOf natLists 0 [OpaqueNode] (Just (DenseI32ArrayAttr [0]))))]
                                     [stmt (Idr.yieldOp [MkValue "%checked" i64])]
                                 , block [cons]
                                     [ binding "%hd" (Idr.dataFieldOp (IntegerAttr 0 (IntegerType 64)) cons [] nat)
                                     , binding "%tl" (Idr.dataFieldOp (IntegerAttr 1 (IntegerType 64)) cons [] (IdrHand (DataOf natLists 0 [LevelNode 1] Nothing)))
                                     , stmt (Idr.yieldOp [x]) ] ]
                                 [i64])
               , binding "%c4" (Arith.constantOp (IntegerAttr 4 IndexType) IndexType)
               , binding "%dest" (Tensor.emptyOp [c4] vec)
               , binding "%t" (Idr.arrayTabulateOp (MkValue "%dest" vec)
                                 (block [i] [ binding "%iv" (Arith.indexCastOp i i64)
                                            , stmt (Idr.arrayYieldOp [MkValue "%iv" i64]) ]) [vec])
               , binding "%z" (Tensor.fromElementsOp [x] scalar)
               , binding "%sum" (Idr.arrayFoldLastOp [MkValue "%z" scalar] c4 (accumulate "fold") [scalar])
               , binding "%r" (Idr.callOp {indexArgs = Just (IdrHand (ArgsOf [OpaqueNode]))} "callee" NonTail [x] [i64])
               , stmt (Idr.returnOp [MkValue "%r" i64])
               ]))
  where
    -- A fold's region: the index along its axis and the accumulator, the
    -- array's element there added to it.
    accumulate : String -> Region
    accumulate stem =
      let j = MkValue ("%" ++ stem ++ "j") IndexType
          acc = MkValue ("%" ++ stem ++ "acc") i64
          el = MkValue ("%" ++ stem ++ "el") i64
          next = MkValue ("%" ++ stem ++ "next") i64
      in block [j, acc] [ binding el.name (Tensor.extractOp (MkValue "%t" (RankedTensorType [Dynamic] i64)) [j] i64)
                        , binding next.name (Arith.addiOp acc el i64)
                        , stmt (Idr.arrayYieldOp [next]) ]

||| A function called and closed over by `@sample`, proved to end.
callee : Statement
callee =
  let a = MkValue "%a" i64
  in stmt (Idr.funcOp {terminates = Just (IdrHand (TerminatesOf (ProvedIn 0)))} "callee"
            (FunctionType (MkSignature [i64] [i64])) (block [a] [stmt (Idr.returnOp [a])]))

||| A function `@sample` suspends.
thunk : Statement
thunk =
  let a = MkValue "%a" i64
  in stmt (Idr.funcOp "thunk" (FunctionType (MkSignature [i64] [i64])) (block [a] [stmt (Idr.returnOp [a])]))

||| A function that crashes, at its site, naming itself.
crashing : Statement
crashing =
  stmt (Idr.funcOp "crashing" (FunctionType (MkSignature [] [i64]))
         (block [] [stmt (Idr.crashCauseOp (IntegerAttr (natToInteger (position causeClosed NoClauseMatched)) (IntegerType 32)) (Idr (SiteAttr "Main.idr" 9 1 "Main.crashing")))]))

||| The program's root.
root : Statement
root = stmt (Idr.funcOp {terminates = Just (IdrHand (TerminatesOf MadeAcyclic))} "root"
               (FunctionType (MkSignature [] [])) (block [] [stmt (Idr.returnOp [])]))

||| The module, with the type and attribute samples as its discardable
||| attributes, and the program of the op samples, whose root is `@root`.
containers : List Container
containers =
  [ (At noLoc, \body => { attributes := named "sample.t" (map TypeAttr types) ++ named "sample.a" attrs }
                          (Builtin.moduleOp body))
  , (At noLoc, Idr.programOp "samples" "root" Higher) ]

||| Writes the samples to `path`.
writeSamples : String -> IO ()
writeSamples path = do
  Right w <- newWriter
    | Left e => die ("syntax-samples: " ++ e)
  for_ [sample, callee, thunk, crashing, root] $ \s => do
    Right () <- writeTopLevel w s
      | Left e => die ("syntax-samples: " ++ e)
    pure ()
  Right h <- openFile path WriteTruncate
    | Left e => die ("syntax-samples: writing " ++ path ++ ": " ++ show e)
  Right () <- finish w h containers
    | Left e => die ("syntax-samples: " ++ e)
  closeFile h
main : IO ()
main = do
  let missed = unsampled
  unless (null missed) $ die ("syntax-samples: no sample of " ++ joinBy ", " missed)
  [_, path] <- getArgs
    | _ => die "usage: syntax-samples OUT.mlirbc"
  writeSamples path
