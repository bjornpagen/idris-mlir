||| One sample of every type and attribute of the `idr` dialect the frontend
||| writes, each its bytecode entry, and of the attributes of `arith`, `ub`
||| and `linalg`, which the frontend writes as text, and of the builtin ones
||| it writes (IdrisMLIR.MLIR), and ops of every shape the frontend's
||| builders make (IdrisMLIR.Dialect.*), written as the frontend writes
||| them: one MLIR bytecode file (IdrisMLIR.MLIR.Bytecode), at the path its
||| command line names. The module's discardable attributes hold the type
||| and attribute samples; its program holds functions of op samples: a
||| family declared and applied, its constructor built and matched, each
||| case binding the scrutinee refined, its fields read; a call with its
||| index arguments and its tail fact; a closure and a suspension of
||| functions; an array built, read, folded and transposed, and moved into
||| its buffer; a choice on a condition; a crash at its site. The round trip
||| (tests/dialect-syntax) has idris-mlir-opt read the file and print it, so
||| that what the Idris side writes is what MLIR reads, through the
||| dialect's generated bytecode readers, and each float sample read back
||| has its Double's bits. Every grade a frontend writes is sampled.
|||
||| A generated sum that gains a constructor gains a mnemonic: this program
||| exits 1, naming every mnemonic of a sum MLIR.idr holds that no sample
||| has, and writes nothing.
module IdrisMLIR.SyntaxSamples

import IdrisMLIR.Dialect.Arith as Arith
import IdrisMLIR.Dialect.Bufferization as Bufferization
import IdrisMLIR.Dialect.Builtin as Builtin
import IdrisMLIR.Dialect.Idr as Idr
import IdrisMLIR.Dialect.Linalg as Linalg
import IdrisMLIR.Dialect.SCF as SCF
import IdrisMLIR.Dialect.Tensor as Tensor
import IdrisMLIR.Dialect.UB as UB
import IdrisMLIR.Ids
import IdrisMLIR.Loc
import IdrisMLIR.MLIR
import IdrisMLIR.MLIR.Bytecode
import IdrisMLIR.Spec.Core.Enums
import IdrisMLIR.Spec.Core.Rules
import IdrisMLIR.Spec.Families.Group
import IdrisMLIR.Spec.Families.Layout
import IdrisMLIR.Spec.Functions.Extents
import IdrisMLIR.Spec.Functions.Tail
import IdrisMLIR.Spec.Grades.Grade
import IdrisMLIR.Spec.Pipeline.Stage
import IdrisMLIR.Spec.Runtime.Endings
import IdrisMLIR.Syntax.Arith
import IdrisMLIR.Syntax.Linalg
import IdrisMLIR.Syntax.UB

import Data.List
import Data.List1
import Data.SortedSet
import Data.String
import System
import System.File

%default total

str : MlirType
str = Idr StrType

big : MlirType
big = Idr BigType

||| A natural no index term is known of, and the natural three.
nat : MlirType
nat = Idr (NatType [TermNodeOpaque])

nat3 : MlirType
nat3 = Idr (NatType [TermNodeNatural 3])

i64 : MlirType
i64 = IntegerType 64

||| A cons's tail as its declaration names it: the group's one member, by
||| `self`, at the cons's binder's level.
consTail : MlirType
consTail = Idr (SelfType 0 [TermNodeLevel 0])

||| A family of naturals' lists, recursive through itself: its group's one
||| member.
natListMembers : List (MemberOf MlirType MlirAttr)
natListMembers =
  [ MemberOfData (MkDataMember "List[Nat]" None (LocAttr (At noLoc)) [SortOfNatSort]
      [ MkCtorDecl "Nil" [] [TermNodeNatural 0] []
      , MkCtorDecl "Cons" [SortOfNatSort] [TermNodeSuccessor 1, TermNodeLevel 0]
          [nat, consTail] ]) ]

||| The group of that family, as every data type of it names the group: the
||| samples' one group.
natLists : MlirAttr
natLists = GroupAttr (MkGroupId 0) natListMembers

||| A vector of naturals of the length given: no refinement, since a known
||| length leaves one constructor possible.
vecOf : Nat -> MlirType
vecOf n = Idr (DataType natLists 0 [TermNodeNatural n] Nothing [] ByIndices)

||| A vector of naturals of three, and of any length.
vec3 : MlirType
vec3 = vecOf 3

vecAny : MlirType
vecAny = Idr (DataType natLists 0 [TermNodeOpaque] Nothing [] ByIndices)

||| A vector known to be a cons.
consCell : MlirType
consCell = Idr (DataType natLists 0 [TermNodeOpaque] (Just (DenseI32ArrayAttr [1])) [] ByIndices)

types : List MlirType
types =
  [ str, big, nat, nat3, vec3, vecAny, consCell, consTail
  , Idr (FnType [] [])
  , Idr (FnType [i64] [i64])
  , Idr (LazyType nat)
  , Idr (GradedType Once Nothing i64)
  , Idr (GradedType Once (Just (Hold.Counted None)) str)
  , Idr (GradedType Many (Just Hold.Static) str)
  , RankedTensorType [Dynamic, Static 3] F64Type
  , RankedTensorType [] i64
  , MemRefType [Dynamic] (IntegerType 8) (Just (Idr MutableAttr))
  , IndexType
  ]

int : Integer -> MlirAttr
int n = IntegerAttr n (OfWidth 64)

-- The attributes of the dialects whose attributes cross as text, each list
-- of its dialect's generated sum, so each is checked against that sum's
-- mnemonics.

arithAttrs : List (ArithAttr IntegerOrIndex Void)
arithAttrs =
  [ FastMathFlagsAttr []
  , FastMathFlagsAttr [Nnan, Ninf]
  , IntegerOverflowFlagsAttr [Nsw, Nuw] ]

ubAttrs : List (UBAttr IntegerOrIndex Void)
ubAttrs = [PoisonAttr]

linalgAttrs : List (LinalgAttr IntegerOrIndex Void)
linalgAttrs =
  [ ElementwiseKindAttr ElementwiseKind.Add
  , UnaryFnAttr UnaryFn.Exp
  , BinaryFnAttr BinaryFn.Add
  , TernaryFnAttr TernaryFn.Select
  , TypeFnAttr TypeFn.CastSigned
  , IteratorTypeAttr IteratorType.Parallel ]

||| Axis 1 of argument 0 is the term `v0`.
inputTerm : MlirAttr
inputTerm = Idr (ExtentAttr OnInput 0 1 [TermNodeLevel 0])

||| Axis 0 of result 0 is the constant 3: a result keeps every axis `?` in
||| its type, and a known size is its entry.
resultConstant : MlirAttr
resultConstant = Idr (ExtentAttr OnResult 0 0 [TermNodeNatural 3])

||| The constant list `[1, 2]`, its naturals bigs: a run of two cons cells
||| along the tail, the last holding the constant nil, each at the length
||| that fixes its constructor.
constantList : MlirAttr
constantList =
  let nil = Idr (ConAttr (vecOf 0) [ArrayAttr []] 0)
  in Idr (ConAttr (vecOf 2) [ArrayAttr [Idr (BigAttr 1)], ArrayAttr [Idr (BigAttr 2), nil]] 1)

attrs : List MlirAttr
attrs =
  [ Idr (FamilyAttr natListMembers)
  , Idr (BigAttr (-12345678901234567890))
  , Idr (SiteAttr "Main.idr" 3 7 "Main.main")
  , Idr MutableAttr
  , Idr (TerminatesAttr (MkComponentProof 2))
  , Idr (IndexBindersAttr [SortOfNatSort, SortOfTypeSort, SortOfOpaqueSort])
  , Idr (IndexArgsAttr [TermNodeNatural 3, TermNodeLevel 0, TermNodeSuccessor 2, TermNodeLevel 0, TermNodeOpaque] 4)
  , Idr (EquationAttr [TermNodeLevel 0] [TermNodeSuccessor 1, TermNodeLevel 1])
    -- The binder at position 2 of `@sample`, as a location names it.
  , Idr (BinderAttr (SymbolRefAttr (MkSymbolRef "sample" [])) 2)
    -- A signature's unknown axes, a term's and a constant's.
  , inputTerm
  , resultConstant
  , Idr (ExtentsAttr [inputTerm, resultConstant])
    -- Constants of a constructor and of a closure of `@callee`, its one
    -- parameter captured.
  , constantList
  , Idr (ClosureAttr (SymbolRefAttr (MkSymbolRef "callee" [])) (ArrayAttr [int 1]))
  , UnitAttr
  , BoolAttr True
    -- A Double of each kind IEEE 754 has, each crossing as its bits: a
    -- finite one, a signed zero, both infinities, a NaN, and the smallest
    -- subnormal, 2^-1074, the double nearest 4.9e-324.
  , FloatAttr 0.1 F64Type
  , FloatAttr (-0.0) F64Type
  , FloatAttr (1.0 / 0.0) F64Type
  , FloatAttr (-1.0 / 0.0) F64Type
  , FloatAttr (0.0 / 0.0) F64Type
  , FloatAttr 4.9e-324 F64Type
  , StringAttr "a string with \"quotes\" and \x00e9"
  , SymbolRefAttr (MkSymbolRef "T" ["A"])
  , TypeAttr vec3
  , ArrayAttr [int 1, StringAttr "b"]
  , DenseI32ArrayAttr [1, 0, 2]
  , DenseI64ArrayAttr [0, dynamicExtent, 4]
  , DenseI64ArrayAttr []
  , DictionaryAttr [("a", int 1), ("b", UnitAttr)]
  ]
  ++ map Arith.arith arithAttrs ++ map UB.ub ubAttrs ++ map Linalg.linalg linalgAttrs

||| The mnemonics of the generated sums that no sample has, each with its
||| dialect and whether it is a type.
unsampled : List String
unsampled =
  missing "idr type" idrTypeMnemonics (mapMaybe idrType types)
    ++ missing "idr attribute" idrAttrMnemonics (mapMaybe idrAttr attrs)
    ++ missing "arith attribute" arithAttrMnemonics (map arithAttrMnemonic arithAttrs)
    ++ missing "ub attribute" ubAttrMnemonics (map ubAttrMnemonic ubAttrs)
    ++ missing "linalg attribute" linalgAttrMnemonics (map linalgAttrMnemonic linalgAttrs)
  where
    missing : String -> List String -> List String -> List String
    missing what mnemonics sampled =
      let seen = SortedSet.fromList sampled in
      map (\m => what ++ " " ++ m) (filter (\m => not (contains m seen)) mnemonics)
    idrType : MlirType -> Maybe String
    idrType (Idr x) = Just (idrTypeMnemonic x)
    idrType _ = Nothing
    idrAttr : MlirAttr -> Maybe String
    idrAttr (Idr x) = Just (idrAttrMnemonic x)
    idrAttr _ = Nothing

||| The samples, named `stem` and their index in two digits, so that the
||| dictionary the parser sorts keeps their order.
named : String -> List MlirAttr -> List NamedAttr
named stem samples =
  zipWith (\i, a => (stem ++ padLeft 2 '0' (show i), a)) [0 .. length samples] samples

------------------------------------------------------------------------------
-- Ops
------------------------------------------------------------------------------

-- The samples are no program's, so every op and block argument is at no
-- location.

||| An op whose results the statement binds, by its number `r` in its
||| function.
binding : Nat -> Op -> Statement
binding r o = MkStatement (Just r) o (At noLoc)

||| The value a binder of the number given binds first: its argument, or
||| its statement's one result.
bound : Nat -> MlirType -> Value
bound k t = MkValue (Bound k 0) t

||| An op with no result.
stmt : Op -> Statement
stmt o = MkStatement Nothing o (At noLoc)

||| A region of one block, which binds `vs`.
block : List Value -> List Statement -> Region
block vs ss = MkRegion (map (\v => MkArgument v (At noLoc)) vs) ss

index : Integer -> Op
index n = Arith.constantOp (IntegerAttr n OfIndex) IndexType

||| One op of each shape, in a function of the values they use.
sample : Statement
sample =
  let v = bound 0 vecAny
      n = bound 1 nat
      x = bound 2 i64
      s = bound 3 str
      fn = Idr (FnType [i64] [i64])
      lazy = Idr (LazyType i64)
      vec = RankedTensorType [Dynamic] i64
      scalar = RankedTensorType [] i64
      buffer = MemRefType [Dynamic] i64 Nothing
      grid = RankedTensorType [Static 2, Static 3] i64
      flipped = RankedTensorType [Static 3, Static 2] i64
      i = bound 20 IndexType
      c4 = bound 17 IndexType
      cons = bound 14 consCell
  in stmt (Idr.funcOp {binders' = Just (Idr (IndexBindersAttr [SortOfNatSort]))} (StringAttr "sample")
            (TypeAttr (FunctionType (MkSignature [vecAny, nat, i64, str] [i64])))
            (block [v, n, x, s]
               [ -- A constructor, its value of the length that leaves it the
                 -- one constructor, so unrefined, then reindexed.
                 binding 4 (Idr.dataConOp [] [] (vecOf 0))
               , binding 5 (Idr.dataReindexOp (bound 4 (vecOf 0)) [] vecAny)
               , binding 6 (Idr.linCastOp x [] (Idr (GradedType Once Nothing i64)))
               , binding 7 (Idr.linCastOp (bound 6 (Idr (GradedType Once Nothing i64))) [] i64)
               , binding 8 (Idr.checkNonzeroOp DivisionByZero (Idr (SiteAttr "Main.idr" 1 1 "Main.sample")) x)
                 -- A closure and a suspension of functions, with the
                 -- scope's levels.
               , binding 9 (Idr.fnClosureOp {index_args' = Just (Idr (IndexArgsAttr [TermNodeLevel 0] 1))} (SymbolRefAttr (MkSymbolRef "callee" [])) [] fn)
               , binding 10 (Idr.lazySuspendOp {index_args' = Just (Idr (IndexArgsAttr [TermNodeLevel 0] 1))} (SymbolRefAttr (MkSymbolRef "thunk" [])) [x] lazy)
               , binding 11 (Idr.fnApplyOp (bound 9 fn) [x] [i64])
                 -- A match whose case binds its scrutinee refined to the
                 -- constructor and its binder, its fields reads of it.
               , binding 12 (Idr.dataMatchOp (DenseI32ArrayAttr [0, 1]) v [] [] NoBlocks
                                 [ block [bound 13 (Idr (DataType natLists 0 [TermNodeOpaque] (Just (DenseI32ArrayAttr [0])) [] ByIndices))]
                                     [stmt (Idr.yieldOp [bound 8 i64])]
                                 , block [cons]
                                     [ binding 15 (Idr.dataFieldOp (IntegerAttr 0 (OfWidth 64)) cons [] nat)
                                     , binding 16 (Idr.dataFieldOp (IntegerAttr 1 (OfWidth 64)) cons [] (Idr (DataType natLists 0 [TermNodeLevel 1] Nothing [] ByIndices)))
                                     , stmt (Idr.yieldOp [x]) ] ]
                                 [i64])
               , binding 17 (Arith.constantOp (IntegerAttr 4 OfIndex) IndexType)
               , binding 18 (Tensor.emptyOp [c4] vec)
               , binding 19 (Idr.arrayTabulateOp (bound 18 vec ::: [])
                                 (block [i] [ binding 21 (Arith.indexCastOp i i64)
                                            , stmt (Idr.arrayYieldOp [bound 21 i64]) ]) [vec])
               , binding 22 (Tensor.fromElementsOp [x] scalar)
               , binding 23 (Idr.arrayFoldLastOp c4 (bound 22 scalar ::: []) accumulate [scalar])
                 -- An array's buffer, as a field holds an array.
               , binding 28 (Bufferization.toBufferOp (bound 19 vec) buffer)
                 -- An array transposed into one of the swapped shape, its
                 -- body giving the input's element on.
               , binding 30 (Tensor.emptyOp [] grid)
               , binding 31 (Tensor.emptyOp [] flipped)
               , binding 32 (Linalg.transposeOp (bound 30 grid) (bound 31 flipped) [1, 0]
                                 (block [bound 33 i64, bound 34 i64] [stmt (Linalg.yieldOp [bound 33 i64])]) [flipped])
                 -- A choice on a condition, a region per arm.
               , binding 35 (Arith.cmpiOp CmpIPredicate.Eq x x (IntegerType 1))
               , binding 36 (SCF.ifOp (bound 35 (IntegerType 1))
                                      (block [] [stmt (SCF.yieldOp [x])])
                                      (block [] [stmt (SCF.yieldOp [bound 8 i64])]) [i64])
               , binding 37 (Idr.callOp {index_args' = Just (Idr (IndexArgsAttr [TermNodeOpaque] 1))} (SymbolRefAttr (MkSymbolRef "callee" [])) NonTail [x] [i64])
               , stmt (Idr.returnOp [bound 37 i64])
               ]))
  where
    -- A fold's region: the index along its axis and the accumulator, the
    -- array's element there added to it.
    accumulate : Region
    accumulate =
      let j = bound 24 IndexType
          acc = bound 25 i64
          el = bound 26 i64
          next = bound 27 i64
      in block [j, acc] [ binding 26 (Tensor.extractOp (bound 19 (RankedTensorType [Dynamic] i64)) [j] i64)
                        , binding 27 (Arith.addiOp acc el i64)
                        , stmt (Idr.arrayYieldOp [next]) ]

||| A function called and closed over by `@sample`, proved to end.
callee : Statement
callee =
  let a = bound 0 i64
  in stmt (Idr.funcOp {terminates' = Just (Idr (TerminatesAttr (MkComponentProof 0)))} (StringAttr "callee")
            (TypeAttr (FunctionType (MkSignature [i64] [i64]))) (block [a] [stmt (Idr.returnOp [a])]))

||| A function `@sample` suspends.
thunk : Statement
thunk =
  let a = bound 0 i64
  in stmt (Idr.funcOp (StringAttr "thunk") (TypeAttr (FunctionType (MkSignature [i64] [i64]))) (block [a] [stmt (Idr.returnOp [a])]))

||| A function that crashes, at its site, naming itself.
crashing : Statement
crashing =
  stmt (Idr.funcOp (StringAttr "crashing") (TypeAttr (FunctionType (MkSignature [] [i64])))
         (block [] [stmt (Idr.crashCauseOp NoClauseMatched (Idr (SiteAttr "Main.idr" 9 1 "Main.crashing")) [])]))

||| The program's root.
root : Statement
root = stmt (Idr.funcOp (StringAttr "root")
               (TypeAttr (FunctionType (MkSignature [] []))) (block [] [stmt (Idr.returnOp [])]))

||| The module, with the type and attribute samples as its discardable
||| attributes, and the program of the op samples, whose root is `@root`.
containers : List Container
containers =
  [ (At noLoc, \body => { attributes := named "sample.t" (map TypeAttr types) ++ named "sample.a" attrs }
                          (Builtin.moduleOp body))
  , (At noLoc, Idr.programOp (StringAttr "samples") (SymbolRefAttr (MkSymbolRef "root" [])) Higher) ]

||| Writes the samples to `path`.
writeSamples : String -> IO ()
writeSamples path = do
  Right w <- newWriter
    | Left e => die ("syntax-samples: " ++ e)
  for_ [sample, callee, thunk, crashing, root] $ \s => do
    Right () <- writeTopLevel w s
      | Left e => die ("syntax-samples: " ++ e)
    pure ()
  Right h <- openFile path WriteTruncate
    | Left e => die ("syntax-samples: writing " ++ path ++ ": " ++ show e)
  Right () <- finish w h containers
    | Left e => die ("syntax-samples: " ++ e)
  closeFile h

main : IO ()
main = do
  let missed = unsampled
  unless (null missed) $ die ("syntax-samples: no sample of " ++ joinBy ", " missed)
  [_, path] <- getArgs
    | _ => die "usage: syntax-samples OUT.mlirbc"
  writeSamples path
