package idris-mlir
version = 0.1.0
brief = "Compiler from checked Idris 2 TT to MLIR"

depends = idris2, network
sourcedir = "src"
modules = IdrisMLIR.Registry.Name
        , IdrisMLIR.Registry.Libraries
        , IdrisMLIR.Loc
        , IdrisMLIR.Rule
        , IdrisMLIR.Ids
        , IdrisMLIR.Types
        , IdrisMLIR.Registry.Entry
        , IdrisMLIR.Registry.Primitives
        , IdrisMLIR.Registry.Recognized
        , IdrisMLIR.Registry
        , IdrisMLIR.Facts
        , IdrisMLIR.Term
        , IdrisMLIR.Term.Check
        , IdrisMLIR.Code
        , IdrisMLIR.Code.Check
        , IdrisMLIR.Code.Loops
        , IdrisMLIR.Simplify.Value
        , IdrisMLIR.Simplify.Fold
        , IdrisMLIR.Simplify.Gen
        , IdrisMLIR.Simplify.Safety
        , IdrisMLIR.Simplify
        , IdrisMLIR.MLIR
        , IdrisMLIR.Emit
        , IdrisMLIR.Frontend.Paths
        , IdrisMLIR.Frontend.Resolve
        , IdrisMLIR.Frontend.Translate
        , IdrisMLIR.Frontend.Profile
main = IdrisMLIR.Frontend.Main
executable = idris-mlir
