package idris-mlir
version = 0.1.0
brief = "Compiler from checked Idris 2 TT to MLIR"

depends = idris2, network
sourcedir = "src"
modules = IdrisMLIR.Registry.Name
        , IdrisMLIR.Registry.Libraries
        , IdrisMLIR.Loc
        , IdrisMLIR.Rule
        , IdrisMLIR.Ids
        , IdrisMLIR.Types
        , IdrisMLIR.Registry.Entry
        , IdrisMLIR.Registry.Primitives
        , IdrisMLIR.Registry.Recognized
        , IdrisMLIR.Registry
        , IdrisMLIR.Facts
        , IdrisMLIR.Graph
        , IdrisMLIR.Term
        , IdrisMLIR.MLIR
        , IdrisMLIR.Emit.Attributes
        , IdrisMLIR.Emit.Breakers
        , IdrisMLIR.Emit.Index
        , IdrisMLIR.Emit.Monad
        , IdrisMLIR.Emit.Types
        , IdrisMLIR.Emit.Operations
        , IdrisMLIR.Emit.Bodies
        , IdrisMLIR.Emit.Declarations
        , IdrisMLIR.Emit
        , IdrisMLIR.Frontend.Paths
        , IdrisMLIR.Frontend.Resolve
        , IdrisMLIR.Frontend.Translate.State
        , IdrisMLIR.Frontend.Translate.Errors
        , IdrisMLIR.Frontend.Translate.Closed
        , IdrisMLIR.Frontend.Translate.Types
        , IdrisMLIR.Frontend.Translate.Recursion
        , IdrisMLIR.Frontend.Translate.Instances
        , IdrisMLIR.Frontend.Translate.Primitives
        , IdrisMLIR.Frontend.Translate.Hooks
        , IdrisMLIR.Frontend.Translate.Terms
        , IdrisMLIR.Frontend.Translate.Cases
        , IdrisMLIR.Frontend.Translate.Programs
        , IdrisMLIR.Frontend.Translate
        , IdrisMLIR.Frontend.Profile
main = IdrisMLIR.Frontend.Main
executable = idris-mlir
