package idris-mlir
version = 0.1.0
brief = "Compiler from checked Idris 2 TT to MLIR"

depends = idris2, network
sourcedir = "src"
modules = IdrisMLIR.Core
        , IdrisMLIR.Emit
        , IdrisMLIR.Simplify
        , IdrisMLIR.HeapCheck
        , IdrisMLIR.Frontend.Paths
        , IdrisMLIR.Frontend.Translate
        , IdrisMLIR.Frontend.Profile
main = IdrisMLIR.Frontend.Main
executable = idris-mlir
