        , IdrisMLIR.Proof.Describes
        , IdrisMLIR.Proof.Generations
        , IdrisMLIR.Proof.Forms
        , IdrisMLIR.Proof.Requests
        , IdrisMLIR.Proof.Reading
        , IdrisMLIR.Proof.Sizes
        , IdrisMLIR.Proof.Weights
        , IdrisMLIR.Proof.Derivation
        , IdrisMLIR.Proof.Held
        , IdrisMLIR.Proof.Markers
        , IdrisMLIR.Proof.Dictionaries
        , IdrisMLIR.Proof.Inversion
        , IdrisMLIR.Proof.Primitives
        , IdrisMLIR.Frontend.Growth.Potential
        , IdrisMLIR.Frontend.Growth.Check
        , IdrisMLIR.Frontend.Growth.Template
        , IdrisMLIR.Proof.Covers
        , IdrisMLIR.Frontend.Finite
