package idris-mlir
version = 0.1.0
brief = "Compiler from checked Idris 2 TT to MLIR"

depends = idris-mlir-checker, idris-mlir-spec, mlir-hash
sourcedir = "src"
modules = IdrisMLIR.Registry.Name
        , IdrisMLIR.Registry.Libraries
        , IdrisMLIR.Loc
        , IdrisMLIR.Ids
        , IdrisMLIR.Types
        , IdrisMLIR.Registry.Entry
