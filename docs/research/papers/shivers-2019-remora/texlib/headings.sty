% headings.tex -*- latex -*-
% Quieter headings that the ones used in article.sty.
%	-Olin 7/91

\renewcommand{\section}%
  {\@startsection{section}{1}{0pt}{-3.5ex plus -1ex minus -.2ex}%
		 {2.3ex plus .2ex}{\normalfont\bfseries\large}}%

\renewcommand{\subsection}%
  {\@startsection{subsection}{2}{0pt}{-3.25ex plus -1ex minus -.2ex}%
                 {1.5ex plus .2ex}{\normalfont\bfseries\normalsize}}%

\renewcommand{\subsubsection}%
  {\@startsection{subsubsection}{3}{0pt}{-3.25ex plus -1ex minus -.2ex}%
                 {1.5ex plus .2ex}{\normalfont\bfseries\normalsize}}%
