def IdrRcBorrows : Pass<"idr-rc-borrows", "::idr::ProgramOp"> {
  let summary = "Write into every signature which parameters are borrowed, and lend what a call passes to one";
  let description = [{
    One backward marking over the closed program within the frame limit: a parameter is
    borrowed only where every call lets it be. A parameter it makes a view is graded
    `scoped`, with every value read from it; each call or jump that passes a counted
    value to a view lends it for the call.
  }];
  let baseClass = "::idr::StagedPass<DerivedT, ::idr::ProgramOp, ::idr::Stage::Graded, ::idr::Stage::Graded>";
  let statistics = [
    Statistic<"numViews", "views", "Parameters made views">,
    Statistic<"numLoans", "loans", "Counted values lent to a view for a call">,
  ];
  let dependentDialects = ["::idr::IdrDialect"];
}

