def IdrFrames : Pass<"idr-frames", "::idr::ProgramOp"> {
  let summary = "Keep every recursion on a call cycle on typed frame stacks, never the native stack";
  let description = [{
    One linear, uncounted, contiguous stack per awaited result: every non-tail call of a
    component pushes its rest as a frame, so the native stack holds only acyclic depth.
  }];
  let baseClass = "::idr::StagedPass<DerivedT, ::idr::ProgramOp, ::idr::Stage::Owned, ::idr::Stage::Owned>";
  let statistics = [
    Statistic<"numFunctions", "functions", "Functions given a run and a resume">,
    Statistic<"numFrames", "frames", "Calls whose rest became a frame">,
    Statistic<"numWork", "work", "Steps the pass's solves took, the same at any thread count">,
  ];
  let dependentDialects = ["::mlir::ub::UBDialect"];
}

