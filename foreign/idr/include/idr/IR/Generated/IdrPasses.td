  }];
  let baseClass = "::idr::StagedPass<DerivedT, ::idr::ProgramOp, ::idr::Stage::First, ::idr::Stage::First>";
  let statistics = [
    Statistic<"numContified", "contified", "Functions made join points of their callers">,
  ];
  let dependentDialects = ["::idr::IdrDialect"];
}

