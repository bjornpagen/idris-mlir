def IdrTarget : Pass<"idr-target", "::mlir::ModuleOp"> {
  let summary = "Give the module its target: triple, CPU, features, data layout";
  let description = [{
    Writes the build's target triple and CPU on the module as its `#llvm.target`, lets LLVM
    fill in the CPU's features and the data layout, and writes the module's target system
    spec: for the device `CPU`, the width in bits of its fixed vector registers. The triple
    and the CPU are the build's target entry; every later step reads them here.
  }];
  let baseClass = "::mlir::OperationPass<::mlir::ModuleOp>";
  let dependentDialects = ["::mlir::LLVM::LLVMDialect", "::mlir::DLTIDialect"];
}

def IdrDefunctionalize : Pass<"idr-defunctionalize", "::idr::ProgramOp"> {
  let summary = "Replace every closure and suspension by a constructor of a sum, every force by a call";
  let description = [{
    On the program as the frontend wrote it, before any optimization: the label solve,
    total and with no budget, decides what each application can meet; each closure sum is a
    family the pass declares, each label a constructor; every apply becomes a dispatch of
    direct calls and every force a call of its sum's dispatch. Its decision builds the
    program graph and derives every function's effect row, callees first.
  }];
  let baseClass = "::idr::StagedPass<DerivedT, ::idr::ProgramOp, ::idr::Stage::Higher, ::idr::Stage::First>";
  let statistics = [
    Statistic<"numFamilies", "families", "Closure and memo families declared, one constructor per label">,
    Statistic<"numWork", "work", "Steps the pass's solves took, the same at any thread count">,
  ];
  let dependentDialects = ["::mlir::ub::UBDialect"];
}

def IdrKnots : Pass<"idr-knots", "::idr::ProgramOp"> {
  let summary = "Refuse a program whose types let a value reach itself, which counting could never free";
  let description = [{
    Right after defunctionalization, where every closure is a constructor of a sum, so a
    knot of references is a cycle of the type graph; total, with no budget.
  }];
  let baseClass = "::idr::StagedPass<DerivedT, ::idr::ProgramOp, ::idr::Stage::First, ::idr::Stage::First>";
}

def IdrInPlace : Pass<"idr-in-place", "::idr::ProgramOp"> {
  let summary = "Decide every in-place promise on the program as the frontend wrote it";
  let description = [{
    Before any optimization: a function that takes apart a quantity-1 parameter of an
    in-place family and builds one from it rebuilds it. Each such parameter is given the
    boundary grade its family's promise gives, read off its type; the local rule then raises
    the claims its matches would otherwise drop, and each rebuild becomes a linear token
    consumed by its rebuild. A call the exclusivity analysis cannot prove exclusive is
    refused at the user's call.
  }];
  let baseClass = "::idr::StagedPass<DerivedT, ::idr::ProgramOp, ::idr::Stage::First, ::idr::Stage::First>";
  let statistics = [
    Statistic<"numWork", "work", "Steps the pass's solves took, the same at any thread count">,
  ];
  let dependentDialects = ["::idr::IdrDialect"];
}

