    operation equivalence, inside call-graph cycles too, each class keeping its first in
    symbol order.
  }];
  let baseClass = "::idr::StagedPass<DerivedT, ::idr::ProgramOp, ::idr::Stage::First, ::idr::Stage::First>";
  let statistics = [
    Statistic<"numGroups", "groups", "Classes of identical functions merged">,
    Statistic<"numMerged", "merged", "Duplicate functions erased">,
  ];
  let dependentDialects = ["::idr::IdrDialect"];
}

def IdrContify : Pass<"idr-contify", "::idr::ProgramOp"> {
  let summary = "Make each function every call of which returns to one continuation a join point there";
