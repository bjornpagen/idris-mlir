def IdrUniqueResults : Pass<"idr-unique-results", "::idr::ProgramOp"> {
  let summary = "Derive which results are unique deep, callees first, before bufferization reads the grades";
  let description = [{
    A value is unique deep where it is fresh (a constructor's, a recycled cell's, or a call's
    result whose signature says so) or taken or read at a linear position from one that is,
    and it flows only through linear positions; each result's claim in its function's
    type is derived over the call graph's components as rows are, and every op that
    infers its result from a graded operand is inferred again.
  }];
  let baseClass = "::idr::StagedPass<DerivedT, ::idr::ProgramOp, ::idr::Stage::First, ::idr::Stage::First>";
  let statistics = [
    Statistic<"numUnique", "unique", "Results whose signature now says unique deep">,
    Statistic<"numWork", "work", "Steps the pass's solves took, the same at any thread count">,
  ];
  let dependentDialects = ["::idr::IdrDialect"];
}

