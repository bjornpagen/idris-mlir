  MissingFeatures,
  // the system's page is not the one the runtime was built for
  WrongPage,
};

// the signals an ending raises
enum class EndingSignal : std::uint8_t {
  // SIGABRT, after the message: a bug of the compiler's or the runtime's
  Abort,
  // SIGPIPE, with no message: a reader of the output went away
