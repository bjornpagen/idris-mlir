def Idr_DataMatchOp : Idr_Op<"data.match", [
    SingleBlock,
    PropagateControlFlowBreak,
    Idr_EliminatesOperandTrait,
    AttrSizedOperandSegments,
    DeclareOpInterfaceMethods<MemoryEffectsOpInterface>,
    RecursiveMemoryEffects,
    Idr_DeclaredEffectsOpInterface,
    RecursivelySpeculatable,
    DeclareOpInterfaceMethods<RegionBranchOpInterface, ["getSuccessorRegions", "getEntrySuccessorRegions", "getRegionInvocationBounds", "getSuccessorInputs", "areTypesCompatible", "getEntrySuccessorOperands"]>,
    DeclareOpInterfaceMethods<Idr_MatchOpInterface, ["getNumCases", "getCaseRegion", "getRegionScrutinee", "caseOf", "keepCases"]>,
    DeclareOpInterfaceMethods<Idr_ValueSourceOpInterface, ["getValueSource"]>,
    DeclareOpInterfaceMethods<Idr_ErasedBinderOpInterface, ["getBoundSorts", "getRefinement"]>,
    DeclareOpInterfaceMethods<Idr_StatesLifetimeOpInterface, ["getStatedLifetime", "setStatedLifetime"]>,
    Idr_StatesOutersOpInterface,
    Idr_LegalAt<"Higher", "Owned">
  ]> {
  let summary = "branches on the constructor of a data value, binding it refined in each case";
  let description = [{
    The scrutinee is taken at its grade: a linear one is used by the match,
    and each region that runs binds it refined, first, then each forwarded
    value at its refined type. A case's fields are reads of its refined
    value. The default region is empty when the cases are exhaustive.

    `%r = idr.data.match %v : !T -> (i64) { case @A(%a: !A) {...} default(%d: !D) {...} }`,
    with `in (%l : !L)` before the colon the lifetimes it states, one per
    scoped value it makes.
  }];
  let arguments = (ins Type<CPred<"::idr::isMatchable($_self)">, "a value of a data type, at any grade", "::mlir::Type">:$scrutinee, Variadic<AnyType>:$forwarded, Variadic<Idr_LifetimeType>:$outers, DenseI32ArrayAttr:$cases);
  let results = (outs Variadic<AnyType>:$results);
  let regions = (region MaxSizedRegion<1>:$default_region, VariadicRegion<SizedRegion<1>>:$case_regions);
  let assemblyFormat = [{ $scrutinee (`forward` `(` $forwarded^ `:` type($forwarded) `)`)? (`in` `(` $outers^ `:` type($outers) `)`)? `:` type($scrutinee) `->` custom<ResultTypes>(type($results)) attr-dict-with-keyword `{` custom<MatchCases>(ref(type($scrutinee)), $cases, $case_regions) custom<DefaultCase>($default_region) `}` }];
  let hasVerifier = 1;
  let skipDefaultBuilders = 1;
  let builders = [
    OpBuilder<(ins "::mlir::TypeRange":$results, "::mlir::Value":$scrutinee, "::mlir::ValueRange":$forwarded, "::llvm::ArrayRef<::idr::Tag>":$tags)>,
  ];
  let extraClassDeclaration = [{
    ::mlir::BlockArgument getRefined(::mlir::Region & region);
    ::idr::Tag getCaseTag(unsigned index);
    ::idr::DataType getDataType();
    ::mlir::OperandRange getEntering();
    ::llvm::SmallVector<::mlir::Type> getDefaultTypes();
    unsigned getScopedBindings();
    std::optional<unsigned> getBindingEntry(::mlir::Value made);
  }];
}

def Idr_LitMatchOp : Idr_Op<"lit.match", [
    SingleBlock,
    PropagateControlFlowBreak,
    NoMemoryEffect,
    RecursiveMemoryEffects,
    Idr_DeclaredEffectsOpInterface,
    RecursivelySpeculatable,
    DeclareOpInterfaceMethods<RegionBranchOpInterface, ["getSuccessorRegions", "getEntrySuccessorRegions", "getRegionInvocationBounds", "getSuccessorInputs", "areTypesCompatible", "getEntrySuccessorOperands"]>,
    DeclareOpInterfaceMethods<Idr_MatchOpInterface, ["getNumCases", "getCaseRegion", "getRegionScrutinee", "caseOf", "keepCases"]>,
    DeclareOpInterfaceMethods<Idr_ValueSourceOpInterface, ["getValueSource"]>,
    DeclareOpInterfaceMethods<Idr_StatesLifetimeOpInterface, ["getStatedLifetime", "setStatedLifetime"]>,
    Idr_StatesOutersOpInterface,
    Idr_LegalAt<"Higher", "Owned">
  ]> {
  let summary = "branches on the value of a word, a string, a big integer or a natural";
  let description = [{
    Each case is one literal of its type; every region binds the
    scrutinee, which in a case equals its literal and in the default is
    none of the keys.

    `%r = idr.lit.match %s : !idr.str -> (i64) { case ""(%e: !idr.str) {...} default(%t: !idr.str) {...} }`
    `%r = idr.lit.match %c : i32 -> (i64) { case 97(%a: i32) {...} default(%d: i32) {...} }`
  }];
  let arguments = (ins Type<CPred<"::idr::isMatchedLiteral($_self)">, "a value of a type with literals that is no condition, at any grade", "::mlir::Type">:$scrutinee, Variadic<Idr_LifetimeType>:$outers, ArrayAttr:$cases);
  let results = (outs Variadic<AnyType>:$results);
  let regions = (region SizedRegion<1>:$default_region, VariadicRegion<SizedRegion<1>>:$case_regions);
  let assemblyFormat = [{ $scrutinee (`in` `(` $outers^ `:` type($outers) `)`)? `:` type($scrutinee) `->` custom<ResultTypes>(type($results)) attr-dict-with-keyword `{` custom<LiteralCases>(ref(type($scrutinee)), $cases, $case_regions) custom<DefaultCase>($default_region) `}` }];
  let hasVerifier = 1;
  let skipDefaultBuilders = 1;
  let builders = [
    OpBuilder<(ins "::mlir::TypeRange":$results, "::mlir::Value":$scrutinee, "::mlir::ArrayAttr":$cases)>,
  ];
  let extraClassDeclaration = [{
    unsigned getScopedBindings();
    std::optional<unsigned> getBindingEntry(::mlir::Value made);
  }];
}

