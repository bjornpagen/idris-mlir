    DeclareOpInterfaceMethods<Idr_StatesLifetimeOpInterface, ["getStatedLifetime", "setStatedLifetime"]>,
    Idr_StatesOutersOpInterface
  ]> {
  let summary = "join points that never repeat: tokens in the body alone";
  let description = [{
    `%r = idr.join tokens(%k) in (%l : !L) -> (R) {...} join(%p: A) {...}`,
    `in (%l : !L)` the lifetimes it states, one per scoped value it makes. The
