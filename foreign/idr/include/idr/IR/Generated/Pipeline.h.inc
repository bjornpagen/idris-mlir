// Every upstream pass the pipeline runs, registered so a pipeline's text can name it.
inline void registerUpstream() {
  ::mlir::registerSymbolDCEPass();
  ::mlir::LLVM::registerDIScopeForLLVMFuncOpPass();
  ::mlir::transform::registerInterpreterPass();
  ::mlir::registerConvertLinalgToLoopsPass();
  ::mlir::registerConvertVectorToSCF();
  ::mlir::memref::registerExpandStridedMetadataPass();
  ::mlir::registerLowerAffinePass();
  ::mlir::registerSCFToControlFlowPass();
  ::mlir::registerConvertVectorToLLVMPass();
  ::mlir::registerConvertToLLVMPass();
  ::mlir::registerReconcileUnrealizedCastsPass();
}

