// a member of a family, its alternative its kind
::mlir::LogicalResult readMemberOf(::mlir::DialectBytecodeReader &reader, ::llvm::BumpPtrAllocator &arena, ::idr::families::Member &value) {
  ::idr::MemberKind kind{};
  if (::mlir::failed(readCase(reader, kind)))
    return ::mlir::failure();
  switch (kind) {
  case ::idr::MemberKind::Data: {
    ::idr::families::DataMember alternative;
    if (::mlir::failed(readDataMember(reader, arena, alternative)))
      return ::mlir::failure();
    value = alternative;
    break;
  }
  case ::idr::MemberKind::Closures: {
    ::idr::families::ClosuresMember alternative;
    if (::mlir::failed(readClosuresMember(reader, arena, alternative)))
      return ::mlir::failure();
    value = alternative;
    break;
  }
  case ::idr::MemberKind::Memo: {
    ::idr::families::MemoMember alternative;
    if (::mlir::failed(readMemoMember(reader, arena, alternative)))
      return ::mlir::failure();
    value = alternative;
    break;
  }
  case ::idr::MemberKind::Frames: {
    ::idr::families::FramesMember alternative;
    if (::mlir::failed(readFramesMember(reader, arena, alternative)))
      return ::mlir::failure();
    value = alternative;
    break;
  }
  }
  return ::mlir::success();
}

void writeMemberOf(::mlir::DialectBytecodeWriter &writer, const ::idr::families::Member &value) {
  ::idr::match(
      value,
      [&](const ::idr::families::DataMember &alternative) {
        writeCase(writer, ::idr::MemberKind::Data);
        writeDataMember(writer, alternative);
      },
      [&](const ::idr::families::ClosuresMember &alternative) {
        writeCase(writer, ::idr::MemberKind::Closures);
        writeClosuresMember(writer, alternative);
      },
      [&](const ::idr::families::MemoMember &alternative) {
        writeCase(writer, ::idr::MemberKind::Memo);
        writeMemoMember(writer, alternative);
      },
      [&](const ::idr::families::FramesMember &alternative) {
        writeCase(writer, ::idr::MemberKind::Frames);
        writeFramesMember(writer, alternative);
      });
}

