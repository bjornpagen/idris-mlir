def VectorizeLanesOp : Op<Transform_Dialect, "idr.vectorize_lanes", [
    ReportTrackingListenerFailuresOpTrait,
    TransformOpInterface,
    MemoryEffectsOpInterface
  ]> {
  let cppNamespace = "::idr::target";
  let summary = "Computes each loop over an array on the target's vector lanes";
  let description = [{
    For each linalg.generic of `target` on buffers with a parallel dimension that the
    vectorizer takes: lanes along its last parallel dimension (the module's
    max_vector_op_width for its CPU over the widest word the loop computes) and one
    element along every other, the lane dimension's tile loop peeled, the full tiles
    vectorized without masks and the last one masked. Any other op, or a loop the
    vectorizer refuses, is left as it is. `vectorized` holds each function that now
    computes on lanes, once. Consumes `target`.
  }];
