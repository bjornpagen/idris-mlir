def Idr_Dialect : Dialect {
  let name = "idr";
  let cppNamespace = "::idr";
  let summary = "Monomorphic Idris programs: families, closures, matches, strings and bigs";
  let description = [{
    The dialect holds only what upstream's dialects do not mean: Idris's data
    as the families it checked, its grades in types, lifetimes as values, join
    points, counting, and the runtime's values. Every fact a pass reads is an
    op's property or a type, never a discardable attribute.
  }];
  let useDefaultTypePrinterParser = 1;
  let useDefaultAttributePrinterParser = 1;
  let hasConstantMaterializer = 1;
  let hasOperationAttrVerify = 1;
  let hasRegionArgAttrVerify = 1;
  let dependentDialects = ["::mlir::arith::ArithDialect", "::mlir::ub::UBDialect", "::mlir::LLVM::LLVMDialect", "::mlir::bufferization::BufferizationDialect"];
  let extraClassDeclaration = [{
    void registerTypes();
    void registerValueFacts();
  }];
}

