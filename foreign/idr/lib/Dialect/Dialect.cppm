// idr.dialect: the idr dialect's declarations, what TableGen generates from
// IdrOps.td and Passes.td with what idr/Idr.h declares around it, for
// module units to import beside idr.mlir. idr/Idr.h is parsed here once
// for every module unit; the dialect's own definitions (the generated code
// and the hooks that define its members) are plain units, since a member of
// a class of the global module cannot be defined in a named module. The
// module re-exports the dialect's whole interface, operators included: its
// ops, types, attributes, interfaces and enums, its passes' constructors and
// options, and what idr/Idr.h declares around them.
module;
#include "idr/Idr.h"

export module idr.dialect;

