package runtests
version = 0.1.0
brief = "The golden test runner of idris-mlir, over tests/"

-- Base and the dialect's specification alone: the runner builds under both
-- hosts, and idris-mlir ships neither contrib nor test.
depends = idris-mlir-spec
sourcedir = "."
modules = Bench
        , Covers
        , Determinism
        , Facts
        , Files
        , Fuzz
        , FuzzRun
        , Gen
        , Harness
        , Json
        , Lazy
        , Lex
        , Linear
        , Lit
        , Lock
        , Planted
        , Prims
        , Programs
        , Properties
        , Reject
        , Runner
        , RuntimeEffects
        , Scale
        , ScaleRun
        , Sem
        , Serve
        , SpecFiles
        , Trace
        , Universal
        , Verdict
main = Main
executable = runtests
