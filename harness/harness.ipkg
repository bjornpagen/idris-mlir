package runtests
version = 0.1.0
brief = "The golden test runner of idris-mlir, over tests/"

-- Base and the dialect's specification alone: the runner builds under both
-- hosts, and idris-mlir ships neither contrib nor test.
depends = idris-mlir-spec
sourcedir = "."
modules = Case
        , Facts
        , Files
        , Fuzz
        , Gen
        , Json
        , Lazy
        , Linear
        , Lock
        , Prims
        , Properties
        , Reject
        , Runner
        , RuntimeEffects
        , Scale
        , Sem
        , Trace
        , TwoLevels
main = Main
executable = runtests
