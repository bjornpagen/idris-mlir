{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.toolchain/ninja/bin/ninja",
        "MLIR_DIR": "${sourceDir}/.toolchain/llvm/lib/cmake/mlir"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "${sourceDir}/.toolchain/gcc/bin/gcc",
        "CMAKE_CXX_COMPILER": "${sourceDir}/.toolchain/gcc/bin/g++"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug development build",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Optimized production build",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "gcc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "IDRIS_MLIR_RUNTIME_SANITIZERS": "ON"
      }
    },
    {
      "name": "lint",
      "displayName": "Clang lint graph (needs clang from the pinned LLVM; see PINS.md)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "${sourceDir}/.toolchain/llvm/bin/clang++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_CLANG_TIDY": "${sourceDir}/.toolchain/llvm/bin/clang-tidy",
        "IDRIS_MLIR_LINT_GRAPH": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "lint", "configurePreset": "lint" }
  ]
}
