{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/.toolchain/llvm/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.toolchain/ninja/bin/ninja",
        "IDRIS_MLIR_IDRIS_PREFIX": "${sourceDir}/build/idris2"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug development build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Optimized production build: full LTO, unused sections dropped, no sanitizer traps",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "hardened",
      "displayName": "Release build with undefined-behavior traps and the mitigations",
      "inherits": "release",
      "cacheVariables": {
        "IDRIS_MLIR_PRESET_COMPILE_FLAGS": "-fsanitize=undefined;-fsanitize-trap=all;-ftrivial-auto-var-init=zero;-fstack-protector-strong;-fzero-call-used-regs=used-gpr;-fno-delete-null-pointer-checks;-fno-strict-aliasing;-fstrict-flex-arrays=3",
        "IDRIS_MLIR_PRESET_LINK_FLAGS": "-fsanitize=undefined;-fsanitize-trap=all"
      }
    },
    {
      "name": "profile",
      "displayName": "Release build instrumented for Tracy (tools/profile.sh)",
      "inherits": "release",
      "cacheVariables": {
        "IDRIS_MLIR_PROFILE": "ON",
        "IDRIS_MLIR_PROFILE_MEMORY": "OFF"
      }
    },
    {
      "name": "lint",
      "displayName": "Debug build checked by the pinned clang-tidy",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_CLANG_TIDY": "${sourceDir}/.toolchain/llvm/bin/clang-tidy;--warnings-as-errors=*"
      }
    },
    {
      "name": "typecheck",
      "displayName": "foreign/idr compiled by the host's clang against the TableGen-only LLVM/MLIR, nothing linked but idris-mlir-tblgen (make typecheck)",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/.toolchain/typecheck/toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "hardened", "configurePreset": "hardened" },
    { "name": "profile", "configurePreset": "profile" },
    { "name": "lint", "configurePreset": "lint" },
    { "name": "typecheck", "configurePreset": "typecheck" }
  ]
}
