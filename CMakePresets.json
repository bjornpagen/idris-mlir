{
  "version": 8,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/.toolchain/ninja/bin/ninja",
        "CMAKE_C_COMPILER": "${sourceDir}/.toolchain/llvm-musl/bin/clang",
        "CMAKE_CXX_COMPILER": "${sourceDir}/.toolchain/llvm-musl/bin/clang++",
        "CMAKE_C_COMPILER_TARGET": "x86_64-unknown-linux-musl",
        "CMAKE_CXX_COMPILER_TARGET": "x86_64-unknown-linux-musl",
        "CMAKE_LINKER_TYPE": "LLD",
        "CMAKE_AR": "${sourceDir}/.toolchain/llvm-musl/bin/llvm-ar",
        "CMAKE_RANLIB": "${sourceDir}/.toolchain/llvm-musl/bin/llvm-ranlib",
        "CMAKE_NM": "${sourceDir}/.toolchain/llvm-musl/bin/llvm-nm",
        "CMAKE_READELF": "${sourceDir}/.toolchain/llvm-musl/bin/llvm-readelf",
        "CMAKE_OBJDUMP": "${sourceDir}/.toolchain/llvm-musl/bin/llvm-objdump",
        "MLIR_DIR": "${sourceDir}/.toolchain/llvm-musl/lib/cmake/mlir"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug development build",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Optimized production build, one LTO domain with LLVM and MLIR",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer (unavailable on static musl; see PINS.md)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "IDRIS_MLIR_RUNTIME_SANITIZERS": "ON"
      }
    },
    {
      "name": "lint",
      "displayName": "Debug build checked by the pinned clang-tidy",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_CLANG_TIDY": "${sourceDir}/.toolchain/llvm-musl/bin/clang-tidy;--warnings-as-errors=*"
      }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan-ubsan", "configurePreset": "asan-ubsan" },
    { "name": "lint", "configurePreset": "lint" }
  ]
}
