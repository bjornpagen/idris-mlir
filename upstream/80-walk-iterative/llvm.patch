+/// The stack of an iterative walk: one entry per operation whose walk has
+/// begun and not ended, the innermost last. An entry never moves while it is
+/// on the stack, since a range it iterates may keep its traversal state
+/// outside its iterators (a post-order traversal of a region's blocks does).
+/// The first entries live in the stack itself, so a shallow walk allocates
+/// nothing; deeper ones live in chunks allocated when the walk first descends
+/// that far, which are kept until the walk ends.
+template <typename EntryT>
+class WalkStack {
+public:
+  WalkStack() = default;
+  WalkStack(const WalkStack &) = delete;
+  WalkStack &operator=(const WalkStack &) = delete;
+  ~WalkStack() {
+    while (!empty())
+      pop();
+  }
+
+  bool empty() const { return depth == 0; }
+
+  EntryT &top() { return *entry(depth - 1); }
+
+  template <typename... Args>
+  void push(Args &&...args) {
+    if (depth >= NumInlineEntries &&
+        (depth - NumInlineEntries) / NumChunkEntries == chunks.size())
+      chunks.push_back(std::make_unique<Slot[]>(NumChunkEntries));
+    ::new (static_cast<void *>(entry(depth)))
+        EntryT(std::forward<Args>(args)...);
+    ++depth;
+  }
+
+  void pop() {
+    --depth;
+    entry(depth)->~EntryT();
+  }
+
+private:
+  static constexpr unsigned NumInlineEntries = 4;
+  static constexpr unsigned NumChunkEntries = 32;
+
+  struct alignas(EntryT) Slot {
+    char bytes[sizeof(EntryT)];
+  };
+
+  EntryT *entry(unsigned index) {
+    Slot &slot = index < NumInlineEntries
+                     ? inlineSlots[index]
+                     : chunks[(index - NumInlineEntries) / NumChunkEntries]
+                             [(index - NumInlineEntries) % NumChunkEntries];
+    return reinterpret_cast<EntryT *>(slot.bytes);
+  }
+
+  Slot inlineSlots[NumInlineEntries];
+  SmallVector<std::unique_ptr<Slot[]>, 0> chunks;
+  unsigned depth = 0;
+};
+
+/// One level of an iterative walk: the range 'Iterator' makes of an IR object
+/// (the regions of an operation, the blocks of a region or the operations of
+/// a block) and the walk's position in it. A level is built in place and never
+/// moved, so its range may hold the state its iterators read.
+template <typename Iterator, typename ParentT>
+struct WalkLevel {
+  using RangeT = decltype(Iterator::makeIterable(std::declval<ParentT &>()));
+  using IteratorT = decltype(std::declval<RangeT &>().begin());
+
+  explicit WalkLevel(ParentT &parent)
+      : range(Iterator::makeIterable(parent)), current(range.begin()),
+        end(range.end()) {}
+  WalkLevel(const WalkLevel &) = delete;
+  WalkLevel &operator=(const WalkLevel &) = delete;
+
+  RangeT range;
+  IteratorT current;
+  IteratorT end;
+};
+
+/// An operation whose walk has begun and not ended: the levels of it the walk
+/// is inside, the outermost first. A level is present only while the walk is
+/// inside it.
+template <typename Iterator, typename Visitor>
+struct WalkFrame {
+  WalkFrame(Operation *op, Visitor &visitor)
+      : op(op), state(visitor.makeState(op)) {}
+
+  Operation *op;
+  typename Visitor::State state;
+  std::optional<WalkLevel<Iterator, Operation>> regions;
+  std::optional<WalkLevel<Iterator, Region>> blocks;
+  std::optional<WalkLevel<Iterator, Block>> ops;
+  /// The region whose blocks, and the block whose operations, are walked.
+  Region *region = nullptr;
+  Block *block = nullptr;
+};
+
+/// Walk 'root' and the regions, blocks and operations nested in it, from an
+/// explicit stack rather than by recursion, so that the nesting depth of the
+/// IR is not the depth of the native stack. 'Visitor' makes the callbacks and
+/// says, with each one's result, where the walk skips or stops; it also says
+/// whether the walk takes the next block or operation before it walks the
+/// current one, so that a callback may erase the current one. Each range is
+/// made, and each callback made, at the point where a walk that recursed
+/// would make it. The result is the root operation's.
+template <typename Iterator, typename Visitor>
+WalkResult walkIteratively(Operation *root, Visitor &visitor) {
+  using Frame = WalkFrame<Iterator, Visitor>;
+  WalkStack<Frame> stack;
+  stack.push(root, visitor);
+  while (true) {
+    Frame &frame = stack.top();
+    Operation *nested = nullptr;
+    WalkResult result = WalkResult::advance();
+    // Advance the innermost operation's walk until it reaches a nested
+    // operation, which is walked next, or ends.
+    while (true) {
+      if (frame.ops) {
+        WalkLevel<Iterator, Block> &ops = *frame.ops;
+        if (ops.current != ops.end) {
+          nested = &*ops.current;
+          if constexpr (Visitor::earlyIncrementOps)
+            ++ops.current;
+          break;
+        }
+        frame.ops.reset();
+        if (visitor.postBlock(frame.block).wasInterrupted())
+          return WalkResult::interrupt();
+        if constexpr (!Visitor::earlyIncrementBlocks)
+          ++frame.blocks->current;
+        continue;
+      }
+      if (frame.blocks) {
+        WalkLevel<Iterator, Region> &blocks = *frame.blocks;
+        if (blocks.current != blocks.end) {
+          Block *block = &*blocks.current;
+          if constexpr (Visitor::earlyIncrementBlocks)
+            ++blocks.current;
+          WalkResult blockResult = visitor.preBlock(block);
+          if (blockResult.wasInterrupted())
+            return WalkResult::interrupt();
+          if (blockResult.wasSkipped()) {
+            if constexpr (!Visitor::earlyIncrementBlocks)
+              ++blocks.current;
+            continue;
+          }
+          frame.block = block;
+          frame.ops.emplace(*block);
+          continue;
+        }
+        frame.blocks.reset();
+        if (visitor.postRegion(frame.region).wasInterrupted())
+          return WalkResult::interrupt();
+        // A callback never erases a region, so the walk moves past one only
+        // after walking it.
+        ++frame.regions->current;
+        continue;
+      }
+      if (frame.regions) {
+        WalkLevel<Iterator, Operation> &regions = *frame.regions;
+        if (regions.current == regions.end) {
+          frame.regions.reset();
+          result = visitor.postOp(frame.op, frame.state);
+          break;
+        }
+        WalkResult stageResult = visitor.beforeRegion(frame.op, frame.state);
+        if (stageResult.wasInterrupted())
+          return WalkResult::interrupt();
+        // A skip before a region ends the operation's walk.
+        if (stageResult.wasSkipped())
+          break;
+        Region *region = &*regions.current;
+        WalkResult regionResult = visitor.preRegion(region);
+        if (regionResult.wasInterrupted())
+          return WalkResult::interrupt();
+        if (regionResult.wasSkipped()) {
+          ++regions.current;
+          continue;
+        }
+        frame.region = region;
+        frame.blocks.emplace(*region);
+        continue;
+      }
+      WalkResult opResult = visitor.preOp(frame.op);
+      if (opResult.wasInterrupted())
+        return WalkResult::interrupt();
+      // A skipped operation's walk ends, and its parent's goes on.
+      if (opResult.wasSkipped())
+        break;
+      frame.regions.emplace(*frame.op);
+    }
+    if (nested) {
+      stack.push(nested, visitor);
+      continue;
+    }
+    stack.pop();
+    if (stack.empty())
+      return result;
+    if (result.wasInterrupted())
+      return WalkResult::interrupt();
+    if constexpr (!Visitor::earlyIncrementOps)
+      ++stack.top().ops->current;
+  }
+}
+
+/// What an iterative walk does where its visitor makes no callback: it goes
+/// on. Each visitor below declares only the callbacks it makes.
+struct WalkVisitorBase {
+  struct State {};
+  static constexpr bool earlyIncrementBlocks = false;
+  static constexpr bool earlyIncrementOps = false;
+
+  State makeState(Operation *) { return {}; }
+  WalkResult preOp(Operation *) { return WalkResult::advance(); }
+  WalkResult beforeRegion(Operation *, State &) {
+    return WalkResult::advance();
+  }
+  WalkResult preRegion(Region *) { return WalkResult::advance(); }
+  WalkResult preBlock(Block *) { return WalkResult::advance(); }
+  WalkResult postBlock(Block *) { return WalkResult::advance(); }
+  WalkResult postRegion(Region *) { return WalkResult::advance(); }
+  WalkResult postOp(Operation *, State &) { return WalkResult::advance(); }
+};
+
+/// The result of a walk callback: its own, or 'advance' for one that returns
+/// nothing.
+template <typename ArgT>
+WalkResult invokeWalkCallback(function_ref<void(ArgT)> callback, ArgT arg) {
+  callback(arg);
+  return WalkResult::advance();
+}
+template <typename ArgT>
+WalkResult invokeWalkCallback(function_ref<WalkResult(ArgT)> callback,
+                              ArgT arg) {
+  return callback(arg);
+}
+
+/// A walk whose callback is on each region.
+template <typename CallbackT>
+struct RegionWalkVisitor : WalkVisitorBase {
+  RegionWalkVisitor(CallbackT callback, WalkOrder order)
+      : callback(callback), order(order) {}
+
+  WalkResult preRegion(Region *region) {
+    if (order == WalkOrder::PreOrder)
+      return invokeWalkCallback(callback, region);
+    return WalkResult::advance();
+  }
+  // A skip after a region's walk is not checked: the walk goes on with the
+  // next region anyway.
+  WalkResult postRegion(Region *region) {
+    if (order == WalkOrder::PostOrder)
+      return invokeWalkCallback(callback, region);
+    return WalkResult::advance();
+  }
+
+  CallbackT callback;
+  WalkOrder order;
+};
+
+/// A walk whose callback is on each block. A callback may erase its block, so
+/// the walk takes the next block first.
+template <typename CallbackT>
+struct BlockWalkVisitor : WalkVisitorBase {
+  static constexpr bool earlyIncrementBlocks = true;
+
+  BlockWalkVisitor(CallbackT callback, WalkOrder order)
+      : callback(callback), order(order) {}
+
+  WalkResult preBlock(Block *block) {
+    if (order == WalkOrder::PreOrder)
+      return invokeWalkCallback(callback, block);
+    return WalkResult::advance();
+  }
+  WalkResult postBlock(Block *block) {
+    if (order == WalkOrder::PostOrder)
+      return invokeWalkCallback(callback, block);
+    return WalkResult::advance();
+  }
+
+  CallbackT callback;
+  WalkOrder order;
+};
+
+/// A walk whose callback is on each operation. A callback may erase its
+/// operation, so the walk takes the next operation first.
+template <typename CallbackT>
+struct OperationWalkVisitor : WalkVisitorBase {
+  static constexpr bool earlyIncrementOps = true;
+
+  OperationWalkVisitor(CallbackT callback, WalkOrder order)
+      : callback(callback), order(order) {}
+
+  WalkResult preOp(Operation *op) {
+    if (order == WalkOrder::PreOrder)
+      return invokeWalkCallback(callback, op);
+    return WalkResult::advance();
+  }
+  WalkResult postOp(Operation *op, State &) {
+    if (order == WalkOrder::PostOrder)
+      return invokeWalkCallback(callback, op);
+    return WalkResult::advance();
+  }
+
+  CallbackT callback;
+  WalkOrder order;
+};
+
