+
+#include "mlir/IR/Iterators.h"
+#include "mlir/IR/Location.h"
+#include "mlir/IR/MLIRContext.h"
+#include "mlir/IR/Operation.h"
+#include "llvm/Support/thread.h"
+#include "gtest/gtest.h"
+
+using namespace mlir;
+
+static Operation *createOp(MLIRContext *context, unsigned numRegions,
+                           ArrayRef<Value> operands = {},
+                           ArrayRef<Type> resultTypes = {}) {
+  context->allowUnregisteredDialects();
+  return Operation::create(
+      UnknownLoc::get(context), OperationName("test.nest", context),
+      resultTypes, operands, NamedAttrList(), PropertyRef(), {}, numRegions);
+}
+
+namespace {
+TEST(WalkTest, DeepNestingOnASmallStack) {
+  MLIRContext context;
+  // A chain of operations, each but the last holding the next in the one
+  // block of its one region.
+  constexpr unsigned depth = 10000;
+  SmallVector<Operation *> chain{createOp(&context, 1)};
+  for (unsigned i = 1; i < depth; ++i) {
+    Block *block = new Block();
+    chain.back()->getRegion(0).push_back(block);
+    chain.push_back(createOp(&context, i + 1 < depth ? 1 : 0));
+    block->push_back(chain.back());
+  }
+  Operation *root = chain.front();
+
+  // A walk that took a native frame per level of nesting would overflow this
+  // thread's stack.
+  unsigned preOrder = 0, postOrder = 0, regions = 0, blocks = 0, stages = 0;
+  Operation *firstPreOrder = nullptr, *firstPostOrder = nullptr;
+  WalkResult interrupted = WalkResult::advance();
+  llvm::thread walker(/*StackSizeInBytes=*/256 * 1024, [&] {
+    root->walk<WalkOrder::PreOrder>([&](Operation *op) {
+      firstPreOrder = firstPreOrder ? firstPreOrder : op;
+      ++preOrder;
+    });
+    root->walk([&](Operation *op) {
+      firstPostOrder = firstPostOrder ? firstPostOrder : op;
+      ++postOrder;
+    });
+    root->walk([&](Region *) { ++regions; });
+    root->walk<WalkOrder::PreOrder, ReverseIterator>([&](Block *) {
+      ++blocks;
+    });
+    root->walk([&](Operation *, const WalkStage &) { ++stages; });
+    interrupted = root->walk([&](Operation *op) {
+      return op == chain.back() ? WalkResult::interrupt()
+                                : WalkResult::advance();
+    });
+  });
+  walker.join();
+
+  EXPECT_EQ(preOrder, depth);
+  EXPECT_EQ(postOrder, depth);
+  EXPECT_EQ(firstPreOrder, root);
+  EXPECT_EQ(firstPostOrder, chain.back());
+  EXPECT_EQ(regions, depth - 1);
+  EXPECT_EQ(blocks, depth - 1);
+  // Before and after the one region of each operation that has one, and once
+  // for the last.
+  EXPECT_EQ(stages, 2 * (depth - 1) + 1);
+  EXPECT_TRUE(interrupted.wasInterrupted());
+
+  // Innermost first, so that no destruction recurses on the depth either.
+  for (Operation *op : llvm::reverse(llvm::drop_begin(chain)))
+    op->erase();
+  root->destroy();
+}
+} // namespace
