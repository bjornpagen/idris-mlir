diff --git a/mlir/test/Transforms/sccp.mlir b/mlir/test/Transforms/sccp.mlir
index 95f0961..aa89d92 100644
--- a/mlir/test/Transforms/sccp.mlir
+++ b/mlir/test/Transforms/sccp.mlir
@@ -366,3 +366,18 @@ func.func @no_inplace_extract_fold_of_speculative_constant(%a: f32, %b: f32) ->
 ^bb2:
   return %e : f32
 }
+
+// -----
+
+// Regression test: SCCP must also revert a property that an in-place fold sets
+// on an operation that had none. The outer `arith.extui` folds in place
+// through the inner one and takes its `nneg` flag.
+
+// CHECK-LABEL: func @no_inplace_fold_of_unset_property
+func.func @no_inplace_fold_of_unset_property(%x: i3) -> i16 {
+  // CHECK: %[[A:.*]] = arith.extui %{{.*}} nneg : i3 to i8
+  %a = arith.extui %x nneg : i3 to i8
+  // CHECK: arith.extui %[[A]] : i8 to i16
+  %b = arith.extui %a : i8 to i16
+  return %b : i16
+}
