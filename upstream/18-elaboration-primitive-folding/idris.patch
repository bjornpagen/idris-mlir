 export
 normalisePrims : {auto c : Ref Ctxt Defs} -> {vs : _} ->
                  -- size heuristic for when to unfold
@@ -341,7 +347,13 @@ normalisePrims boundSafe viewConstant all prims n args tm env
         let True = boundSafe c -- that we should expand
