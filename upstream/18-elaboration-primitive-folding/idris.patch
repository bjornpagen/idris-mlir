diff --git a/tests/idris2/evaluator/evaluator006/Fold.idr b/tests/idris2/evaluator/evaluator006/Fold.idr
new file mode 100644
index 0000000..6561a3f
--- /dev/null
+++ b/tests/idris2/evaluator/evaluator006/Fold.idr
@@ -0,0 +1,28 @@
+-- A checked definition keeps a primitive applied to constants: what the
+-- primitive computes is the backend's to say (the text of a Double, the
+-- number a String reads as). A literal's conversion is reduced to a
+-- constant as it is elaborated, running only the primitives every backend
+-- computes alike, so `small` and `nat` are constants, and the conversion
+-- of `viaLiteral` keeps its cast from String.
+
+plain : Int
+plain = prim__cast_StringInt "12.7"
+
+text : String
+text = prim__cast_DoubleString 0.1
+
+public export
+data N = MkN Int
+
+public export
+FromString N where
+  fromString s = MkN (prim__cast_StringInt s)
+
+viaLiteral : N
+viaLiteral = "12.7"
+
+small : Int
+small = 42
+
+nat : Nat
+nat = 3
