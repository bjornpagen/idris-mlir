+namespace mlir::bufferization::detail {
+/// Buffer types computed from an explicit stack, so that the native stack
+/// does not grow with the chains of values whose buffer types depend on each
+/// other. Each frame is a value whose buffer type is being computed; the
+/// frames' values follow those the caller gave on `invocationStack`. A frame's
+/// step asks the value's owner for its buffer type. A `getBufferType`
+/// implementation asks for the buffer type of another value by calling
+/// `bufferization::getBufferType` with the invocation stack it was given,
+/// which reaches `ask` instead of recursing: the step's next answer, if an
+/// earlier run of the step asked for it; otherwise the value is wanted and the
+/// question fails. A step that wanted a value is void: the value is computed by
+/// a frame of its own, its buffer type becomes the step's next answer, and the
+/// step runs again from the start. So every implementation is asked for the
+/// same values, in the same order, with the same invocation stack, and is given
+/// the same answers as in a recursion, provided it asks the same questions
+/// when run again and acts on a failed question only by failing.
+class BufferTypeQuery {
+public:
+  BufferTypeQuery(const BufferizationOptions &options,
+                  const BufferizationState &state, ArrayRef<Value> context)
+      : options(options), state(state),
+        invocationStack(context.begin(), context.end()),
+        outer(state.bufferTypeQuery) {
+    state.bufferTypeQuery = this;
+  }
+  BufferTypeQuery(const BufferTypeQuery &) = delete;
+  BufferTypeQuery &operator=(const BufferTypeQuery &) = delete;
+  ~BufferTypeQuery() { state.bufferTypeQuery = outer; }
+
+  /// The query running on `state` whose implementations are given
+  /// `invocationStack`, if any.
+  static BufferTypeQuery *running(const BufferizationState &state,
+                                  const SmallVector<Value> &invocationStack) {
+    for (BufferTypeQuery *query = state.bufferTypeQuery; query;
+         query = query->outer)
+      if (&query->invocationStack == &invocationStack)
+        return query;
+    return nullptr;
+  }
+
+  /// The buffer type of `value`.
+  FailureOr<BufferLikeType> run(Value value) {
+    push(value);
+    while (true) {
+      wanted = Value();
+      frames.back().given = 0;
+      FailureOr<BufferLikeType> result = step(invocationStack.back());
+      if (wanted) {
+        // The step asked for a value it has no answer for yet: what it
+        // computed is void, and that value is computed first.
+        push(wanted);
+        continue;
+      }
+      Value computed = invocationStack.pop_back_val();
+      frames.pop_back();
+      if (frames.empty())
+        return result;
+      frames.back().answers.emplace_back(computed, result);
+    }
+  }
+
+  /// The answer to the step being run, asking for the buffer type of `value`.
+  FailureOr<BufferLikeType> ask(Value value) {
+    // Once the step has wanted a value, it is void until it runs again.
+    if (wanted)
+      return failure();
+    Frame &frame = frames.back();
+    if (frame.given == frame.answers.size()) {
+      wanted = value;
+      return failure();
+    }
+    auto &[asked, answer] = frame.answers[frame.given++];
+    assert(asked == value && "getBufferType asked differently when run again");
+    (void)asked;
+    return answer;
+  }
+
+private:
+  /// A value whose buffer type is being computed: the answers to the
+  /// questions its step asked, in order, and how many of them the step being
+  /// run has been given.
+  struct Frame {
+    SmallVector<std::pair<Value, FailureOr<BufferLikeType>>, 2> answers;
+    unsigned given = 0;
+  };
+
+  void push(Value value) {
+    invocationStack.push_back(value);
+    frames.emplace_back();
+  }
+
+  /// The buffer type of `value`, as its owner gives it.
+  FailureOr<BufferLikeType> step(Value value) {
+    // Try querying BufferizableOpInterface.
+    Operation *op = getOwnerOfValue(value);
+    auto bufferizableOp = options.dynCastBufferizableOp(op);
+    if (bufferizableOp)
+      return bufferizableOp.getBufferType(value, options, state,
+                                          invocationStack);
+
+    // Op is not bufferizable.
+    auto memSpace =
+        options.defaultMemorySpaceFn(cast<TensorLikeType>(value.getType()));
+    if (!memSpace.has_value())
+      return op->emitError("could not infer memory space");
+
+    return options.unknownTypeConverterFn(cast<TensorLikeType>(value.getType()),
+                                          *memSpace, options);
+  }
+
+  const BufferizationOptions &options;
+  const BufferizationState &state;
+  SmallVector<Value> invocationStack;
+  SmallVector<Frame> frames;
+  /// The value the step being run asked for with no answer, if any.
+  Value wanted;
+  BufferTypeQuery *outer;
+};
+} // namespace mlir::bufferization::detail
+
 /// Return the buffer type for a given Value (tensor) after bufferization.
 FailureOr<BufferLikeType>
 bufferization::getBufferType(Value value, const BufferizationOptions &options,
@@ -797,23 +916,11 @@ bufferization::getBufferType(Value value, const BufferizationOptions &options,
                              SmallVector<Value> &invocationStack) {
   assert(llvm::isa<TensorLikeType>(value.getType()) &&
          "unexpected non-tensor type");
-  invocationStack.push_back(value);
-  llvm::scope_exit popFromStack([&]() { invocationStack.pop_back(); });
-
-  // Try querying BufferizableOpInterface.
-  Operation *op = getOwnerOfValue(value);
-  auto bufferizableOp = options.dynCastBufferizableOp(op);
-  if (bufferizableOp)
-    return bufferizableOp.getBufferType(value, options, state, invocationStack);
-
-  // Op is not bufferizable.
-  auto memSpace =
-      options.defaultMemorySpaceFn(cast<TensorLikeType>(value.getType()));
-  if (!memSpace.has_value())
-    return op->emitError("could not infer memory space");
-
-  return options.unknownTypeConverterFn(cast<TensorLikeType>(value.getType()),
-                                        *memSpace, options);
+  // An implementation the running query runs asks for another value.
+  if (detail::BufferTypeQuery *query =
+          detail::BufferTypeQuery::running(state, invocationStack))
+    return query->ask(value);
+  return detail::BufferTypeQuery(options, state, invocationStack).run(value);
 }
 
