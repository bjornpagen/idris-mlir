diff --git a/mlir/unittests/Dialect/Bufferization/BufferTypeTest.cpp b/mlir/unittests/Dialect/Bufferization/BufferTypeTest.cpp
new file mode 100644
index 0000000..bde8b0c
--- /dev/null
+++ b/mlir/unittests/Dialect/Bufferization/BufferTypeTest.cpp
@@ -0,0 +1,72 @@
+//===- BufferTypeTest.cpp - Tests for computing buffer types --------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "mlir/Dialect/Arith/IR/Arith.h"
+#include "mlir/Dialect/Arith/Transforms/BufferizableOpInterfaceImpl.h"
+#include "mlir/Dialect/Bufferization/IR/BufferizableOpInterface.h"
+#include "mlir/Dialect/Bufferization/IR/Bufferization.h"
+#include "mlir/Dialect/Bufferization/Transforms/BufferizableOpInterfaceImpl.h"
+#include "mlir/Dialect/Tensor/IR/Tensor.h"
+#include "mlir/Dialect/Tensor/Transforms/BufferizableOpInterfaceImpl.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "llvm/Support/thread.h"
+#include "gtest/gtest.h"
+
+using namespace mlir;
+using namespace mlir::bufferization;
+
+namespace {
+
+TEST(BufferTypeTest, LongChainOnASmallStack) {
+  DialectRegistry registry;
+  registry.insert<arith::ArithDialect, BufferizationDialect,
+                  tensor::TensorDialect>();
+  arith::registerBufferizableOpInterfaceExternalModels(registry);
+  bufferization::registerBufferizableOpInterfaceExternalModels(registry);
+  tensor::registerBufferizableOpInterfaceExternalModels(registry);
+  MLIRContext context(registry);
+  context.loadAllAvailableDialects();
+
+  // An allocated tensor, then a chain of `length` values, each with a buffer
+  // type computed from the one before: a tensor.cast, whose implementation
+  // asks for its source's buffer type and builds its own from it, alternating
+  // with an arith.select of the value before and the allocation, whose
+  // implementation asks for both.
+  constexpr unsigned length = 10000;
+  OpBuilder b(&context);
+  Location loc = b.getUnknownLoc();
+  OwningOpRef<ModuleOp> module = ModuleOp::create(loc);
+  b.setInsertionPointToEnd(module->getBody());
+  auto tensorType = RankedTensorType::get({4}, b.getF32Type());
+  Value allocation =
+      AllocTensorOp::create(b, loc, tensorType, ValueRange()).getResult();
+  Value condition =
+      arith::ConstantOp::create(b, loc, b.getIntegerAttr(b.getI1Type(), 1));
+  Value last = allocation;
+  for (unsigned i = 0; i < length; ++i)
+    last = i % 2 == 0 ? Value(tensor::CastOp::create(b, loc, tensorType, last))
+                      : Value(arith::SelectOp::create(b, loc, condition, last,
+                                                      allocation));
+
+  // A computation that took a native frame per value of the chain would
+  // overflow this thread's stack.
+  BufferizationOptions options;
+  BufferizationState state;
+  FailureOr<BufferLikeType> bufferType = failure();
+  llvm::thread computer(/*StackSizeInBytes=*/256 * 1024, [&] {
+    bufferType = getBufferType(last, options, state);
+  });
+  computer.join();
+
+  // Every value of the chain has the allocation's buffer type.
+  ASSERT_TRUE(succeeded(bufferType));
+  EXPECT_EQ(Type(*bufferType), MemRefType::get({4}, b.getF32Type()));
+}
+
+} // namespace
