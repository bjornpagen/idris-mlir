+  /// Two operations compared without their regions: attributes, properties,
+  /// operands and results, the results marked equivalent.
+  UpToRegions compareUpToRegions(Operation *lhs, Operation *rhs) {
+    if (lhs == rhs)
+      return UpToRegions::Same;
+
+    // Each attribute and type below is compared as it is and, when they
+    // differ and `mapSymbolRef` is given, once more with its symbol
