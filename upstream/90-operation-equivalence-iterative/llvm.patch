+TEST(OperationEquivalenceTest, DeepNestingOnASmallStack) {
+  MLIRContext context;
+  context.allowUnregisteredDialects();
+  Location loc = UnknownLoc::get(&context);
+  Type i32 = Builder(&context).getI32Type();
+
+  // A chain of operations nested `depth` deep, each with one result and one
+  // region of one block with one argument, the block holding the next
+  // operation of the chain and then a use of its argument. The innermost
+  // block holds a region of two blocks, the first branching to the second
+  // and the second to the block `target` names. `marked` lists the values a
+  // comparison marks equivalent, in the order of a recursion: each result,
+  // then the argument of the block in its region, down the chain, then the
+  // uses' results back up. Returns the chain, outermost first.
+  constexpr unsigned depth = 10000;
+  auto makeChain = [&](unsigned target, SmallVectorImpl<Value> &marked) {
+    OpBuilder b(&context);
+    SmallVector<Operation *> chain;
+    SmallVector<Block *> bodies;
+    for (unsigned level = 0; level < depth; ++level) {
+      OperationState nest(loc, "foo.nest");
+      nest.addTypes(i32);
+      nest.addRegion();
+      chain.push_back(b.create(nest));
+      marked.push_back(chain.back()->getResult(0));
+      bodies.push_back(
+          b.createBlock(&chain.back()->getRegion(0), {}, {i32}, {loc}));
+      marked.push_back(bodies.back()->getArgument(0));
+    }
+    OperationState leaf(loc, "foo.leaf");
+    leaf.addRegion();
+    Region &cfg = b.create(leaf)->getRegion(0);
+    Block *blocks[] = {b.createBlock(&cfg), b.createBlock(&cfg)};
+    for (unsigned i = 0; i < 2; ++i) {
+      b.setInsertionPointToEnd(blocks[i]);
+      OperationState br(loc, "foo.br");
+      br.addSuccessors(blocks[i == 0 ? 1 : target]);
+      b.create(br);
+    }
+    for (Block *body : llvm::reverse(bodies)) {
+      b.setInsertionPointToEnd(body);
+      OperationState use(loc, "foo.use");
+      use.addOperands(body->getArgument(0));
+      use.addTypes(i32);
+      marked.push_back(b.create(use)->getResult(0));
+    }
+    return chain;
+  };
+  SmallVector<Value> lhsMarked, rhsMarked, otherMarked;
+  SmallVector<Operation *> lhs = makeChain(1, lhsMarked);
+  SmallVector<Operation *> rhs = makeChain(1, rhsMarked);
+  SmallVector<Operation *> other = makeChain(0, otherMarked);
+
+  // A comparison that took a native frame per level of nesting would
+  // overflow this thread's stack.
+  DenseMap<Value, Value> equivalent;
+  SmallVector<std::pair<Value, Value>> marks;
+  bool chainsEquivalent = false, regionsEquivalent = false,
+       otherEquivalent = true;
+  llvm::thread comparer(/*StackSizeInBytes=*/256 * 1024, [&] {
+    chainsEquivalent = OperationEquivalence::isEquivalentTo(
+        lhs.front(), rhs.front(),
+        [&](Value l, Value r) {
+          return success(l == r || equivalent.lookup(l) == r);
+        },
+        [&](Value l, Value r) {
+          equivalent[l] = r;
+          marks.emplace_back(l, r);
+        },
+        OperationEquivalence::IgnoreLocations);
+    regionsEquivalent = OperationEquivalence::isRegionEquivalentTo(
+        &lhs.front()->getRegion(0), &rhs.front()->getRegion(0),
+        OperationEquivalence::IgnoreLocations);
+    otherEquivalent = OperationEquivalence::isEquivalentTo(
+        lhs.front(), other.front(), OperationEquivalence::IgnoreLocations);
+  });
+  comparer.join();
+
+  EXPECT_TRUE(chainsEquivalent);
+  EXPECT_TRUE(regionsEquivalent);
+  // The innermost branches map the second block to two different blocks.
+  EXPECT_FALSE(otherEquivalent);
+  // Every value is marked once, in the order a recursion marks them.
+  SmallVector<std::pair<Value, Value>> expected;
+  for (auto [l, r] : llvm::zip_equal(lhsMarked, rhsMarked))
+    expected.emplace_back(l, r);
+  EXPECT_TRUE(marks == expected);
+
+  // Innermost first, so that no destruction recurses on the depth either.
+  for (SmallVector<Operation *> *chain : {&lhs, &rhs, &other})
+    for (Operation *op : llvm::reverse(*chain))
+      op->erase();
+}
