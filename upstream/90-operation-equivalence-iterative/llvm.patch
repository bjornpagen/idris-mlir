+namespace {
+/// Two operations, or two lists of regions, compared from an explicit stack,
+/// so that the native stack does not grow with the depth of region nesting.
+/// The comparison runs in the order of a recursion, and calls back in it: an
+/// operation's attributes, properties, operands and results, then each of
+/// its regions in turn, each region's blocks in order, each block's arguments
+/// and then its operations, and an operation's successors once everything
+/// nested in it is compared. It stops at the first difference.
+class EquivalenceComparison {
+public:
+  EquivalenceComparison(
+      function_ref<LogicalResult(Value, Value)> checkEquivalent,
+      function_ref<void(Value, Value)> markEquivalent,
+      OperationEquivalence::Flags flags,
+      function_ref<LogicalResult(ValueRange, ValueRange)>
+          checkCommutativeEquivalent,
+      OperationEquivalence::MapSymbolRefFn mapSymbolRef)
+      : checkEquivalent(checkEquivalent), markEquivalent(markEquivalent),
+        flags(flags), checkCommutativeEquivalent(checkCommutativeEquivalent),
+        mapper(mapSymbolRef) {}
+
+  /// Whether two operations are equivalent, with everything nested in them.
+  bool operations(Operation *lhs, Operation *rhs) {
+    UpToRegions found = compareUpToRegions(lhs, rhs);
+    if (found != UpToRegions::Equivalent)
+      return found == UpToRegions::Same;
+    return regions(lhs->getRegions(), rhs->getRegions());
+  }
+
+  /// Whether each pair of regions is equivalent, with everything nested in
+  /// them; the blocks of each pair are mapped apart.
+  bool regions(MutableArrayRef<Region> lhs, MutableArrayRef<Region> rhs) {
+    SmallVector<Frame> stack;
+    Step step = open(stack, lhs, rhs);
+    if (step != Step::AtBlocks)
+      return step == Step::Done;
+    while (true) {
+      Frame &frame = stack.back();
+      if (frame.lhsOp != frame.lhsBlock->end() &&
+          frame.rhsOp != frame.rhsBlock->end()) {
+        // The next pair of operations of the pair of blocks.
+        Operation *lhsOp = &*frame.lhsOp, *rhsOp = &*frame.rhsOp;
+        UpToRegions found = compareUpToRegions(lhsOp, rhsOp);
+        if (found == UpToRegions::Different)
+          return false;
+        if (found == UpToRegions::Equivalent) {
+          // Opening their regions may move the stack, `frame` with it.
+          step = open(stack, lhsOp->getRegions(), rhsOp->getRegions());
+          if (step == Step::Different)
+            return false;
+          if (step == Step::AtBlocks)
+            continue;
+        }
+      } else {
+        // The pair of blocks is compared: both must end here.
+        if (frame.lhsOp != frame.lhsBlock->end() ||
+            frame.rhsOp != frame.rhsBlock->end())
+          return false;
+        ++frame.lhsBlock;
+        ++frame.rhsBlock;
+        step = seekBlocks(frame);
+        if (step == Step::Different)
+          return false;
+        if (step == Step::AtBlocks)
+          continue;
+        // Every pair of regions of the frame is equivalent, so the pair of
+        // operations holding them is, or the regions the caller gave are.
+        stack.pop_back();
+        if (stack.empty())
+          return true;
+      }
+      // The pair of operations the frame on top has reached is equivalent,
+      // with everything nested in it: its successors are mapped in the
+      // frame's region, and the frame moves on to the next pair.
+      Frame &top = stack.back();
+      if (!mapSuccessors(top))
+        return false;
+      ++top.lhsOp;
+      ++top.rhsOp;
+    }
+  }
+
+private:
+  /// What comparing two operations without their regions found.
+  enum class UpToRegions {
+    /// They differ.
+    Different,
+    /// They are one operation, so equivalent with nothing more compared.
+    Same,
+    /// They are equivalent if their regions are.
+    Equivalent,
+  };
+
+  /// The pairs of regions of two operations being compared, or the regions
+  /// the caller gave: the pairs not yet finished, the one being compared
+  /// first, with the map of its blocks, and the pair of blocks and of
+  /// operations in them the comparison has reached.
+  struct Frame {
+    Frame(MutableArrayRef<Region> lhs, MutableArrayRef<Region> rhs)
+        : lhsRegions(lhs), rhsRegions(rhs), lhsBlock(lhs.front().begin()),
+          rhsBlock(rhs.front().begin()) {}
+
+    MutableArrayRef<Region> lhsRegions, rhsRegions;
+    DenseMap<Block *, Block *> blocks;
+    Region::iterator lhsBlock, rhsBlock;
+    Block::iterator lhsOp, rhsOp;
+  };
+
+  /// Where a frame stands once it has looked for its next pair of blocks.
+  enum class Step {
+    /// The blocks or the regions differ.
+    Different,
+    /// It is at a pair of blocks whose arguments are equivalent.
+    AtBlocks,
+    /// Every pair of its regions is equivalent.
+    Done,
+  };
+
+  /// A frame for two lists of regions, on the stack while it has blocks to
+  /// compare.
+  Step open(SmallVectorImpl<Frame> &stack, MutableArrayRef<Region> lhs,
+            MutableArrayRef<Region> rhs) {
+    if (lhs.empty())
+      return Step::Done;
+    Step step = seekBlocks(stack.emplace_back(lhs, rhs));
+    if (step != Step::AtBlocks)
+      stack.pop_back();
+    return step;
+  }
+
+  /// The frame moved to the pair of blocks its iterators are at, or past the
+  /// end of its pair of regions to the next pair.
+  Step seekBlocks(Frame &frame) {
+    while (true) {
+      bool lhsEnded = frame.lhsBlock == frame.lhsRegions.front().end();
+      bool rhsEnded = frame.rhsBlock == frame.rhsRegions.front().end();
+      if (!lhsEnded && !rhsEnded)
+        return enterBlocks(frame) ? Step::AtBlocks : Step::Different;
+      // The pair of regions is compared: both must end here.
+      if (lhsEnded != rhsEnded)
+        return Step::Different;
+      frame.lhsRegions = frame.lhsRegions.drop_front();
+      frame.rhsRegions = frame.rhsRegions.drop_front();
+      if (frame.lhsRegions.empty())
+        return Step::Done;
+      frame.blocks.clear();
+      frame.lhsBlock = frame.lhsRegions.front().begin();
+      frame.rhsBlock = frame.rhsRegions.front().begin();
+    }
+  }
+
+  /// Whether the frame's pair of blocks map to each other and their
+  /// arguments are equivalent; if so, the frame is at their first operations.
+  bool enterBlocks(Frame &frame) {
+    Block &lBlock = *frame.lhsBlock, &rBlock = *frame.rhsBlock;
     // Check block arguments.
     if (lBlock.getNumArguments() != rBlock.getNumArguments())
       return false;
 
