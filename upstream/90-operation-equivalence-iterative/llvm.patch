+
+    // 2. Compare operands.
+    if (!(flags & OperationEquivalence::IgnoreCommutativity) &&
+        checkCommutativeEquivalent &&
+        lhs->hasTrait<mlir::OpTrait::IsCommutative>()) {
+      auto lhsRange = lhs->getOperands();
