+-- The nodes of a term, which bound how far 'isEmpty' looks into a type.
+termSize : Term vars -> Nat
+termSize (Meta _ _ _ args) = S (foldr (\t, acc => termSize t + acc) 0 args)
+termSize (Bind _ _ b sc) = S (foldr (\t, acc => termSize t + acc) 0 b + termSize sc)
+termSize (App _ f a) = S (termSize f + termSize a)
+termSize (As _ _ a p) = S (termSize a + termSize p)
+termSize (TDelayed _ _ t) = S (termSize t)
+termSize (TDelay _ _ ty a) = S (termSize ty + termSize a)
+termSize (TForce _ _ t) = S (termSize t)
+termSize _ = 1
+
+-- What a constructor's type says of building a value of a given type: it
+-- cannot, its return type conflicting with the type, or it may, and then
+-- takes arguments of these types, each argument its return type
+-- determines replaced by what the type has there (an argument it does not
+-- determine stays a fresh name, which conflicts with nothing). Also the
+-- next number for a fresh name.
+data Build : Scope -> Type where
+     Conflicts : Build vars
+     Fits : List (Term vars) -> Int -> Build vars
+
+-- How a constructor builds a value of the type, if it can: whether any
+-- part of the type conflicts with the constructor's return type in such a
+-- way that they can't possibly be equal (i.e. mismatched constructor), and
+-- otherwise the types of its arguments. Their fresh names are numbered
+-- from 'base'.
+build : {vars : _} ->
+        {auto c : Ref Ctxt Defs} ->
+        Defs -> Env Term vars -> Int -> NF vars -> Name -> Core (Build vars)
+build defs env base nfty n
     = do Just gdef <- lookupCtxtExact n (gamma defs)
-              | Nothing => pure False
+              | Nothing => pure (Fits [] base)
          case (definition gdef, type gdef) of
               (DCon t arity _, dty)
-                  => do Nothing <- conflictNF 0 nfty !(nf defs Env.empty dty)
-                            | Just ms => pure $ conflictMatch ms
-                        pure True
-              _ => pure False
+                  => do (argtys, ret, next) <- instantiate base !(nf defs Env.empty dty)
+                        Just ms <- conflictNF next nfty ret
+                            | Nothing => pure Conflicts
+                        pure $ if conflictMatch ms
+                                  then Conflicts
+                                  else Fits (map (substAll ms . embed) argtys) next
+              _ => pure (Fits [] base)
   where
+    -- The constructor's type with each argument a fresh name, numbered
+    -- from i: the arguments' types, the type it returns, and the next
+    -- number.
+    instantiate : Int -> ClosedNF -> Core (List ClosedTerm, ClosedNF, Int)
+    instantiate i (NBind fc x b sc)
+        = do let x' = MN (show x) i
+             ty <- quote defs Env.empty !(evalClosure defs (binderType b))
+             (tys, ret, next) <- instantiate (i + 1)
+                                   !(sc defs (toClosure defaultOpts Env.empty (Ref fc Bound x')))
+             pure (ty :: tys, ret, next)
+    instantiate i ret = pure ([], ret, i)
+
+    -- The fresh names are numbered past those of every type the caller
+    -- is inside, so what one is replaced by mentions no other of them.
+    substAll : List (Name, Term vars) -> Term vars -> Term vars
+    substAll ms tm = foldl (\t, (x, v) => substName x v t) tm ms
