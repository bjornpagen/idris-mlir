-                  => do Nothing <- conflictNF 0 nfty !(nf defs Env.empty dty)
-                            | Just ms => pure $ conflictMatch ms
-                        pure True
-              _ => pure False
+                  => do (argtys, ret, next) <- instantiate base !(nf defs Env.empty dty)
+                        Just ms <- conflictNF next nfty ret
+                            | Nothing => pure Conflicts
+                        -- The fresh names are numbered past those of
+                        -- every type the caller is inside, so what one is
+                        -- replaced by mentions no other of them.
+                        pure $ if conflictMatch ms
+                                  then Conflicts
+                                  else Fits (map (substAll ms . embed) argtys) (sameArg ms) next
+              _ => pure (Fits [] [] base)
