+isEmpty defs env tynf
+    = do (None, _) <- emptyFrom 0 tynf
+           | (Holding _, _) => pure False
+         pure True
+  where
+    -- Each search takes the number of its first fresh name and gives the
+    -- number past every fresh name it made, so no two fresh names of the
+    -- whole search are the same, and putting into a type what one stands
+    -- for captures no other.
+    emptyFrom : Int -> NF vars -> Core (Inhabitants vars, Int)
+    emptyFrom next nfty@(NTCon fc n a args)
+      = do Just nty <- lookupDefExact n (gamma defs)
+             | _ => pure (Holding [], next)
+           case nty of
+                TCon _ _ _ flags _ Nothing _ => pure (Holding [], next)
+                TCon _ _ _ flags _ (Just cons) _
+                     => if not (external flags)
+                           then inhabitants next cons
+                           else pure (Holding [], next)
+                _ => pure (Holding [], next)
+      where
+        emptyArg : Nat -> Int -> Term vars -> Core (Inhabitants vars, Int)
+        emptyArg size next ty
+            = do argnf@(NTCon {}) <- nf defs env ty
+                   | _ => pure (Holding [], next)
+                 if termSize !(quote defs env argnf) < size
+                    then emptyFrom next argnf
+                    else pure (Holding [], next)
+
+        -- What the arguments' types hold, or Nothing if one is empty.
+        argsHold : Nat -> Int -> List (Term vars) ->
+                   Core (Maybe (List (Term vars, Term vars)), Int)
+        argsHold size next [] = pure (Just [], next)
+        argsHold size next (ty :: tys)
+            = do (Holding eqs, next) <- emptyArg size next ty
+                   | (None, next) => pure (Nothing, next)
+                 (held, next) <- argsHold size next tys
+                 pure (map (eqs ++) held, next)
+
+        -- What a constructor that fits holds of the type when it builds a
+        -- value of it, or Nothing if it cannot: one of its arguments' types
+        -- is empty, as it is or read under what the others hold of the
+        -- fresh names, each of which stands for one value of an argument.
+        builds : List (Term vars) -> List (Term vars, Term vars) -> Int ->
+                 Core (Maybe (List (Term vars, Term vars)), Int)
+        builds [] eqs next = pure (Just eqs, next)
+        builds argtys eqs next
+            = do size <- termSize <$> quote defs env nfty
+                 (Just held, next) <- argsHold size next argtys
+                   | (Nothing, next) => pure (Nothing, next)
+                 let holds = eqs ++ held
+                 let solved = forcedBy holds
+                 let changed = filter (\ty => any (\ (x, _) => occurs x ty) solved) argtys
+                 (Just _, next) <- argsHold size next (map (substAll solved) changed)
+                   | (Nothing, next) => pure (Nothing, next)
+                 pure (Just holds, next)
+
+        -- Whether some constructor builds a value of the type.
+        noneBuilds : Int -> List Name -> Core (Inhabitants vars, Int)
+        noneBuilds next [] = pure (None, next)
+        noneBuilds next (con :: cons)
+            = case !(build defs env next nfty con) of
+                   Conflicts => noneBuilds next cons
+                   Fits argtys eqs next
+                       => do (Nothing, next) <- builds argtys eqs next
+                               | (Just _, next) => pure (Holding [], next)
+                             noneBuilds next cons
+
+        inhabitants : Int -> List Name -> Core (Inhabitants vars, Int)
+        inhabitants next [con]
+            = case !(build defs env next nfty con) of
+                   Conflicts => pure (None, next)
+                   Fits argtys eqs next
+                       => do (held, next) <- builds argtys eqs next
+                             pure (maybe None Holding held, next)
+        inhabitants next cons = noneBuilds next cons
+    emptyFrom next _ = pure (Holding [], next)
 
