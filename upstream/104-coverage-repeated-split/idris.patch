+    -- A tree may split a variable again below a split of it (the tree of a
+    -- default repeats the split), binding its arguments under new names,
+    -- and a split of one of those refines what the first split found. So
+    -- the walk keeps what each variable stands for in 'ps': a split of a
+    -- variable that stands for a constructor binds its arguments to that
+    -- constructor's parts, and is impossible for any other constructor; a
+    -- split of one that stands for a pattern variable substitutes it.
+    standsFor : ClosedTerm
+    standsFor = fromMaybe (Ref fc Bound var) (lookup var bound)
+
+    -- The names 'ps' give a split's arguments, its own: the alternatives
+    -- that stand for a default all use the same names. Each is printed as
+    -- `m`, as theirs are.
+    fieldNames : List Name -> Core (List Name)
+    fieldNames = traverse (\_ => do i <- get FreshArg
+                                    put FreshArg (i + 1)
+                                    pure (MN "m" i))
+
+    refine : ClosedTerm -> (List ClosedTerm, Bindings)
+    refine pat
+        = case standsFor of
+               Ref _ Bound x => (map (substName x pat) ps,
+                                 map (\(n, tm) => (n, substName x pat tm)) bound)
+               _ => (ps, bound)
