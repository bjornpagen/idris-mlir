+-- Whether an argument is no computation: an identity drops the arguments
+-- but its own, which eager evaluation would evaluate, so a recursive call
+-- that drops a computation makes no identity.
+inert : CExp vars -> Bool
+inert (CLocal {}) = True
+inert (CRef {}) = True
+inert (CLam {}) = True
+inert (CDelay {}) = True
+inert (CPrimVal {}) = True
+inert (CErased {}) = True
+inert (CCon _ _ _ _ args) = allInert args
+  where
+    allInert : List (CExp vars) -> Bool
+    allInert [] = True
+    allInert (a :: as) = inert a && allInert as
+inert _ = False
+
+-- Whether every argument but the one at the index is inert.
+othersInert : Nat -> List (CExp vars) -> Bool
+othersInert _ [] = True
+othersInert Z (_ :: as) = all inert as
+othersInert (S k) (a :: as) = inert a && othersInert k as
+
