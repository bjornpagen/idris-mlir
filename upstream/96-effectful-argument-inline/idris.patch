+-- Whether an expression may go unevaluated when nothing uses its value,
+-- without changing what eager evaluation does: a variable, a value, a
+-- function applied to fewer arguments than it takes, a constructor or a
+-- primitive operation that cannot fail applied to such, or the force of
+-- such (a lazy value's computation runs only where its value is needed).
+-- Any other expression, a call with all its arguments, an external
+-- primitive, a case or a crash, is a computation: eager evaluation runs it
+-- even when nothing uses its value, and so must the inlined code.
+droppable : {auto c : Ref Ctxt Defs} -> CExp vars -> Core Bool
+droppable (CLocal {}) = pure True
+droppable (CRef {}) = pure True
+droppable (CLam {}) = pure True
+droppable (CDelay {}) = pure True
+droppable (CPrimVal {}) = pure True
+droppable (CErased {}) = pure True
+droppable (CForce _ _ e) = droppable e
+droppable (CCon _ _ _ _ args) = allM droppable args
+droppable (COp _ op args)
+    = if canFail op then pure False else allM droppable (toList args)
+  where
+    canFail : PrimFn arity -> Bool
+    canFail (Div _) = True
+    canFail (Mod _) = True
+    canFail StrHead = True
+    canFail StrTail = True
+    canFail StrIndex = True
+    canFail StrSubstr = True
+    canFail (Cast DoubleType _) = True
+    canFail Crash = True
+    canFail _ = False
+droppable (CApp _ (CRef _ n) args)
+    = do defs <- get Ctxt
+         Just gdef <- lookupCtxtExact n (gamma defs)
+              | Nothing => pure False
+         let Just def = compexpr gdef
+              | Nothing => pure False
+         if length args < getArity def
+            then allM droppable args
+            else pure False
+droppable _ = pure False
+
+-- The computations among values bound to variables a body never uses:
+-- substituting the values for the variables would drop them.
+ignored : {auto c : Ref Ctxt Defs} ->
+          {scope : _} ->
+          CExp scope -> List (Name, Var scope) -> List (CExp free) ->
+          Core (List (Name, CExp free))
+ignored sc ((x, MkVar p) :: ps) (val :: vals)
+    = do rest <- ignored sc ps vals
+         if !(droppable val) || used p sc > 0
+            then pure rest
+            else pure ((x, val) :: rest)
+ignored _ _ _ = pure []
+
+-- Lets that run, before a body, the computations whose values it ignores,
+-- the first outermost, as eager evaluation runs them. The inliner never
+-- inlines them.
+keep : List (Name, CExp vars) -> CExp vars -> CExp vars
+keep [] body = body
+keep ((x, val) :: rest) body
+    = CLet (getFC val) x NotInline val (weaken (keep rest body))
+
