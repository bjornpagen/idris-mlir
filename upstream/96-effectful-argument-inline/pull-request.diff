+mutual
+  ||| Whether evaluating an expression can only give a value: no call,
+  ||| primitive, force or case runs in it. Such an expression may be
+  ||| substituted, or dropped when unused, without changing what eager
+  ||| evaluation does; any other is evaluated once, where it stands.
+  export
+  isValue : CExp vars -> Bool
+  isValue (CLocal {}) = True
+  isValue (CLam {}) = True
+  isValue (CDelay {}) = True
+  isValue (CPrimVal {}) = True
+  isValue (CErased {}) = True
+  isValue (CCon _ _ _ _ args) = allValues args
+  isValue _ = False
+
+  allValues : List (CExp vars) -> Bool
+  allValues [] = True
+  allValues (a :: as) = isValue a && allValues as
+
 export
 getFC : CExp args -> FC
 getFC (CLocal fc _) = fc
