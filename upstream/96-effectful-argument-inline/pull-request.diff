+  -- The arguments a call consumes that are not values are evaluated once,
+  -- before the body, as eager evaluation evaluates them: each is bound by a
+  -- let the inliner keeps, and the body takes the let's name, so an argument
+  -- the body never uses still runs.
+  bindComputations : {free : _} ->
+                     {auto l : Ref LVar Int} ->
+                     Nat -> Stack free ->
+                     Core (Stack free, List (Name, CExp free))
+  bindComputations Z stk = pure (stk, [])
+  bindComputations (S k) [] = pure ([], [])
+  bindComputations (S k) (e :: stk)
+      = do (stk', lets) <- bindComputations k stk
+           if isValue e
+              then pure (e :: stk', lets)
+              else do xn <- genName "arg"
+                      pure (CRef (getFC e) xn :: stk', (xn, e) :: lets)
+
+  -- The lets of `bindComputations`, the first argument's outermost.
+  bindLets : {free : _} -> List (Name, CExp free) -> CExp free -> CExp free
+  bindLets [] body = body
+  bindLets ((xn, e) :: lets) body
+      = CLet (getFC e) xn NotInline e (refToLocal xn xn (bindLets lets body))
+
