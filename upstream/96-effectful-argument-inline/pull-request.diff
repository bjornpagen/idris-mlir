+-- Whether every argument but the one at the index is a value: a recursive
+-- call an identity drops drops its other arguments with it.
+othersAreValues : Nat -> List (CExp vars) -> Bool
+othersAreValues _ [] = True
+othersAreValues Z (_ :: as) = all isValue as
+othersAreValues (S k) (a :: as) = isValue a && othersAreValues k as
