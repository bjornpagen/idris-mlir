+onClausePatNames : (Name -> Core Name) -> (ClosedTerm -> Core ClosedTerm) ->
+                   List (List Pat) -> Core (List (List Pat))
+onClausePatNames f g [] = pure []
+onClausePatNames f g (c :: cs) = [| onPatsNames f g c :: onClausePatNames f g cs |]
