--- A term and the parts of one, each as its instance below writes it.
+-- A term keeps the location of each of its nodes, which a compiler reading
+-- the term back names in what it reports. A node's location is written
+-- against the location it is part of: the nearest enclosing node's that has
+-- one (`within`), whose file it nearly always shares, so a location in that
+-- file is its start line as a difference from that one's, its columns, and
+-- its line count, each small; any other is written whole. A term written on
+-- its own is part of no location.
+total
+within : FC -> FC -> FC
+within at EmptyFC = at
+within at fc = fc
+
+total
+originOf : FC -> Maybe OriginDesc
+originOf (MkFC o _ _) = Just o
+originOf (MkVirtualFC o _ _) = Just o
+originOf EmptyFC = Nothing
+
+-- A location of the file `at` is in, by tag `t`; any other, whole.
+total
+encodeAgainst : {auto b : Ref Bin Binary} -> (at : FC) -> (t : Int) -> FC ->
+                OriginDesc -> FilePos -> FilePos -> Core ()
+encodeAgainst at t fc o (sl, sc) (el, ec)
+    = case (originOf at, startOf at) of
+           (Just o', Just (al, _)) =>
+             if o == o'
+                then do tag t; toBuf (sl - al); toBuf sc; toBuf (el - sl); toBuf ec
+                else do tag 3; toBuf fc
+           _ => do tag 3; toBuf fc
+  where
+    startOf : FC -> Maybe FilePos
+    startOf (MkFC _ s _) = Just s
+    startOf (MkVirtualFC _ s _) = Just s
+    startOf EmptyFC = Nothing
+
+total
+encodeFC : {auto b : Ref Bin Binary} -> (at : FC) -> FC -> Core ()
+encodeFC at EmptyFC = tag 0
+encodeFC at fc@(MkFC o s e) = encodeAgainst at 1 fc o s e
+encodeFC at fc@(MkVirtualFC o s e) = encodeAgainst at 2 fc o s e
+
+total
+decodeFC : {auto b : Ref Bin Binary} -> (at : FC) -> Core FC
+decodeFC at
+    = case !getTag of
+           0 => pure EmptyFC
+           1 => against MkFC
+           2 => against MkVirtualFC
+           3 => fromBuf
+           _ => corrupt "FC"
+  where
+    against : (OriginDesc -> FilePos -> FilePos -> FC) -> Core FC
+    against mk
+        = case at of
+               MkFC o (al, _) _ => relative mk o al
+               MkVirtualFC o (al, _) _ => relative mk o al
+               EmptyFC => corrupt "FC"
+      where
+        relative : (OriginDesc -> FilePos -> FilePos -> FC) -> OriginDesc -> Int -> Core FC
+        relative mk o al
+            = do dl <- fromBuf; sc <- fromBuf; n <- fromBuf; ec <- fromBuf
+                 let sl = al + dl
+                 pure (mk o (sl, sc) (sl + n, ec))
+
