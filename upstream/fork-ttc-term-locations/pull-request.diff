+-- A term keeps the location of each of its nodes, which a compiler reading
+-- the term back names in what it reports. A node's location is written
+-- against the location it is part of: the nearest enclosing node's that has
+-- one (`within`), whose file it nearly always shares, so a location in that
+-- file is its start line as a difference from that one's, its columns, and
+-- its line count, each small; any other is written whole. A term written on
+-- its own is part of no location.
+total
+within : FC -> FC -> FC
+within at EmptyFC = at
+within at fc = fc
+
+total
+originOf : FC -> Maybe OriginDesc
+originOf (MkFC o _ _) = Just o
+originOf (MkVirtualFC o _ _) = Just o
+originOf EmptyFC = Nothing
+
+-- A location of the file `at` is in, by tag `t`; any other, whole.
+total
+encodeAgainst : {auto b : Ref Bin Binary} -> (at : FC) -> (t : Int) -> FC ->
+                OriginDesc -> FilePos -> FilePos -> Core ()
+encodeAgainst at t fc o (sl, sc) (el, ec)
+    = case (originOf at, startOf at) of
+           (Just o', Just (al, _)) =>
+             if o == o'
+                then do tag t; toBuf (sl - al); toBuf sc; toBuf (el - sl); toBuf ec
+                else do tag 3; toBuf fc
+           _ => do tag 3; toBuf fc
+  where
+    startOf : FC -> Maybe FilePos
+    startOf (MkFC _ s _) = Just s
+    startOf (MkVirtualFC _ s _) = Just s
+    startOf EmptyFC = Nothing
+
+total
+encodeFC : {auto b : Ref Bin Binary} -> (at : FC) -> FC -> Core ()
+encodeFC at EmptyFC = tag 0
+encodeFC at fc@(MkFC o s e) = encodeAgainst at 1 fc o s e
+encodeFC at fc@(MkVirtualFC o s e) = encodeAgainst at 2 fc o s e
+
+total
+decodeFC : {auto b : Ref Bin Binary} -> (at : FC) -> Core FC
+decodeFC at
+    = case !getTag of
+           0 => pure EmptyFC
+           1 => against MkFC
+           2 => against MkVirtualFC
+           3 => fromBuf
+           _ => corrupt "FC"
+  where
+    against : (OriginDesc -> FilePos -> FilePos -> FC) -> Core FC
+    against mk
+        = case at of
+               MkFC o (al, _) _ => relative mk o al
+               MkVirtualFC o (al, _) _ => relative mk o al
+               EmptyFC => corrupt "FC"
+      where
+        relative : (OriginDesc -> FilePos -> FilePos -> FC) -> OriginDesc -> Int -> Core FC
+        relative mk o al
+            = do dl <- fromBuf; sc <- fromBuf; n <- fromBuf; ec <- fromBuf
+                 let sl = al + dl
+                 pure (mk o (sl, sc) (sl + n, ec))
+
+-- A term and the parts of one, each as its instance below writes it, read
+-- within the location `at` it is part of.
+mutual
+  decodePi : {vars : _} -> {auto b : Ref Bin Binary} -> (at : FC) ->
+             Core (PiInfo (Term vars))
+  decodePi at
+      = case !getTag of
+             0 => pure Implicit
+             1 => pure Explicit
+             2 => pure AutoImplicit
+             3 => do t <- decodeTerm at; pure (DefImplicit t)
+             _ => corrupt "PiInfo"
+
+  decodeBinder : {vars : _} -> {auto b : Ref Bin Binary} -> (at : FC) ->
+                 Core (Binder (Term vars))
+  decodeBinder at
+      = do t <- getTag
+           fc <- decodeFC at
+           let inner = within at fc
+           case t of
+                0 => do c <- fromBuf; x <- decodePi inner; ty <- decodeTerm inner; pure (Lam fc c x ty)
+                1 => do c <- fromBuf; x <- decodeTerm inner; pure (Let fc c x (Erased emptyFC Placeholder))
+                2 => do c <- fromBuf; x <- decodePi inner; y <- decodeTerm inner; pure (Pi fc c x y)
+                3 => do c <- fromBuf; p <- decodePi inner; ty <- decodeTerm inner; pure (PVar fc c p ty)
+                4 => do c <- fromBuf; x <- decodeTerm inner; pure (PLet fc c x (Erased emptyFC Placeholder))
+                5 => do c <- fromBuf; pure (PVTy fc c (Erased emptyFC Placeholder))
+                _ => corrupt "Binder"
+
+  -- A list of terms as the list instance writes it: its length, then each.
+  decodeTerms : {vars : _} -> {auto b : Ref Bin Binary} -> (at : FC) ->
+                Core (List (Term vars))
+  decodeTerms at
+      = do len <- fromBuf {a = Int}
+           decodeTermList at [] (integerToNat (cast len))
+
+  decodeTermList : {vars : _} -> {auto b : Ref Bin Binary} -> (at : FC) ->
+                   List (Term vars) -> (count : Nat) -> Core (List (Term vars))
+  decodeTermList at ts Z = pure (reverse ts)
+  decodeTermList at ts (S k)
+      = do t <- decodeTerm at
+           decodeTermList at (t :: ts) k
+
+  -- The arguments of an application of `f` to several, as encodeArgs writes
+  -- them: their count, then each with the location of its application.
+  decodeArgs : {vars : _} -> {auto b : Ref Bin Binary} -> (at : FC) ->
+               Term vars -> Core (Term vars)
+  decodeArgs at f
+      = do len <- fromBuf {a = Int}
+           decodeSpine at f (integerToNat (cast len))
+
+  decodeSpine : {vars : _} -> {auto b : Ref Bin Binary} -> (at : FC) ->
+                Term vars -> (count : Nat) -> Core (Term vars)
+  decodeSpine at f Z = pure f
+  decodeSpine at f (S k)
+      = do fc <- decodeFC at
+           a <- decodeTerm (within at fc)
+           decodeSpine at (App fc f a) k
+
+  decodeTerm : {vars : _} -> {auto b : Ref Bin Binary} -> (at : FC) ->
+               Core (Term vars)
+  decodeTerm {vars} at
+      = do t <- getTag
+           -- An application to several arguments has no location of its
+           -- own: each of its applications has one, in the list of them.
+           fc <- if t == 12 then pure at else decodeFC at
+           let inner = within at fc
+           case t of
+                0 => do c <- fromBuf
+                        idx <- fromBuf
+                        name <- maybe (corrupt "Term") pure
+                                      (getAt idx vars)
+                        pure (Local {name} fc c idx (mkPrf idx))
+                1 => do nt <- fromBuf; name <- fromBuf
+                        pure (Ref fc nt name)
+                2 => do n <- fromBuf
+                        xs <- decodeTerms inner
+                        pure (Meta fc n 0 xs) -- needs resolving
+                3 => do x <- fromBuf
+                        bnd <- decodeBinder inner; scope <- decodeTerm inner
+                        pure (Bind fc x bnd scope)
+                4 => do fn <- decodeTerm inner
+                        arg <- decodeTerm inner
+                        pure (App fc fn arg)
+                5 => do as <- decodeTerm inner; s <- fromBuf; tm <- decodeTerm inner
+                        pure (As fc s as tm)
+                6 => do lr <- fromBuf; tm <- decodeTerm inner
+                        pure (TDelayed fc lr tm)
+                7 => do lr <- fromBuf;
+                        ty <- decodeTerm inner; tm <- decodeTerm inner
+                        pure (TDelay fc lr ty tm)
+                8 => do lr <- fromBuf; tm <- decodeTerm inner
+                        pure (TForce fc lr tm)
+                9 => do c <- fromBuf
+                        pure (PrimVal fc c)
+                10 => pure (Erased fc Placeholder)
+                11 => do u <- fromBuf; pure (TType fc u)
+                12 => do fn <- decodeTerm at
+                         decodeArgs at fn
+                idxp => do c <- fromBuf
+                           let idx : Nat = fromInteger (cast (idxp - 13))
+                           let Just name = getAt idx vars
+                               | Nothing => corrupt "Term"
+                           pure (Local {name} fc c idx (mkPrf idx))
+
+-- A term and the parts of one written as their instances below write them,
+-- each node's location after its tag, within the location `at` the node is
+-- part of. An application of a function to several arguments is written as
+-- its head and the list of them, each with the location of its application.
+mutual
+  encodePi : {auto b : Ref Bin Binary} -> (at : FC) -> PiInfo (Term vars) -> Core ()
+  encodePi at Implicit = tag 0
+  encodePi at Explicit = tag 1
+  encodePi at AutoImplicit = tag 2
+  encodePi at (DefImplicit r) = do tag 3; encodeTerm at r
+
+  encodeBinder : {auto b : Ref Bin Binary} -> (at : FC) -> Binder (Term vars) -> Core ()
+  encodeBinder at (Lam fc c x ty)
+      = do tag 0; encodeFC at fc; toBuf c; encodePi (within at fc) x; encodeTerm (within at fc) ty
+  encodeBinder at (Let fc c val ty)
+      = do tag 1; encodeFC at fc; toBuf c; encodeTerm (within at fc) val -- ; toBuf ty
+  encodeBinder at (Pi fc c x ty)
+      = do tag 2; encodeFC at fc; toBuf c; encodePi (within at fc) x; encodeTerm (within at fc) ty
+  encodeBinder at (PVar fc c p ty)
+      = do tag 3; encodeFC at fc; toBuf c; encodePi (within at fc) p; encodeTerm (within at fc) ty
+  encodeBinder at (PLet fc c val ty)
+      = do tag 4; encodeFC at fc; toBuf c; encodeTerm (within at fc) val -- ; toBuf ty
+  encodeBinder at (PVTy fc c ty)
+      = do tag 5; encodeFC at fc; toBuf c -- ; toBuf ty
+
+  -- As the list instance writes a list: its length, then each.
+  encodeTerms : {auto b : Ref Bin Binary} -> (at : FC) -> List (Term vars) -> Core ()
+  encodeTerms at ts = do toBuf (the Int (cast (length ts))); traverse_ (encodeTerm at) ts
+
+  -- The arguments of an application, each after the location of its
+  -- application.
+  encodeArgs : {auto b : Ref Bin Binary} -> (at : FC) -> Term vars -> Core ()
+  encodeArgs at (App fc f a) = do encodeArgs at f; encodeFC at fc; encodeTerm (within at fc) a
+  encodeArgs at _ = pure ()
+
+  encodeTerm : {auto b : Ref Bin Binary} -> (at : FC) -> Term vars -> Core ()
+  encodeTerm at (Local {name} fc c idx y)
+      = if idx < 243
+           then do tag (13 + cast idx)
+                   encodeFC at fc
+                   toBuf c
+           else do tag 0
+                   encodeFC at fc
+                   toBuf c
+                   toBuf idx
+  encodeTerm at (Ref fc nt name)
+      = do tag 1; encodeFC at fc
+           toBuf nt; toBuf name
+  encodeTerm at (Meta fc n i xs)
+      = do tag 2; encodeFC at fc
+           toBuf n; encodeTerms (within at fc) xs
+  encodeTerm at (Bind fc x bnd scope)
+      = do tag 3; encodeFC at fc
+           toBuf x;
+           encodeBinder (within at fc) bnd; encodeTerm (within at fc) scope
+  encodeTerm at t@(App fc fn arg)
+      = do let (fn, args) = getFnArgs (App fc fn arg)
+           case args of
+                [arg] => do tag 4; encodeFC at fc
+                            encodeTerm (within at fc) fn
+                            encodeTerm (within at fc) arg
+                args => do tag 12
+                           encodeTerm at fn
+                           toBuf (the Int (cast (length args)))
+                           encodeArgs at t
+  encodeTerm at (As fc s as tm)
+      = do tag 5; encodeFC at fc
+           encodeTerm (within at fc) as; toBuf s; encodeTerm (within at fc) tm
+  encodeTerm at (TDelayed fc r tm)
+      = do tag 6; encodeFC at fc
+           toBuf r; encodeTerm (within at fc) tm
+  encodeTerm at (TDelay fc r ty tm)
+      = do tag 7; encodeFC at fc
+           toBuf r; encodeTerm (within at fc) ty; encodeTerm (within at fc) tm
+  encodeTerm at (TForce fc r tm)
+      = do tag 8; encodeFC at fc
+           toBuf r; encodeTerm (within at fc) tm
+  encodeTerm at (PrimVal fc c)
+      = do tag 9; encodeFC at fc
+           toBuf c
+  encodeTerm at (Erased fc _)
+      = do tag 10; encodeFC at fc
+  encodeTerm at (TType fc u)
+      = do tag 11; encodeFC at fc; toBuf u
+
