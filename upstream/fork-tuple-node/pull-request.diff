index aa55339..7a4bc29 100644
--- a/src/TTImp/Elab/Ambiguity.idr
+++ b/src/TTImp/Elab/Ambiguity.idr
@@ -2,11 +2,13 @@ module TTImp.Elab.Ambiguity
 
 import Core.Env
 import Core.Metadata
+import Core.Reflect
 import Core.Unify
 import Core.Value
 
 import Idris.REPL.Opts
