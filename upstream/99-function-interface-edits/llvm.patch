diff --git a/mlir/test/IR/test-func-edit-overrides.mlir b/mlir/test/IR/test-func-edit-overrides.mlir
new file mode 100644
index 0000000..0ebb8f5
--- /dev/null
+++ b/mlir/test/IR/test-func-edit-overrides.mlir
@@ -0,0 +1,43 @@
+// RUN: mlir-opt %s -split-input-file -test-func-insert-arg | FileCheck %s --check-prefix=INSERT-ARG
+// RUN: mlir-opt %s -split-input-file -test-func-insert-result | FileCheck %s --check-prefix=INSERT-RESULT
+// RUN: mlir-opt %s -split-input-file -test-func-erase-arg | FileCheck %s --check-prefix=ERASE-ARG
+// RUN: mlir-opt %s -split-input-file -test-func-erase-result | FileCheck %s --check-prefix=ERASE-RESULT
+
+// test.positional_func overrides the four edits to keep a tag for each
+// argument and result, which its verifier checks against its signature.
+// Each pass edits it through a FunctionOpInterface handle and reaches the
+// override; the passes that erase leave the functions they erase nothing
+// from as they were.
+
+// INSERT-ARG: test.positional_func private @insert_arg(f32, i32, f32)
+// INSERT-ARG-SAME: arg_tags = array<i64: 0, -1, 1>
+// INSERT-RESULT: test.positional_func private @insert_arg(f32, f32)
+// INSERT-RESULT-SAME: arg_tags = array<i64: 0, 1>
+// ERASE-ARG: test.positional_func private @insert_arg(f32, f32)
+// ERASE-ARG-SAME: arg_tags = array<i64: 0, 1>
+test.positional_func private @insert_arg(f32, f32)
+    attributes {arg_tags = array<i64: 0, 1>, res_tags = array<i64>,
+                test.insert_args = [[1, i32]]}
+
+// -----
+
+// INSERT-RESULT: test.positional_func private @insert_result() -> (f32, i32)
+// INSERT-RESULT-SAME: res_tags = array<i64: 0, -1>
+test.positional_func private @insert_result() -> f32
+    attributes {arg_tags = array<i64>, res_tags = array<i64: 0>,
+                test.insert_results = [[1, i32]]}
+
+// -----
+
+// ERASE-ARG: test.positional_func private @erase_arg(f32, f32)
+// ERASE-ARG-SAME: arg_tags = array<i64: 0, 2>
+test.positional_func private @erase_arg(f32, i32 {test.erase_this_arg}, f32)
+    attributes {arg_tags = array<i64: 0, 1, 2>, res_tags = array<i64>}
+
+// -----
+
+// ERASE-RESULT: test.positional_func private @erase_result() -> f32
+// ERASE-RESULT-SAME: res_tags = array<i64: 1>
+test.positional_func private @erase_result()
+    -> (i32 {test.erase_this_result}, f32)
+    attributes {arg_tags = array<i64>, res_tags = array<i64: 0, 1>}
diff --git a/mlir/test/lib/Dialect/Test/TestOpDefs.cpp b/mlir/test/lib/Dialect/Test/TestOpDefs.cpp
index 8a54190..182eb01 100644
--- a/mlir/test/lib/Dialect/Test/TestOpDefs.cpp
+++ b/mlir/test/lib/Dialect/Test/TestOpDefs.cpp
@@ -1389,6 +1389,105 @@ void ConversionFuncOp::print(OpAsmPrinter &p) {
       getArgAttrsAttrName(), getResAttrsAttrName());
 }
 
+//===----------------------------------------------------------------------===//
+// PositionalFuncOp
+//===----------------------------------------------------------------------===//
+
+ParseResult PositionalFuncOp::parse(OpAsmParser &parser,
+                                    OperationState &result) {
+  auto buildFuncType =
+      [](Builder &builder, ArrayRef<Type> argTypes, ArrayRef<Type> results,
+         function_interface_impl::VariadicFlag,
+         std::string &) { return builder.getFunctionType(argTypes, results); };
+
+  return function_interface_impl::parseFunctionOp(
+      parser, result, /*allowVariadic=*/false,
+      getFunctionTypeAttrName(result.name), buildFuncType,
+      getArgAttrsAttrName(result.name), getResAttrsAttrName(result.name));
+}
+
+void PositionalFuncOp::print(OpAsmPrinter &p) {
+  function_interface_impl::printFunctionOp(
+      p, *this, /*isVariadic=*/false, getFunctionTypeAttrName(),
+      getArgAttrsAttrName(), getResAttrsAttrName());
+}
+
+LogicalResult PositionalFuncOp::verify() {
+  if (getArgTags().size() != getNumArguments())
+    return emitOpError("has ") << getArgTags().size() << " argument tags for "
+                               << getNumArguments() << " arguments";
+  if (getResTags().size() != getNumResults())
+    return emitOpError("has ") << getResTags().size() << " result tags for "
+                               << getNumResults() << " results";
+  return success();
+}
+
+/// `tags` with -1 inserted before the original position each of the sorted
+/// `indices` names, in order.
+static SmallVector<int64_t> insertTags(ArrayRef<int64_t> tags,
+                                       ArrayRef<unsigned> indices) {
+  SmallVector<int64_t> result;
+  const unsigned *next = indices.begin();
+  for (unsigned i = 0, e = tags.size(); i <= e; ++i) {
+    for (; next != indices.end() && *next == i; ++next)
+      result.push_back(-1);
+    if (i != e)
+      result.push_back(tags[i]);
+  }
+  return result;
+}
+
+/// `tags` without the positions `erased` sets.
+static SmallVector<int64_t> eraseTags(ArrayRef<int64_t> tags,
+                                      const BitVector &erased) {
+  SmallVector<int64_t> result;
+  for (auto [i, tag] : llvm::enumerate(tags))
+    if (!erased.test(i))
+      result.push_back(tag);
+  return result;
+}
+
+LogicalResult PositionalFuncOp::insertArguments(
+    ArrayRef<unsigned> argIndices, TypeRange argTypes,
+    ArrayRef<DictionaryAttr> argAttrs, ArrayRef<Location> argLocs) {
+  SmallVector<int64_t> tags = insertTags(getArgTags(), argIndices);
+  if (failed(FunctionOpInterface::Trait<PositionalFuncOp>::insertArguments(
+          argIndices, argTypes, argAttrs, argLocs)))
+    return failure();
+  setArgTags(tags);
+  return success();
+}
+
+LogicalResult
+PositionalFuncOp::insertResults(ArrayRef<unsigned> resultIndices,
+                                TypeRange resultTypes,
+                                ArrayRef<DictionaryAttr> resultAttrs) {
+  SmallVector<int64_t> tags = insertTags(getResTags(), resultIndices);
+  if (failed(FunctionOpInterface::Trait<PositionalFuncOp>::insertResults(
+          resultIndices, resultTypes, resultAttrs)))
+    return failure();
+  setResTags(tags);
+  return success();
+}
+
+LogicalResult PositionalFuncOp::eraseArguments(const BitVector &argIndices) {
+  SmallVector<int64_t> tags = eraseTags(getArgTags(), argIndices);
+  if (failed(FunctionOpInterface::Trait<PositionalFuncOp>::eraseArguments(
+          argIndices)))
+    return failure();
+  setArgTags(tags);
+  return success();
+}
+
+LogicalResult PositionalFuncOp::eraseResults(const BitVector &resultIndices) {
+  SmallVector<int64_t> tags = eraseTags(getResTags(), resultIndices);
+  if (failed(FunctionOpInterface::Trait<PositionalFuncOp>::eraseResults(
+          resultIndices)))
+    return failure();
+  setResTags(tags);
+  return success();
+}
+
