+def PositionalFuncOp
+    : TEST_Op<"positional_func", [
+        SymbolName, SymbolVisibility,
+        DeclareOpInterfaceMethods<FunctionOpInterface, [
+          "insertArguments", "insertResults", "eraseArguments", "eraseResults"
+        ]>]> {
+  let summary = "function with a tag for each argument and result";
+  let description = [{
+    A function whose own edits of its signature keep `arg_tags` and
+    `res_tags`, one tag for each argument and result, in step with it, as
+    its verifier checks; an inserted argument or result is tagged -1. The
+    edits reach these overrides through a `FunctionOpInterface` handle.
+  }];
+  let arguments = (ins SymbolNameAttr:$sym_name,
+                       TypeAttrOf<FunctionType>:$function_type,
+                       OptionalAttr<DictArrayAttr>:$arg_attrs,
+                       OptionalAttr<DictArrayAttr>:$res_attrs,
+                       OptionalAttr<StrAttr>:$sym_visibility,
+                       DenseI64ArrayAttr:$arg_tags,
+                       DenseI64ArrayAttr:$res_tags);
+  let regions = (region AnyRegion:$body);
+
+  let extraClassDeclaration = [{
+    ::mlir::Region *getCallableRegion() {
+      return isExternal() ? nullptr : &getBody();
+    }
+    ::mlir::ArrayRef<::mlir::Type> getArgumentTypes() {
+      return getFunctionType().getInputs();
+    }
+    ::mlir::ArrayRef<::mlir::Type> getResultTypes() {
+      return getFunctionType().getResults();
+    }
+  }];
+
+  let hasCustomAssemblyFormat = 1;
+  let hasVerifier = 1;
+}
