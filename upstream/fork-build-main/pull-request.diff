+||| The main file and every module it imports, built in a session of their
+||| own: a unification state and metadata made here, and the context reset
+||| to the main module's origin, before `buildDeps`. A driver that only
+||| builds a program never holds the session's state.
+export
+buildMain : {auto c : Ref Ctxt Defs} ->
+            {auto s : Ref Syn SyntaxInfo} ->
+            {auto o : Ref ROpts REPLOpts} ->
+            (mainFile : String) ->
+            Core (List Error)
+buildMain mainFile
+    = do mainModule <- ctxtPathToNS mainFile
+         u <- newRef UST initUState
+         m <- newRef MD (initMetadata (PhysicalIdrSrc mainModule))
+         resetContext (PhysicalIdrSrc mainModule)
+         buildDeps mainFile
+
