diff --git a/mlir/test/Dialect/Linalg/int-range-interface.mlir b/mlir/test/Dialect/Linalg/int-range-interface.mlir
new file mode 100644
index 000000000..0a67e29ac
--- /dev/null
+++ b/mlir/test/Dialect/Linalg/int-range-interface.mlir
@@ -0,0 +1,58 @@
+// RUN: mlir-opt -int-range-optimizations %s | FileCheck %s
+
+// The iteration index of a static loop of extent N is in [0, N - 1].
+// CHECK-LABEL: func @index_static
+// CHECK: test.reflect_bounds <umin = 0 : index, umax = 7 : index, smin = 0 : index, smax = 7 : index>
+// CHECK: test.reflect_bounds <umin = 0 : index, umax = 4 : index, smin = 0 : index, smax = 4 : index>
+func.func @index_static(%t: tensor<8x5xindex>) -> tensor<8x5xindex> {
+  %r = linalg.generic {indexing_maps = [affine_map<(d0, d1) -> (d0, d1)>],
+                       iterator_types = ["parallel", "parallel"]}
+      outs(%t : tensor<8x5xindex>) {
+  ^bb0(%out: index):
+    %i = linalg.index 0 : index
+    %j = linalg.index 1 : index
+    %bi = test.reflect_bounds %i : index
+    %bj = test.reflect_bounds %j : index
+    %s = arith.addi %bi, %bj : index
+    linalg.yield %s : index
+  } -> tensor<8x5xindex>
+  return %r : tensor<8x5xindex>
+}
+
+// A dynamic extent is still a dimension, so the index is non-negative and
+// below the largest signed index: comparing it against 0 folds.
+// CHECK-LABEL: func @index_dynamic
+// CHECK: %[[TRUE:.*]] = arith.constant true
+// CHECK: test.reflect_bounds <umin = 0 : index, umax = 9223372036854775806 : index, smin = 0 : index, smax = 9223372036854775806 : index>
+// CHECK: linalg.yield %[[TRUE]]
+func.func @index_dynamic(%t: tensor<?xi1>) -> tensor<?xi1> {
+  %c0 = arith.constant 0 : i64
+  %r = linalg.generic {indexing_maps = [affine_map<(d0) -> (d0)>],
+                       iterator_types = ["parallel"]}
+      outs(%t : tensor<?xi1>) {
+  ^bb0(%out: i1):
+    %i = linalg.index 0 : index
+    %b = test.reflect_bounds %i : index
+    %w = arith.index_castui %b : index to i64
+    %nonneg = arith.cmpi sge, %w, %c0 : i64
+    linalg.yield %nonneg : i1
+  } -> tensor<?xi1>
+  return %r : tensor<?xi1>
+}
+
+// The extent comes from the loop the index names, which an operand's shape
+// fixes through the indexing maps.
+// CHECK-LABEL: func @index_transposed
+// CHECK: test.reflect_bounds <umin = 0 : index, umax = 2 : index, smin = 0 : index, smax = 2 : index>
+func.func @index_transposed(%a: tensor<?x3xindex>, %t: tensor<3x?xindex>) -> tensor<3x?xindex> {
+  %r = linalg.generic {indexing_maps = [affine_map<(d0, d1) -> (d1, d0)>,
+                                        affine_map<(d0, d1) -> (d0, d1)>],
+                       iterator_types = ["parallel", "parallel"]}
+      ins(%a : tensor<?x3xindex>) outs(%t : tensor<3x?xindex>) {
+  ^bb0(%in: index, %out: index):
+    %i = linalg.index 0 : index
+    %b = test.reflect_bounds %i : index
+    linalg.yield %b : index
+  } -> tensor<3x?xindex>
+  return %r : tensor<3x?xindex>
+}
