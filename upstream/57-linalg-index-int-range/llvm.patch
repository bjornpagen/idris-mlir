+//===- InferIntRangeInterfaceImpl.cpp - Impl. of InferIntRangeInterface ---===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "mlir/Dialect/Linalg/IR/InferIntRangeInterfaceImpl.h"
+
+#include "mlir/Dialect/Linalg/IR/Linalg.h"
+#include "mlir/Interfaces/InferIntRangeInterface.h"
+
+using namespace mlir;
+
+namespace mlir {
+namespace linalg {
+namespace {
+
+struct IndexOpInterface
+    : public InferIntRangeInterface::ExternalModel<IndexOpInterface, IndexOp> {
+  void inferResultRanges(Operation *op, ArrayRef<ConstantIntRanges> argRanges,
+                         SetIntRangeFn setResultRange) const {
+    auto indexOp = cast<IndexOp>(op);
+    unsigned width = IndexType::kInternalStorageBitWidth;
+    // An iteration index lies in [0, extent - 1]. An extent the shapes leave
+    // dynamic is still a dimension, at most the largest signed index.
+    APInt extent = APInt::getSignedMaxValue(width);
+    if (auto linalgOp = dyn_cast_or_null<LinalgOp>(op->getParentOp())) {
+      int64_t staticExtent =
+          linalgOp.getStaticLoopRanges()[indexOp.getDim()];
+      if (!ShapedType::isDynamic(staticExtent))
+        extent = APInt(width, staticExtent);
+    }
+    // A loop of extent 0 runs no iteration: its index has no value to bound.
+    if (extent.isZero())
+      return;
+    setResultRange(indexOp.getResult(),
+                   ConstantIntRanges::fromSigned(APInt::getZero(width),
+                                                 extent - 1));
+  }
+
+  // The interface's default reads the op as one declaring the interface,
+  // which an op with an external model is not.
+  void inferResultRangesFromOptional(Operation *op,
+                                     ArrayRef<IntegerValueRange> argRanges,
+                                     SetIntLatticeFn setResultRanges) const {
+    intrange::detail::defaultInferResultRanges(
+        cast<InferIntRangeInterface>(op), argRanges, setResultRanges);
+  }
+};
+
+} // namespace
+} // namespace linalg
+} // namespace mlir
+
+void mlir::linalg::registerInferIntRangeInterfaceExternalModels(
+    DialectRegistry &registry) {
+  registry.addExtension(+[](MLIRContext *ctx, linalg::LinalgDialect *dialect) {
+    IndexOp::attachInterface<IndexOpInterface>(*ctx);
+  });
+}
