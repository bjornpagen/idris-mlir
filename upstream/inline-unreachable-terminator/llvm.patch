   // Handle the case where only a single block was inlined.
-  if (singleBlockFastPath && llvm::hasSingleElement(newBlocks)) {
+  if (singleBlockFastPath) {
     // Run the result attribute handler on the terminator operands.
     Operation *firstBlockTerminator = firstNewBlock->getTerminator();
     builder.setInsertionPoint(firstBlockTerminator);
diff --git a/mlir/test/Dialect/UB/inlining.mlir b/mlir/test/Dialect/UB/inlining.mlir
index cb76750044a3b8f4bc81d7d1a06289806baf2c4a..aafd251d7f508dfda8a4f45bf3b1ab3c85340ffe 100644
--- a/mlir/test/Dialect/UB/inlining.mlir
+++ b/mlir/test/Dialect/UB/inlining.mlir
@@ -11,3 +11,39 @@ func.func @test_inline(%ptr : !llvm.ptr) -> i32 {
   %0 = call @func() : () -> i32
   return %0 : i32
 }
+
+// -----
+
+// A callee that never returns is inlined: `ub.unreachable` stays the end of
+// its block, and the code after the call, which nothing reaches, goes.
+func.func private @never() -> i32 {
+  ub.unreachable
+}
+
+// CHECK-LABEL: func @inline_never
+// CHECK-NEXT:    ub.unreachable
+// CHECK-NEXT:  }
+func.func @inline_never() -> i32 {
+  %0 = call @never() : () -> i32
+  return %0 : i32
+}
+
+// -----
+
+// Inlined into a region that must stay one block, it would need a second
+// block for the code after the call: the call stays.
+func.func private @never_returns() {
+  ub.unreachable
+}
+
+// CHECK-LABEL: func @never_in_loop
+// CHECK:         scf.for
+// CHECK-NEXT:      call @never_returns()
+func.func @never_in_loop(%n: index) {
+  %c0 = arith.constant 0 : index
+  %c1 = arith.constant 1 : index
+  scf.for %i = %c0 to %n step %c1 {
+    func.call @never_returns() : () -> ()
+  }
+  return
+}
