diff --git a/mlir/unittests/IR/DestructionTest.cpp b/mlir/unittests/IR/DestructionTest.cpp
new file mode 100644
index 0000000..d9397c4
--- /dev/null
+++ b/mlir/unittests/IR/DestructionTest.cpp
@@ -0,0 +1,70 @@
+//===- DestructionTest.cpp - Destroying deeply nested IR ------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "mlir/IR/BuiltinTypes.h"
+#include "mlir/IR/Location.h"
+#include "mlir/IR/MLIRContext.h"
+#include "mlir/IR/Operation.h"
+#include "llvm/Support/thread.h"
+#include "gtest/gtest.h"
+
+using namespace mlir;
+
+namespace {
+/// A chain of operations nested `depth` deep, outermost first: each but the
+/// last holds the next in the one block of its one region, and the next takes
+/// that block's argument as its operand.
+SmallVector<Operation *> createChain(MLIRContext &context, unsigned depth) {
+  context.allowUnregisteredDialects();
+  Location loc = UnknownLoc::get(&context);
+  Type i32 = IntegerType::get(&context, 32);
+  SmallVector<Operation *> chain{Operation::create(
+      loc, OperationName("test.nest", &context), {}, {}, NamedAttrList(),
+      PropertyRef(), {}, /*numRegions=*/1)};
+  for (unsigned i = 1; i < depth; ++i) {
+    Block *block = new Block();
+    chain.back()->getRegion(0).push_back(block);
+    Value argument = block->addArgument(i32, loc);
+    chain.push_back(Operation::create(
+        loc, OperationName("test.nest", &context), {}, {argument},
+        NamedAttrList(), PropertyRef(), {}, i + 1 < depth ? 1 : 0));
+    block->push_back(chain.back());
+  }
+  return chain;
+}
+
+/// Run `fn` on a thread whose stack a native frame per level of nesting would
+/// overflow.
+template <typename Fn>
+void onSmallStack(Fn fn) {
+  llvm::thread thread(/*StackSizeInBytes=*/256 * 1024, fn);
+  thread.join();
+}
+
+constexpr unsigned depth = 10000;
+
+TEST(DestructionTest, DropAllReferences) {
+  MLIRContext context;
+  SmallVector<Operation *> chain = createChain(context, depth);
+  onSmallStack([&] { chain.front()->dropAllReferences(); });
+  for (Operation *op : llvm::drop_begin(chain))
+    EXPECT_TRUE(op->getBlock()->getArgument(0).use_empty());
+  onSmallStack([&] { chain.front()->destroy(); });
+}
+
+TEST(DestructionTest, DestroyAndDeleteBlock) {
+  MLIRContext context;
+  SmallVector<Operation *> chain = createChain(context, depth);
+  onSmallStack([&] { chain.front()->destroy(); });
+
+  // Deleting a block destroys the operations in it, and all nested in them.
+  Block *holder = new Block();
+  holder->push_back(createChain(context, depth).front());
+  onSmallStack([&] { delete holder; });
+}
+} // namespace
