+/// Parse the name of an attribute dictionary's entry and the `=` after it.
+/// An entry with no `=` is a unit attribute, added to `attributes` here;
+/// otherwise `valueName` is set, and the caller parses the value.
+ParseResult
+Parser::parseAttributeEntryName(llvm::SmallDenseSet<StringAttr> &seenKeys,
+                                NamedAttrList &attributes,
+                                std::optional<StringAttr> &valueName) {
+  // The name of an attribute can either be a bare identifier, or a string.
+  std::optional<StringAttr> nameId;
+  if (getToken().is(Token::string))
+    nameId = builder.getStringAttr(getToken().getStringValue());
+  else if (getToken().isAny(Token::bare_identifier, Token::inttype) ||
+           getToken().isKeyword())
+    nameId = builder.getStringAttr(getTokenSpelling());
+  else
+    return emitWrongTokenError("expected attribute name");
+
+  if (nameId->empty())
+    return emitError("expected valid attribute name");
+
+  if (!seenKeys.insert(*nameId).second)
+    return emitError("duplicate key '")
+           << nameId->getValue() << "' in dictionary attribute";
+  consumeToken();
+
+  // Lazy load a dialect in the context if there is a possible namespace.
+  auto splitName = nameId->strref().split('.');
+  if (!splitName.second.empty())
+    getContext()->getOrLoadDialect(splitName.first);
+
+  // Try to parse the '=' for the attribute value.
+  if (!consumeIf(Token::equal)) {
+    // If there is no '=', we treat this as a unit attribute.
+    attributes.push_back({*nameId, builder.getUnitAttr()});
+    return success();
+  }
+  valueName = nameId;
+  return success();
+}
+
+/// Parse a builtin array or dictionary attribute, beginning at its `[` or
+/// `{`.
+///
+/// Arrays and dictionaries nest in one another without bound, so the ones
+/// nested in this one are parsed from an explicit stack rather than by
+/// recursion: the depth of the native stack does not grow with the depth of
+/// the nesting. Every other element or value is parsed by `parseAttribute`,
+/// and the attributes built, the diagnostics and the tokens consumed are
+/// those of parsing each array as a comma-separated list until `]` and each
+/// dictionary with `parseAttributeDict`.
+Attribute Parser::parseArrayOrDictionaryAttr() {
+  // An array whose elements are being parsed, and its elements so far.
+  struct OpenArray {
+    SmallVector<Attribute, 4> elements;
+  };
+  // A dictionary whose entries are being parsed: its entries so far, the keys
+  // it has seen, and the name of the entry whose value is being parsed.
+  struct OpenDictionary {
+    NamedAttrList entries;
+    llvm::SmallDenseSet<StringAttr> seenKeys;
+    std::optional<StringAttr> valueName;
+  };
+  SmallVector<std::variant<OpenArray, OpenDictionary>, 0> stack;
+
+  // Parse the next entry's name in `dictionary`. Returns failure on a parse
+  // error, and otherwise whether the entry has a value to parse.
+  auto parseEntryName = [&](OpenDictionary &dictionary) -> FailureOr<bool> {
+    dictionary.valueName.reset();
+    if (parseAttributeEntryName(dictionary.seenKeys, dictionary.entries,
+                                dictionary.valueName))
+      return failure();
+    return dictionary.valueName.has_value();
+  };
+
+  // Each iteration opens an array or dictionary at the current token, or
+  // parses one element or entry value of the innermost one. A value it
+  // completes is added to the container it belongs to, and each container
+  // that then ends is closed and added to its own in turn.
+  while (true) {
+    Attribute done;
+    if (consumeIf(Token::l_square)) {
+      if (consumeIf(Token::r_square)) {
+        done = builder.getArrayAttr({});
+      } else {
+        stack.emplace_back(OpenArray());
+        continue;
+      }
+    } else if (consumeIf(Token::l_brace)) {
+      if (consumeIf(Token::r_brace)) {
+        done = NamedAttrList().getDictionary(getContext());
+      } else {
+        stack.emplace_back(OpenDictionary());
+        FailureOr<bool> hasValue =
+            parseEntryName(std::get<OpenDictionary>(stack.back()));
+        if (failed(hasValue))
+          return nullptr;
+        if (*hasValue)
+          continue;
+      }
+    } else {
+      done = parseAttribute();
+      if (!done)
+        return nullptr;
+    }
+
+    while (true) {
+      if (done) {
+        if (stack.empty())
+          return done;
+        if (auto *dictionary = std::get_if<OpenDictionary>(&stack.back()))
+          dictionary->entries.push_back({*dictionary->valueName, done});
+        else
+          std::get<OpenArray>(stack.back()).elements.push_back(done);
+        done = Attribute();
+      }
+      auto *dictionary = std::get_if<OpenDictionary>(&stack.back());
+      if (consumeIf(Token::comma)) {
+        if (!dictionary)
+          break;
+        FailureOr<bool> hasValue = parseEntryName(*dictionary);
+        if (failed(hasValue))
+          return nullptr;
+        if (*hasValue)
+          break;
+        continue;
+      }
+      if (dictionary) {
+        if (parseToken(Token::r_brace, "expected '}' in attribute dictionary"))
+          return nullptr;
+        done = dictionary->entries.getDictionary(getContext());
+      } else {
+        if (parseToken(Token::r_square, "expected ',' or ']'"))
+          return nullptr;
+        done = builder.getArrayAttr(std::get<OpenArray>(stack.back()).elements);
+      }
+      stack.pop_back();
+    }
+  }
+}
