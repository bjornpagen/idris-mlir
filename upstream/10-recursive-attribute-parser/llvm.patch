+/// Arrays and dictionaries nest in one another without bound, so the ones
+/// nested in `attr` are printed from an explicit stack rather than by
+/// recursion: the depth of the native stack does not grow with the depth of
+/// the nesting. The text is that of printing an array's elements with
+/// `printAttribute(element, AttrTypeElision::May)` and a dictionary's entries
+/// with `printNamedAttribute`: a nested array or dictionary with an alias
+/// prints its alias, and one without is opened in place.
+void AsmPrinter::Impl::printArrayOrDictionaryAttr(Attribute attr) {
+  // An array or dictionary being printed, and the next element or entry.
+  struct Open {
+    Attribute container;
+    size_t next;
+  };
+  SmallVector<Open> stack;
+  auto open = [&](Attribute container) {
+    os << (isa<ArrayAttr>(container) ? '[' : '{');
+    stack.push_back({container, 0});
+  };
+
+  open(attr);
+  while (!stack.empty()) {
+    Open &top = stack.back();
+    auto array = dyn_cast<ArrayAttr>(top.container);
+    size_t size = array ? array.size()
+                        : cast<DictionaryAttr>(top.container).size();
+    if (top.next == size) {
+      os << (array ? ']' : '}');
+      stack.pop_back();
+      continue;
+    }
+    size_t index = top.next++;
+    if (index != 0)
+      os << ", ";
+
+    Attribute value;
+    AttrTypeElision typeElision;
+    if (array) {
+      value = array[index];
+      typeElision = AttrTypeElision::May;
+    } else {
+      NamedAttribute entry =
+          cast<DictionaryAttr>(top.container).getValue()[index];
+      ::printKeywordOrString(entry.getName().strref(), os);
+      // Pretty printing elides the attribute value for unit attributes.
+      if (isa<UnitAttr>(entry.getValue()))
+        continue;
+      os << " = ";
+      value = entry.getValue();
+      typeElision = AttrTypeElision::Never;
+    }
+
+    // What `printAttribute` does, but with a nested array or dictionary that
+    // has no alias opened here instead of printed by recursion.
+    if (!value) {
+      os << "<<NULL ATTRIBUTE>>";
+      continue;
+    }
+    if (succeeded(printAlias(value)))
+      continue;
+    if (isa<ArrayAttr, DictionaryAttr>(value)) {
+      open(value);
+      continue;
+    }
+    printAttributeImpl(value, typeElision);
+  }
+}
