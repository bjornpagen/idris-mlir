+void AliasInitializer::markAliasNonDeferrable(size_t aliasIndex) {
+  // The aliases reachable from `aliasIndex` through deferrable ones are
+  // marked from a worklist: the children of an alias nest as deeply as the
+  // attributes and types do. An alias already marked non-deferrable has
+  // every child marked as well, so the walk stops there.
+  SmallVector<size_t> worklist = {aliasIndex};
+  while (!worklist.empty()) {
+    auto *it = std::next(aliases.begin(), worklist.pop_back_val());
+    if (!it->second.canBeDeferred)
+      continue;
+    it->second.canBeDeferred = false;
+    llvm::append_range(worklist, it->second.childIndices);
+  }
