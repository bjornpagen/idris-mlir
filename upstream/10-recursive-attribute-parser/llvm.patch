+    size_t aliasIndex;
+    Attribute container;
+    size_t next = 0;
+    SmallVector<size_t> childIndices;
+    size_t maxAliasDepth = 0;
+  };
+  auto numChildren = [](Attribute container) -> size_t {
+    if (auto array = dyn_cast<ArrayAttr>(container))
+      return array.size();
+    return 2 * cast<DictionaryAttr>(container).size();
+  };
+  auto child = [](Attribute container, size_t index) -> Attribute {
+    if (auto array = dyn_cast<ArrayAttr>(container))
+      return array[index];
+    NamedAttribute entry =
+        cast<DictionaryAttr>(container).getValue()[index / 2];
+    return index % 2 == 0 ? Attribute(entry.getName()) : entry.getValue();
+  };
+  auto record = [](Open &parent, std::pair<size_t, size_t> depthAndIndex) {
+    parent.childIndices.push_back(depthAndIndex.second);
+    if (depthAndIndex.first > parent.maxAliasDepth)
