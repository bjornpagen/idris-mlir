+                Term vars -> Term vars -> Term vars
+    applyCase Nothing _ applyEnv scrtm = App fc applyEnv scrtm
+    applyCase (Just _) Nothing applyEnv scrtm = applyEnv
+    applyCase (Just (MkVar {varIdx = i} _)) (Just _) applyEnv scrtm
+        = let (f, args) = getFnArgs applyEnv
+              pos = minus (length vars) (S i) in
+              apply fc f (take (S pos) args ++ drop pos args)
