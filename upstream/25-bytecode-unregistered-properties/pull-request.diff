+// An operation written as bytecode where its dialect is not loaded stores its
+// properties as an attribute; read where it is registered, its properties are
+// set from that attribute.
+TEST(OpPropertiesTest, BytecodeWrittenUnregistered) {
+  std::string bytecode;
+  {
+    MLIRContext context;
+    context.allowUnregisteredDialects();
+    ParserConfig config(&context);
+    OwningOpRef<Operation *> op = parseSourceString(mlirSrc, config);
+    ASSERT_TRUE(op.get() != nullptr);
+    ASSERT_FALSE(op->isRegistered());
+    llvm::raw_string_ostream os(bytecode);
+    ASSERT_TRUE(succeeded(writeBytecodeToFile(op.get(), os)));
+  }
+  MLIRContext context;
+  context.getOrLoadDialect<TestOpPropertiesDialect>();
+  ParserConfig config(&context);
+  OwningOpRef<Operation *> op = parseSourceString(bytecode, config);
+  ASSERT_TRUE(op.get() != nullptr);
+  auto opWithProp = dyn_cast<OpWithProperties>(op.get());
+  ASSERT_TRUE(opWithProp);
+  TestProperties &prop = opWithProp.getProperties();
+  EXPECT_EQ(prop.a, -42);
+  EXPECT_EQ(prop.b, -42.0f);
+  EXPECT_EQ(prop.array, (std::vector<int64_t>{40, 41}));
+  ASSERT_TRUE(prop.label);
+  EXPECT_EQ(*prop.label, "bar foo");
+}
