+/// Return the return-like terminators of the blocks of the given function.
+SmallVector<Operation *>
+bufferization::getReturnOps(FunctionOpInterface funcOp) {
+  SmallVector<Operation *> result;
+  for (Block &b : funcOp.getFunctionBody()) {
+    Operation *terminator = b.mightHaveTerminator() ? b.getTerminator() : nullptr;
+    if (terminator && terminator->hasTrait<OpTrait::ReturnLike>())
+      result.push_back(terminator);
+  }
   return result;
 }
 
