+/// The memory space of the bufferized form of `type` by default.
+Attribute getDefaultMemorySpace(const bufferization::BufferizationOptions &options,
+                                bufferization::TensorLikeType type) {
+  if (isa<TensorType>(type))
+    return *options.defaultMemorySpaceFn(type);
+  return nullptr;
+}
+
+/// BufferizableOpInterface for test.conversion_call_op: a call that Module
+/// Bufferization analyzes and bufferizes as it does func.call, written on the
+/// queries of FuncBufferizableOpInterfaceImpl.h.
+struct TestCallOpInterface
+    : public bufferization::BufferizableOpInterface::ExternalModel<
+          TestCallOpInterface, test::ConversionCallOp> {
+  bool bufferizesToMemoryRead(Operation *op, OpOperand &opOperand,
+                              const bufferization::AnalysisState &state) const {
+    FunctionOpInterface funcOp =
+        func_ext::getCalledFunction(cast<CallOpInterface>(op), state);
+    if (!funcOp || func_ext::getFuncOpAnalysisState(state, funcOp) !=
+                       func_ext::FuncOpAnalysisState::Analyzed)
+      return true;
+    return func_ext::getFuncAnalysisState(state)
+        .readBbArgs.lookup(funcOp)
+        .contains(opOperand.getOperandNumber());
+  }
+
+  bool bufferizesToMemoryWrite(Operation *op, OpOperand &opOperand,
+                               const bufferization::AnalysisState &state) const {
+    FunctionOpInterface funcOp =
+        func_ext::getCalledFunction(cast<CallOpInterface>(op), state);
+    if (!funcOp || func_ext::getFuncOpAnalysisState(state, funcOp) !=
+                       func_ext::FuncOpAnalysisState::Analyzed)
+      return true;
+    return func_ext::getFuncAnalysisState(state)
+        .writtenBbArgs.lookup(funcOp)
+        .contains(opOperand.getOperandNumber());
+  }
+
+  bufferization::AliasingValueList
+  getAliasingValues(Operation *op, OpOperand &opOperand,
+                    const bufferization::AnalysisState &state) const {
+    FunctionOpInterface funcOp =
+        func_ext::getCalledFunction(cast<CallOpInterface>(op), state);
+    if (!funcOp || func_ext::getFuncOpAnalysisState(state, funcOp) !=
+                       func_ext::FuncOpAnalysisState::Analyzed)
+      return bufferization::detail::unknownGetAliasingValues(opOperand);
+    const func_ext::FuncAnalysisState &funcState =
+        func_ext::getFuncAnalysisState(state);
+    SmallVector<int64_t> aliasingReturnVals =
+        funcState.aliasingReturnVals.lookup(funcOp).lookup(
+            opOperand.getOperandNumber());
+    std::optional<int64_t> equivalent;
+    if (aliasingReturnVals.size() == 1)
+      equivalent = func_ext::getEquivalentFuncArgIdx(funcOp, funcState,
+                                                     aliasingReturnVals.front());
+    bufferization::AliasingValueList result;
+    for (int64_t resultIdx : aliasingReturnVals)
+      result.addAlias({op->getOpResult(resultIdx),
+                       equivalent ? bufferization::BufferRelation::Equivalent
+                                  : bufferization::BufferRelation::Unknown,
+                       /*isDefinite=*/equivalent.has_value()});
+    return result;
+  }
