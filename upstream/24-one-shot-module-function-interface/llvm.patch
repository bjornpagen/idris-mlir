diff --git a/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-function-interface.mlir b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-function-interface.mlir
new file mode 100644
index 000000000..7f8a10cb2
--- /dev/null
+++ b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-function-interface.mlir
@@ -0,0 +1,49 @@
+// RUN: mlir-opt %s -test-one-shot-module-bufferize | FileCheck %s
+
+// One-Shot Module Bufferize bufferizes the boundary of every function op that
+// implements BufferizableOpInterface, and the calls between them. The test
+// pass attaches such implementations, written on the queries of
+// FuncBufferizableOpInterfaceImpl.h, to the test dialect's function, call and
+// return ops.
+
+// CHECK-LABEL: test.conversion_func_op @callee(
+//  CHECK-SAME:     %[[ARG:.*]]: memref<4xf32>) -> memref<4xf32>
+//   CHECK-NOT:   memref.alloc
+//       CHECK:   memref.store %{{.*}}, %[[ARG]]
+//       CHECK:   "test.return"(%[[ARG]])
+test.conversion_func_op @callee(%t: tensor<4xf32>) -> tensor<4xf32> {
+  %f = arith.constant 1.0 : f32
+  %c0 = arith.constant 0 : index
+  %0 = tensor.insert %f into %t[%c0] : tensor<4xf32>
+  "test.return"(%0) : (tensor<4xf32>) -> ()
+}
+
+// The caller does not read its tensor after the call, so the callee writes
+// the caller's buffer in place.
+// CHECK-LABEL: test.conversion_func_op @caller_in_place(
+//  CHECK-SAME:     %[[ARG:.*]]: memref<4xf32>) -> f32
+//   CHECK-NOT:   memref.alloc
+//   CHECK-NOT:   memref.copy
+//       CHECK:   %[[CALL:.*]] = "test.conversion_call_op"(%[[ARG]])
+//       CHECK:   memref.load %[[CALL]]
+test.conversion_func_op @caller_in_place(%t: tensor<4xf32>) -> f32 {
+  %c1 = arith.constant 1 : index
+  %0 = "test.conversion_call_op"(%t) {callee = @callee} : (tensor<4xf32>) -> tensor<4xf32>
+  %1 = tensor.extract %0[%c1] : tensor<4xf32>
+  "test.return"(%1) : (f32) -> ()
+}
+
+// The caller reads its tensor after the call, which writes it, so the call
+// is given a copy.
+// CHECK-LABEL: test.conversion_func_op @caller_reads_after(
+//  CHECK-SAME:     %[[ARG:.*]]: memref<4xf32>) -> (f32, f32)
+//       CHECK:   %[[ALLOC:.*]] = memref.alloc() {{.*}}: memref<4xf32>
+//       CHECK:   memref.copy %[[ARG]], %[[ALLOC]]
+//       CHECK:   "test.conversion_call_op"(%[[ALLOC]])
+test.conversion_func_op @caller_reads_after(%t: tensor<4xf32>) -> (f32, f32) {
+  %c0 = arith.constant 0 : index
+  %0 = "test.conversion_call_op"(%t) {callee = @callee} : (tensor<4xf32>) -> tensor<4xf32>
+  %1 = tensor.extract %0[%c0] : tensor<4xf32>
+  %2 = tensor.extract %t[%c0] : tensor<4xf32>
+  "test.return"(%1, %2) : (f32, f32) -> ()
+}
diff --git a/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-no-return.mlir b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-no-return.mlir
new file mode 100644
index 000000000..240af6d60
--- /dev/null
+++ b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-no-return.mlir
@@ -0,0 +1,24 @@
+// RUN: mlir-opt %s -one-shot-bufferize="bufferize-function-boundaries" -split-input-file | FileCheck %s
+
+// A function none of whose blocks returns never produces a result, so no
+// result aliases an argument: it bufferizes, and so do its callers.
+
+// CHECK-LABEL: func private @never_returns(
+//  CHECK-SAME:     %{{.*}}: memref<4xf32{{.*}}>) -> memref<4xf32{{.*}}>
+//       CHECK:   ub.unreachable
+func.func private @never_returns(%t: tensor<4xf32>) -> tensor<4xf32> {
+  ub.unreachable
+}
+
+// CHECK-LABEL: func @caller(
+//  CHECK-SAME:     %[[ARG:.*]]: memref<4xf32{{.*}}>, %[[C:.*]]: i1) -> f32
+//       CHECK:   scf.if %[[C]]
+//       CHECK:     call @never_returns(%[[ARG]])
+func.func @caller(%t: tensor<4xf32>, %c: i1) -> f32 {
+  %c0 = arith.constant 0 : index
+  scf.if %c {
+    %0 = func.call @never_returns(%t) : (tensor<4xf32>) -> tensor<4xf32>
+  }
+  %1 = tensor.extract %t[%c0] : tensor<4xf32>
+  return %1 : f32
+}
diff --git a/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-transform-sequence.mlir b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-transform-sequence.mlir
new file mode 100644
index 000000000..13ffa0cff
--- /dev/null
+++ b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-transform-sequence.mlir
@@ -0,0 +1,20 @@
+// RUN: mlir-opt %s -one-shot-bufferize="bufferize-function-boundaries" | FileCheck %s
+
+// A function op without a BufferizableOpInterface implementation is no
+// function of One-Shot Module Bufferize: the named sequence beside the
+// payload is bufferized like any other op, which leaves it as it is.
+
+module attributes {transform.with_named_sequence} {
+  // CHECK-LABEL: func @payload(
+  //  CHECK-SAME:     %[[ARG:.*]]: memref<4xf32{{.*}}>) -> memref<4xf32{{.*}}>
+  //       CHECK:   return %[[ARG]]
+  func.func @payload(%t: tensor<4xf32>) -> tensor<4xf32> {
+    return %t : tensor<4xf32>
+  }
+
+  // CHECK: transform.named_sequence @schedule(
+  // CHECK-NEXT: transform.yield
+  transform.named_sequence @schedule(%arg0: !transform.any_op {transform.readonly}) {
+    transform.yield
+  }
+}
