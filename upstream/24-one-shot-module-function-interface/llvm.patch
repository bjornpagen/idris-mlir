+/// BufferizableOpInterface for test.conversion_func_op: a function whose
+/// boundary Module Bufferization bufferizes, as it does func.func's.
+struct TestFuncOpInterface
+    : public bufferization::
+          OpWithUnstructuredControlFlowBufferizableOpInterfaceExternalModel<
+              TestFuncOpInterface, test::ConversionFuncOp> {
+  static bool supportsUnstructuredControlFlow() { return true; }
+
+  bool hasTensorSemantics(Operation *op) const {
+    auto isaTensor = llvm::IsaPred<bufferization::TensorLikeType>;
+    auto funcOp = cast<FunctionOpInterface>(op);
+    if (llvm::any_of(funcOp.getArgumentTypes(), isaTensor) ||
+        llvm::any_of(funcOp.getResultTypes(), isaTensor))
+      return true;
+    for (Block &block : funcOp.getFunctionBody())
+      if (llvm::any_of(block.getArgumentTypes(), isaTensor))
+        return true;
+    return false;
+  }
+
+  bufferization::AliasingOpOperandList
+  getAliasingOpOperands(Operation *op, Value value,
+                        const bufferization::AnalysisState &state) const {
+    return getAliasingBranchOpOperands(op, cast<BlockArgument>(value), state);
+  }
+
+  FailureOr<bufferization::BufferLikeType>
+  getBufferType(Operation *op, Value value,
+                const bufferization::BufferizationOptions &options,
+                const bufferization::BufferizationState &state,
+                SmallVector<Value> &invocationStack) const {
+    auto funcOp = cast<FunctionOpInterface>(op);
+    auto bbArg = cast<BlockArgument>(value);
+    if (bbArg.getOwner() == &funcOp.getFunctionBody().front())
+      return func_ext::getBufferizedFunctionArgType(
+          funcOp, bbArg.getArgNumber(), options);
+    return OpWithUnstructuredControlFlowBufferizableOpInterfaceExternalModel::
+        getBufferType(op, value, options, state, invocationStack);
+  }
+
+  LogicalResult bufferize(Operation *op, RewriterBase &rewriter,
+                          const bufferization::BufferizationOptions &options,
+                          bufferization::BufferizationState &state) const {
+    auto funcOp = cast<FunctionOpInterface>(op);
+    SmallVector<Type> argTypes;
+    for (auto [index, argType] : llvm::enumerate(funcOp.getArgumentTypes())) {
+      if (isa<bufferization::TensorLikeType>(argType))
+        argTypes.push_back(
+            func_ext::getBufferizedFunctionArgType(funcOp, index, options));
+      else
+        argTypes.push_back(argType);
+    }
+    SmallVector<Type> retTypes;
+    for (Type resultType : funcOp.getResultTypes()) {
+      if (auto tensorType = dyn_cast<bufferization::TensorLikeType>(resultType))
+        retTypes.push_back(options.functionArgTypeConverterFn(
+            tensorType, getDefaultMemorySpace(options, tensorType), funcOp,
+            options));
+      else
+        retTypes.push_back(resultType);
+    }
+
+    for (Block &block : funcOp.getFunctionBody())
+      if (failed(bufferization::bufferizeBlockSignature(&block, rewriter,
+                                                        options, state)))
+        return failure();
+
+    for (Operation *returnOp : bufferization::getReturnOps(funcOp)) {
+      SmallVector<Value> returnValues;
+      for (auto [returnVal, bufferizedType] :
+           llvm::zip_equal(returnOp->getOperands(), retTypes)) {
+        if (!isa<bufferization::TensorLikeType>(returnVal.getType())) {
+          returnValues.push_back(returnVal);
+          continue;
+        }
+        rewriter.setInsertionPoint(returnOp);
+        returnValues.push_back(bufferization::ToBufferOp::create(
+            rewriter, returnOp->getLoc(), bufferizedType, returnVal));
+      }
+      returnOp->setOperands(returnValues);
+    }
+
+    funcOp.setType(FunctionType::get(op->getContext(), argTypes, retTypes));
+    return success();
+  }
+
+  bool isWritable(Operation *op, Value value,
+                  const bufferization::AnalysisState &state) const {
+    return true;
+  }
+};
