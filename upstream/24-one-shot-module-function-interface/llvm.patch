+++ b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-non-writable-result.mlir
@@ -0,0 +1,69 @@
+// RUN: mlir-opt %s -one-shot-bufferize="bufferize-function-boundaries" -split-input-file | FileCheck %s
+
+// A function may return a buffer that is not writable, such as the buffer of
+// a constant. A caller that writes the result of a call of it writes a copy.
+
+// CHECK-LABEL: func private @constant(
+//       CHECK:   %[[GLOBAL:.*]] = memref.get_global
+//       CHECK:   return %[[GLOBAL]]
+func.func private @constant() -> tensor<3xi64> {
+  %c = arith.constant dense<[1, 2, 3]> : tensor<3xi64>
+  return %c : tensor<3xi64>
+}
+
+// CHECK-LABEL: func @writes_constant(
+//       CHECK:   %[[RESULT:.*]] = call @constant()
+//       CHECK:   %[[ALLOC:.*]] = memref.alloc
+//       CHECK:   memref.copy %[[RESULT]], %[[ALLOC]]
+//   CHECK-NOT:   memref.store %{{.*}}, %[[RESULT]]
+//       CHECK:   memref.store %{{.*}}, %[[ALLOC]]
+func.func @writes_constant(%v: i64) -> tensor<3xi64> {
+  %c0 = arith.constant 0 : index
+  %0 = func.call @constant() : () -> tensor<3xi64>
+  %1 = tensor.insert %v into %0[%c0] : tensor<3xi64>
+  return %1 : tensor<3xi64>
+}
+
+// -----
+
+// A function that returns a buffer of its own allocation returns a writable
+// buffer, which a caller writes in place.
+
+// CHECK-LABEL: func private @fresh(
+//       CHECK:   %[[ALLOC:.*]] = memref.alloc
+//       CHECK:   linalg.fill {{.*}} outs(%[[ALLOC]]
+func.func private @fresh(%f: f32) -> tensor<4xf32> {
+  %e = tensor.empty() : tensor<4xf32>
+  %0 = linalg.fill ins(%f : f32) outs(%e : tensor<4xf32>) -> tensor<4xf32>
+  return %0 : tensor<4xf32>
+}
+
+// CHECK-LABEL: func @writes_fresh(
+//       CHECK:   %[[RESULT:.*]] = call @fresh(
+//   CHECK-NOT:   memref.alloc
+//   CHECK-NOT:   memref.copy
+//       CHECK:   memref.store %{{.*}}, %[[RESULT]]
+func.func @writes_fresh(%f: f32) -> tensor<4xf32> {
+  %c0 = arith.constant 0 : index
+  %0 = func.call @fresh(%f) : (f32) -> tensor<4xf32>
+  %1 = tensor.insert %f into %0[%c0] : tensor<4xf32>
+  return %1 : tensor<4xf32>
+}
+
+// -----
+
+// The result of a call of a function without a body may be any buffer.
+
+func.func private @external() -> tensor<4xf32>
+
+// CHECK-LABEL: func @writes_external(
+//       CHECK:   %[[RESULT:.*]] = call @external()
+//       CHECK:   %[[ALLOC:.*]] = memref.alloc
+//       CHECK:   memref.copy %[[RESULT]], %[[ALLOC]]
+//       CHECK:   memref.store %{{.*}}, %[[ALLOC]]
+func.func @writes_external(%f: f32) -> tensor<4xf32> {
+  %c0 = arith.constant 0 : index
+  %0 = func.call @external() : () -> tensor<4xf32>
+  %1 = tensor.insert %f into %0[%c0] : tensor<4xf32>
+  return %1 : tensor<4xf32>
+}
diff --git a/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-transform-sequence.mlir b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-transform-sequence.mlir
