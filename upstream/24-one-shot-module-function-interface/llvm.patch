+// RUN: mlir-opt %s -allow-unregistered-dialect -pass-pipeline='builtin.module(test.symbol_scope_isolated(eliminate-empty-tensors))' | FileCheck %s
+
+// On a symbol table that is not a module, empty tensor elimination analyzes
+// function boundaries too: the tensor.empty is found through the call of a
+// function that returns its argument, and replaced with the slice of the
+// destination that the call's result is inserted into.
+
+"test.symbol_scope_isolated"() ({
+  func.func private @fill(%t: tensor<4xf32>) -> tensor<4xf32> {
+    %f = arith.constant 1.0 : f32
+    %0 = linalg.fill ins(%f : f32) outs(%t : tensor<4xf32>) -> tensor<4xf32>
+    return %0 : tensor<4xf32>
+  }
+
+  // CHECK-LABEL: func @caller(
+  //  CHECK-SAME:     %[[T:.*]]: tensor<10xf32>
+  //       CHECK:   %[[SLICE:.*]] = tensor.extract_slice %[[T]][0] [4] [1]
+  //       CHECK:   %[[CALL:.*]] = call @fill(%[[SLICE]])
+  //       CHECK:   tensor.insert_slice %[[CALL]] into %[[T]][0] [4] [1]
+  func.func @caller(%t: tensor<10xf32>) -> tensor<10xf32> {
+    %e = tensor.empty() : tensor<4xf32>
+    %0 = func.call @fill(%e) : (tensor<4xf32>) -> tensor<4xf32>
+    %1 = tensor.insert_slice %0 into %t[0] [4] [1] : tensor<4xf32> into tensor<10xf32>
+    return %1 : tensor<10xf32>
+  }
+  "test.finish" () : () -> ()
+}) : () -> ()
