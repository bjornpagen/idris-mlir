+
+// Each level writes, in place, the buffer that the level below returns: the
+// callee is on a cycle of calls, and its result is a writable buffer of its
+// own allocation, which the analysis of the cycle finds.
+
+// CHECK-LABEL: func.func @build(
+//   CHECK-NOT:   memref.copy
+//       CHECK:   return
+func.func @build(%n: index) -> tensor<8xf32> {
+  %c0 = arith.constant 0 : index
+  %c1 = arith.constant 1 : index
+  %f = arith.constant 1.0 : f32
+  %done = arith.cmpi eq, %n, %c0 : index
+  %r = scf.if %done -> tensor<8xf32> {
+    %e = tensor.empty() : tensor<8xf32>
+    %z = linalg.fill ins(%f : f32) outs(%e : tensor<8xf32>) -> tensor<8xf32>
+    scf.yield %z : tensor<8xf32>
+  } else {
+    %m = arith.subi %n, %c1 : index
+    %t = func.call @build(%m) : (index) -> tensor<8xf32>
+    %t1 = tensor.insert %f into %t[%m] : tensor<8xf32>
+    scf.yield %t1 : tensor<8xf32>
+  }
+  return %r : tensor<8xf32>
+}
+
+// -----
+
+// A recursive function writes its argument and passes it on; its caller does
+// not read the argument after the call, so nothing is copied.
+
+// CHECK-LABEL: func.func @fill(
+//   CHECK-NOT:   memref.alloc
+//   CHECK-NOT:   memref.copy
+//       CHECK:   return
+
+// CHECK-ANALYSIS-LABEL: func.func @fill(
+//  CHECK-ANALYSIS-SAME:     bufferization.access = "read-write"
+func.func @fill(%t: tensor<8xf32>, %n: index) -> tensor<8xf32> {
+  %c0 = arith.constant 0 : index
+  %c1 = arith.constant 1 : index
+  %f = arith.constant 1.0 : f32
+  %done = arith.cmpi eq, %n, %c0 : index
+  %r = scf.if %done -> tensor<8xf32> {
+    scf.yield %t : tensor<8xf32>
+  } else {
+    %m = arith.subi %n, %c1 : index
+    %t1 = tensor.insert %f into %t[%m] : tensor<8xf32>
+    %t2 = func.call @fill(%t1, %m) : (tensor<8xf32>, index) -> tensor<8xf32>
+    scf.yield %t2 : tensor<8xf32>
+  }
+  return %r : tensor<8xf32>
+}
+
+// CHECK-LABEL: func.func @fills_in_place(
+//  CHECK-SAME:     %[[ARG:.*]]: memref<8xf32
+//   CHECK-NOT:   memref.copy
+//       CHECK:   call @fill(%[[ARG]],
+func.func @fills_in_place(%t: tensor<8xf32>) -> tensor<8xf32> {
+  %c8 = arith.constant 8 : index
+  %r = func.call @fill(%t, %c8) : (tensor<8xf32>, index) -> tensor<8xf32>
+  return %r : tensor<8xf32>
+}
+
+// -----
+
+// Two functions call each other, and one of them writes its argument: the
+// analysis of the cycle finds that both do, so a caller that reads its
+// tensor after the call passes a copy.
+
+// CHECK-ANALYSIS-LABEL: func.func @ping(
+//  CHECK-ANALYSIS-SAME:     bufferization.access = "read-write"
+func.func @ping(%t: tensor<4xf32>, %n: index) -> tensor<4xf32> {
+  %c0 = arith.constant 0 : index
+  %done = arith.cmpi eq, %n, %c0 : index
+  %r = scf.if %done -> tensor<4xf32> {
+    scf.yield %t : tensor<4xf32>
+  } else {
+    %p = func.call @pong(%t, %n) : (tensor<4xf32>, index) -> tensor<4xf32>
+    scf.yield %p : tensor<4xf32>
+  }
+  return %r : tensor<4xf32>
+}
+
+// CHECK-ANALYSIS-LABEL: func.func @pong(
+//  CHECK-ANALYSIS-SAME:     bufferization.access = "read-write"
+func.func @pong(%t: tensor<4xf32>, %n: index) -> tensor<4xf32> {
+  %c0 = arith.constant 0 : index
+  %c1 = arith.constant 1 : index
+  %f = arith.constant 1.0 : f32
+  %m = arith.subi %n, %c1 : index
+  %t1 = tensor.insert %f into %t[%c0] : tensor<4xf32>
+  %r = func.call @ping(%t1, %m) : (tensor<4xf32>, index) -> tensor<4xf32>
+  return %r : tensor<4xf32>
+}
+
+// CHECK-LABEL: func.func @reads_after(
+//  CHECK-SAME:     %[[ARG:.*]]: memref<4xf32
+//       CHECK:   %[[ALLOC:.*]] = memref.alloc
+//       CHECK:   memref.copy %[[ARG]], %[[ALLOC]]
+//       CHECK:   call @ping(
+//       CHECK:   memref.load %[[ARG]]
+func.func @reads_after(%t: tensor<4xf32>) -> (tensor<4xf32>, f32) {
+  %c0 = arith.constant 0 : index
+  %c3 = arith.constant 3 : index
+  %r = func.call @ping(%t, %c3) : (tensor<4xf32>, index) -> tensor<4xf32>
+  %x = tensor.extract %t[%c0] : tensor<4xf32>
+  return %r, %x : tensor<4xf32>, f32
+}
diff --git a/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-definite-alias.mlir b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-definite-alias.mlir
new file mode 100644
index 0000000..e7d8aad
--- /dev/null
+++ b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-definite-alias.mlir
@@ -0,0 +1,64 @@
+// RUN: mlir-opt %s -one-shot-bufferize="bufferize-function-boundaries" -split-input-file | FileCheck %s
+
+// A call result that is equivalent to an argument is the buffer of the call
+// operand, whatever else the callee's alias sets hold. @pick returns its
+// argument, whose alias set also holds a constant through the scf.if that
+// may yield either, so the callee may return a buffer that is not writable
+// as that result. But the result is definitely the operand's buffer, so the
+// caller writes it in place: the operand is the caller's argument, which is
+// writable and not read after the call.
+
+func.func private @pick(%t: tensor<4xf32>, %c: i1, %i: index) -> (tensor<4xf32>, f32) {
+  %cst = arith.constant dense<0.0> : tensor<4xf32>
+  %s = scf.if %c -> tensor<4xf32> {
+    scf.yield %t : tensor<4xf32>
+  } else {
+    scf.yield %cst : tensor<4xf32>
+  }
+  %x = tensor.extract %s[%i] : tensor<4xf32>
+  return %t, %x : tensor<4xf32>, f32
+}
+
+// CHECK-LABEL: func @writes_picked(
+//  CHECK-SAME:     %[[ARG:[^:]*]]: memref<4xf32
+//   CHECK-NOT:   memref.alloc
+//   CHECK-NOT:   memref.copy
+//       CHECK:   %[[R:.*]]:2 = call @pick(%[[ARG]],
+//       CHECK:   memref.store %{{.*}}, %[[R]]#0
+func.func @writes_picked(%t: tensor<4xf32>, %c: i1, %v: f32) -> tensor<4xf32> {
+  %c0 = arith.constant 0 : index
+  %r:2 = func.call @pick(%t, %c, %c0) : (tensor<4xf32>, i1, index) -> (tensor<4xf32>, f32)
+  %w = tensor.insert %v into %r#0[%c0] : tensor<4xf32>
+  return %w : tensor<4xf32>
+}
+
+// -----
+
+// The same call, with the operand read after the call: the operand bufferizes
+// out-of-place, so the result is the buffer of the copy, which the caller
+// writes in place. There is one copy, not a second one before the write.
+
+func.func private @pick(%t: tensor<4xf32>, %c: i1, %i: index) -> (tensor<4xf32>, f32) {
+  %cst = arith.constant dense<0.0> : tensor<4xf32>
+  %s = scf.if %c -> tensor<4xf32> {
+    scf.yield %t : tensor<4xf32>
+  } else {
+    scf.yield %cst : tensor<4xf32>
+  }
+  %x = tensor.extract %s[%i] : tensor<4xf32>
+  return %t, %x : tensor<4xf32>, f32
+}
+
+// CHECK-LABEL: func @writes_picked_copy(
+//       CHECK:   memref.alloc
+//       CHECK:   memref.copy
+//   CHECK-NOT:   memref.alloc
+//   CHECK-NOT:   memref.copy
+//       CHECK:   return
+func.func @writes_picked_copy(%t: tensor<4xf32>, %c: i1, %v: f32) -> (tensor<4xf32>, f32) {
+  %c0 = arith.constant 0 : index
+  %r:2 = func.call @pick(%t, %c, %c0) : (tensor<4xf32>, i1, index) -> (tensor<4xf32>, f32)
+  %w = tensor.insert %v into %r#0[%c0] : tensor<4xf32>
+  %y = tensor.extract %t[%c0] : tensor<4xf32>
+  return %w, %y : tensor<4xf32>, f32
+}
diff --git a/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-function-interface.mlir b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-function-interface.mlir
new file mode 100644
index 0000000..816f84d
--- /dev/null
+++ b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-function-interface.mlir
@@ -0,0 +1,49 @@
+// RUN: mlir-opt %s -test-one-shot-module-bufferize | FileCheck %s
+
+// One-Shot Module Bufferize bufferizes the boundary of every function op that
+// implements BufferizableOpInterface, and the calls between them. The test
+// pass attaches the implementations that func.func, func.call and func.return
+// have, which are written on FunctionOpInterface, CallOpInterface and the
+// ReturnLike trait, to the test dialect's function, call and return ops.
+
+// CHECK-LABEL: test.conversion_func_op @callee(
+//  CHECK-SAME:     %[[ARG:.*]]: memref<4xf32>) -> memref<4xf32>
+//   CHECK-NOT:   memref.alloc
+//       CHECK:   memref.store %{{.*}}, %[[ARG]]
+//       CHECK:   "test.return"(%[[ARG]])
+test.conversion_func_op @callee(%t: tensor<4xf32>) -> tensor<4xf32> {
+  %f = arith.constant 1.0 : f32
+  %c0 = arith.constant 0 : index
+  %0 = tensor.insert %f into %t[%c0] : tensor<4xf32>
+  "test.return"(%0) : (tensor<4xf32>) -> ()
+}
+
+// The caller does not read its tensor after the call, so the callee writes
+// the caller's buffer in place.
+// CHECK-LABEL: test.conversion_func_op @caller_in_place(
+//  CHECK-SAME:     %[[ARG:.*]]: memref<4xf32>) -> f32
+//   CHECK-NOT:   memref.alloc
+//   CHECK-NOT:   memref.copy
+//       CHECK:   %[[CALL:.*]] = "test.conversion_call_op"(%[[ARG]])
+//       CHECK:   memref.load %[[CALL]]
+test.conversion_func_op @caller_in_place(%t: tensor<4xf32>) -> f32 {
+  %c1 = arith.constant 1 : index
+  %0 = "test.conversion_call_op"(%t) {callee = @callee} : (tensor<4xf32>) -> tensor<4xf32>
+  %1 = tensor.extract %0[%c1] : tensor<4xf32>
+  "test.return"(%1) : (f32) -> ()
+}
+
+// The caller reads its tensor after the call, which writes it, so the call
+// is given a copy.
+// CHECK-LABEL: test.conversion_func_op @caller_reads_after(
+//  CHECK-SAME:     %[[ARG:.*]]: memref<4xf32>) -> (f32, f32)
+//       CHECK:   %[[ALLOC:.*]] = memref.alloc() {{.*}}: memref<4xf32>
+//       CHECK:   memref.copy %[[ARG]], %[[ALLOC]]
+//       CHECK:   "test.conversion_call_op"(%[[ALLOC]])
+test.conversion_func_op @caller_reads_after(%t: tensor<4xf32>) -> (f32, f32) {
+  %c0 = arith.constant 0 : index
+  %0 = "test.conversion_call_op"(%t) {callee = @callee} : (tensor<4xf32>) -> tensor<4xf32>
+  %1 = tensor.extract %0[%c0] : tensor<4xf32>
+  %2 = tensor.extract %t[%c0] : tensor<4xf32>
+  "test.return"(%1, %2) : (f32, f32) -> ()
+}
diff --git a/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-no-return.mlir b/mlir/test/Dialect/Bufferization/Transforms/one-shot-module-bufferize-no-return.mlir
