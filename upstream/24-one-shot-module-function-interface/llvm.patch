+        cast<CallOpInterface>(op), state.getSymbolTables());
+    Type resultType =
+        funcOp.getResultTypes()[cast<OpResult>(value).getResultNumber()];
+    if (auto bufferType = dyn_cast<bufferization::BufferLikeType>(resultType))
+      return bufferType;
+    auto tensorType = cast<bufferization::TensorLikeType>(resultType);
+    return options.functionArgTypeConverterFn(
+        tensorType, getDefaultMemorySpace(options, tensorType), funcOp,
+        options);
