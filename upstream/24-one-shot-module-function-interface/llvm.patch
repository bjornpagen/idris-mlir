+/// CallOpInterface) of a function op that One-Shot Module Bufferize
+/// bufferizes across its boundary. It is attached to func.call and may be
+/// attached to the call op of any dialect.
+template <typename ConcreteOp>
+struct CallOpBufferizableModel
+    : public BufferizableOpInterface::ExternalModel<
+          CallOpBufferizableModel<ConcreteOp>, ConcreteOp> {
+  bool bufferizesToMemoryRead(Operation *op, OpOperand &opOperand,
+                              const AnalysisState &state) const {
+    return callOpBufferizesToMemoryRead(cast<CallOpInterface>(op), opOperand,
+                                        state);
+  }
+
+  bool bufferizesToMemoryWrite(Operation *op, OpOperand &opOperand,
+                               const AnalysisState &state) const {
