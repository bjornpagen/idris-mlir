+    SmallVector<Type> resultTypes;
+    for (Value result : callOp->getResults()) {
+      if (!isa<bufferization::TensorLikeType>(result.getType())) {
+        resultTypes.push_back(result.getType());
+        continue;
+      }
+      FailureOr<bufferization::BufferLikeType> resultType =
