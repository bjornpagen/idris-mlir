+bool FuncBoundaryFacts::join(const FuncBoundaryFacts &other) {
+  bool changed = false;
+  auto unite = [&](DenseSet<int64_t> &into, const DenseSet<int64_t> &from) {
+    for (int64_t idx : from)
+      changed |= into.insert(idx).second;
