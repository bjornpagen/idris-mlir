+||| The rightmost argument.
+lastArg : {p : _} -> {ps : _} -> NamedPats (p :: ps) ns -> (n ** NVar n (p :: ps))
+lastArg {ps = []} _ = (p ** MkNVar First)
+lastArg {ps = q :: qs} (_ :: rest)
+    = let (n ** MkNVar v) = lastArg rest in (n ** MkNVar (Later v))
+
+||| The leftmost argument a run keeps, if there is one.
+firstKept : {ps : _} -> NamedPats ps ns -> Maybe (n ** NVar n ps)
+firstKept [] = Nothing
+firstKept {ps = p :: _} (pinf :: rest)
+    = if kept (argType pinf)
+         then Just (p ** MkNVar First)
+         else map (\ (n ** MkNVar v) => (n ** MkNVar (Later v))) (firstKept rest)
+  where
+    kept : ArgType vs -> Bool
+    kept (Known r _) = not (isErased r)
+    kept _ = False
+
