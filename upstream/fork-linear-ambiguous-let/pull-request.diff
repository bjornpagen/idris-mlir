+||| Whether an elaboration failed because a linear binder was used at a
+||| multiplicity it does not have, so that checking the term again at
+||| multiplicity one may succeed. A name with several candidates fails when
+||| all of them do, and checking again at one tries every candidate again,
+||| so that failure is such a failure when any candidate's is.
+export
+misusesLinear : Error -> Bool
+misusesLinear (LinearMisuse _ _ r _) = isLinear r
+misusesLinear (AllFailed alts) = candidates alts
+  where
+    candidates : List (Maybe Name, Error) -> Bool
+    candidates [] = False
+    candidates ((_, err) :: rest) = misusesLinear err || candidates rest
+misusesLinear (InType _ _ err) = misusesLinear err
+misusesLinear (InCon _ err) = misusesLinear err
+misusesLinear (InLHS _ _ err) = misusesLinear err
+misusesLinear (InRHS _ _ err) = misusesLinear err
+misusesLinear _ = False
+
 mutual
   mismatchNF : {auto c : Ref Ctxt Defs} ->
                {vars : _} ->
diff -ruN a/tests/idris2/linear/linear021/LinearLet.idr b/tests/idris2/linear/linear021/LinearLet.idr
--- a/tests/idris2/linear/linear021/LinearLet.idr	1969-12-31 18:00:00
+++ b/tests/idris2/linear/linear021/LinearLet.idr	2026-10-15 09:23:10
@@ -0,0 +1,32 @@
+module LinearLet
+
+%default total
+
+||| A resource that is used once.
+export
+data Handle : Type where
+  MkHandle : Nat -> Handle
+
+namespace Plain
+  ||| A size of an unrestricted value: the candidate that does not fit.
+  export
+  size : List a -> Nat
+  size = length
+
+namespace Linear
+  ||| A handle's size, and the handle given back.
+  export
+  size : (1 _ : Handle) -> Res Nat (const Handle)
+  size (MkHandle n) = n # MkHandle n
+
+||| The handle's size, read twice through an unqualified `size` on the
+||| right of a linear pattern `let`. The name has two candidates, and only
+||| the linear one fits the linear handle.
+twice : (1 _ : Handle) -> Res Nat (const Handle)
+twice h = let n # h = size h in
+          let m # h = size h in
+          (n + m) # h
+
+||| The same through a plain `let`, which binds the pair linearly.
+once : (1 _ : Handle) -> Res Nat (const Handle)
+once h = let r = size h in r
