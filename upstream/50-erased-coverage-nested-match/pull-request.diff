@@ -0,0 +1,46 @@
+import Data.List.Quantifiers
+
+%default total
+
+data W = A | F Integer | B
+
+data IsF : W -> Type where
+  ItIsF : IsF (F w)
+
+data Pr : W -> Type where
+  M1 : Pr (F w)
+  M2 : Pr B
+
+-- The clauses do not write `ws`: the elaborator binds it, and the patterns
+-- of the explicit argument fix it. `fp`'s case tree must not split it
+-- before them, as `fp2`'s does not.
+0 fp : All IsF ws -> All Pr ws
+fp [] = []
+fp (ItIsF :: fs) = M1 :: fp fs
+
+fp2 : All IsF ws -> All Pr ws
+fp2 [] = []
+fp2 (ItIsF :: fs) = M1 :: fp2 fs
+
+0 fp3 : {ws : List W} -> All IsF ws -> All Pr ws
+fp3 [] = []
+fp3 (ItIsF :: fs) = M1 :: fp3 fs
+
+fpTwo : fp (ItIsF {w = 1} :: ItIsF {w = 2} :: []) = M1 :: M1 :: []
+fpTwo = Refl
+
+-- A pattern the clause writes on an erased argument is still a match.
+0 g : (0 n : Nat) -> Nat
+g Z = 1
+g _ = 2
+
+gFive : g 5 = 2
+gFive = Refl
+
+-- A case on a variable, here in a type: the alternative's pattern is the
+-- clause's own, although it sits in the as-pattern that names the variable.
+0 Pick : Bool -> Type
+Pick b = if b then Nat else String
+
+pickFalse : Pick False = String
+pickFalse = Refl
