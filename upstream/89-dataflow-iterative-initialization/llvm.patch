diff --git a/mlir/include/mlir/Analysis/DataFlowFramework.h b/mlir/include/mlir/Analysis/DataFlowFramework.h
index 9609053..0e13e10 100644
--- a/mlir/include/mlir/Analysis/DataFlowFramework.h
+++ b/mlir/include/mlir/Analysis/DataFlowFramework.h
@@ -760,6 +760,24 @@ protected:
     return *solver.symbolTables;
   }
 
+  /// The order in which `initializeNested` takes the operations of a block. A
+  /// backward analysis takes them last first, so that it propagates as much as
+  /// it can before the solver's worklist runs.
+  enum class OperationOrder { Forward, Backward };
+
+  /// Call `visitOp` on `top` and on every operation nested in it, and
+  /// `visitBlock` on every block nested in it, in the order a recursion over
+  /// the nesting takes: an operation before its regions, the regions of an
+  /// operation and the blocks of a region in order, each block before its
+  /// operations, and each operation of a block, in `order`, with everything
+  /// nested in it before the next. The traversal keeps its position in an
+  /// explicit worklist, so the nesting depth of the IR is not the depth of the
+  /// native stack. It stops at the first failure of `visitOp` and returns it.
+  LogicalResult
+  initializeNested(Operation *top, OperationOrder order,
+                   function_ref<LogicalResult(Operation *)> visitOp,
+                   function_ref<void(Block *)> visitBlock);
+
 #if LLVM_ENABLE_ABI_BREAKING_CHECKS
   /// When compiling with debugging, keep a name for the analyis.
   StringRef debugName;
