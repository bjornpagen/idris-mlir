diff --git a/mlir/unittests/Analysis/DataFlowTest.cpp b/mlir/unittests/Analysis/DataFlowTest.cpp
new file mode 100644
index 0000000..4de0e64
--- /dev/null
+++ b/mlir/unittests/Analysis/DataFlowTest.cpp
@@ -0,0 +1,131 @@
+//===- DataFlowTest.cpp - Data-flow analyses of deeply nested IR ----------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "mlir/Analysis/DataFlow/ConstantPropagationAnalysis.h"
+#include "mlir/Analysis/DataFlow/DeadCodeAnalysis.h"
+#include "mlir/Analysis/DataFlow/DenseAnalysis.h"
+#include "mlir/Analysis/DataFlow/LivenessAnalysis.h"
+#include "mlir/Analysis/DataFlowFramework.h"
+#include "mlir/IR/Builders.h"
+#include "mlir/IR/BuiltinOps.h"
+#include "mlir/IR/BuiltinTypes.h"
+#include "mlir/IR/MLIRContext.h"
+#include "mlir/IR/SymbolTable.h"
+#include "llvm/Support/thread.h"
+#include "gtest/gtest.h"
+
+using namespace mlir;
+using namespace mlir::dataflow;
+
+namespace {
+/// A dense lattice that holds nothing.
+class Reached : public AbstractDenseLattice {
+public:
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(Reached)
+  using AbstractDenseLattice::AbstractDenseLattice;
+  void print(raw_ostream &os) const override { os << "reached"; }
+};
+
+/// A dense forward analysis that records whether it visited `leaf`.
+class ForwardReach : public DenseForwardDataFlowAnalysis<Reached> {
+public:
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(ForwardReach)
+  ForwardReach(DataFlowSolver &solver, Operation *leaf)
+      : DenseForwardDataFlowAnalysis(solver), leaf(leaf) {}
+
+  LogicalResult visitOperation(Operation *op, const Reached &before,
+                               Reached *after) override {
+    visitedLeaf |= op == leaf;
+    return success();
+  }
+  void setToEntryState(Reached *lattice) override {}
+
+  Operation *leaf;
+  bool visitedLeaf = false;
+};
+
+/// A dense backward analysis that records whether it visited `leaf`.
+class BackwardReach : public DenseBackwardDataFlowAnalysis<Reached> {
+public:
+  MLIR_DEFINE_EXPLICIT_INTERNAL_INLINE_TYPE_ID(BackwardReach)
+  BackwardReach(DataFlowSolver &solver, SymbolTableCollection &symbolTable,
+                Operation *leaf)
+      : DenseBackwardDataFlowAnalysis(solver, symbolTable), leaf(leaf) {}
+
+  LogicalResult visitOperation(Operation *op, const Reached &after,
+                               Reached *before) override {
+    visitedLeaf |= op == leaf;
+    return success();
+  }
+  void setToExitState(Reached *lattice) override {}
+
+  Operation *leaf;
+  bool visitedLeaf = false;
+};
+
+TEST(DataFlowTest, DeepNestingOnASmallStack) {
+  MLIRContext context;
+  context.allowUnregisteredDialects();
+  Location loc = UnknownLoc::get(&context);
+  Type i32 = IntegerType::get(&context, 32);
+
+  // A module holding a value and a chain of operations, each holding the next
+  // in the one block of its one region, the last using the value.
+  constexpr unsigned depth = 10000;
+  OwningOpRef<ModuleOp> module = ModuleOp::create(loc);
+  OpBuilder builder = OpBuilder::atBlockEnd(module->getBody());
+  OperationState sourceState(loc, "test.source");
+  sourceState.addTypes(i32);
+  Value source = builder.create(sourceState)->getResult(0);
+  SmallVector<Operation *> chain;
+  for (unsigned i = 0; i < depth; ++i) {
+    OperationState state(loc, "test.nest");
+    state.addRegion();
+    chain.push_back(builder.create(state));
+    builder.createBlock(&chain.back()->getRegion(0));
+  }
+  OperationState leafState(loc, "test.leaf");
+  leafState.addOperands(source);
+  leafState.addTypes(i32);
+  Operation *leaf = builder.create(leafState);
+  Value result = leaf->getResult(0);
+
+  // An initialization that took a native frame per level of nesting would
+  // overflow this thread's stack. Each kind of analysis reaches the leaf.
+  bool solved = false, forward = false, backward = false;
+  bool constant = false, live = false;
+  llvm::thread solving(/*StackSizeInBytes=*/256 * 1024, [&] {
+    SymbolTableCollection symbolTable;
+    DataFlowSolver solver;
+    solver.load<DeadCodeAnalysis>();
+    solver.load<SparseConstantPropagation>();
+    solver.load<LivenessAnalysis>(symbolTable);
+    auto *forwardReach = solver.load<ForwardReach>(leaf);
+    auto *backwardReach = solver.load<BackwardReach>(symbolTable, leaf);
+    solved = succeeded(solver.initializeAndRun(*module));
+    forward = forwardReach->visitedLeaf;
+    backward = backwardReach->visitedLeaf;
+    const auto *value = solver.lookupState<Lattice<ConstantValue>>(result);
+    constant = value && !value->getValue().isUninitialized();
+    const auto *liveness = solver.lookupState<Liveness>(source);
+    live = liveness && liveness->isLive;
+  });
+  solving.join();
+
+  EXPECT_TRUE(solved);
+  EXPECT_TRUE(forward);
+  EXPECT_TRUE(backward);
+  EXPECT_TRUE(constant);
+  EXPECT_TRUE(live);
+
+  // Innermost first, so that no destruction recurses on the depth either.
+  leaf->erase();
+  for (Operation *op : llvm::reverse(chain))
+    op->erase();
+}
+} // namespace
