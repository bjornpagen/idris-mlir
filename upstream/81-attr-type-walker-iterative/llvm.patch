+  // place in an explicit stack: one frame per element whose sub elements are
+  // being replaced, with its pending cache entry, the replacement the
+  // replacement functions made of it, that replacement's sub elements and
+  // the next one to replace, their replacements so far, and whether any
+  // differs from the sub element it replaces. Each element is replaced as a
+  // recursion through `replace` would replace it: looked up in the cache
+  // first, then replaced, its sub elements replaced in order until one
+  // fails, and its result resolved in the cache after theirs.
+  struct Frame {
+    PendingEntry pending;
+    SubElement replacement;
+    SmallVector<SubElement, 4> subElements;
