 using namespace mlir;
 
+namespace {
+/// An attribute or a type, as a walk or a replacement meets it. A sub element
+/// may be null where `walkImmediateSubElements` gives a null one.
+struct SubElement {
+  enum class Kind { Attribute, Type };
+
+  static SubElement of(Attribute attr) {
+    return {Kind::Attribute, attr.getAsOpaquePointer()};
+  }
+  static SubElement of(Type type) {
+    return {Kind::Type, type.getAsOpaquePointer()};
+  }
+
+  /// Invokes `fn` with the attribute or the type.
+  template <typename FnT>
+  decltype(auto) visit(FnT &&fn) const {
+    if (kind == Kind::Attribute)
+      return fn(Attribute::getFromOpaquePointer(opaque));
+    return fn(Type::getFromOpaquePointer(opaque));
+  }
+
+  Kind kind;
+  const void *opaque;
+};
+} // namespace
+
+/// The immediate sub elements of `element`, in the order
+/// `walkImmediateSubElements` gives them, null ones included. That only
+/// enumerates them: nothing is walked or replaced while they are gathered.
+static SmallVector<SubElement, 4> getSubElements(SubElement element) {
+  SmallVector<SubElement, 4> subElements;
+  element.visit([&](auto value) {
+    value.walkImmediateSubElements(
+        [&](Attribute attr) { subElements.push_back(SubElement::of(attr)); },
+        [&](Type type) { subElements.push_back(SubElement::of(type)); });
+  });
+  return subElements;
+}
