+//===----------------------------------------------------------------------===//
+// AttrTypeWalker and AttrTypeReplacer: deep nesting
+//===----------------------------------------------------------------------===//
+
+/// An array attribute nested `depth` deep around `leaf`.
+static Attribute getNestedArray(Builder &b, Attribute leaf, unsigned depth) {
+  Attribute nested = leaf;
+  for (unsigned i = 0; i < depth; ++i)
+    nested = b.getArrayAttr(nested);
+  return nested;
+}
+
+TEST(AttrTypeSubElementsTest, testDeepNestingOnASmallStack) {
+  MLIRContext ctx;
+  Builder b(&ctx);
+  constexpr unsigned depth = 10000;
+  Attribute nested = getNestedArray(b, b.getI64IntegerAttr(0), depth);
+  Attribute innermost = getNestedArray(b, b.getI64IntegerAttr(0), 1);
+  Attribute expected = getNestedArray(b, b.getI64IntegerAttr(1), depth);
+
+  // A walk or a replacement that took a native frame per level of nesting
+  // would overflow this thread's stack.
+  unsigned preOrderArrays = 0, postOrderArrays = 0;
+  Attribute firstPreOrder, firstPostOrder, replaced, cyclicReplaced;
+  WalkResult interrupted = WalkResult::advance();
+  llvm::thread worker(/*StackSizeInBytes=*/256 * 1024, [&] {
+    AttrTypeWalker preOrder;
+    preOrder.addWalk([&](ArrayAttr array) {
+      if (!firstPreOrder)
+        firstPreOrder = array;
+      ++preOrderArrays;
+    });
+    preOrder.walk<WalkOrder::PreOrder>(nested);
+
+    AttrTypeWalker postOrder;
+    postOrder.addWalk([&](ArrayAttr array) {
+      if (!firstPostOrder)
+        firstPostOrder = array;
+      ++postOrderArrays;
+    });
+    postOrder.walk(nested);
+
+    AttrTypeWalker interrupting;
+    interrupting.addWalk([](IntegerAttr) { return WalkResult::interrupt(); });
+    interrupted = interrupting.walk(nested);
+
+    auto increment = [&](IntegerAttr attr) {
+      return b.getI64IntegerAttr(attr.getInt() + 1);
+    };
+    AttrTypeReplacer replacer;
+    replacer.addReplacement(increment);
+    replaced = replacer.replace(nested);
+    CyclicAttrTypeReplacer cyclicReplacer;
+    cyclicReplacer.addReplacement(increment);
+    cyclicReplaced = cyclicReplacer.replace(nested);
+  });
+  worker.join();
+
+  EXPECT_EQ(preOrderArrays, depth);
+  EXPECT_EQ(postOrderArrays, depth);
+  EXPECT_TRUE(firstPreOrder == nested);
+  EXPECT_TRUE(firstPostOrder == innermost);
+  EXPECT_TRUE(interrupted.wasInterrupted());
+  EXPECT_TRUE(replaced == expected);
+  EXPECT_TRUE(cyclicReplaced == expected);
+}
