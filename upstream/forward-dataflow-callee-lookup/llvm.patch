Subject: [PATCH] [mlir][dataflow][NFC] Resolve callees from one symbol table per run

AbstractSparseForwardDataFlowAnalysis::visitCallOperation and
AbstractDenseForwardDataFlowAnalysis::visitCallOperation ask,
on every visit of a call, whether the callee is an external
declaration, using CallOpInterface::resolveCallable(). Without a
SymbolTableCollection that is SymbolTable::lookupNearestSymbolFrom,
a walk over the operations of the enclosing symbol table. A call is
visited again whenever its operands or its callee's returns change,
so an interprocedural forward analysis over a module of n functions
that call each other does O(n^2) work. DeadCodeAnalysis, which every
forward analysis runs with, already resolves the same callees through
a SymbolTableCollection of its own.

The solver now holds one SymbolTableCollection for the
duration of initializeAndRun, and analyses reach it through
DataFlowAnalysis::getSymbolTables(). The forward analyses resolve their
callees through it, and DeadCodeAnalysis uses it instead of its member.
The IR does not change during a run, so each lookup finds the same
symbol as before; the tables are built on first use and none outlives
the run that built it. The backward analyses keep resolving through
the collection their constructors take: moving them onto the solver's
changes their public constructors and is left to a separate change.

No test: results are unchanged and the existing sccp,
int-range-optimizations and remove-dead-values tests cover these
lookups. On a module of 16,000 functions, each calling the next,
--sccp goes from 9.6 s to 0.7 s and --int-range-optimizations from
17.5 s to 1.9 s.
---
 mlir/include/mlir/Analysis/DataFlow/DeadCodeAnalysis.h |  3 ---
 mlir/include/mlir/Analysis/DataFlowFramework.h         | 15 +++++++++++++++
 mlir/lib/Analysis/DataFlow/DeadCodeAnalysis.cpp        |  5 +++--
 mlir/lib/Analysis/DataFlow/DenseAnalysis.cpp           |  4 ++--
 mlir/lib/Analysis/DataFlow/SparseAnalysis.cpp          |  4 ++--
 mlir/lib/Analysis/DataFlowFramework.cpp                |  4 ++++
 6 files changed, 26 insertions(+), 9 deletions(-)

diff --git a/mlir/include/mlir/Analysis/DataFlow/DeadCodeAnalysis.h b/mlir/include/mlir/Analysis/DataFlow/DeadCodeAnalysis.h
index 3b2914c..a7bb3d8 100644
--- a/mlir/include/mlir/Analysis/DataFlow/DeadCodeAnalysis.h
+++ b/mlir/include/mlir/Analysis/DataFlow/DeadCodeAnalysis.h
@@ -243,9 +243,6 @@ private:
   /// operation does not have a symbol table, but one is encountered in a nested
   /// region.
   bool hasSymbolTable = false;
-
-  /// A symbol table used for O(1) symbol lookups during simplification.
-  SymbolTableCollection symbolTable;
 };
 
 } // end namespace dataflow
diff --git a/mlir/include/mlir/Analysis/DataFlowFramework.h b/mlir/include/mlir/Analysis/DataFlowFramework.h
index 30fed25..c2dd138 100644
--- a/mlir/include/mlir/Analysis/DataFlowFramework.h
+++ b/mlir/include/mlir/Analysis/DataFlowFramework.h
@@ -50,6 +50,8 @@ inline ChangeResult operator&(ChangeResult lhs, ChangeResult rhs) {
   return lhs == ChangeResult::NoChange ? lhs : rhs;
 }
 
+class SymbolTableCollection;
+
 /// Forward declare the analysis state class.
 class AnalysisState;
 
@@ -446,6 +448,11 @@ private:
   /// The solver is working on the worklist.
   bool isRunning = false;
 
+  /// The symbol tables of the current run, shared by all analyses. They are
+  /// built on first lookup and discarded when the run ends: the IR does not
+  /// change while the solver runs, but it may change between runs.
+  SymbolTableCollection *symbolTables = nullptr;
+
   /// The solver's work queue. Work items can be inserted to the front of the
   /// queue to be processed greedily, speeding up computations that otherwise
   /// quickly degenerate to quadratic due to propagation of state updates.
@@ -716,6 +723,14 @@ protected:
   /// Return the configuration of the solver used for this analysis.
   const DataFlowConfig &getSolverConfig() const { return solver.getConfig(); }
 
+  /// Return the symbol tables shared by all analyses of the running solver.
+  /// Look symbols up through them rather than by scanning a symbol table
+  /// operation.
+  SymbolTableCollection &getSymbolTables() {
+    assert(solver.symbolTables && "the solver is not running");
+    return *solver.symbolTables;
+  }
+
 #if LLVM_ENABLE_ABI_BREAKING_CHECKS
   /// When compiling with debugging, keep a name for the analyis.
   StringRef debugName;
diff --git a/mlir/lib/Analysis/DataFlow/DeadCodeAnalysis.cpp b/mlir/lib/Analysis/DataFlow/DeadCodeAnalysis.cpp
index 37aaf1f..05a6956 100644
--- a/mlir/lib/Analysis/DataFlow/DeadCodeAnalysis.cpp
+++ b/mlir/lib/Analysis/DataFlow/DeadCodeAnalysis.cpp
@@ -228,7 +228,8 @@ void DeadCodeAnalysis::initializeSymbolCallables(Operation *top) {
         continue;
       // If a callable symbol has a non-call use, then we can't be guaranteed to
       // know all callsites.
-      Operation *symbol = symbolTable.lookupSymbolIn(top, use.getSymbolRef());
+      Operation *symbol =
+          getSymbolTables().lookupSymbolIn(top, use.getSymbolRef());
       if (!symbol)
         continue;
       auto *state = getOrCreate<PredecessorState>(getProgramPointAfter(symbol));
@@ -413,7 +414,7 @@ void DeadCodeAnalysis::visitCallOperation(CallOpInterface call) {
 
   Operation *callableOp = nullptr;
   if (hasSymbolTable)
-    callableOp = call.resolveCallableInTable(&symbolTable);
+    callableOp = call.resolveCallableInTable(&getSymbolTables());
   else
     LDBG()
         << "No symbol table present in analysis scope, can't resolve callable";
diff --git a/mlir/lib/Analysis/DataFlow/DenseAnalysis.cpp b/mlir/lib/Analysis/DataFlow/DenseAnalysis.cpp
index a2a9018..878ee55 100644
--- a/mlir/lib/Analysis/DataFlow/DenseAnalysis.cpp
+++ b/mlir/lib/Analysis/DataFlow/DenseAnalysis.cpp
@@ -100,8 +100,8 @@ void AbstractDenseForwardDataFlowAnalysis::visitCallOperation(
   // Allow for customizing the behavior of calls to external symbols, including
   // when the analysis is explicitly marked as non-interprocedural.
   auto isExternalCallable = [&]() {
-    auto callable =
-        dyn_cast_if_present<CallableOpInterface>(call.resolveCallable());
+    auto callable = dyn_cast_if_present<CallableOpInterface>(
+        call.resolveCallableInTable(&getSymbolTables()));
     return callable && !callable.getCallableRegion();
   };
   if (!getSolverConfig().isInterprocedural() || isExternalCallable()) {
diff --git a/mlir/lib/Analysis/DataFlow/SparseAnalysis.cpp b/mlir/lib/Analysis/DataFlow/SparseAnalysis.cpp
index 3d9a375..0b24b65 100644
--- a/mlir/lib/Analysis/DataFlow/SparseAnalysis.cpp
+++ b/mlir/lib/Analysis/DataFlow/SparseAnalysis.cpp
@@ -233,8 +233,8 @@ LogicalResult AbstractSparseForwardDataFlowAnalysis::visitCallOperation(
   // If the call operation is to an external function, attempt to infer the
   // results from the call arguments.
   auto isExternalCallable = [&]() {
-    auto callable =
-        dyn_cast_if_present<CallableOpInterface>(call.resolveCallable());
+    auto callable = dyn_cast_if_present<CallableOpInterface>(
+        call.resolveCallableInTable(&getSymbolTables()));
     return callable && !callable.getCallableRegion();
   };
   if (!getSolverConfig().isInterprocedural() || isExternalCallable()) {
diff --git a/mlir/lib/Analysis/DataFlowFramework.cpp b/mlir/lib/Analysis/DataFlowFramework.cpp
index e51ae7a..7c2516a 100644
--- a/mlir/lib/Analysis/DataFlowFramework.cpp
+++ b/mlir/lib/Analysis/DataFlowFramework.cpp
@@ -116,6 +116,10 @@ LogicalResult DataFlowSolver::initializeAndRun(
   isRunning = true;
   llvm::scope_exit guard([&]() { isRunning = false; });
 
+  SymbolTableCollection runSymbolTables;
+  symbolTables = &runSymbolTables;
+  llvm::scope_exit clearSymbolTables([&]() { symbolTables = nullptr; });
+
   bool isInterprocedural = config.isInterprocedural();
   llvm::scope_exit restoreInterprocedural(
       [&]() { config.setInterprocedural(isInterprocedural); });
