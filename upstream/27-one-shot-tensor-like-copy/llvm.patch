diff --git a/mlir/test/Dialect/Bufferization/Transforms/one-shot-bufferize-tensor-like-copy.mlir b/mlir/test/Dialect/Bufferization/Transforms/one-shot-bufferize-tensor-like-copy.mlir
new file mode 100644
index 0000000..8043e0e
--- /dev/null
+++ b/mlir/test/Dialect/Bufferization/Transforms/one-shot-bufferize-tensor-like-copy.mlir
@@ -0,0 +1,14 @@
+// RUN: mlir-opt %s -test-one-shot-module-bufferize -split-input-file -verify-diagnostics
+
+// An OpOperand of a tensor-like type that is not a builtin tensor bufferizes
+// out-of-place: %arg is read after the op writes it. Such a value is copied
+// by BufferizationOptions::tensorAllocationFn, which the test pass does not
+// set, so the copy is an error. The OpOperand used to be given no copy, and
+// the op wrote the buffer that is read after it.
+func.func @custom_type_read_after_write(%arg: !test.test_tensor<[4], f64>)
+    -> (!test.test_tensor<[4], f64>, !test.test_tensor<[4], f64>) {
+  // expected-error @below {{allocating a tensor of type '!test.test_tensor<[4], f64>' is not supported}}
+  %out = "test.dummy_tensor_op"(%arg) : (!test.test_tensor<[4], f64>)
+    -> !test.test_tensor<[4], f64>
+  return %out, %arg : !test.test_tensor<[4], f64>, !test.test_tensor<[4], f64>
+}
diff --git a/mlir/test/Dialect/Bufferization/Transforms/tensor-copy-insertion-tensor-like.mlir b/mlir/test/Dialect/Bufferization/Transforms/tensor-copy-insertion-tensor-like.mlir
new file mode 100644
index 0000000..43bca31
--- /dev/null
+++ b/mlir/test/Dialect/Bufferization/Transforms/tensor-copy-insertion-tensor-like.mlir
@@ -0,0 +1,23 @@
+// RUN: mlir-opt %s -test-tensor-copy-insertion=copy-test-tensors | FileCheck %s
+
+// The cast's operand bufferizes out-of-place: in place, the op would write the
+// function argument, which is not writable. The cast writes nothing, so its
+// result is copied instead, by BufferizationOptions::tensorAllocationFn, which
+// the test pass sets to copy a test tensor between two casts. The copy's first
+// cast reads the result, and only the uses the result had before its copy read
+// the copy.
+
+// CHECK-LABEL: func @copy_of_result(
+//  CHECK-SAME:     %[[arg:.*]]: tensor<4xf64>
+//       CHECK:   %[[cast:.*]] = test.tensor_like_cast %[[arg]] : tensor<4xf64> to !test.test_tensor<[4], f64>
+//       CHECK:   %[[plain:.*]] = test.tensor_like_cast %[[cast]] : !test.test_tensor<[4], f64> to tensor<4xf64>
+//       CHECK:   %[[alloc:.*]] = bufferization.alloc_tensor() copy(%[[plain]]) : tensor<4xf64>
+//       CHECK:   %[[copy:.*]] = test.tensor_like_cast %[[alloc]] : tensor<4xf64> to !test.test_tensor<[4], f64>
+//       CHECK:   %[[out:.*]] = "test.dummy_tensor_op"(%[[copy]])
+//       CHECK:   return %[[out]]
+func.func @copy_of_result(%arg: tensor<4xf64>) -> !test.test_tensor<[4], f64> {
+  %cast = test.tensor_like_cast %arg : tensor<4xf64> to !test.test_tensor<[4], f64>
+  %out = "test.dummy_tensor_op"(%cast) : (!test.test_tensor<[4], f64>)
+    -> !test.test_tensor<[4], f64>
+  return %out : !test.test_tensor<[4], f64>
+}
