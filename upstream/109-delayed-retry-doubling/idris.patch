+-- The metavariables unsolved at some point: the holes, and the guesses
+-- that wait on constraints.
+Unsolved : Type
+Unsolved = (IntMap (FC, Name), IntMap (FC, Name))
+
+unsolved : {auto u : Ref UST UState} -> Core Unsolved
+unsolved = do ust <- get UST
+              pure (holes ust, guesses ust)
+
+-- Whether every metavariable unsolved at the first point is still unsolved
+-- at the second.
+noneSolved : Unsolved -> Unsolved -> Bool
+noneSolved (hs, gs) (hs', gs') = still hs hs' && still gs gs'
+  where
+    still : IntMap (FC, Name) -> IntMap (FC, Name) -> Bool
+    still before now = all (\k => isJust (lookup k now)) (keys before)
+
+-- What a pass learnt of a delayed elaborator that failed recoverably: the
+-- error, and what was unsolved when the failing attempt began. An attempt
+-- that begins with all of that still unsolved knows no more than the one
+-- that failed, so it fails the same way, and is not run again. Each
+-- delayed elaborator may retry delayed elaborators of its own, so running
+-- such a failure again at every level of a nest, once in each pass, costs
+-- time exponential in the nesting before the same error is reported.
+Failures : Type
+Failures = IntMap (Unsolved, Error)
+
