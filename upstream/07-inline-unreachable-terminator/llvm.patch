diff --git a/mlir/lib/Dialect/UB/IR/UBOps.cpp b/mlir/lib/Dialect/UB/IR/UBOps.cpp
index ee523f9522953db3712e9960eaf8266be612d7ed..41441a31624c64dc1f4105ad2c7097c3bfe04cd0 100644
--- a/mlir/lib/Dialect/UB/IR/UBOps.cpp
+++ b/mlir/lib/Dialect/UB/IR/UBOps.cpp
@@ -29,6 +29,16 @@ struct UBInlinerInterface : public DialectInlinerInterface {
   bool isLegalToInline(Operation *, Region *, bool, IRMapping &) const final {
     return true;
   }
+
+  /// `ub.unreachable` does not return to the caller, so the operations after
+  /// the call cannot follow it in its block.
+  bool allowSingleBlockOptimization(
+      iterator_range<Region::iterator> inlinedBlocks) const final {
+    return !isa<UnreachableOp>(inlinedBlocks.begin()->getTerminator());
+  }
+
+  /// `ub.unreachable` stays the terminator of its inlined block.
+  void handleTerminator(Operation *, Block *) const final {}
 };
 } // namespace
 
