+// A callee whose terminator does not return to the caller is inlined as a
+// block of its own: the terminator stays, and the operations after the call
+// move to a block that it does not branch to.
+func.func private @func_unreachable() -> i32 {
+  ub.unreachable
+}
+
+// CHECK-LABEL: func @inline_unreachable(
+func.func @inline_unreachable() -> i32 {
+  // CHECK-NEXT: ub.unreachable
+  // CHECK-NEXT: ^{{.*}}(%[[RES:.*]]: i32):
+  // CHECK-NEXT: return %[[RES]]
+  %0 = call @func_unreachable() : () -> i32
+  return %0 : i32
+}
+
+// CHECK-LABEL: func @inline_unreachable_single_block_region(
+func.func @inline_unreachable_single_block_region(%n : index) {
+  %c0 = arith.constant 0 : index
+  %c1 = arith.constant 1 : index
+  // The call cannot be inlined because scf.for does not support unstructured
+  // control flow in its body.
+  // CHECK: scf.for
+  // CHECK-NEXT: call @func_unreachable()
+  scf.for %i = %c0 to %n step %c1 {
+    %0 = func.call @func_unreachable() : () -> i32
+  }
+  return
+}
+
+llvm.func @llvm_func_unreachable() -> i32 {
+  llvm.unreachable
+}
+
+// CHECK-LABEL: func @inline_llvm_unreachable(
+func.func @inline_llvm_unreachable() -> i32 {
+  // CHECK-NEXT: llvm.unreachable
+  // CHECK-NEXT: ^{{.*}}(%[[RES:.*]]: i32):
+  // CHECK-NEXT: return %[[RES]]
+  %0 = llvm.call @llvm_func_unreachable() : () -> i32
+  return %0 : i32
+}
