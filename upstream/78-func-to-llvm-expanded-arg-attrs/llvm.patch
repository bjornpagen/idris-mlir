Subject: [PATCH] [mlir][FuncToLLVM] Keep pointer attributes of a memref argument

`propagateFunctionArgResAttrs` attaches an argument's attributes only
where the argument converts to one LLVM argument, and drops every
attribute of one that expands into several, leaving a TODO ("Implement
custom handling for types that expand to multiple function arguments").
A ranked memref expands into its descriptor, so `{llvm.noalias}` on a
memref argument never reaches LLVM unless the bare-pointer convention is
used.

For a ranked memref, the pointer attributes now go where they hold:
`llvm.noalias`, `llvm.nocapture`, `llvm.nofree`, `llvm.nonnull`,
`llvm.noundef`, `llvm.readonly`, `llvm.writeonly` and `llvm.readnone` to
the allocated and the aligned pointer, and `llvm.align`,
`llvm.dereferenceable` and `llvm.dereferenceable_or_null`, which measure
from the data, to the aligned pointer alone. No attribute goes to the
offset, sizes or strides, and an attribute that is no pointer's is still
dropped. The TODO goes. convert-argattrs.mlir's check that the
attributes are dropped becomes a check of where they go.
---
diff --git a/mlir/lib/Conversion/FuncToLLVM/FuncToLLVM.cpp b/mlir/lib/Conversion/FuncToLLVM/FuncToLLVM.cpp
index f5e21d63..65356812 100644
--- a/mlir/lib/Conversion/FuncToLLVM/FuncToLLVM.cpp
+++ b/mlir/lib/Conversion/FuncToLLVM/FuncToLLVM.cpp
@@ -413,11 +413,39 @@ static void propagateFunctionArgResAttrs(
             DictionaryAttr::get(rewriter.getContext(), convertedAttrs);
         continue;
       }
-      // TODO: Implement custom handling for types that expand to multiple
-      // function arguments.
       for (size_t j = 0; j < mapping->size; ++j)
         newArgAttrs[mapping->inputNo + j] =
             DictionaryAttr::get(rewriter.getContext(), {});
+      // A ranked memref expands into its descriptor: the allocated and the
+      // aligned pointer, then the offset, sizes and strides. An attribute of
+      // the pointer the memref stands for holds of both pointers; one that
+      // measures from the data (alignment, dereferenceable bytes) holds of the
+      // aligned pointer alone. Every other attribute names no one argument.
+      if (isa<MemRefType>(funcOp.getArgumentTypes()[i])) {
+        SmallVector<NamedAttribute, 4> bothPointers, alignedPointer;
+        for (const NamedAttribute &attr : convertedAttrs) {
+          StringRef name = attr.getName().getValue();
+          if (name == LLVM::LLVMDialect::getAlignAttrName() ||
+              name == LLVM::LLVMDialect::getDereferenceableAttrName() ||
+              name == LLVM::LLVMDialect::getDereferenceableOrNullAttrName()) {
+            alignedPointer.push_back(attr);
+          } else if (name == LLVM::LLVMDialect::getNoAliasAttrName() ||
+                     name == LLVM::LLVMDialect::getNoCaptureAttrName() ||
+                     name == LLVM::LLVMDialect::getNoFreeAttrName() ||
+                     name == LLVM::LLVMDialect::getNonNullAttrName() ||
+                     name == LLVM::LLVMDialect::getNoUndefAttrName() ||
+                     name == LLVM::LLVMDialect::getReadonlyAttrName() ||
+                     name == LLVM::LLVMDialect::getWriteOnlyAttrName() ||
+                     name == LLVM::LLVMDialect::getReadnoneAttrName()) {
+            bothPointers.push_back(attr);
+          }
+        }
+        llvm::append_range(alignedPointer, bothPointers);
+        newArgAttrs[mapping->inputNo] =
+            DictionaryAttr::get(rewriter.getContext(), bothPointers);
+        newArgAttrs[mapping->inputNo + 1] =
+            DictionaryAttr::get(rewriter.getContext(), alignedPointer);
+      }
     }
     if (!newArgAttrs.empty())
       newFuncOp.setAllArgAttrs(rewriter.getArrayAttr(newArgAttrs));
diff --git a/mlir/test/Conversion/FuncToLLVM/convert-argattrs.mlir b/mlir/test/Conversion/FuncToLLVM/convert-argattrs.mlir
index 85c7cbdd..b220c060 100644
--- a/mlir/test/Conversion/FuncToLLVM/convert-argattrs.mlir
+++ b/mlir/test/Conversion/FuncToLLVM/convert-argattrs.mlir
@@ -7,12 +7,22 @@ func.func @check_attributes(%int: i64 {dialect.a = true, dialect.b = 4 : i64 })
 }
 
 // CHECK-LABEL: func @check_memref
-// When expanding the memref to multiple arguments, argument attributes should be dropped entirely.
-// CHECK-NOT: {llvm.noalias}
+// When expanding a ranked memref into its descriptor, a pointer attribute
+// goes to the allocated and the aligned pointer, and none to the offset, sizes
+// and strides.
+// CHECK-SAME: %{{.*}}: !llvm.ptr {llvm.noalias}, %{{.*}}: !llvm.ptr {llvm.noalias}, %{{[^:]*}}: i64, %{{[^:]*}}: i64, %{{[^:]*}}: i64, %{{[^:]*}}: i64, %{{[^:]*}}: i64)
 func.func @check_memref(%static: memref<10x20xf32> {llvm.noalias}) {
   return
 }
 
+// CHECK-LABEL: func @check_memref_pointer_attributes
+// The alignment and dereferenceable bytes measure from the aligned pointer
+// alone; an attribute that is no pointer's is dropped.
+// CHECK-SAME: %{{.*}}: !llvm.ptr {llvm.nonnull, llvm.readonly}, %{{.*}}: !llvm.ptr {llvm.align = 16 : i64, llvm.dereferenceable = 32 : i64, llvm.nonnull, llvm.readonly}, %{{[^:]*}}: i64, %{{[^:]*}}: i64, %{{[^:]*}}: i64)
+func.func @check_memref_pointer_attributes(%m: memref<8xf32> {llvm.align = 16 : i64, llvm.dereferenceable = 32 : i64, llvm.nonnull, llvm.readonly, dialect.a = true}) {
+  return
+}
+
 // CHECK-LABEL: func @check_multiple
 // CHECK-SAME: %{{.*}}: f32 {first.arg = true}, %{{.*}}: i64 {second.arg = 42 : i32}
 func.func @check_multiple(%first: f32 {first.arg = true}, %second: i64 {second.arg = 42 : i32}) {
