     dictAttrs = op->getRawDictionaryAttrs();
-  llvm::hash_code hash =
-      llvm::hash_combine(op->getName(), dictAttrs, op->getResultTypes());
-  if (!(flags & Flags::IgnoreProperties))
-    hash = llvm::hash_combine(hash, op->hashProperties());
+    if (mapper)
