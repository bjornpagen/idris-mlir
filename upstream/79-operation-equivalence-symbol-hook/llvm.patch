diff --git a/mlir/unittests/IR/OperationSupportTest.cpp b/mlir/unittests/IR/OperationSupportTest.cpp
index 33f69a6..436fd0e 100644
--- a/mlir/unittests/IR/OperationSupportTest.cpp
+++ b/mlir/unittests/IR/OperationSupportTest.cpp
@@ -443,4 +443,100 @@ TEST(RepeatedRangeTest, TypeRangeFromRepeatedValueViaValueRange) {
   useOp->destroy();
 }
 
+TEST(OperationEquivalenceTest, MapSymbolRef) {
+  MLIRContext context;
+  context.allowUnregisteredDialects();
+  Builder builder(&context);
+  auto makeCall = [&](StringRef callee) {
+    NamedAttrList attrs;
+    attrs.append("callee", FlatSymbolRefAttr::get(&context, callee));
+    return Operation::create(UnknownLoc::get(&context),
+                             OperationName("foo.call", &context), {}, {},
+                             std::move(attrs), PropertyRef(), {}, 0);
+  };
+  Operation *callA = makeCall("a");
+  Operation *callB = makeCall("b");
+  Operation *callC = makeCall("c");
+
+  // @a and @b are one class, represented by @a; @c is its own.
+  auto classOf = [&](SymbolRefAttr ref) -> Attribute {
+    if (ref.getRootReference() == "b")
+      return FlatSymbolRefAttr::get(&context, "a");
+    return ref;
+  };
+  auto exact = OperationEquivalence::exactValueMatch;
+  EXPECT_FALSE(OperationEquivalence::isEquivalentTo(
+      callA, callB, exact, nullptr, OperationEquivalence::IgnoreLocations));
+  EXPECT_TRUE(OperationEquivalence::isEquivalentTo(
+      callA, callB, exact, nullptr, OperationEquivalence::IgnoreLocations,
+      nullptr, classOf));
+  EXPECT_FALSE(OperationEquivalence::isEquivalentTo(
+      callA, callC, exact, nullptr, OperationEquivalence::IgnoreLocations,
+      nullptr, classOf));
+  auto hash = [&](Operation *op) {
+    return OperationEquivalence::computeHash(
+        op, OperationEquivalence::directHashValue,
+        OperationEquivalence::ignoreHashValue,
+        OperationEquivalence::IgnoreLocations, classOf);
+  };
+  EXPECT_EQ(hash(callA), hash(callB));
+  callA->destroy();
+  callB->destroy();
+  callC->destroy();
+}
+
+TEST(OperationEquivalenceTest, MapSymbolRefInTypes) {
+  MLIRContext context;
+  context.allowUnregisteredDialects();
+  Builder builder(&context);
+  // A ranked tensor's encoding may be any attribute, a symbol reference
+  // among them.
+  auto tensorOf = [&](StringRef symbol) -> Type {
+    return RankedTensorType::get({4}, builder.getF32Type(),
+                                 FlatSymbolRefAttr::get(&context, symbol));
+  };
+  auto classOf = [&](SymbolRefAttr ref) -> Attribute {
+    if (ref.getRootReference() == "b")
+      return FlatSymbolRefAttr::get(&context, "a");
+    return ref;
+  };
+  auto anyValue = OperationEquivalence::ignoreValueEquivalence;
+
+  // Result types.
+  Operation *makeA = createOp(&context, /*operands=*/{}, tensorOf("a"));
+  Operation *makeB = createOp(&context, /*operands=*/{}, tensorOf("b"));
+  Operation *makeC = createOp(&context, /*operands=*/{}, tensorOf("c"));
+  EXPECT_FALSE(OperationEquivalence::isEquivalentTo(
+      makeA, makeB, anyValue, nullptr, OperationEquivalence::IgnoreLocations));
+  EXPECT_TRUE(OperationEquivalence::isEquivalentTo(
+      makeA, makeB, anyValue, nullptr, OperationEquivalence::IgnoreLocations,
+      nullptr, classOf));
+  EXPECT_FALSE(OperationEquivalence::isEquivalentTo(
+      makeA, makeC, anyValue, nullptr, OperationEquivalence::IgnoreLocations,
+      nullptr, classOf));
+  auto hash = [&](Operation *op) {
+    return OperationEquivalence::computeHash(
+        op, OperationEquivalence::ignoreHashValue,
+        OperationEquivalence::ignoreHashValue,
+        OperationEquivalence::IgnoreLocations, classOf);
+  };
+  EXPECT_EQ(hash(makeA), hash(makeB));
+
+  // Operand types: two uses of different values whose types differ only in
+  // the symbol they name.
+  Operation *useA = createOp(&context, makeA->getResult(0));
+  Operation *useB = createOp(&context, makeB->getResult(0));
+  EXPECT_FALSE(OperationEquivalence::isEquivalentTo(
+      useA, useB, anyValue, nullptr, OperationEquivalence::IgnoreLocations));
+  EXPECT_TRUE(OperationEquivalence::isEquivalentTo(
+      useA, useB, anyValue, nullptr, OperationEquivalence::IgnoreLocations,
+      nullptr, classOf));
+
+  useA->destroy();
+  useB->destroy();
+  makeA->destroy();
+  makeB->destroy();
+  makeC->destroy();
+}
+
 } // namespace
