+namespace {
+/// Attributes and types with every symbol reference in them replaced by what
+/// a `MapSymbolRefFn` gives for it, made only when a comparison needs one, and
+/// remembering what it replaced for the rest of the comparison.
+class SymbolRefMapper {
+public:
+  explicit SymbolRefMapper(OperationEquivalence::MapSymbolRefFn mapSymbolRef)
+      : mapSymbolRef(mapSymbolRef) {}
+
+  /// Whether a mapping was given at all.
+  explicit operator bool() const { return static_cast<bool>(mapSymbolRef); }
+
+  Attribute map(Attribute attr) {
+    return attr ? getReplacer().replace(attr) : attr;
+  }
+  Type map(Type type) { return type ? getReplacer().replace(type) : type; }
+
+  /// Whether `lhs` and `rhs` are equal, or equal once their symbol references
+  /// are mapped.
+  template <typename T>
+  bool same(T lhs, T rhs) {
+    return lhs == rhs || (mapSymbolRef && map(lhs) == map(rhs));
+  }
+
+private:
+  AttrTypeReplacer &getReplacer() {
+    if (!replacer) {
+      replacer.emplace();
+      // What stands for a reference is final: nothing nested in it is mapped
+      // again.
+      replacer->addReplacement(
+          [mapSymbolRef = mapSymbolRef](SymbolRefAttr ref)
+              -> std::optional<std::pair<Attribute, WalkResult>> {
+            return std::make_pair(mapSymbolRef(ref), WalkResult::skip());
+          });
+    }
+    return *replacer;
+  }
+
+  OperationEquivalence::MapSymbolRefFn mapSymbolRef;
+  std::optional<AttrTypeReplacer> replacer;
+};
+} // namespace
