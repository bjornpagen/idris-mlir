+
+void IRNumberingState::numberNested(SmallVector<NestedComponent> components) {
+  // The components left to number, grouped by the attribute or type whose
+  // writing reached them (or by the caller's writing), each group with the
+  // index of its next component. The components of a newly numbered attribute
+  // or type are numbered before the rest of its group, which is the order a
+  // recursive walk would take, while the native stack stays independent of
+  // the nesting depth.
+  SmallVector<std::pair<SmallVector<NestedComponent>, size_t>> worklist;
+  if (!components.empty())
+    worklist.emplace_back(std::move(components), 0);
+  while (!worklist.empty()) {
+    auto &[group, next] = worklist.back();
+    if (next == group.size()) {
+      worklist.pop_back();
+      continue;
+    }
+    SmallVector<NestedComponent> nested;
+    std::visit(llvm::makeVisitor(
+                   [&](Attribute attr) { numberShallow(attr, nested); },
+                   [&](Type type) { numberShallow(type, nested); },
+                   [&](const NestedResources &resources) {
+                     number(resources.dialect, resources.resources);
+                   },
+                   [&](const NestedGroupName &groupName) {
+                     groupName.numbering->dialect =
+                         &numberDialect(groupName.name);
+                   }),
+               group[next++]);
+    if (!nested.empty())
+      worklist.emplace_back(std::move(nested), 0);
+  }
 }
 
