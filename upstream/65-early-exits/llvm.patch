+    // CHECK-NEXT: test.op2
+     "test.op2"() : () -> ()
+    // CHECK-NEXT: cf.cond_br %arg0, [[IF_ENTRY:.*]], [[IF_CONTINUE:.*]]
+    // CHECK-NEXT: [[IF_ENTRY]]
+     scf.if %cond {
+       "test.op3"() : () -> ()
+       scf.break [%loop] loc("break1")
+     }
+     "test.op3"() : () -> ()
+   } loc("loop1")
+   "test.op4"() : () -> ()
