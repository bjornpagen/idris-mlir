diff --git a/mlir/unittests/IR/CloneTest.cpp b/mlir/unittests/IR/CloneTest.cpp
new file mode 100644
index 0000000..a7b285c
--- /dev/null
+++ b/mlir/unittests/IR/CloneTest.cpp
@@ -0,0 +1,85 @@
+//===- CloneTest.cpp - Cloning deeply nested IR ---------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+#include "mlir/IR/BuiltinTypes.h"
+#include "mlir/IR/IRMapping.h"
+#include "mlir/IR/Location.h"
+#include "mlir/IR/MLIRContext.h"
+#include "mlir/IR/Operation.h"
+#include "llvm/Support/thread.h"
+#include "gtest/gtest.h"
+
+using namespace mlir;
+
+namespace {
+/// A chain of operations nested `depth` deep, outermost first: each but the
+/// last holds the next in the one block of its one region, and the next takes
+/// that block's argument as its operand.
+SmallVector<Operation *> createChain(MLIRContext &context, unsigned depth) {
+  context.allowUnregisteredDialects();
+  Location loc = UnknownLoc::get(&context);
+  Type i32 = IntegerType::get(&context, 32);
+  SmallVector<Operation *> chain{Operation::create(
+      loc, OperationName("test.nest", &context), {}, {}, NamedAttrList(),
+      PropertyRef(), {}, /*numRegions=*/1)};
+  for (unsigned i = 1; i < depth; ++i) {
+    Block *block = new Block();
+    chain.back()->getRegion(0).push_back(block);
+    Value argument = block->addArgument(i32, loc);
+    chain.push_back(Operation::create(
+        loc, OperationName("test.nest", &context), {}, {argument},
+        NamedAttrList(), PropertyRef(), {}, i + 1 < depth ? 1 : 0));
+    block->push_back(chain.back());
+  }
+  return chain;
+}
+
+/// The operations of a chain made by `createChain`, outermost first, found by
+/// following the one region of each.
+SmallVector<Operation *> followChain(Operation *root) {
+  SmallVector<Operation *> chain{root};
+  while (chain.back()->getNumRegions() != 0)
+    chain.push_back(&chain.back()->getRegion(0).front().front());
+  return chain;
+}
+
+/// Destroy a chain innermost first, so that no destruction recurses on its
+/// depth.
+void destroyChain(ArrayRef<Operation *> chain) {
+  for (Operation *op : llvm::reverse(llvm::drop_begin(chain)))
+    op->erase();
+  chain.front()->destroy();
+}
+
+TEST(CloneTest, DeepNestingOnASmallStack) {
+  MLIRContext context;
+  constexpr unsigned depth = 10000;
+  SmallVector<Operation *> chain = createChain(context, depth);
+
+  // A clone that took a native frame per level of nesting would overflow this
+  // thread's stack.
+  Operation *clone = nullptr;
+  IRMapping mapper;
+  llvm::thread cloner(/*StackSizeInBytes=*/256 * 1024,
+                      [&] { clone = chain.front()->clone(mapper); });
+  cloner.join();
+
+  SmallVector<Operation *> cloned = followChain(clone);
+  ASSERT_EQ(cloned.size(), depth);
+  for (unsigned i = 0; i < depth; ++i) {
+    EXPECT_EQ(mapper.lookup(chain[i]), cloned[i]);
+    // Each operand is the argument of the cloned block that holds it.
+    if (i != 0)
+      EXPECT_EQ(cloned[i]->getOperand(0),
+                cloned[i]->getBlock()->getArgument(0));
+  }
+
+  destroyChain(cloned);
+  destroyChain(chain);
+}
+} // namespace
