+/// Create in `dest`, before `destPos`, a block for each block of `source`,
+/// with its arguments, and an operation for each of its operations, with no
+/// operand set and no region cloned, mapping each in `mapper`. Returns the
+/// first block created; `source` must not be empty.
+static Region::iterator cloneBlocksAndOperations(Region &source, Region *dest,
+                                                 Region::iterator destPos,
+                                                 IRMapping &mapper) {
   // First clone all the blocks and block arguments and map them, but don't yet
   // clone the operations, as they may otherwise add a use to a block that has
   // not yet been mapped
-  for (Block &block : *this) {
+  for (Block &block : source) {
     Block *newBlock = new Block();
     mapper.map(&block, newBlock);
 
@@ -108,8 +96,8 @@ void Region::cloneInto(Region *dest, Region::iterator destPos,
     dest->getBlocks().insert(destPos, newBlock);
   }
 
-  auto newBlocksRange =
-      llvm::make_range(Region::iterator(mapper.lookup(&front())), destPos);
+  Region::iterator firstNewBlock(mapper.lookup(&source.front()));
+  auto newBlocksRange = llvm::make_range(firstNewBlock, destPos);
 
   // Now follow up with creating the operations, but don't yet clone their
   // regions, nor set their operands. Setting the successors is safe as all have
@@ -119,32 +107,105 @@ void Region::cloneInto(Region *dest, Region::iterator destPos,
   // not yet mapped.
   auto cloneOptions =
       Operation::CloneOptions::all().cloneRegions(false).cloneOperands(false);
-  for (auto zippedBlocks : llvm::zip(*this, newBlocksRange)) {
+  for (auto zippedBlocks : llvm::zip(source, newBlocksRange)) {
     Block &sourceBlock = std::get<0>(zippedBlocks);
     Block &clonedBlock = std::get<1>(zippedBlocks);
