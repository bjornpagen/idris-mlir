-  // Finally now that all operation results have been mapped, set the operands
-  // and clone the regions.
+/// Clone this region into 'dest' before the given position in 'dest'.
+void Region::cloneInto(Region *dest, Region::iterator destPos,
+                       IRMapping &mapper) {
+  assert(dest && "expected valid region to clone into");
+  assert(this != dest && "cannot clone region into itself");
+
+  // If the list is empty there is nothing to clone.
+  if (empty())
+    return;
+
+  // The below clone implementation takes special care to be read only for the
+  // sake of multi threading. That essentially means not adding any uses to any
+  // of the blocks or operation results contained within this region as that
+  // would lead to a write in their use-def list. This is unavoidable for
+  // 'Value's from outside the region however, in which case it is not read
+  // only. Using the IRMapper it is possible to remap such 'Value's
+  // to ones owned by the calling thread however, making it read only once
+  // again.
+
+  // Each region is cloned in two steps: its blocks and operations are created
+  // and mapped first, and only then are the operations' operands set and
+  // their regions cloned, so that every value an operand names is mapped by
+  // the time it is set. A nested region is cloned in full, both steps, when
+  // the operation holding it is reached in the second step of its parent.
+  // Regions nest without bound, so the second step keeps its place in each
+  // region it is inside on an explicit stack rather than by recursion: the
+  // depth of the native stack does not grow with the depth of the nesting.
+  // The blocks, operations and mappings are created in the order a recursive
+  // clone would create them.
+  struct RegionInProgress {
+    Region::iterator sourceBlock, sourceEnd, clonedBlock;
+    Block::iterator sourceOp, clonedOp;
+    // The next region of the operation at `sourceOp` to clone.
+    unsigned nextRegion = 0;
+  };
+  SmallVector<RegionInProgress> stack;
   SmallVector<Value> operands;
-  for (auto zippedBlocks : llvm::zip(*this, newBlocksRange)) {
-    for (auto ops :
-         llvm::zip(std::get<0>(zippedBlocks), std::get<1>(zippedBlocks))) {
-      Operation &source = std::get<0>(ops);
-      Operation &clone = std::get<1>(ops);
-
-      operands.resize(source.getNumOperands());
-      llvm::transform(
-          source.getOperands(), operands.begin(),
-          [&](Value operand) { return mapper.lookupOrDefault(operand); });
-      clone.setOperands(operands);
-
-      for (auto regions : llvm::zip(source.getRegions(), clone.getRegions()))
-        std::get<0>(regions).cloneInto(&std::get<1>(regions), mapper);
+
+  // Move `region` to its first operation at or after its position, across
+  // empty blocks, and set that operation's operands. Returns false when no
+  // operation is left in the region.
+  auto reachOperation = [&](RegionInProgress &region) {
+    while (region.sourceOp == region.sourceBlock->end()) {
+      ++region.sourceBlock;
+      ++region.clonedBlock;
+      if (region.sourceBlock == region.sourceEnd)
+        return false;
+      region.sourceOp = region.sourceBlock->begin();
+      region.clonedOp = region.clonedBlock->begin();
+    }
+    Operation &source = *region.sourceOp;
+    operands.resize(source.getNumOperands());
+    llvm::transform(
+        source.getOperands(), operands.begin(),
+        [&](Value operand) { return mapper.lookupOrDefault(operand); });
+    region.clonedOp->setOperands(operands);
+    region.nextRegion = 0;
+    return true;
+  };
+
+  // Create `source`'s blocks and operations in `clone` before `clonePos`, and
+  // begin setting their operands and cloning their regions.
+  auto enterRegion = [&](Region &source, Region *clone,
+                         Region::iterator clonePos) {
+    Region::iterator firstClonedBlock =
+        cloneBlocksAndOperations(source, clone, clonePos, mapper);
+    RegionInProgress region{source.begin(), source.end(), firstClonedBlock,
+                            source.front().begin(), firstClonedBlock->begin()};
+    if (reachOperation(region))
+      stack.push_back(region);
+  };
+
+  enterRegion(*this, dest, destPos);
+  while (!stack.empty()) {
+    RegionInProgress &region = stack.back();
+    Operation &source = *region.sourceOp;
+    if (region.nextRegion == source.getNumRegions()) {
+      ++region.sourceOp;
+      ++region.clonedOp;
+      if (!reachOperation(region))
+        stack.pop_back();
+      continue;
     }
+    unsigned index = region.nextRegion++;
+    Region &nested = source.getRegion(index);
+    if (nested.empty())
+      continue;
+    Region &clonedNested = region.clonedOp->getRegion(index);
+    enterRegion(nested, &clonedNested, clonedNested.end());
   }
 }
 
