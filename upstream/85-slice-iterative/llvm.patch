+/// Insert into `forwardSlice` the ops that `root` reaches, through the ops
+/// nested in its regions and the users of its results and theirs, each after
+/// every op it reaches (the slice's reverse topological order), and `root`
+/// last. `visited` holds the ops on the current path of the search; the
+/// caller adds `root` to it.
+///
+/// Use-def chains and nesting are unbounded, so the search keeps its path on
+/// an explicit stack rather than recursing: the depth of the native stack
+/// does not grow with the length of a chain. Searching changes no IR, so an
+/// op's successors are listed when its visit begins, and each is tested when
+/// its turn comes, as by recursion.
 static void
-getForwardSliceImpl(Operation *op, DenseSet<Operation *> &visited,
+getForwardSliceImpl(Operation *root, DenseSet<Operation *> &visited,
                     SetVector<Operation *> *forwardSlice,
                     const SliceOptions::TransitiveFilter &filter = nullptr) {
-  if (!op)
-    return;
+  // An op the search may go to from an op it visits: one nested in its
+  // regions, or a user of its results.
+  enum class Edge { Nested, Use };
+  // One frame per op on the current path, innermost last: the ops it may go
+  // to, and the next of them.
+  struct Frame {
+    Operation *op;
+    SmallVector<std::pair<Operation *, Edge>> next;
+    size_t nextIndex;
+  };
+  SmallVector<Frame> stack;
+
+  // Begin the visit of `op`, unless it is null or the filter stops at it.
+  auto visit = [&](Operation *op) {
+    if (!op)
+      return false;
+
+    // Evaluate whether we should keep this use.
+    // This is useful in particular to implement scoping; i.e. return the
+    // transitive forwardSlice in the current scope.
+    if (filter && !filter(op))
+      return false;
+
+    SmallVector<std::pair<Operation *, Edge>> next;
+    for (Region &region : op->getRegions())
+      for (Block &block : region)
+        for (Operation &blockOp : block)
+          next.emplace_back(&blockOp, Edge::Nested);
+    for (Value result : op->getResults())
+      for (Operation *userOp : result.getUsers())
+        next.emplace_back(userOp, Edge::Use);
+    stack.push_back({op, std::move(next), 0});
+    return true;
+  };
 
