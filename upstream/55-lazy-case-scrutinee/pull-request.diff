diff --git a/src/TTImp/Elab/Case.idr b/src/TTImp/Elab/Case.idr
index f4e6873..b733644 100644
--- a/src/TTImp/Elab/Case.idr
+++ b/src/TTImp/Elab/Case.idr
@@ -359,21 +359,20 @@ caseBlock {vars} rigc elabinfo fc nest env opts scr scrtm scrty caseRig alts exp
               ImpossibleClause loc' (applyNested nest lhs')
 
 
-export
-checkCase : {vars : _} ->
-            {auto c : Ref Ctxt Defs} ->
-            {auto m : Ref MD Metadata} ->
-            {auto u : Ref UST UState} ->
-            {auto e : Ref EST (EState vars)} ->
-            {auto s : Ref Syn SyntaxInfo} ->
-            {auto o : Ref ROpts REPLOpts} ->
-            RigCount -> ElabInfo ->
-            NestedNames vars -> Env Term vars ->
-            FC -> List FnOpt -> (scr : RawImp) -> (ty : RawImp) -> List ImpClause ->
-            Maybe (Glued vars) ->
-            Core (Term vars, Glued vars)
-checkCase rig elabinfo nest env fc opts scr scrty_in alts exp
-    = delayElab fc rig env exp CaseBlock $
+checkCaseDelayed : {vars : _} ->
+                   {auto c : Ref Ctxt Defs} ->
+                   {auto m : Ref MD Metadata} ->
+                   {auto u : Ref UST UState} ->
+                   {auto e : Ref EST (EState vars)} ->
+                   {auto s : Ref Syn SyntaxInfo} ->
+                   {auto o : Ref ROpts REPLOpts} ->
+                   RigCount -> ElabInfo ->
+                   NestedNames vars -> Env Term vars ->
+                   FC -> List FnOpt -> (scr : RawImp) -> (ty : RawImp) -> List ImpClause ->
+                   Maybe (Glued vars) ->
+                   Core (Term vars, Glued vars)
+checkCaseDelayed rig elabinfo nest env fc opts scr scrty_in alts exp
+    =
         do scrty_exp <- case scrty_in of
                              Implicit {} => guessScrType alts
                              _ => pure scrty_in
@@ -448,3 +447,51 @@ checkCase rig elabinfo nest env fc opts scr scrty_in alts exp
                      applyTo defs (IVar fc tyn) tyty
                _ => guessScrType xs
     guessScrType (_ :: xs) = guessScrType xs
+
+-- A case block expected at a delayed type, Lazy t or Inf t, is checked at
+-- t and delayed whole. Checked at the delayed type, each alternative would
+-- be delayed instead, so the block, and its scrutinee, would be computed
+-- where the value is built: `ifThenElse True 1 (if boom 1 then 2 else 3)`
+-- would compute `boom 1`, which the program delays with the rest of the
+-- argument.
+checkCaseExpected : {vars : _} ->
+                    {auto c : Ref Ctxt Defs} ->
+                    {auto m : Ref MD Metadata} ->
+                    {auto u : Ref UST UState} ->
+                    {auto e : Ref EST (EState vars)} ->
+                    {auto s : Ref Syn SyntaxInfo} ->
+                    {auto o : Ref ROpts REPLOpts} ->
+                    RigCount -> ElabInfo ->
+                    NestedNames vars -> Env Term vars ->
+                    FC -> List FnOpt -> (scr : RawImp) -> (ty : RawImp) -> List ImpClause ->
+                    Maybe (Glued vars) ->
+                    Core (Term vars, Glued vars)
+checkCaseExpected rig elabinfo nest env fc opts scr scrty_in alts Nothing
+    = checkCaseDelayed rig elabinfo nest env fc opts scr scrty_in alts Nothing
+checkCaseExpected rig elabinfo nest env fc opts scr scrty_in alts (Just expected)
+    = case !(getNF expected) of
+           NDelayed _ r expnf =>
+              do defs <- get Ctxt
+                 (tm, gty) <- checkCaseDelayed rig elabinfo nest env fc opts scr scrty_in alts
+                                               (Just (glueBack defs env expnf))
+                 tynf <- getNF gty
+                 ty <- getTerm gty
+                 pure (TDelay fc r ty tm, glueBack defs env (NDelayed fc r tynf))
+           _ => checkCaseDelayed rig elabinfo nest env fc opts scr scrty_in alts (Just expected)
+
+export
+checkCase : {vars : _} ->
+            {auto c : Ref Ctxt Defs} ->
+            {auto m : Ref MD Metadata} ->
+            {auto u : Ref UST UState} ->
+            {auto e : Ref EST (EState vars)} ->
+            {auto s : Ref Syn SyntaxInfo} ->
+            {auto o : Ref ROpts REPLOpts} ->
+            RigCount -> ElabInfo ->
+            NestedNames vars -> Env Term vars ->
+            FC -> List FnOpt -> (scr : RawImp) -> (ty : RawImp) -> List ImpClause ->
+            Maybe (Glued vars) ->
+            Core (Term vars, Glued vars)
+checkCase rig elabinfo nest env fc opts scr scrty_in alts exp
+    = delayElab fc rig env exp CaseBlock $
+        checkCaseExpected rig elabinfo nest env fc opts scr scrty_in alts exp
diff --git a/tests/idris2/basic/lazycase001/LazyCase.idr b/tests/idris2/basic/lazycase001/LazyCase.idr
