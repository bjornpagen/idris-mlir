index 0000000..cc59e2c
--- /dev/null
+++ b/tests/idris2/basic/lazycase001/LazyCase.idr
@@ -0,0 +1,19 @@
+module LazyCase
+
+partial
+boom : Int -> Int
+boom 0 = 5
+
+pick : Lazy Int -> Int
+pick _ = 1
+
+later : Lazy Int -> Int
+later x = x + 1
+
+partial
+main : IO ()
+main = do
+  printLn (pick (case boom 1 of { 5 => 1; _ => 2 }))
+  printLn (ifThenElse True (the Int 1) (if boom 1 == 5 then 2 else 3))
+  printLn (later (case boom 0 of { 5 => 10; _ => 20 }))
+  printLn (later (if boom 0 == 5 then 30 else 40))
