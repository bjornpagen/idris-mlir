+      -- The fallthrough tree is copied into every alternative. Each copy
+      -- is reached only with 'el' known to be that alternative's
+      -- constructor (or, for the default, none of the others), so its own
+      -- cases on 'el' keep only the alternatives that can still match.
+      -- Without this a function whose clauses alternate between a
+      -- constructor and a wildcard in one argument gets a tree exponential
+      -- in the number of clauses.
       altGroups : forall ne. List01 ne (Group todo vars) -> Core (List (CaseAlt vars))
-      altGroups [] = pure $ toList $ DefaultCase <$> errorCase
+      altGroups [] = pure $ toList $
+          DefaultCase . pruneCase (MkVar el) (NoneOf (matched gs)) <$> errorCase
       altGroups (ConGroup {newargs} cn tag rest :: cs)
-          = do crest <- match fc fn phase rest (map (weakenNs (mkSizeOf newargs)) errorCase)
+          = do let l = mkSizeOf newargs
