+++ b/src/Core/Case/CaseBuilder.idr
@@ -862,6 +862,47 @@ shuffleVars First orig@(MkPatClause pvars lhs pid rhs) = orig -- no-op
 shuffleVars el (MkPatClause pvars lhs pid rhs)
     = MkPatClause pvars (moveFirst el lhs) pid rhs
 
+-- What a tree may assume of a variable a case further up has matched.
+data Matched = IsCon Name | NoneOf (List Name)
+
+-- Drop the alternatives of every case on the variable that what is known of
+-- it rules out. A data or type constructor is told apart by its name, which
+-- is how the evaluator matches a type constructor. A case left with nothing
+-- is left alone.
+pruneCase : {vars : _} -> Var vars -> Matched -> CaseTree vars -> CaseTree vars
+pruneCase v m (Case idx el ty alts)
+    = let alts' = map pruneAlt alts in
+          Case idx el ty (if MkVar el == v then agreeing alts' else alts')
+  where
+    pruneAlt : CaseAlt vars -> CaseAlt vars
+    pruneAlt (ConCase n t args sc)
+        = ConCase n t args (pruneCase (weakenNs (mkSizeOf args) v) m sc)
+    pruneAlt (DelayCase t a sc)
+        = DelayCase t a (pruneCase (weakenNs (mkSizeOf [t, a]) v) m sc)
+    pruneAlt (ConstCase c sc) = ConstCase c (pruneCase v m sc)
+    pruneAlt (DefaultCase sc) = DefaultCase (pruneCase v m sc)
+
+    conIs : Name -> CaseAlt vars -> Bool
+    conIs n (ConCase n' _ _ _) = n == n'
+    conIs _ _ = False
+
+    conIn : List Name -> CaseAlt vars -> Bool
+    conIn ns (ConCase n _ _ _) = n `elem` ns
+    conIn _ _ = False
+
+    keepSome : List (CaseAlt vars) -> List (CaseAlt vars) -> List (CaseAlt vars)
+    keepSome alts [] = alts
+    keepSome _ kept = kept
+
+    agreeing : List (CaseAlt vars) -> List (CaseAlt vars)
+    agreeing alts
+        = keepSome alts $ case m of
+              IsCon n => case filter (conIs n) alts of
+                              (a :: _) => [a]
+                              [] => filter isDefault alts
+              NoneOf ns => filter (not . conIn ns) alts
+pruneCase v m t = t
+
 mutual
