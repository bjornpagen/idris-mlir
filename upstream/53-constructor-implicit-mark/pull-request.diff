+%default total
+
+-- At quantity 0, a constant or a type that a clause writes on an erased
+-- argument is a match.
+0 h : (0 n : Integer) -> Integer
+h 0 = 1
+h _ = 2
+
+hFive : h 5 = 2
+hFive = Refl
+
+hZero : h 0 = 1
+hZero = Refl
+
+0 tp : (0 t : Type) -> Integer
+tp Integer = 1
+tp _ = 2
+
+tpString : tp String = 2
+tpString = Refl
+
+data P : Type where
+  MkP : (0 n : Integer) -> P
+
+0 pv : P -> Integer
+pv (MkP 0) = 1
+pv (MkP _) = 2
+
+pvFive : pv (MkP 5) = 2
+pvFive = Refl
+
+-- A type that a constructor's implicit takes by unification is no match:
+-- `len` covers every list.
+0 len : List Integer -> Nat
+len [] = 0
+len (_ :: xs) = S (len xs)
+
+lenTwo : len [1, 2] = 2
+lenTwo = Refl
