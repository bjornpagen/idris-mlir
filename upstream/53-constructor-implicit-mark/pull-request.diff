+import Data.List.Quantifiers
+
+%default total
+
+data W = A | F Integer | B
+
+data IsF : W -> Type where
+  ItIsF : IsF (F w)
+
+-- A constructor's implicit that the clauses leave out, and that the pattern
+-- of the constructor's field fixes, is no match: the case tree must not
+-- split it before that field, at either quantity.
+data T1 : Type where
+  C1 : {x : W} -> All IsF [x] -> T1
+
+v1 : T1 -> ()
+v1 (C1 (ItIsF :: [])) = ()
+
+data T2 : Type where
+  C2 : {0 x : W} -> All IsF [x] -> T2
+
+0 v3 : T2 -> Integer
+v3 (C2 (ItIsF :: [])) = 3
+
+v3Three : v3 (C2 (ItIsF {w = 7} :: [])) = 3
+v3Three = Refl
+
+-- An implicit the clause writes is still a match.
+data T3 : Type where
+  C3 : {x : W} -> T3
+
+w3 : T3 -> Integer
+w3 (C3 {x = A}) = 1
+w3 _ = 2
+
+w3B : w3 (C3 {x = B}) = 2
+w3B = Refl
+
+data T4 : Type where
+  C4 : {0 x : W} -> T4
+
+0 w4 : T4 -> Integer
+w4 (C4 {x = A}) = 1
+w4 _ = 2
+
+w4B : w4 (C4 {x = B}) = 2
+w4B = Refl
